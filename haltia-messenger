def move_old_home():
    """2.0 renamed the program (b8k-max → haltia-messenger): its session,
    data, cache and settings move over from the old places once, at the
    first start, so nothing is lost and MAX asks for no second login. The
    folders through the kit (a link is left at the old name, till 3.0); the
    settings here, as their name changes too ([max] → [messenger])."""
    paths.migrate_dirs(OLD_NAME, "haltia-messenger", bases=BASES)
    new_conf = os.path.join(CONFIG, "messenger.conf")
    source = next((p for p in (OLD_CONF, KIT_CONF) if os.path.isfile(p)), None)
    if source and not os.path.lexists(new_conf):
        try:
            old = configparser.ConfigParser(interpolation=None)
            old.read(source, encoding="utf-8")
            conf = configparser.ConfigParser(interpolation=None)
            conf["messenger"] = dict(old["max"]) if old.has_section("max") else {}
            os.makedirs(CONFIG, exist_ok=True)
            with open(new_conf + ".new", "w", encoding="utf-8") as fh:
                conf.write(fh)
            os.replace(new_conf + ".new", new_conf)
            if source == OLD_CONF:  # the kit's copy may be another program's to read: kept
                os.remove(OLD_CONF)
        except (OSError, configparser.Error, UnicodeDecodeError) as exc:
            print("haltia-messenger: settings not moved: %s" % exc, file=sys.stderr)



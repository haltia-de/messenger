def initials_icon(name, key, size=64):
    area = Gtk.DrawingArea()
    area.set_size_request(size, size)
    letters = "".join(w[0] for w in (name or "?").split()[:2]).upper() or "?"
    colour = COLOURS[(key if isinstance(key, int) else zlib.crc32(str(key).encode())) % len(COLOURS)]

    def draw(_w, cr):
        cr.set_source_rgb(*colour)
        cr.arc(size / 2, size / 2, size / 2, 0, 6.2832)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(size * 0.38)
        ext = cr.text_extents(letters)
        cr.move_to((size - ext.width) / 2 - ext.x_bearing, (size - ext.height) / 2 - ext.y_bearing)
        cr.show_text(letters)
        return False

    area.connect("draw", draw)
    return area


FACES = collections.OrderedDict()  # (url, size) -> its round picture, the newest last
FACES_KEPT = 200  # round pictures kept in memory: a row redrawn shows its face at once


def round_pixbuf(pix, size):
    """A picture cut to a circle of size px, its middle kept (a face)."""
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    cr = cairo.Context(surface)
    cr.arc(size / 2, size / 2, size / 2, 0, 6.2832)
    cr.clip()
    k = size / min(pix.get_width(), pix.get_height())
    cr.translate((size - pix.get_width() * k) / 2, (size - pix.get_height() * k) / 2)
    cr.scale(k, k)
    Gdk.cairo_set_source_pixbuf(cr, pix, 0, 0)
    cr.paint()
    return Gdk.pixbuf_get_from_surface(surface, 0, 0, size, size)


def avatar(name, key, url, photo, size=64):
    """A chat's or person's round picture, as in MAX and Telegram: its
    initials at once, its photo (photo(url, done, size, owner): Media's)
    in their place once it has come."""
    box = watched(Gtk.Box())
    box.set_valign(Gtk.Align.CENTER)
    box.photo_url = url
    known = FACES.get((url, size)) if url else None
    if known is not None:
        # Cut round before: shown at once, no initials flashing on each
        # message that redraws the row.
        FACES.move_to_end((url, size))
        box.pack_start(Gtk.Image.new_from_pixbuf(known), False, False, 0)
        return box
    box.pack_start(initials_icon(name, key, size), False, False, 0)

    def came(pix):
        if pix is None or getattr(box, "gone", False):
            return
        face = FACES[(url, size)] = round_pixbuf(pix, size)
        while len(FACES) > FACES_KEPT:
            FACES.popitem(last=False)  # the one shown longest ago
        for child in box.get_children():
            child.destroy()
        image = Gtk.Image.new_from_pixbuf(face)
        box.pack_start(image, False, False, 0)
        image.show()
    if url:
        photo(url, came, size=size * 2, owner=box)
    return box



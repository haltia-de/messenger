        self.recorder = recorder or Recorder()  # voice messages from the microphone
        self.backend = Backend(self, link)  # link: PyMaxLink unless given (tests, demo)
        self.telemetry = Telemetry(self.backend)
        self.came_from = "chats"  # the page the settings go back to
        self.buzz_new = load_setting("buzz")  # a desktop notification of a new message
        # The list's rules and state; pins and notifications are kept here
        # only: MAX's own pinning and muting are not in PyMax.
        self.chatlist = ChatList(LIST, PREFS, contacts_only=load_setting("contacts_only"))
        self.counted = None  # (tab labels, subtitle, badge) as last shown
        self.tab = "chats"  # or "channels"

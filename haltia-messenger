    def page_changed(self, *_args):
        page = self.stack.get_visible_child_name()
        # Settings from the list or before the login, so telemetry can be
        # switched off before anything is sent.
        self.gear.set_visible(page in ("chats", "wait", "login"))
        self.findb.set_visible(page == "chats")
        self.head_face.set_visible(page == "chat")
        self.edit.set_visible(page == "chat" and self.chatlist.listed(self.open_chat))
        self.viewer_save.set_visible(page == "photo")
        summary = self.about(self.open_chat) if self.open_chat is not None else {}
        self.show_call_buttons(self.open_chat, summary, page == "chat")
        if page != "chat":
            self.record_stop(False)  # a voice is said in its chat, or not at all
        if page not in ("chat", "photo", "forward") and not self.keep_sound:
            self.stop_sound()  # the chat is left: its sound stops
        self.show_nowplay()
        if page != "chat":
            self.smile.set_active(False)
            self.confirm.hide()
            self.naming.hide()
            if self.view is not None:
                # A photo or forwarding is part of the chat: the place stays.
                (self.view.pause if page in ("photo", "forward") else self.view.leave)()
        elif self.view is not None:
            self.view.enter()  # back in it (from forwarding): building goes on
        self.moved()

    def run_chooser(self, dialog):
        """A file chooser's answer; a call ringing meanwhile closes it (as a
        cancel), so it never covers «Ответить»."""
        self.chooser = dialog
        try:
            return dialog.run()
        finally:
            self.chooser = None

    def clear_for_call(self):
        """Every question and chooser over the window answered «Отмена»: the
        incoming call's controls must be in front, not a «Сохранить …?»."""
        for dialog in Gtk.Window.list_toplevels():
            if (isinstance(dialog, Gtk.Dialog) and dialog.get_modal()
                    and dialog.get_transient_for() is self.win):
                dialog.response(Gtk.ResponseType.CANCEL)
        if self.chooser is not None:
            self.chooser.hide()


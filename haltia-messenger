def ask_background(bus):
    """Inside Flatpak, where no XDG autostart file reaches the session: ask
    the Background portal to start the program hidden with the session and
    to let it live without a window. The portal asks the person once and
    remembers; outside Flatpak the autostart file does it."""
    if bus is None:
        return
    options = {
        "reason": GLib.Variant("s", "Чтобы сообщения приходили, когда окно закрыто"),
        "autostart": GLib.Variant("b", True),
        "commandline": GLib.Variant("as", ["haltia-messenger", "--background"]),
    }
    bus.call("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
             "org.freedesktop.portal.Background", "RequestBackground",
             GLib.Variant("(sa{sv})", ("", options)), None, Gio.DBusCallFlags.NONE,
             -1, None, None)


def watched(widget):
    """The widget, its `gone` set once destroyed: an owner for Media's queue,
    which reads it from its workers (GTK is not asked from there)."""
    widget.gone = False
    widget.connect("destroy", lambda w: setattr(w, "gone", True))
    return widget


def fitted(path, size):
    """A picture file within size × size, turned upright; the kit's
    pixbuf_of refuses one too large or of unknown size before decoding (a
    sender chooses these files)."""
    _fmt, w, h = GdkPixbuf.Pixbuf.get_file_info(path)
    if w <= 0 or h <= 0:
        raise ValueError("not a picture: %s" % path)
    return photos.pixbuf_of(path, max(1, int(size * min(w, h) / max(w, h))))


def fetch_photo(url, headers):
    req = urllib.request.Request(url, headers=headers)
    with PHOTO_OPENER.open(req, timeout=20) as fh:
        return fh.read(8 * 1024 * 1024)


class Media:
    """Fetching and playing what messages carry (CONTEXT.md: Медиа): the one
    place that decides how to go to MAX's CDNs. Only https links on
    MEDIA_HOSTS are fetched, played or opened; photos never follow a redirect
    off them; everything goes with one header, the browser user agent
    PyMax presents (agent, set at login) and no Referer or Origin: MAX's
    video CDN answers 400 to those. Photos are cached on disk by URL and
    pruned when unshown for PHOTO_DAYS; voice messages play through libmpv,
    one at a time (on_time(sec, total or None), on_end() come back on the
    GTK side), audio files too; a
    video opens full screen in haltia-vplay (mpv elsewhere) without
    youtube-dl or playlists; a file in the browser. What fails, and what
    the players say, goes to LOG (600, host and path only).

    Photos come through a queue: PHOTO_WORKERS at a time, the one asked
    for last first (what is on screen now), one fetch per link however many
    wait for it, and none for whom nobody waits any more (their owner gone:
    an object whose `gone` is set, as ChatView marks its images).

    It also saves what a message carries into a folder (save()), one at a
    time, under a harmless name that never overwrites another.

    What another messenger carries has no link: its link fetches it (own,
    set by the window: Backend.download(ref, path), from a worker thread),
    into the same cache; voice, video and files are played or opened from
    there once fetched.

    Its hands come in at creation, the real ones by default: spawn(cmd),
    open_uri(url) -> bool, fetch(url, headers) -> bytes, player(on_time,
    on_end) -> an object with play(url, agent), toggle(), stop(), and
    download(url, headers, path). Tests give their own."""

    def __init__(self, spawn=spawn_player, open_uri=open_in_browser, fetch=fetch_photo,
                 player=Libmpv, download=download_file):
        self.spawn, self.open_uri, self.fetch, self.player = spawn, open_uri, fetch, player
        self.download = download
        self.own = None  # own(ref, path): a messenger's own attachment fetched by its link
        self.wanted = None  # the voice asked for last: one fetched late plays only if still it
        self.agent = "Mozilla/5.0"  # PyMax's browser user agent, once logged in
        self.on_time = self.on_end = lambda *_a: None
        self._sound = None  # the voice player, made at the first voice message
        self._no_sound = False
        self.cond = threading.Condition()
        self.jobs = []  # photos waiting for a worker, the one wanted last at the end
        self.busy = {}  # url -> its job, waiting or being fetched
        self.workers = 0  # photo workers running
        self.saves = []  # saves waiting, oldest first
        self.saving = False  # the save worker runs

    def headers(self):
        return {"User-Agent": self.agent}

    def how(self, ref):
        """"http" for a link on MEDIA_HOSTS, "own" for an attachment a
        messenger's link fetches (is_ref), None for what is not to be
        fetched at all."""
        if media_ok(ref):
            return "http"
        return "own" if self.own is not None and is_ref(ref) else None

    def _later(self, ref, then):
        """An own attachment into the cache by a thread; then(path or None)
        on the GTK side."""
        def work():
            path = self._photo_file(ref)
            GLib.idle_add(lambda: then(path) and False)
        threading.Thread(target=work, daemon=True).start()

    # --- photos ---------------------------------------------------------------
    def photo(self, url, done, size=460, owner=None):
        """A photo, from the cache or fetched (see the queue above), fitted
        within size × size; done(pixbuf or None) on the GTK side, unless
        owner is gone by then. Nothing at all for a link not to be fetched."""
        if not self.how(url):
            log_line("photo refused: %s" % where(url))
            return
        with self.cond:
            job = self.busy.get(url)
            if job is None:
                job = self.busy[url] = {"url": url, "waiters": [], "started": False}
                self.jobs.append(job)
            elif not job["started"]:
                self.jobs.remove(job)
                self.jobs.append(job)  # wanted again: first
            job["waiters"].append((size, done, owner))
            if self.workers < PHOTO_WORKERS:
                self.workers += 1
                threading.Thread(target=self._photo_worker, daemon=True).start()

    def _photo_worker(self):
        while True:
            with self.cond:
                job = None
                while self.jobs:
                    job = self.jobs.pop()
                    if any(not getattr(o, "gone", False) for _s, _d, o in job["waiters"]):
                        job["started"] = True
                        break
                    del self.busy[job["url"]]  # nobody waits for it any more
                    job = None
                if job is None:
                    self.workers -= 1
                    return
            path = self._photo_file(job["url"])
            with self.cond:
                del self.busy[job["url"]]  # who comes now asks anew (from the cache)
                waiters = list(job["waiters"])
            for size, done, owner in waiters:
                if getattr(owner, "gone", False):
                    continue
                try:
                    pix = fitted(path, size) if path else None
                except Exception as exc:
                    log_line("photo %s: %r" % (where(job["url"]), exc))
                    pix = None
                GLib.idle_add(self._give, done, owner, pix)

    @staticmethod
    def _give(done, owner, value):
        if not getattr(owner, "gone", False):
            done(value)
        return False

    def _photo_file(self, url):
        """The file in the cache (a photo; another messenger's voice, video,
        file too), fetched if not there yet; None if it can't be."""
        path = os.path.join(PHOTOS, hashlib.sha1(url.encode()).hexdigest()[:20] + ".img")
        part = None
        try:
            if os.path.exists(path):
                os.utime(path)  # in use: kept by prune()
                return path
            os.makedirs(PHOTOS, mode=0o700, exist_ok=True)
            fd, part = tempfile.mkstemp(dir=PHOTOS, suffix=".new")
            if self.how(url) == "own":
                os.close(fd)
                self.own(url, part)
            else:
                data = self.fetch(url, self.headers())
                with os.fdopen(fd, "wb") as out:
                    out.write(data)
            os.replace(part, path)
            return path
        except Exception as exc:
            log_line("photo %s: %r" % (where(url), exc))
            if part:
                try:
                    os.remove(part)
                except OSError:
                    pass
            return None

    @staticmethod
    def prune():
        """Photos not shown for PHOTO_DAYS go (each one shown is touched);
        the players' log of before 2.4 too."""
        limit = time.time() - PHOTO_DAYS * 86400
        try:
            os.remove(OLD_LOG)
        except OSError:
            pass
        try:
            names = os.listdir(PHOTOS)
        except OSError:
            return
        for name in names:
            if not name.endswith(".img"):
                continue  # the chats directory, a half-written .new
            path = os.path.join(PHOTOS, name)
            try:
                if os.path.getmtime(path) < limit:
                    os.remove(path)
            except OSError:
                continue

    # --- saving -----------------------------------------------------------------
    def save(self, url, folder, name, done, replace=False):
        """A file into folder, by the save worker (one at a time); done(path
        or None) on the GTK side. The name is made harmless and, if taken,
        numbered: «песня (2).mp3», unless replace (the person chose to write
        over it)."""
        how = self.how(url)
        if not how:
            log_line("save refused: %s" % where(url))
            GLib.idle_add(lambda: done(None) and False)
            return

        def work():
            path = None
            try:
                os.makedirs(folder, exist_ok=True)
                stem, ext = os.path.splitext(safe_name(name))
                for n in range(1, 1000):
                    if replace:
                        path = os.path.join(folder, stem + ext)
                        break
                    path = os.path.join(folder, stem + (" (%d)" % n if n > 1 else "") + ext)
                    try:  # the name is taken here at once: two saves never meet
                        os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
                        break
                    except FileExistsError:
                        continue
                if how == "own":
                    self.own(url, path + ".part")
                else:
                    self.download(url, self.headers(), path + ".part")
                os.replace(path + ".part", path)
                log_line("saved %s as %s" % (where(url), path))
            except Exception as exc:
                log_line("save %s: %r" % (where(url), exc))
                for junk in ((path + ".part",) if replace and path else
                             (path, path and path + ".part")):
                    try:
                        if junk:
                            os.remove(junk)
                    except OSError:
                        pass
                path = None
            GLib.idle_add(lambda: done(path) and False)

        with self.cond:
            self.saves.append(work)
            if not self.saving:
                self.saving = True
                threading.Thread(target=self._save_worker, daemon=True).start()

    def _save_worker(self):
        while True:
            with self.cond:
                if not self.saves:
                    self.saving = False
                    return
                work = self.saves.pop(0)
            work()

    # --- voice ----------------------------------------------------------------
    def voice(self, url):
        """Play a voice message (the one playing stops); False if it cannot
        be: no libmpv here, or a link not to be opened. Another messenger's
        is fetched first and played when there (on_end() if it can't be)."""
        how = self.how(url)
        if not how:
            log_line("voice refused: %s" % where(url))
            return False
        if self._sound is None and not self._no_sound:
            try:
                self._sound = self.player(lambda sec, total=None: self.on_time(sec, total),
                                          lambda: self.on_end())
            except Exception as exc:
                log_line("voice: no libmpv (%r)" % exc)
                self._no_sound = True
        if self._sound is None:
            return False
        log_line("voice %s" % where(url))
        self.wanted = url
        if how == "own":
            def fetched(path):
                if self.wanted != url:
                    return  # stopped or another asked for meanwhile
                if path is None:
                    self.on_end()
                else:
                    self._sound.play(path, self.agent)
            self._sound.stop()  # the one playing stops now, not when this one is there
            self._later(url, fetched)
            return True
        self._sound.play(url, self.agent)
        return True

    def toggle(self):
        """Pause or go on; True if playing now."""
        return self._sound.toggle() if self._sound else False

    def stop(self):
        self.wanted = None
        if self._sound:
            self._sound.stop()

    # --- video and files ------------------------------------------------------
    def video(self, url, title):
        """Full screen in the shell's player; False if it cannot be.
        Another messenger's is fetched first (it plays when there)."""
        how = self.how(url)
        if not how:
            log_line("video refused: %s" % where(url))
            return False
        self.stop()
        if how == "own":
            self._later(url, lambda path: path and self._play_video(path, title))
            return True
        return self._play_video(url, title)

    def _player_cmd(self, url, title):
        """The command line that plays url full screen."""
        # No youtube-dl and no playlists: the link is played as it is.
        opts = {"ytdl": "no", "load-unsafe-playlists": "no", "user-agent": self.agent}
        if FLATPAK:
            del opts["ytdl"]  # its mpv is built without Lua: no ytdl, which it refuses to be told
        player = next(filter(None, map(shutil.which, PLAYERS)), None)  # /usr/bin (ADR 0002)
        if player:
            opts.update({"terminal": "yes", "msg-level": "all=warn"})  # libmpv: to the log
            cmd = [player, "--title", title, url] + ["%s=%s" % kv for kv in opts.items()]
        else:
            cmd = ["mpv", "--fs"] + ["--%s=%s" % kv for kv in opts.items()] + ["--", url]
        return cmd

    def _play_video(self, url, title):
        cmd = self._player_cmd(url, title)
        log_line("video %s via %s" % (where(url), os.path.basename(cmd[0])))
        try:
            self.spawn(cmd)
        except OSError as exc:
            log_line("video: no player (%r)" % exc)
            return False
        return True

    def file(self, url):
        """A file in the browser (another messenger's: fetched, then opened
        as a file); False if it cannot be."""
        how = self.how(url)
        if not how:
            log_line("file refused: %s" % where(url))
            return False
        log_line("file %s" % where(url))
        if how == "own":
            self._later(url, lambda path: path and self.open_uri(GLib.filename_to_uri(path)))
            return True
        return bool(self.open_uri(url))


# --- the chat list ---------------------------------------------------------------
class ChatList:
    """The chat list (CONTEXT.md: Список чатов) without its widgets: the
    chats' summaries, dialogs opened from the search and not written to
    yet, pins, notifications per chat, strangers hidden; and every answer
    the window needs of it: what a tab shows in which order, the counts,
    whether a message buzzes, what the search finds. It keeps the last list
    (list_path, shown at once on the next start) and the pins and
    notifications (prefs_path) on disk itself.

    Rules: pinned chats come first, in the order pinned, then the newest;
    channels are quiet unless switched on, other chats loud unless switched
    off; a quiet chat neither buzzes nor counts on the panel's button; while
    contacts_only is on, dialogs of strangers are not shown, counted or
    found, and do not buzz."""

    def __init__(self, list_path, prefs_path, contacts_only=True):
        self.list_path, self.prefs_path = list_path, prefs_path
        self.contacts_only = contacts_only
        self.chats = {s["id"]: s for s in load_json(list_path, []) if isinstance(s, dict)}
        self.saved_list = None  # the list's text as last written
        self.saving = None  # the thread writing it
        self.pending = {}  # dialogs opened from the search, not written to yet
        prefs = load_json(prefs_path, {})
        self.pinned = [i for i in prefs.get("pinned", []) if isinstance(i, int)]
        self.muted = set(prefs.get("muted", []))  # chats without buzz and count
        self.unmuted = set(prefs.get("unmuted", []))  # channels with them

    # --- what comes in ----------------------------------------------------------
    def replace(self, summaries, account="max"):
        """An account's whole list, after its login: the others' chats stay
        (a summary without an account is MAX's, as 2.4 kept them)."""
        chats = {i: s for i, s in self.chats.items() if s.get("account", "max") != account}
        chats.update((s["id"], s) for s in summaries)
        self.chats = chats
        self.pending = {i: s for i, s in self.pending.items() if i not in self.chats}
        self._save_list()

    def update(self, summary):
        """One chat as it is now (a message, a join): a new one is added."""
        new = summary["id"] not in self.chats
        self.chats[summary["id"]] = summary
        self.pending.pop(summary["id"], None)
        if new:
            self._save_list()

    def retitle(self, chat_id, title):
        if chat_id in self.chats:
            self.chats[chat_id]["title"] = title
            self._save_list()

    def remove(self, chat_id):
        self.chats.pop(chat_id, None)
        self.pending.pop(chat_id, None)
        self._save_list()

    def read(self, chat_id):
        if chat_id in self.chats:
            self.chats[chat_id]["unread"] = 0

    def start_dialog(self, summary):
        """A dialog opened from the search: it joins the list once written to."""
        if summary["id"] not in self.chats:
            self.pending[summary["id"]] = summary

    def wrote(self, chat_id, text):
        """The own message sent: the dialog is in the list now, and whoever
        is in it is no stranger."""
        if chat_id in self.pending:
            self.chats.setdefault(chat_id, self.pending.pop(chat_id))
            self._save_list()
        s = self.chats.get(chat_id)
        if s:
            s["last"], s["time"] = "Вы: " + text, int(time.time() * 1000)
            s["stranger"] = False

    def known(self, user_id):
        """Someone added to the contacts: their dialog is shown."""
        for s in self.chats.values():
            if s.get("peer") == user_id:
                s["stranger"] = False

    def pin(self, chat_id):
        """Pinned to the top, or no longer."""
        if chat_id in self.pinned:
            self.pinned.remove(chat_id)
        else:
            self.pinned.append(chat_id)
        self._save_prefs()

    def mute(self, chat_id):
        """Notifications off, or on again."""
        quiet = not self.quiet(chat_id)
        if (self.chats.get(chat_id) or {}).get("type") == "CHANNEL":
            (self.unmuted.discard if quiet else self.unmuted.add)(chat_id)
        else:
            (self.muted.add if quiet else self.muted.discard)(chat_id)
        self._save_prefs()

    # --- what is asked ------------------------------------------------------------
    def get(self, chat_id):
        """The summary, also of a dialog not written to yet; None if unknown."""
        return self.chats.get(chat_id) or self.pending.get(chat_id)

    def listed(self, chat_id):
        """In the list (not only opened from the search)."""
        return chat_id in self.chats

    def is_pinned(self, chat_id):
        return chat_id in self.pinned

    def quiet(self, chat_id):
        """No buzz and no count on the panel's button."""
        s = self.chats.get(chat_id) or {}
        if s.get("type") == "CHANNEL":
            return chat_id not in self.unmuted
        return chat_id in self.muted

    def hidden(self, chat_id):
        """A stranger's dialog, while those are not shown."""
        return self.contacts_only and bool((self.chats.get(chat_id) or {}).get("stranger"))

    def loud(self, chat_id):
        """Whether a message from this chat buzzes."""
        return not self.hidden(chat_id) and not self.quiet(chat_id)

    def entries(self, tab):
        """What a tab ("chats" or "channels") shows, top to bottom:
        (summary, pinned, quiet) each."""
        shown = [i for i in self.chats if self.shown(i, tab)]
        return [self.entry(i) for i in sorted(shown, key=self.order)]

    def entry(self, chat_id):
        """(summary, pinned, quiet) of a chat in the list; None if not in it."""
        s = self.chats.get(chat_id)
        return None if s is None else (s, chat_id in self.pinned, self.quiet(chat_id))

    def shown(self, chat_id, tab):
        """Whether a chat is in a tab ("chats" or "channels") now."""
        s = self.chats.get(chat_id)
        return s is not None and not self.hidden(chat_id) and \
            (s.get("type") == "CHANNEL") == (tab == "channels")

    def order(self, chat_id):
        """The chat's place in its tab as a key: pinned first, in the order
        pinned, then the newest."""
        if chat_id in self.pinned:
            return (0, self.pinned.index(chat_id))
        return (1, -((self.chats.get(chat_id) or {}).get("time") or 0))

    def counts(self):
        """Unread messages: per tab, and in loud chats (the subtitle and the
        panel's button)."""
        shown = [s for s in self.chats.values() if not self.hidden(s["id"])]
        return {"chats": sum(s["unread"] for s in shown if s.get("type") != "CHANNEL"),
                "channels": sum(s["unread"] for s in shown if s.get("type") == "CHANNEL"),
                "loud": sum(s["unread"] for s in shown if not self.quiet(s["id"]))}

    def find(self, text):
        """Own chats shown whose title has the text, the newest first."""
        want = text.casefold()
        return sorted((s for s in self.chats.values()
                       if want in s["title"].casefold() and not self.hidden(s["id"])),
                      key=lambda s: -(s["time"] or 0))

    # --- on disk ----------------------------------------------------------------------
    def _save_list(self):
        """Written only when it changed, by a thread (the text made here)."""
        text = json.dumps(list(self.chats.values()), ensure_ascii=False)
        if text != self.saved_list:
            self.saved_list = text
            self.saving = threading.Thread(target=save_text, args=(self.list_path, text), daemon=True)
            self.saving.start()

    def _save_prefs(self):
        save_json(self.prefs_path, {"pinned": self.pinned, "muted": sorted(self.muted),
                                    "unmuted": sorted(self.unmuted)})


# --- a chat on screen ----------------------------------------------------------
class ChatView:
    """One chat's messages on screen (CONTEXT.md: Chat view): its own scroll
    area, the bubbles with their day labels, reactions and media controls,
    built a few at a time; older pages fetched as the reader scrolls up (and
    PREFETCH of them in the background), with a spinner while they come; the
    place kept while bubbles go in above; photos fetched only near the
    screen. It works only between enter() and leave(); leave() cuts it to
    its newest BUBBLES.

    What it needs from outside comes in at creation: the cached messages,
    fetch_older(before_ms, done(msgs, err)) for the page before a time, and
    what a long press (on_hold(msg_id, widget)), a media control
    (on_media(msg, item, controls)) and a reaction chip (on_react(msg_id,
    emoji or None)), a tap on a photo (on_photo(url)) and on the ↪ beside a
    bubble (on_forward(msg_id)) do, and photo(url, done) that fetches a
    photo. Everything is called on the GTK side."""

    def __init__(self, chat_id, kind, cached, fetch_older, on_hold, on_media, on_react,
                 photo, on_photo=lambda url: None, on_forward=None, on_save=None):
        self.chat_id = chat_id
        self.group = kind in ("CHAT", "CHANNEL")  # senders' names over their bubbles
        self.fetch_older, self.on_hold = fetch_older, on_hold
        self.on_media, self.on_react = on_media, on_react
        self.photo = photo  # photo(url, done(pixbuf)): Media.photo
        self.on_photo = on_photo  # a photo tapped: shown large
        self.on_forward = on_forward  # the ↪ beside a bubble: on_forward(msg_id)
        self.on_save = on_save  # a photo's or a file's save button: on_save(msg, item, button)
        self.held_at = 0.0  # a long press just now: its release is no tap
        self.shown = set()  # ids of the messages built
        self.msgs = {}  # message id -> (its dict, the box of its reactions)
        self.photos = []  # (image, url) not loaded yet: only when near the screen
        self.last_day = None  # of the newest message built
        self.first_day = self.top_sep = None  # of the oldest, and its day label
        self.oldest = None  # time of the oldest message known (built or queued)
        self.loading = self.done = False  # older pages: one at a time, none left
        self.prefetch = 0  # older pages still to fetch in the background
        # Messages still to build: newer ones at the bottom, older ones
        # (oldest first) above the top, a few at a time (_step).
        self.pending_new, self.pending_old = [], []
        self.active = self.entered = self.building = False
        self.gone = False  # destroyed: answers on their way (Backend.run) are not given
        self.due = False  # a pass (_pass) is coming: more reasons wait for it
        self.scrolled = False  # among them a scroll
        self.fresh = False  # the newest page came (newest()): older ones may be asked for
        self.anchor_timer = None  # drops the anchor 400 ms after the last chunk above
        self.at_bottom = True  # stays at the newest while things come in
        self.anchor = None  # distance from the bottom kept while bubbles go in above
        self.moving = False  # the place is being set here, not by the reader
        self.scrolled_at = 0.0  # when the reader last moved it (monotonic)

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.box.set_margin_start(16)
        self.box.set_margin_end(16)
        self.box.set_margin_bottom(12)
        # Over the top message while an older page is on its way.
        self.busy = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        self.busy.set_margin_top(12)
        self.spinner = Gtk.Spinner()
        self.spinner.set_size_request(32, 32)
        self.busy.pack_start(self.spinner, False, False, 0)
        self.busy.pack_start(label("загрузка…", "older"), False, False, 0)
        self.busy.set_no_show_all(True)
        for w in self.busy.get_children():
            w.show()
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        column.set_margin_top(12)
        column.pack_start(self.busy, False, False, 0)
        column.pack_start(self.box, False, False, 0)
        viewport = Gtk.Viewport()
        viewport.set_shadow_type(Gtk.ShadowType.NONE)
        viewport.add(column)
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll.set_kinetic_scrolling(True)
        self.scroll.add(viewport)
        # Down to the newest message, while the reader is up among older
        # ones; it counts the messages come meanwhile.
        self.unseen = 0
        self.down = Gtk.Button(label="↓", halign=Gtk.Align.END, valign=Gtk.Align.END)
        self.down.get_style_context().add_class("down")
        self.down.set_margin_end(24)
        self.down.set_margin_bottom(24)
        self.down.set_can_focus(False)
        self.down.set_no_show_all(True)
        self.down.connect("clicked", lambda _b: self._to_bottom())
        self.widget = Gtk.Overlay()
        self.widget.add(self.scroll)
        self.widget.add_overlay(self.down)
        self.widget.show_all()
        adj = self.scroll.get_vadjustment()
        adj.connect("changed", self._keep_place)
        adj.connect("value-changed", self._moved)

        for m in cached[-FIRST:]:  # a screen at once, the rest above it later
            self._append(m)
        self._queue_older(cached[:-FIRST])

    # --- the interface --------------------------------------------------------
    @property
    def empty(self):
        return not self.shown

    def newest(self, msgs, gap, done=None):
        """The newest page fetched on opening. If more came than a screen
        (or MAX says there is a gap after the cache), what was built is not
        continuous with it: start again from these. done() runs once drawn."""
        self.fresh = True
        if msgs:  # within the page, what MAX no longer has was deleted meanwhile
            fetched = {m["id"] for m in msgs}
            self.remove([i for i, (m, _b) in self.msgs.items()
                         if m["time"] >= msgs[0]["time"] and i not in fetched])
        latest = max((m["time"] for m in msgs if m["id"] in self.shown), default=0)
        new = [m for m in msgs if m["id"] not in self.shown and m["time"] >= latest]
        if gap or len(new) > FIRST:
            self._clear()
            new = list(msgs)
        for m in msgs:
            if m["id"] in self.msgs:  # reactions may have changed meanwhile
                self.reacted(m["id"], m["reactions"], m["yours"])
        if self.shown:
            self.pending_new.extend(new)  # a few newer ones: at the bottom
            # and older ones than any built (the cache had only the last few)
            self._queue_older([m for m in msgs if m["id"] not in self.shown and
                               m["time"] < latest and m not in new])
        else:
            for m in new[-FIRST:]:
                self._append(m)
            self._queue_older(new[:-FIRST])
        self.prefetch = PREFETCH  # fetched once the bubbles are built
        self._start()
        if not self.building and self.active:  # nothing to build: on to older pages
            GLib.timeout_add(800, lambda: self._load_older(background=True) and False)
        if done:
            GLib.idle_add(lambda: done() and False)  # an idle runs after the redraw

    def add(self, msg):
        """A message just come or sent: at the bottom. The own one scrolls
        there; another's only if the reader is already there."""
        if msg["id"] in self.shown:
            return
        if self.pending_new:
            self.pending_new.append(msg)
            self._start()
        else:
            self._append(msg)
        if msg["mine"]:
            self._to_bottom()
        elif not self.at_bottom:
            self.unseen += 1
            self._show_down()

    def remove(self, msg_ids):
        """Deleted messages out of the chat; a day left empty loses its label."""
        gone = set(msg_ids) & self.shown
        self.pending_new = [m for m in self.pending_new if m["id"] not in msg_ids]
        self.pending_old = [m for m in self.pending_old if m["id"] not in msg_ids]
        if not gone:
            return
        for w in self.box.get_children():
            if getattr(w, "msg_id", None) in gone:
                w.destroy()
        self.shown -= gone
        for i in gone:
            self.msgs.pop(i, None)
        self.photos = [(img, url) for img, url in self.photos if img.get_parent()]
        kids = self.box.get_children()
        for k, w in enumerate(kids):  # a day label with no message after it before the next
            if getattr(w, "is_day", False) and (k + 1 == len(kids) or
                                                getattr(kids[k + 1], "is_day", False)):
                if w is self.top_sep:
                    self.top_sep = self.first_day = None
                w.destroy()
        kids = self.box.get_children()
        if not kids:
            self.last_day = self.first_day = self.top_sep = None
        elif self.top_sep is None and getattr(kids[0], "is_day", False):
            self.top_sep = kids[0]
            first = next((w for w in kids if hasattr(w, "msg_id")), None)
            if first is not None:
                t = self.msgs[first.msg_id][0]["time"]
                self.first_day = datetime.fromtimestamp(t / 1000).date()
        holds = [w for w in kids if hasattr(w, "msg_id")]
        if holds:
            last = self.msgs[holds[-1].msg_id][0]["time"]
            self.last_day = datetime.fromtimestamp(last / 1000).date()

    def reacted(self, msg_id, reactions, yours=...):
        """New reactions of a message (yours: ... when not known to change)."""
        if msg_id not in self.msgs:
            return
        m = self.msgs[msg_id][0]
        if m.get("reactions") != reactions or yours is not ... and m.get("yours") != yours:
            m["reactions"] = reactions
            if yours is not ...:
                m["yours"] = yours
            self._fill_reactions(msg_id)

    def message(self, msg_id):
        """The message as built, or None."""
        return self.msgs[msg_id][0] if msg_id in self.msgs else None

    def show_message(self, msg_id):
        """Scroll to a message (a third down the screen) and light it up for
        a moment; False if it is not built here."""
        hold = next((w for w in self.box.get_children()
                     if getattr(w, "msg_id", None) == msg_id), None)
        if hold is None:
            return False

        def go():
            pos = hold.translate_coordinates(self.box, 0, 0)
            if pos is None:
                return False
            adj = self.scroll.get_vadjustment()
            page = adj.get_page_size()
            self.anchor = None
            self.moving = True
            adj.set_value(max(0, min(pos[1] - page / 3, adj.get_upper() - page)))
            self.moving = False
            self.at_bottom = adj.get_value() + page >= adj.get_upper() - 60
            self._show_down()
            hold.get_style_context().add_class("found")
            GLib.timeout_add(1500, lambda: hold.get_style_context().remove_class("found") and False)
            return False

        GLib.idle_add(go)  # once laid out
        return True

    def enter(self):
        """Shown: the first time at the newest message, later where it was."""
        self.active = True
        if not self.entered:
            self.entered = True
            self._to_bottom()
        self._start()
        self._soon()

    def leave(self):
        """No longer shown: nothing more is built or fetched, and only the
        newest BUBBLES stay."""
        if not self.active:
            return
        self.active = False
        self._show_busy()
        self._trim()

    def destroy(self):
        self.active = False
        self.gone = True  # answers still on their way are not given to it
        self.widget.destroy()

    # --- building ---------------------------------------------------------------
    def _day_label(self, ms):
        sep = label(day_label(ms), "day", xalign=0.5)
        sep.set_halign(Gtk.Align.CENTER)
        sep.is_day = True
        self.box.pack_start(sep, False, False, 6)
        sep.show()
        return sep

    def _append(self, m):
        """A message at the bottom (the newest)."""
        day = datetime.fromtimestamp(m["time"] / 1000).date() if m["time"] else None
        if day and day != self.last_day:
            self.last_day = day
            sep = self._day_label(m["time"])
            if self.top_sep is None:
                self.first_day, self.top_sep = day, sep
        if self.oldest is None or (m["time"] or 0) < self.oldest:
            self.oldest = m["time"] or 0
        self.box.pack_start(self._bubble(m), False, False, 0)

    def _prepend(self, msgs):
        """Older messages (oldest first) at the top, under their day labels."""
        pos, prev, first_sep = 0, None, None
        for m in msgs:
            if m["id"] in self.shown:
                continue
            day = datetime.fromtimestamp(m["time"] / 1000).date() if m["time"] else None
            if day and day != prev:
                sep = self._day_label(m["time"])
                self.box.reorder_child(sep, pos)
                pos += 1
                first_sep = first_sep or (day, sep)
                prev = day
            w = self._bubble(m)
            self.box.pack_start(w, False, False, 0)
            self.box.reorder_child(w, pos)
            pos += 1
            self.oldest = min(self.oldest or m["time"], m["time"])
        if first_sep is None:
            return
        if prev == self.first_day and self.top_sep is not None:
            self.top_sep.destroy()  # that day now starts higher up
        if self.last_day is None:
            self.last_day = prev
        self.first_day, self.top_sep = first_sep

    def _bubble(self, m):
        self.shown.add(m["id"])
        bubble = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        bubble.get_style_context().add_class("bubble")
        bubble.get_style_context().add_class("mine" if m["mine"] else "theirs")
        # A long press offers the reactions. Beside the bubble, at its foot
        # and on the side with room (as Telegram has it), the ↪ to forward it.
        hold = Gtk.EventBox()
        hold.set_halign(Gtk.Align.END if m["mine"] else Gtk.Align.START)
        side = Gtk.Box(spacing=8)
        if self.on_forward is not None:
            share = Gtk.Button.new_from_icon_name("mail-forward-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
            share.set_valign(Gtk.Align.END)
            share.get_style_context().add_class("share")
            share.set_can_focus(False)
            share.set_tooltip_text("Переслать")
            share.connect("clicked", lambda _b: self.on_forward(m["id"]))
            side.pack_start(bubble, False, False, 0)
            if m["mine"]:
                side.pack_start(share, False, False, 0)
                side.reorder_child(share, 0)  # left of the own bubble
            else:
                side.pack_start(share, False, False, 0)  # right of another's
        else:
            side.pack_start(bubble, False, False, 0)
        hold.add(side)
        hold.press = Gtk.GestureLongPress.new(hold)
        hold.press.connect("pressed", lambda _g, _x, _y: (
            setattr(self, "held_at", time.monotonic()), self.on_hold(m["id"], bubble)))
        if self.group and not m["mine"] and m["who"]:
            bubble.pack_start(label(m["who"], "who"), False, False, 0)
        if m.get("forwarded"):
            bubble.pack_start(label("↪ Переслано от %s" % m["forwarded"], "forwarded"), False, False, 0)
        for url in m["photos"]:
            img = Gtk.Image.new_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            img.set_size_request(460, 200)
            # A tap shows it large; a scroll or a long press does not
            # (the gesture is cancelled, or the release follows a long press).
            frame = Gtk.EventBox()
            frame.add(img)
            frame.photo_url = url
            frame.tap = Gtk.GestureMultiPress.new(frame)
            frame.tap.connect("released", lambda _g, _n, _x, _y, url=url: (
                time.monotonic() - self.held_at > 1.0 and self.on_photo(url)))
            over = Gtk.Overlay()
            over.add(frame)
            save = self._save_button(m, {"kind": "photo", "url": url,
                                         "n": m["photos"].index(url) + 1})
            if save:
                save.set_halign(Gtk.Align.END)
                save.set_valign(Gtk.Align.END)
                save.set_margin_end(8)
                save.set_margin_bottom(8)
                over.add_overlay(save)
            bubble.pack_start(over, False, False, 0)
            self.photos.append((watched(img), url))  # loaded once near the screen
        for item in m.get("media") or []:
            bubble.pack_start(self._media(m, item), False, False, 0)
        if m["text"]:
            text = label(m["text"], "msg", wrap=True)
            text.set_max_width_chars(38)
            text.set_selectable(False)
            bubble.pack_start(text, False, False, 0)
        reacts = Gtk.Box(spacing=6)
        bubble.pack_start(reacts, False, False, 0)
        self.msgs[m["id"]] = (m, reacts)
        self._fill_reactions(m["id"])
        bubble.pack_start(label(when(m["time"], full=True), "when", xalign=1.0), False, False, 0)
        hold.msg_id = m["id"]
        hold.show_all()
        return hold

    def _save_button(self, m, item):
        """The round button that keeps one photo or file on the tablet."""
        if self.on_save is None:
            return None
        b = Gtk.Button.new_from_icon_name("document-save-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
        b.get_style_context().add_class("save")
        b.set_can_focus(False)
        b.set_valign(Gtk.Align.CENTER)
        b.set_tooltip_text("Сохранить на планшет")
        b.connect("clicked", lambda _b: self.on_save(m, item, b))
        return b

    def _with_save(self, widget, m, item):
        """A control with its save button after it, in a row."""
        save = self._save_button(m, item)
        if save is None:
            return widget
        row = Gtk.Box(spacing=10)
        row.pack_start(widget, True, True, 0)
        row.pack_start(save, False, False, 0)
        return row

    def _media(self, m, item):
        """The controls of a voice message, a video or a file, each with its
        save button; what they do is on_media's and on_save's."""
        if item["kind"] == "audio":
            box = Gtk.Box(spacing=12)
            play = Gtk.Button()
            set_play(play, "play")
            play.get_style_context().add_class("media")
            play.set_can_focus(False)
            bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER)
            bar.set_size_request(260, -1)
            length = label(mmss(secs(item["duration"])) if item["duration"] else
                           size_text(item.get("size") or 0), "when")
            controls = {"button": play, "bar": bar, "length": length}
            play.connect("clicked", lambda _b: self.on_media(m, item, controls))
            box.pack_start(play, False, False, 0)
            box.pack_start(bar, True, True, 0)
            box.pack_start(length, False, False, 0)
            save = self._save_button(m, item)
            if save:
                box.pack_start(save, False, False, 0)
            if not item.get("name"):
                return box
            named = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            name = label("🎵  " + item["name"], "chat-last", ellipsize=True)
            name.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            name.set_max_width_chars(32)
            named.pack_start(name, False, False, 0)
            named.pack_start(box, False, False, 0)
            return named
        if item["kind"] == "video":
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            if item["thumb"]:
                img = Gtk.Image.new_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)
                img.set_size_request(460, 200)
                box.pack_start(img, False, False, 0)
                self.photos.append((watched(img), item["thumb"]))  # Media.photo checks the host
            sec = secs(item["duration"])
            b = Gtk.Button(label="▶  Видео %s" % mmss(sec) if sec else "▶  Видео")
            b.get_style_context().add_class("file")
            b.set_can_focus(False)
            b.connect("clicked", lambda _b: self.on_media(m, item, {"button": b}))
            box.pack_start(self._with_save(b, m, item), False, False, 0)
            return box
        b = Gtk.Button(label="📄  %s · %s" % (item["name"], size_text(item["size"])))
        b.get_style_context().add_class("file")
        b.get_child().set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        b.get_child().set_max_width_chars(32)
        b.set_can_focus(False)
        b.connect("clicked", lambda _b: self.on_media(m, item, {"button": b}))
        return self._with_save(b, m, item)

    def _fill_reactions(self, msg_id):
        """The reactions under a message: emoji and count, the account's own
        highlighted; a tap puts that one on, or takes the own one off."""
        m, box = self.msgs[msg_id]
        for child in box.get_children():
            child.destroy()
        for emoji, count in m.get("reactions") or []:
            b = Gtk.Button(label="%s %d" % (emoji, count))
            b.get_style_context().add_class("react")
            yours = emoji == m.get("yours")
            if yours:
                b.get_style_context().add_class("yours")
            b.set_can_focus(False)
            b.connect("clicked", lambda _b, e=None if yours else emoji: self.on_react(msg_id, e))
            box.pack_start(b, False, False, 0)
        box.show_all()

    def _start(self):
        if self.active and not self.building and (self.pending_new or self.pending_old):
            self.building = True
            GLib.idle_add(self._step, priority=GLib.PRIORITY_LOW)

    def _step(self):
        """A few bubbles, between the window's other work; stops when the
        chat is left and goes on when it is entered again."""
        if not self.active or not (self.pending_new or self.pending_old):
            self.building = False
            self._show_busy()
            if self.active:
                self._soon()
                if self.prefetch > 0:  # all built: the next older page
                    GLib.timeout_add(300, lambda: self._load_older(background=True) and False)
            return False
        if self.pending_new:
            for m in self.pending_new[:STEP]:
                if m["id"] not in self.shown:
                    self._append(m)
            del self.pending_new[:STEP]
        elif time.monotonic() - self.scrolled_at < SETTLE:
            # The reader is scrolling: bubbles put in above now would fight
            # the kinetic scroll and throw the place. Wait until it rests.
            GLib.timeout_add(300, lambda: GLib.idle_add(self._step,
                                                        priority=GLib.PRIORITY_LOW) and False)
            return False  # still building: resumed by the timeout
        else:
            chunk = self.pending_old[-STEP:]
            del self.pending_old[-STEP:]
            adj = self.scroll.get_vadjustment()
            if not self.at_bottom:  # keep the place being read
                self.anchor = adj.get_upper() - adj.get_value()
            self._prepend(chunk)
            if self.anchor_timer is not None:  # one timer: the last chunk's
                GLib.source_remove(self.anchor_timer)
            self.anchor_timer = GLib.timeout_add(400, self._drop_anchor)
        return True

    def _queue_older(self, msgs):
        """Older messages (oldest first) to build above the top later; the
        oldest known time moves at once, so a page asked for meanwhile does
        not repeat them."""
        msgs = [m for m in msgs or [] if m["id"] not in self.shown]
        if not msgs:
            return
        self.pending_old = msgs + self.pending_old
        times = [m["time"] or 0 for m in msgs]
        self.oldest = min([self.oldest] + times) if self.oldest is not None else min(times)

    def _load_older(self, background=False):
        """The page before the oldest message known; the background ones
        stop when the chat is left."""
        if self.loading or self.done or self.oldest is None or self.pending_old:
            return False  # one page at a time, after the built ones
        if not self.fresh:
            return False  # the newest page first: an older one meanwhile would cross it
        if not self.active or background and self.prefetch <= 0:
            return False
        self.loading = True
        if background:
            self.prefetch -= 1
        self._show_busy()

        def done(msgs, err):
            self.loading = False
            if not err:
                if msgs:
                    self._queue_older(msgs)  # built above, a few at a time
                    self._start()
                else:
                    self.done = True
            self._show_busy()

        self.fetch_older(self.oldest, done)
        return False

    def _show_busy(self):
        """The spinner, while an older page comes or waits to be built and
        the reader is up at the top for it."""
        adj = self.scroll.get_vadjustment()
        near_top = adj.get_value() < adj.get_page_size() * 0.5
        on = self.active and near_top and (self.loading or bool(self.pending_old))
        if on != self.busy.get_visible():
            self.busy.set_visible(on)
            (self.spinner.start if on else self.spinner.stop)()

    # --- the place --------------------------------------------------------------
    def _keep_place(self, adj):
        self.moving = True
        if self.at_bottom:
            adj.set_value(adj.get_upper() - adj.get_page_size())
        elif self.anchor is not None:  # older messages came in above: stay put
            adj.set_value(adj.get_upper() - self.anchor)
        self.moving = False
        self._soon()

    def _moved(self, adj):
        if not self.moving:
            self.scrolled_at = time.monotonic()
        self.at_bottom = adj.get_value() + adj.get_page_size() >= adj.get_upper() - 60
        self.scrolled = True  # an older page is asked for on a scroll only
        self._soon()

    def _soon(self):
        """One pass for every reason come meanwhile (a scroll, a size change,
        bubbles built): many reasons, one pass."""
        if not self.due and not self.gone:
            self.due = True
            GLib.idle_add(self._pass)

    def _pass(self):
        """Everything the place decides, at once: the down button, the
        spinner, an older page when near the top, the photos near the
        screen, and back at the newest, the top cut to BUBBLES."""
        self.due = False
        if self.gone:
            return False
        self._show_down()
        adj = self.scroll.get_vadjustment()
        if self.scrolled and self.active and adj.get_value() < adj.get_page_size() * 0.5:
            self._load_older()
        self.scrolled = False
        self._show_busy()
        self._load_visible()
        if self.active and self.at_bottom and not self.pending_new and \
                len(self.msgs) > BUBBLES + PAGE:
            self._trim()  # read back down from far above: what is up there goes
        return False

    def _to_bottom(self):
        self.at_bottom = True
        adj = self.scroll.get_vadjustment()
        self.moving = True
        adj.set_value(adj.get_upper() - adj.get_page_size())
        self.moving = False
        self._show_down()

    def _show_down(self):
        """The down button: only away from the newest message."""
        if self.at_bottom:
            self.unseen = 0
        text = "↓ %d" % self.unseen if self.unseen else "↓"
        if self.down.get_label() != text:
            self.down.set_label(text)
        self.down.set_visible(not self.at_bottom and bool(self.shown))

    def _drop_anchor(self):
        self.anchor = self.anchor_timer = None
        return False

    def _load_visible(self):
        """Fetch the photos within a screen of what is shown."""
        if not self.photos:
            return False
        adj = self.scroll.get_vadjustment()
        top, page = adj.get_value(), adj.get_page_size()
        keep = []
        for img, url in self.photos:
            pos = img.translate_coordinates(self.box, 0, 0)
            if img.get_realized() and pos and top - page <= pos[1] <= top + 2 * page:
                self.photo(url, lambda pix, img=img: pix and (
                    img.set_from_pixbuf(pix), img.set_size_request(-1, -1)), owner=img)
            else:
                keep.append((img, url))
        self.photos = keep
        return False

    # --- forgetting -------------------------------------------------------------
    def _trim(self):
        """Only the newest BUBBLES messages stay built."""
        holds = [w for w in self.box.get_children() if hasattr(w, "msg_id")]
        if len(holds) <= BUBBLES:
            return
        gone = set()
        for w in self.box.get_children():
            if hasattr(w, "msg_id"):
                if len(holds) - len(gone) <= BUBBLES:
                    break
                gone.add(w.msg_id)
            w.destroy()
        self.shown -= gone
        self.pending_new, self.pending_old = [], []  # no longer continuous
        for i in gone:
            self.msgs.pop(i, None)
        self.photos = [(img, url) for img, url in self.photos if img.get_parent()]
        first = self.box.get_children()[0]
        m = self.msgs[first.msg_id][0]
        self.first_day = datetime.fromtimestamp(m["time"] / 1000).date()
        self.top_sep = self._day_label(m["time"])
        self.box.reorder_child(self.top_sep, 0)
        self.oldest, self.done = m["time"], False

    def _clear(self):
        for w in self.box.get_children():
            w.destroy()
        self.shown, self.msgs, self.photos = set(), {}, []
        self.pending_new, self.pending_old = [], []
        self.last_day = self.first_day = self.top_sep = self.oldest = None
        self.done = False



    def page_changed(self, *_args):
        page = self.stack.get_visible_child_name()
        # Settings from the list or before the login, so telemetry can be
        # switched off before anything is sent.
        self.gear.set_visible(page in ("chats", "wait", "login"))
        self.findb.set_visible(page == "chats")
        self.edit.set_visible(page == "chat" and self.chatlist.listed(self.open_chat))
        self.viewer_save.set_visible(page == "photo")
        summary = self.about(self.open_chat) if self.open_chat is not None else {}
        self.call_button.set_visible(page == "chat" and summary.get("type") == "DIALOG"
                                     and isinstance(self.open_chat, int)
                                     and summary.get("peer") is not None
                                     and self.backend.can("calls", self.open_chat))
        if page not in ("chat", "photo", "forward") and not self.keep_sound:
            self.stop_sound()  # the chat is left: its sound stops
        self.show_nowplay()
        if page != "chat":
            self.smile.set_active(False)
            self.confirm.hide()
            self.naming.hide()
            if self.view is not None:
                self.view.leave()
        elif self.view is not None:
            self.view.enter()  # back in it (from forwarding): building goes on
        self.moved()

    def moved(self):
        """Tell telemetry which screen is in front."""
        if not self.win.is_visible():
            return
        page = self.stack.get_visible_child_name()
        if page == "chats":
            self.telemetry.go(SCREEN_CHATS, MAIN_TAB)
        elif page == "find":
            self.telemetry.go(SCREEN_SEARCH)
        elif page == "chat":
            s = self.about(self.open_chat)
            self.telemetry.go(SCREEN_CHAT, {"source_type": 1 if s.get("type") == "DIALOG" else 2,
                                            "source_id": self.open_chat})
        elif page == "settings":
            self.telemetry.go(SCREEN_SETTINGS)

    # a chat
    def about(self, chat_id):
        """The chat's summary, also of a dialog not yet written to."""
        return self.chatlist.get(chat_id) or {}

    def view_for(self, chat_id):
        """The chat's ChatView: kept from before, else built from the cache."""
        view = self.views.pop(chat_id, None)
        if view is None:
            view = ChatView(
                chat_id, self.about(chat_id).get("type"), self.backend.cache.read(chat_id),
                fetch_older=lambda before, done: self.backend.run(
                    self.backend.older(chat_id, before), done, owner=self.views.get(chat_id)),
                on_hold=lambda msg_id, widget: self.pick_reaction(chat_id, msg_id, widget),
                on_media=lambda m, item, ctl: self.media_tapped(chat_id, m, item, ctl),
                on_react=lambda msg_id, emoji: self.react(chat_id, msg_id, emoji),
                photo=self.media.photo, on_photo=self.show_photo,
                on_forward=lambda msg_id: self.show_forward(chat_id, msg_id),
                on_save=lambda m, item, b: self.save_message(chat_id, m, [item], b))
        self.views[chat_id] = view  # most recently used last
        while len(self.views) > VIEWS:
            old_id = next(iter(self.views))
            old = self.views.pop(old_id)
            if old is self.view:
                self.views[old_id] = old
                break
            old.destroy()
        return view

    def dial_call(self):
        if self.call_id is None:
            self.stop_sound()
            self.record_stop(False)
            self.backend.run(self.backend.call("dial", peer=self.open_chat), self.call_result)

    def call_action(self, action):
        if self.call_id is None:
            self.call_box.hide()
            return
        self.call_answer.set_sensitive(False)
        if action == "answer":
            self.stop_sound()
            self.record_stop(False)
        self.backend.run(self.backend.call(action, conversation=self.call_id), self.call_result)

    def call_result(self, _result, error):
        if error and self.call_id is None:
            self.call_label.set_text("Не удалось соединиться. Позвоните ещё раз, когда будете готовы.")
            self.call_answer.hide()
            self.call_end.set_label("Закрыть")
            self.call_end.show()
            self.call_box.show()

    def call_changed(self, call):
        state = call["state"]
        if self.call_id is not None and self.call_id != call["id"]:
            return False
        terminal = state in ("ended", "failed", "unsupported")
        self.call_id = None if terminal else call["id"]
        text = {"ringing": "Входящий звонок", "dialling": "Звоним…",
                "connecting": "Соединяемся…", "active": "Разговор · микрофон включён",
                "ended": "Звонок завершён", "failed": "Связь прервалась",
                "unsupported": "Этот вид соединения пока не поддерживается"}[state]
        self.call_label.set_text(call["name"] + "\n" + text)
        self.call_answer.set_visible(state == "ringing")
        self.call_answer.set_sensitive(state == "ringing")
        self.call_end.show()
        self.call_end.set_label("Закрыть" if terminal else "Отклонить" if state == "ringing" else "Завершить")
        self.call_box.show()
        self.call_button.set_sensitive(terminal)
        if state in ("connecting", "active"):
            self.call_awake.hold()
        else:
            self.call_awake.release()
        if state == "ringing":
            self.win.present()
            notification = Gio.Notification.new("Входящий звонок")
            notification.set_body(call["name"])
            notification.set_priority(Gio.NotificationPriority.URGENT)
            self.send_notification("voice-call", notification)
        else:
            self.withdraw_notification("voice-call")
        return False

    def open(self, chat_id):
        start = time.monotonic()
        self.withdraw_notification("chat-%d" % chat_id)
        s = self.about(chat_id)
        self.open_chat = chat_id
        self.confirm.hide()
        self.naming.hide()
        self.edit.set_visible(self.chatlist.listed(chat_id))
        self.call_button.set_visible(s.get("type") == "DIALOG" and isinstance(chat_id, int)
                                     and s.get("peer") is not None
                                     and self.backend.can("calls", chat_id))
        if self.playing and self.playing_chat != chat_id and not self.keep_sound:
            self.stop_sound()  # another chat in front: the sound of the last one stops
        GLib.idle_add(lambda: self.show_nowplay() and False)
        view = self.view_for(chat_id)
        if self.view is not view:
            if self.view is not None:
                self.view.leave()
                self.chat_area.remove(self.view.widget)
            self.chat_area.pack_start(view.widget, True, True, 0)
            self.view = view
        self.title.set_text(s.get("title", ""))
        self.sub.set_text("" if not view.empty else "загрузка…")
        self.back.show()
        self.inputbar.set_visible(s.get("type") != "CHANNEL")
        self.stack.set_visible_child_name("chat")
        # Nothing focused: the on-screen keyboard comes when the entry is tapped,
        # not over the messages being read (and never in a channel).
        self.win.set_focus(None)
        view.enter()

        def done(res, err):
            came = time.monotonic()
            if err:
                if self.open_chat == chat_id:
                    self.sub.set_text("" if not view.empty else "не удалось загрузить")
                return
            msgs, gap = res

            def drawn():
                if self.open_chat == chat_id:
                    self.telemetry.chat_shown(int((came - start) * 1000),
                                              int((time.monotonic() - came) * 1000))
            view.newest(msgs or [], gap, done=drawn)
            if self.open_chat == chat_id:
                self.sub.set_text("")
            if self.chatlist.listed(chat_id):
                self.chatlist.read(chat_id)
                self.fill_list(only={chat_id})

        self.backend.run(self.backend.history(chat_id), done, owner=view)

    # voice messages, videos, files
    def media_tapped(self, chat_id, m, item, controls):
        """A media control of a chat tapped (ChatView's on_media)."""
        if item["kind"] == "audio":
            play = controls["button"]
            if item["url"] or (self.playing and self.playing[1] is play):
                self.play_sound(chat_id, m, item, play, controls["bar"], controls["length"],
                                item["url"])
                return
            play.set_sensitive(False)  # an audio file: its link first

            def done(url, err):
                play.set_sensitive(True)
                if err or not url:
                    log_line("audio file no link: %r" % (err,))
                    self.sub.set_text("не удалось открыть")
                    return
                self.play_sound(chat_id, m, item, play, controls["bar"], controls["length"], url)

            self.backend.run(self.backend.media_url(
                chat_id, m["id"], {"kind": "file", "id": item["file"]}), done)
        else:
            self.open_media(chat_id, m["id"], item, controls["button"])

    def play_sound(self, chat_id, m, item, play, bar, length, url):
        """What plays and where its button is are the window's; the playing
        is Media's. It plays only while its chat is in front: leaving it (for
        the list, another chat, the search, the settings) or hiding the
        window stops it (stop_sound)."""
        if self.playing and self.playing[1] is play:
            self.toggle_sound()
            return
        self.sound_end()
        if not self.media.voice(url):
            set_play(play, "fail")  # no libmpv here, or a link not to be opened
            return
        self.playing = [bar, play, length, secs(item["duration"]), item]
        self.playing_chat, self.playing_msg, self.playing_pos = chat_id, m["id"], 0.0
        # Its bubble gone (the chat cut or deleted): the sound stops too.
        if not getattr(play, "sound_watched", False):  # once per button, however often played
            play.sound_watched = True
            play.connect("destroy", lambda b: self.playing and self.playing[1] is b and (
                self.media.stop(), setattr(self, "playing", None),
                self.mpris and self.mpris.changed()))
        set_play(play, "pause")
        self.show_nowplay()
        if self.mpris:
            self.mpris.changed()

    def go_to_playing(self):
        """The chat of what plays, at its message."""
        if not self.playing or self.playing_chat is None:
            return
        self.open(self.playing_chat)
        view = self.views.get(self.playing_chat)
        if view is not None:
            view.show_message(self.playing_msg)

    def stop_sound(self):
        """Whatever plays stops, and its button shows ▶ again."""
        if self.playing:
            self.media.stop()
            self.sound_end()

    def toggle_sound(self):
        if self.playing:
            on = self.media.toggle()
            set_play(self.playing[1], "pause" if on else "play")
            set_play(self.nowplay_toggle, "pause" if on else "play")
            if self.mpris:
                self.mpris.changed()

    def show_nowplay(self):
        """The bar of what plays, with «Звук играет и вне чата»: from the
        moment it starts, in its chat too, so it is plain that it plays on
        when the chat is left (without the setting it stops there: no bar)."""
        show = bool(self.playing) and self.keep_sound
        if show:
            title = (self.chatlist.get(self.playing_chat) or {}).get("title", "")
            self.nowplay_label.set_text("🎵  %s  ·  %s" % (title, self.playing[2].get_text()))
            set_play(self.nowplay_toggle, self.playing[1].state)
        self.nowplay.set_visible(show)

    def sound_time(self, pos, total=None):
        """How far it played; the length is the message's, else the player's
        (an audio file carries none)."""
        if self.playing:
            self.playing_pos = pos
            bar, _play, length, known, _item = self.playing
            if not known and total:
                self.playing[3] = known = total
            if known:
                bar.set_fraction(min(1.0, pos / known))
            length.set_text(mmss(pos))
            if self.nowplay.get_visible():
                self.show_nowplay()
        return False

    def sound_end(self):
        if self.playing:
            bar, play, length, known, item = self.playing
            bar.set_fraction(0)
            set_play(play, "play")
            length.set_text(mmss(known) if known else size_text(item.get("size") or 0))
            self.playing = None
            self.show_nowplay()
            if self.mpris:
                self.mpris.changed()
        return False

    def open_media(self, chat_id, msg_id, item, button):
        """A video full screen in the shell's player, a file in the browser;
        MAX gives the link on request."""
        button.set_sensitive(False)

        def done(url, err):
            button.set_sensitive(True)
            if err or not url:
                log_line("%s no link: %r" % (item["kind"], err))
                self.sub.set_text("не удалось открыть")
            elif item["kind"] == "video":
                self.sound_end()  # the voice playing stops for it
                if not self.media.video(url, self.title.get_text()):
                    self.sub.set_text("не удалось открыть видео")
            elif not self.media.file(url):
                self.sub.set_text("нечем открыть файл")

        self.backend.run(self.backend.media_url(chat_id, msg_id, item), done)

    # reactions
    def pick_reaction(self, chat_id, msg_id, bubble):
        view = self.views.get(chat_id)
        m = view.message(msg_id) if view else None
        if m is None:
            return
        yours = m.get("yours")
        pop = Gtk.Popover.new(bubble)
        row = Gtk.Box(spacing=4)
        row.set_margin_start(6)
        row.set_margin_end(6)
        row.set_margin_top(6)
        row.set_margin_bottom(6)
        for emoji in REACTIONS:
            b = Gtk.Button(label=emoji)
            b.get_style_context().add_class("emoji")
            if emoji == yours:
                b.get_style_context().add_class("yours")  # a tap takes it off
            b.set_can_focus(False)
            b.connect("clicked", lambda _b, e=emoji: (
                pop.popdown(), self.react(chat_id, msg_id, None if e == yours else e)))
            row.pack_start(b, False, False, 0)
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        column.pack_start(row, False, False, 0)
        acts = []  # forwarding is the ↪ beside the bubble; saving, each item's own button
        for text, act in acts:
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("menu")
            b.get_child().set_xalign(0.0)
            b.set_can_focus(False)
            b.connect("clicked", lambda _b, a=act: (pop.popdown(), a()))
            column.pack_start(b, False, False, 0)
        pop.add(column)
        pop.connect("closed", lambda p: GLib.idle_add(p.destroy))
        column.show_all()
        pop.popup()
        self.menu = pop  # the one open, for the tests

    def react(self, chat_id, msg_id, emoji):
        """Put the account's reaction (None: take it off), then show what
        MAX says, or count it here if MAX sent no counts."""
        def done(res, err):
            if err:
                if self.open_chat == chat_id:
                    self.sub.set_text("реакция не отправлена, попробуйте ещё раз")
                return
            if res is None:
                view = self.views.get(chat_id)
                m = view.message(msg_id) if view else None
                if m is None:
                    return
                counts = dict(m.get("reactions") or [])
                if m.get("yours") in counts:
                    counts[m["yours"]] -= 1
                if emoji:
                    counts[emoji] = counts.get(emoji, 0) + 1
                res = [[e, n] for e, n in counts.items() if n > 0], emoji
                self.backend.cache.react(chat_id, msg_id, *res)
            self.reacted(chat_id, msg_id, *res)

        self.backend.run(self.backend.react(chat_id, msg_id, emoji), done)

    def deleted(self, chat_id, msg_ids, summary):
        """Messages deleted in a chat (Backend.on_delete)."""
        view = self.views.get(chat_id)
        if view:
            view.remove(msg_ids)
        if summary and self.chatlist.listed(chat_id):
            self.chatlist.update(summary)
            self.fill_list(only={chat_id})
        return False

    def reacted(self, chat_id, msg_id, reactions, yours):
        """New reactions of a message (yours: ... when not known to change)."""
        view = self.views.get(chat_id)
        if view:
            view.reacted(msg_id, reactions, yours)
        return False

    # emoji in the message
    def emoji_panel(self, show):
        if not show:
            pop = self.emoji_pop
            if pop:
                pop.popdown()
                self.emoji_closed(pop)  # now: its "closed" comes after the animation, if at all
            return
        if self.recent is None:
            self.recent = [e for e in load_json(EMOJI_RECENT, []) if isinstance(e, str)]
            self.recent_saved = list(self.recent)
        if self.emoji_built is None:  # built once: some hundreds of buttons
            pop = Gtk.Popover.new(self.smile)
            pop.set_modal(False)  # the entry keeps the focus, the keyboard stays
            pop.set_position(Gtk.PositionType.TOP)
            column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            for margin in ("start", "end", "top", "bottom"):
                getattr(column, "set_margin_" + margin)(8)
            recent_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            column.pack_start(recent_box, False, False, 0)
            for name, line in EMOJI:
                self.emoji_group(column, name, line.split())
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.set_kinetic_scrolling(True)
            scroll.set_size_request(760, 360)
            scroll.add(column)
            pop.add(scroll)
            pop.connect("closed", self.emoji_closed)
            scroll.show_all()
            self.emoji_built = [pop, recent_box, []]
        pop, recent_box, shown = self.emoji_built
        if shown != self.recent:  # the recent ones anew, only when they changed
            for child in recent_box.get_children():
                child.destroy()
            if self.recent:
                self.emoji_group(recent_box, "Недавние", self.recent)
            recent_box.show_all()
            self.emoji_built[2] = list(self.recent)
        self.emoji_pop = pop
        pop.popup()

    def emoji_group(self, column, name, emoji):
        column.pack_start(label(name, "emoji-group"), False, False, 4)
        grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           max_children_per_line=10, min_children_per_line=6)
        grid.set_can_focus(False)
        for e in emoji:
            b = Gtk.Button(label=e)
            b.get_style_context().add_class("emoji")
            b.set_can_focus(False)
            b.set_focus_on_click(False)
            b.connect("clicked", lambda _b, e=e: self.put_emoji(e))
            grid.add(b)
        column.pack_start(grid, False, False, 0)

    def emoji_closed(self, pop):
        if self.emoji_pop is pop:
            self.emoji_pop = None
            self.smile.set_active(False)
        if self.recent is not None and self.recent != self.recent_saved:
            save_json(EMOJI_RECENT, self.recent)  # once per panel, not per emoji
            self.recent_saved = list(self.recent)

    def put_emoji(self, emoji):
        """An emoji where the cursor is; it goes first among the recent ones."""
        pos = self.entry.insert_text(emoji, self.entry.get_position())
        self.entry.set_position(pos)
        self.recent = ([emoji] + [e for e in self.recent or [] if e != emoji])[:RECENT]

    def send(self, voice=None):
        """The entry's text and the files waiting above it (or a voice
        message just recorded: voice) into the open chat. What could not
        be sent stays where it was."""
        text = "" if voice else self.entry.get_text().strip()
        files = [voice] if voice else list(self.attached)
        chat_id = self.open_chat
        if not (text or files) or chat_id is None:
            return
        self.sendb.set_sensitive(False)

        def done(msg, err):
            self.sendb.set_sensitive(True)
            if err:
                log_line("send %s: %r" % ("voice" if voice else "message", err))
                self.sub.set_text("Нет связи — сообщение не отправлено"
                                  if isinstance(err, Offline) else "не отправлено, попробуйте ещё раз")
                if voice:
                    remove_file(voice["path"])
                return
            if voice:
                remove_file(voice["path"])
            else:
                self.entry.set_text("")
                self.attached = []
                self.show_attached()
            self.sub.set_text("")
            self.smile.set_active(False)
            view = self.views.get(chat_id)
            for one in (msg if isinstance(msg, list) else [msg] if msg else []):
                if view:
                    view.add(one)
            # a dialog from the search is in the list now
            self.chatlist.wrote(chat_id, text or attachment_words(files))
            self.edit.set_visible(self.open_chat == chat_id and self.chatlist.listed(chat_id))

        if files:
            self.backend.run(self.backend.send(chat_id, text, files), done)
        else:
            self.backend.run(self.backend.send(chat_id, text), done)

    # --- attachments ------------------------------------------------------------
    def attach(self):
        for path in self.choose_files():
            if not any(f["path"] == path for f in self.attached):
                self.attached.append(attachment(path))
        self.show_attached()

    def choose_files(self):
        """Files picked to send (the portal's dialog in Flatpak and KDE);
        [] when cancelled. Tests replace it."""
        dialog = Gtk.FileChooserNative.new("Прикрепить", self.win, Gtk.FileChooserAction.OPEN,
                                           "Прикрепить", "Отмена")
        dialog.set_select_multiple(True)
        photos = Gtk.FileFilter()
        photos.set_name("Фото")
        for ext in PHOTO_FILES:
            photos.add_pattern("*" + ext)
            photos.add_pattern("*" + ext.upper())
        for mime in PHOTO_TYPES:  # a chooser may start in the pictures by them
            photos.add_mime_type(mime)
        everything = Gtk.FileFilter()
        everything.set_name("Все файлы")
        everything.add_pattern("*")
        dialog.add_filter(photos)  # the first one is chosen: photos, with their previews
        dialog.add_filter(everything)
        chosen = dialog.run() == Gtk.ResponseType.ACCEPT
        paths = [p for p in dialog.get_filenames() if os.path.isfile(p)] if chosen else []
        dialog.destroy()
        return paths

    def show_attached(self):
        """The files waiting to be sent, above the entry."""
        for child in self.attachbar.get_children():
            child.destroy()
        for f in self.attached:
            chip = Gtk.Box(spacing=8)
            chip.get_style_context().add_class("attachment")
            chip.attachment = f
            if f["kind"] == "photo":
                try:
                    pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(f["path"], 96, 96, True)
                    chip.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)
                except GLib.Error:
                    chip.pack_start(label(f["name"], "attachment-name", ellipsize=True),
                                    False, False, 0)
            else:
                chip.pack_start(label("📄 " + f["name"], "attachment-name", ellipsize=True),
                                False, False, 0)
            drop = Gtk.Button.new_from_icon_name("window-close-symbolic", Gtk.IconSize.BUTTON)
            drop.get_style_context().add_class("plain")
            drop.set_can_focus(False)
            drop.set_tooltip_text("Не отправлять")
            drop.connect("clicked", lambda _b, f=f: self.unattach(f))
            chip.pack_start(drop, False, False, 0)
            self.attachbar.pack_start(chip, False, False, 0)
            chip.show_all()  # not the bar's show_all: its no-show-all stops it
        self.attachbar.set_visible(bool(self.attached))

    def unattach(self, f):
        self.attached = [a for a in self.attached if a is not f]
        self.show_attached()

    # --- a voice message --------------------------------------------------------
    def record_start(self):
        if self.call_id is not None or self.open_chat is None or self.recorder.recording():
            return
        self.stop_sound()  # no voice played into the microphone
        if not self.recorder.start():
            self.sub.set_text("Запись голоса здесь недоступна")
            return
        self.mic.get_style_context().add_class("recording")
        self.entry.hide()
        self.record_label.show()
        self.show_recording()
        self.record_timer = GLib.timeout_add(250, self.show_recording)

    def show_recording(self):
        self.record_label.set_text("● %s — отпустите, чтобы отправить"
                                   % mmss(self.recorder.seconds()))
        return self.recorder.recording()

    def record_stop(self, keep):
        if not self.recorder.recording():
            return
        if self.record_timer is not None:
            GLib.source_remove(self.record_timer)
            self.record_timer = None
        self.mic.get_style_context().remove_class("recording")
        self.record_label.hide()
        self.entry.show()
        chat_id = self.open_chat

        def done(got):
            if got is None:
                if keep:
                    self.sub.set_text("Держите кнопку, пока говорите")
                return
            path, ms = got
            if self.open_chat != chat_id:
                remove_file(path)  # the chat left meanwhile: not sent elsewhere
                return
            self.send({"kind": "voice", "path": path, "duration": ms, "name": "voice.ogg"})
        self.recorder.stop(done, keep)



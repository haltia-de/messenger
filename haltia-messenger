        "!", "audio/x-raw,rate=48000,channels=1", "!", "opusenc", "!", "oggmux", "!",
        "filesink", "location=" + path]),
    ("parecord", lambda path: ["parecord", "--file-format=oga", path]),
)
SHORTEST = 1000  # ms: a press shorter than this was not a message
RECONNECT_FIRST = 3.0  # s before MAX is connected again after a loss; doubled each time
RECONNECT_MOST = 60.0  # s, at most
FIND_HINT = ("Имя — среди ваших чатов. Номер телефона — чтобы написать человеку. "
             "Название — канал или группа.")

    return "voice-call-%s" % conversation


REMOTE_STALE = 3.0  # s without the peer's frames: their video is gone
REMOTE_MAX = 480  # px, the longer side of the peer's frames handed to GTK
VIDEO_CAPS = ("application/x-rtp,media=video,encoding-name=VP8,payload=%d,clock-rate=90000,"
              "max-fs=(string)1200,max-fr=(string)15")  # RFC 7741: what we can take, ~480x640 at 15/s
# What the camera sends, best first; a tablet that cannot keep up steps down
# (adapt_video), the last step off. 320×240 looked much worse than «Камера».
VIDEO_SIZES = ((640, 480, 15), (480, 360, 15), (320, 240, 15), (160, 120, 10))
VIDEO_BITRATE = {640: 900000, 480: 600000, 320: 350000, 160: 150000}  # bit/s for each width
# 640×480 kept two of the B8000-H's four cores busy (10:40, a live call): a
# call starts at 480×360, and at the size that last kept up after a step down.
VIDEO_START = [VIDEO_SIZES[1]]
ADAPT_TIMES = 2  # looks in a row the tablet must be behind before a step down
ADAPT_SETTLE = 15  # s after a camera starts before its load is judged
ADAPT_IDLE = .15  # the whole system idle less than this over a look: overloaded too
ADAPT_EVERY = 5  # s between looks at whether the encoder keeps up
ADAPT_KEPT = .7  # the share of the camera's frames the encoder keeps up with


def calls_allowed(video):
    """Are voice (video False) or video calls switched on in the settings?
    Video calls are off by default for now (video_calls, #55)."""
    return video_calls() if video else SETTINGS.get_bool("calls_audio", True)


def system_cpu():
    """(idle, total) jiffies of all processors since boot, or None."""
    try:
        with open("/proc/stat") as fh:
            fields = [int(x) for x in fh.readline().split()[1:]]
        return fields[3] + (fields[4] if len(fields) > 4 else 0), sum(fields)
    except (OSError, ValueError, IndexError):
        return None


class CameraWorker:
    """One daemon thread for camera work (finding and opening a camera takes
    a second or more with libcamera): taps stay in order, the asyncio loop
    never waits for it, and a wedged driver cannot keep the program alive."""

    def __init__(self):
        self.jobs = None

    def submit(self, fn, *args):
        if self.jobs is None:
            import queue
            self.jobs = queue.SimpleQueue()
            threading.Thread(target=self._run, name="camera", daemon=True).start()
        future = concurrent.futures.Future()
        self.jobs.put((future, fn, args))
        return future

    def _run(self):
        while True:
            future, fn, args = self.jobs.get()
            if future.set_running_or_notify_cancel():
                try:
                    future.set_result(fn(*args))
                except BaseException as exc:
                    future.set_exception(exc)


CAMERA_WORKER = CameraWorker()


class CallPicture(Gtk.DrawingArea):
    """A bounded decoded frame, fitted to the window without changing its size."""

    def __init__(self, mirror=False):
        super().__init__()
        self.surface = None
        self.mirror = mirror
        self.connect("draw", self._draw)

    def picture(self, frame):
        """A frame as (width, height, BGRA bytes): cairo's own layout, so it is
        copied once here and drawn as it is, never converted on each draw."""
        self.surface = None
        if frame is not None:
            width, height, data = frame
            self.surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, width, height)
            stride = self.surface.get_stride()
            pixels = self.surface.get_data()
            if stride == width * 4:
                pixels[:len(data)] = data
            else:
                for row in range(height):
                    pixels[row * stride:row * stride + width * 4] = data[row * width * 4:(row + 1) * width * 4]
            self.surface.mark_dirty()
        self.queue_draw()

    def _draw(self, widget, cr):
        cr.set_source_rgb(0, 0, 0)
        cr.paint()
        if self.surface is None:
            return
        width, height = widget.get_allocated_width(), widget.get_allocated_height()
        pw, ph = self.surface.get_width(), self.surface.get_height()
        scale = min(width / pw, height / ph)
        if self.mirror:
            cr.translate(width, 0)
            cr.scale(-1, 1)
        cr.translate((width - pw * scale) / 2, (height - ph * scale) / 2)
        cr.scale(scale, scale)
        cr.set_source_surface(self.surface, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_FAST)  # 2-3x cheaper than GOOD in software
        cr.paint()


class CallAudio:
    """One WebRTC peer with Opus and optional video, owned by VoiceCall.

    Gst callbacks cross into that loop; they never touch GTK. Constructed
    only after Answer/Call, so an invitation cannot open the microphone.
    source/sink are replaceable for the local, account-free media test.
    """

    def __init__(self, loop, candidate, status, params, source="pulsesrc",
                 sink="pulsesink sync=false", video_payload=96):
        Gst, GstWebRTC, GstSdp = call_media()
        self.Gst, self.RTC, self.Sdp = Gst, GstWebRTC, GstSdp
        Gst.init(None)
        self.loop, self.candidate, self.status = loop, candidate, status
        self.closed = False
        self.remote_set = False
        self.pending = []
        self.sink = sink
        self.pipeline = None
        self.rtc = None
        self.bus = None
        self.signals = []
        self.camera = None
        self.video_bin = None
        self.video_pad = None
        self.frame = None
        self.video_generation = 0
        self.video_frames = 0  # pictures encoded
        self.video_pushed = 0  # the camera's frames handed to the encoder
        self.remote_bin = None  # the peer's video decoding, once it comes
        self.failed_bins = []  # video branches given up: their late errors are not the call's
        self.video_size = VIDEO_START[0]  # the size that last worked here
        try:
            # RFC 7587 section 7 requires /2 in Opus SDP even for mono.
            # Keep it in RTP caps: without it the MAX peer never answers.
            self.pipeline = Gst.parse_launch(
                "webrtcbin name=rtc bundle-policy=max-bundle " + source +
                " ! audioconvert ! volume name=microphone ! audioresample ! audio/x-raw,rate=48000,channels=1 "
                "! opusenc bitrate=32000 audio-type=voice inband-fec=true packet-loss-percentage=10 "
                "complexity=5 ! rtpopuspay pt=111 "
                "! application/x-rtp,media=audio,encoding-name=OPUS,payload=111,clock-rate=48000,"
                "encoding-params=(string)2 ! rtc.")
            self._phone_streams(self.pipeline)
            self.rtc = self.pipeline.get_by_name("rtc")
            for name, callback in (("on-ice-candidate", self._candidate),
                                   ("pad-added", self._received),
                                   ("notify::connection-state", self._state)):
                self.signals.append(self.rtc.connect(name, callback))
            # Reserve a sendrecv video track even in audio calls, as MAX does.
            # appsrc holds no camera and produces no frames until a person's tap.
            self.video_ok = video_on()  # decided once per call
            if self.video_ok:
                self.video_bin = self._sender_bin(video_payload)
                self.pipeline.add(self.video_bin)
                self.video_pad = self.rtc.request_pad_simple("sink_1")
                self.video_bin.get_static_pad("src").link(self.video_pad)
            else:
                caps = Gst.Caps.from_string("application/x-rtp,media=video,encoding-name=VP8,payload=96,clock-rate=90000")
                self.rtc.emit("add-transceiver", GstWebRTC.WebRTCRTPTransceiverDirection.INACTIVE, caps)
            turn = params.get("turn") or {}
            stun = params.get("stun") or {}
            stuns = stun.get("urls") or params.get("stne", "").split(",")
            turns = turn.get("urls") or params.get("trne", "").split(",")
            if isinstance(stuns, str):
                stuns = [stuns]
            if isinstance(turns, str):
                turns = [turns]
            if stuns and stuns[0]:
                self.rtc.set_property("stun-server", stuns[0].replace("stun:", "stun://", 1))
            for server in filter(None, turns):
                scheme, address = server.split(":", 1)
                if scheme not in ("turn", "turns"):
                    raise ValueError("invalid TURN scheme")
                user = urllib.parse.quote(turn.get("username", params.get("trnu", "")), safe="")
                password = urllib.parse.quote(turn.get("credential", params.get("trnp", "")), safe="")
                if not self.rtc.emit("add-turn-server", "%s://%s:%s@%s" %
                                     (scheme, user, password, address.removeprefix("//"))):
                    raise ValueError("invalid TURN server")
            if params.get("p2p_forbidden"):
                self.rtc.set_property("ice-transport-policy", GstWebRTC.WebRTCICETransportPolicy.RELAY)
            self.bus = self.pipeline.get_bus()
            self.bus.set_sync_handler(self._bus, None)
            if self.pipeline.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
                raise RuntimeError("audio pipeline failed")
        except BaseException:
            self.close()
            raise

    def _phone_streams(self, container):
        # Let PulseAudio route calls to the device's tuned phone pair.
        # Do not request another filter over its existing echo canceller.
        properties = self.Gst.Structure.new_from_string(
            "props,media.role=phone")
        elements = container.iterate_recurse()
        while True:
            result, element = elements.next()
            if result == self.Gst.IteratorResult.DONE:
                break
            if result == self.Gst.IteratorResult.RESYNC:
                elements.resync()
                continue
            if result != self.Gst.IteratorResult.OK:
                raise RuntimeError("could not configure call audio streams")
            factory = element.get_factory()
            if factory is not None and factory.get_name() in ("pulsesrc", "pulsesink"):
                element.set_property("stream-properties", properties)

    def _candidate(self, _rtc, index, candidate):
        self.loop.call_soon_threadsafe(self._deliver, self.candidate,
                                      {"candidate": candidate, "sdpMLineIndex": index})

    def _deliver(self, callback, value):
        if not self.closed:
            callback(value)

    def _state(self, rtc, _spec):
        state = rtc.get_property("connection-state").value_nick
        self.loop.call_soon_threadsafe(self._deliver, self.status, state)

    def _branch_failed(self, state, branch):
        """A video branch's error, on the loop: told once per branch still in use."""
        if branch is self.video_bin and state == "send-video-failed" or \
                branch is self.remote_bin and state == "remote-video-failed":
            self.failed_bins.append(branch)  # its later errors count no more
            if state == "remote-video-failed":
                self.remote_bin = None
                pad = getattr(self, "remote_pad", None)
                if pad is not None:
                    # Nothing more into it: a failed branch must not stop the
                    # bundle's flow, which carries the voice too.
                    pad.add_probe(self.Gst.PadProbeType.BUFFER,
                                  lambda *_a: self.Gst.PadProbeReturn.DROP)
            self._deliver(self.status, state)

    def _sender_bin(self, payload):
        """What sends the camera's picture: appsrc, VP8, RTP with payload."""
        sender = self.Gst.parse_bin_from_description(
            "appsrc name=outgoing_video is-live=true format=time do-timestamp=true max-buffers=2 leaky-type=downstream "
            "caps=video/x-raw,format=I420,width=320,height=240,framerate=15/1 "
            "! queue max-size-buffers=2 leaky=downstream "
            # Real-time: constant rate for the link, the fastest speed for
            # the tablet's Atom, two partitions so both threads have work.
            "! vp8enc name=video_encoder deadline=1 cpu-used=16 threads=2 token-partitions=2 "
            "end-usage=cbr target-bitrate=300000 keyframe-max-dist=30 "
            "! rtpvp8pay name=video_pay pt=%d picture-id-mode=15-bit " % payload +
            '! capsfilter name=video_caps caps="%s"' % (VIDEO_CAPS % payload), True)
        sender.get_static_pad("src").add_probe(self.Gst.PadProbeType.BUFFER, self._encoded_video)
        return sender

    def rebuild_sender(self):
        """The sending branch failed (its encoder): a new one in its place, on
        the same transceiver, so the camera's picture goes on. On the loop."""
        old, pad = self.video_bin, self.video_pad
        if self.closed or old is None or pad is None or self.pipeline is None:
            return False
        payload = old.get_by_name("video_pay").get_property("pt")
        if old not in self.failed_bins:
            self.failed_bins.append(old)  # late errors from it count no more
        old.set_state(self.Gst.State.NULL)  # stopped before it is let go of
        old.get_static_pad("src").unlink(pad)
        self.pipeline.remove(old)
        sender = self._sender_bin(payload)
        # As many bits as the picture's size wants, not vp8enc's default.
        sender.get_by_name("video_encoder").set_property(
            "target-bitrate", VIDEO_BITRATE.get(self.video_size[0], 350000))
        self.pipeline.add(sender)
        if not sender.get_static_pad("src").link(pad) == self.Gst.PadLinkReturn.OK:
            self.pipeline.remove(sender)
            self.video_bin = None
            return False
        sender.sync_state_with_parent()
        self.video_bin = sender
        return True

    def _bus(self, _bus, message, _data):
        if message.type == self.Gst.MessageType.ERROR:
            # Video is optional: its encoder's or decoder's error stops video,
            # never the call. Logged by element and code only: the debug
            # details can contain TURN credentials.
            err, _debug = message.parse_error()
            src = message.src
            inside = lambda part: part is not None and (src is part or src.has_as_ancestor(part))  # noqa: E731
            factory = src.get_factory() if hasattr(src, "get_factory") else None
            self.loop.call_soon_threadsafe(log_line, "voice call: gst error %s %s:%d" % (
                factory.get_name() if factory else "bin", err.domain, err.code))
            # The peer's picture failing never stops the own camera; one failure
            # posts several errors, and those of a branch already replaced count
            # no more (the bin goes with them, checked on the loop).
            if any(inside(gone) for gone in self.failed_bins):
                pass  # a branch already given up: its late errors count no more
            elif inside(self.video_bin):
                self.loop.call_soon_threadsafe(self._branch_failed, "send-video-failed", self.video_bin)
            elif inside(self.remote_bin):
                self.loop.call_soon_threadsafe(self._branch_failed, "remote-video-failed", self.remote_bin)
            else:
                self.loop.call_soon_threadsafe(self._deliver, self.status, "failed")
        return self.Gst.BusSyncReply.DROP

    def _received(self, _rtc, pad):
        pipeline = self.pipeline
        if pad.direction != self.Gst.PadDirection.SRC or self.closed or pipeline is None:
            return
        # Link on this streaming thread before its first packet arrives.
        caps = pad.get_current_caps() or pad.query_caps(None)
        media = caps.get_structure(0).get_string("media")
        if media == "audio":
            # Concealment and the peer's in-band FEC: a lost packet is not a gap.
            description = ("queue ! rtpopusdepay ! opusdec plc=true use-inband-fec=true "
                           "! audioconvert ! audioresample ! " + self.sink)
        elif media == "video" and not getattr(self, "video_ok", True):
            # A peer's video coming all the same is dropped undecoded.
            description = "fakesink sync=false async=false"
        elif media == "video":
            codec = caps.get_structure(0).get_string("encoding-name")
            decoder = "rtpvp8depay request-keyframe=true wait-for-keyframe=true ! vp8dec threads=2" if codec == "VP8" else None
            if codec == "H264":
                name = next((n for n in ("avdec_h264", "openh264dec")
                             if self.Gst.ElementFactory.find(n)), None)
                if name:
                    decoder = "rtph264depay request-keyframe=true wait-for-keyframe=true ! " + name
            if decoder is None:
                return
            description = ("queue max-size-time=200000000 max-size-buffers=0 max-size-bytes=1048576 leaky=downstream ! " + decoder +
                           " ! videorate drop-only=true ! videoconvert ! videoscale "
                           # Within REMOTE_MAX, in the peer's own proportions (a phone
                           # held upright stays upright); CallPicture fits it.
                           "! video/x-raw,format=BGRA,width=[16,%d],height=[16,%d],"
                           "pixel-aspect-ratio=1/1,framerate=15/1 " % (REMOTE_MAX, REMOTE_MAX) +
                           "! appsink name=remote_video emit-signals=true sync=false max-buffers=1 drop=true")
        else:
            return
        received = self.Gst.parse_bin_from_description(description, True)
        if media == "audio":
            self._phone_streams(received)
        elif getattr(self, "video_ok", True):
            self.remote_bin, self.remote_pad = received, pad
            received.get_by_name("remote_video").connect("new-sample", self._frame_sample, False, 0)
        pipeline.add(received)
        pad.link(received.get_static_pad("sink"))
        received.sync_state_with_parent()

    def _frame_sample(self, sink, own, generation):
        sample = sink.emit("pull-sample")
        if sample is None or self.closed or (own and generation != self.video_generation):
            return self.Gst.FlowReturn.OK
        caps = sample.get_caps().get_structure(0)
        width, height = caps.get_value("width"), caps.get_value("height")
        buffer = sample.get_buffer()
        mapped, info = buffer.map(self.Gst.MapFlags.READ)
        if not mapped:
            return self.Gst.FlowReturn.OK
        try:
            data = info.data  # one copy, as bytes; CallPicture copies it once more
        finally:
            buffer.unmap(info)
        # The UI mailbox coalesces frames; never queue unbounded idle callbacks.
        if self.frame:
            self.frame(own, (width, height, data))
        return self.Gst.FlowReturn.OK

    def _encoded_video(self, pad, info):
        # RTP marker marks the final packet of each VP8 picture.
        buffer = info.get_buffer()
        if buffer is not None:
            header = buffer.extract_dup(0, min(2, buffer.get_size()))
            if len(header) == 2 and header[1] & 0x80:
                self.video_frames += 1
        return self.Gst.PadProbeReturn.OK

    def _send_video(self, sink, generation):
        sample = sink.emit("pull-sample")
        video_bin = self.video_bin
        if (sample is not None and not self.closed and video_bin is not None
                and generation == self.video_generation):
            self.video_pushed += 1
            source = video_bin.get_by_name("outgoing_video")
            source.set_property("caps", sample.get_caps())
            buffer = sample.get_buffer().copy()
            # Separate camera and WebRTC clocks: timestamp at the RTP pipeline.
            buffer.pts = buffer.dts = self.Gst.CLOCK_TIME_NONE
            source.emit("push-buffer", buffer)
        return self.Gst.FlowReturn.OK

    def set_mute(self, muted):
        """The microphone off (silence goes) or on again."""
        microphone = self.pipeline.get_by_name("microphone") if self.pipeline else None
        if microphone is not None:
            microphone.set_property("mute", bool(muted))

    def set_video(self, enabled):
        """Open only on a tap; stopping releases the device immediately.
        It blocks (finding the camera takes a second or more with libcamera):
        it runs on CAMERA_WORKER, never on the asyncio loop, and gives up
        between its steps once the call is closed."""
        return self._set_video(enabled)

    def _set_video(self, enabled):
        self.video_generation += 1
        camera, self.camera = self.camera, None
        if camera is not None:
            camera.set_state(self.Gst.State.NULL)
            camera.get_bus().set_sync_handler(None, None)
        if not enabled or self.closed:
            return False
        if self.video_bin is None:
            raise RuntimeError("video unavailable")
        self.camera_kind = None
        for attempt in range(2):
            try:
                return self._start_camera(self.camera_kind)
            except (RuntimeError, GLib.Error):
                if attempt or self.closed or os.environ.get("HALTIA_CAMERA_SOURCE"):
                    raise
                # Device re-enumeration can invalidate both discovery and source.
                # This retries capture once, never the call or a failed RTP link.

    def _start_camera(self, previous_kind):
        override = os.environ.get("HALTIA_CAMERA_SOURCE")
        if override == "videotestsrc":
            source = self.Gst.ElementFactory.make("videotestsrc", None)
            source.set_property("is-live", True)
        elif override:
            raise ValueError("unsupported camera source")
        else:
            from haltia_kit import camera
            found = camera.cameras()  # libcamera first, V4L2 fallback; on CAMERA_WORKER
            if self.closed:
                raise RuntimeError("call closed")  # hung up meanwhile: never open the device
            if not found:
                raise RuntimeError("no camera")
            chosen = next((c for c in found if c.front), found[0])
            width, height, _fps = self.video_size
            size = "video/x-raw,width=%d,height=%d" % (width, height)
            try:
                # haltia-kit 2.3.2: the size asked of the sensor as it lies,
                # the whole of its view; kit's videoflip turns the picture
                # with the screen (2.3.1 swapped it upright for the sensor,
                # which cut a narrow middle out: a face did not fit).
                source = chosen.make(caps=size, sensor=True)
                self.sized = True
            except TypeError:
                try:  # haltia-kit 2.3.1: the size after the turn
                    source = chosen.make(caps=size)
                    self.sized = True
                except TypeError:  # haltia-kit 2.3.0: the source alone, sized below
                    source = chosen.make()
                    self.sized = False
        if source is None:
            raise RuntimeError("no camera source")
        # Its kind is the source's, inside kit's bin if it is one (read only).
        self.camera_kind = self._source_of(source).get_factory().get_name()
        if previous_kind == "libcamerasrc" and self.camera_kind != "libcamerasrc":
            # A raw Bayer V4L2 node is not a replacement for libcamera's ISP.
            raise RuntimeError("libcamera unavailable")
        width, height, fps = self.video_size
        # Within the size's longer side, in the picture's own proportions: a
        # tablet held upright sends an upright picture, not a squashed one.
        most = max(width, height)
        camera = self.Gst.parse_launch(
            "videorate name=rate drop-only=true ! video/x-raw,framerate=%d/1 "
            "! videoconvert ! videoscale ! video/x-raw,format=I420,width=[16,%d],height=[16,%d],"
            "pixel-aspect-ratio=1/1 ! tee name=t "
            "t. ! queue max-size-buffers=2 leaky=downstream "
            "! appsink name=send emit-signals=true sync=false max-buffers=1 drop=true "
            # The own picture is small: scaled and slowed here, not in Python.
            "t. ! queue max-size-buffers=1 leaky=downstream ! videorate drop-only=true "
            "! video/x-raw,framerate=10/1 ! videoscale ! videoconvert "
            "! video/x-raw,format=BGRA,width=[16,240],height=[16,240],pixel-aspect-ratio=1/1 "
            "! appsink name=preview emit-signals=true "
            "sync=false max-buffers=1 drop=true" % (fps, most, most))
        self.camera = camera
        try:
            camera.add(source)
            rate = camera.get_by_name("rate")
            if self.camera_kind == "libcamerasrc" and not getattr(self, "sized", False):
                # kit 2.3.0's plain source: the size asked here, else libcamera
                # gives its own (960×640, much heavier).
                linked = source.link_filtered(rate, self.Gst.Caps.from_string(
                    "video/x-raw,width=%d,height=%d" % (width, height)))
            else:
                linked = source.link(rate)
            if not linked:
                raise RuntimeError("camera format unavailable")
            encoder = self.video_bin.get_by_name("video_encoder") if hasattr(self.video_bin, "get_by_name") else None
            if encoder is not None:  # as many bits as the picture's size wants
                encoder.set_property("target-bitrate", VIDEO_BITRATE.get(width, 350000))
            generation = self.video_generation
            camera.get_by_name("send").connect("new-sample", self._send_video, generation)
            camera.get_by_name("preview").connect("new-sample", self._frame_sample, True, generation)
            camera.get_bus().set_sync_handler(self._camera_bus, None)
            if camera.set_state(self.Gst.State.PLAYING) == self.Gst.StateChangeReturn.FAILURE:
                raise RuntimeError("camera failed")
        except BaseException:
            self._set_video(False)
            raise
        if self.closed:  # hung up while it started
            self._set_video(False)
            return False
        return True

    def _source_of(self, element):
        """The camera's source in what kit's Camera.make() gave: itself, or
        the libcamerasrc / v4l2src inside its bin (the source, a videoflip)."""
        if not isinstance(element, getattr(self.Gst, "Bin", ())):
            return element
        walker = element.iterate_sources()
        while True:
            result, child = walker.next()
            if result == self.Gst.IteratorResult.OK:
                return child
            if result == self.Gst.IteratorResult.RESYNC:
                walker.resync()
                continue
            return element

    def _camera_bus(self, _bus, message, _data):
        if message.type == self.Gst.MessageType.ERROR:
            err, _debug = message.parse_error()
            factory = message.src.get_factory() if hasattr(message.src, "get_factory") else None
            self.loop.call_soon_threadsafe(log_line, "voice call: camera error %s %s:%d" % (
                factory.get_name() if factory else "bin", err.domain, err.code))
            self.loop.call_soon_threadsafe(self._camera_error, _bus, self.video_generation)
        return self.Gst.BusSyncReply.DROP

    def _camera_error(self, bus, generation):
        if (self.camera is not None and self.camera.get_bus() == bus
                and generation == self.video_generation):
            self._deliver(self.status, "camera-failed")

    async def _promise(self, command, *args):
        future = self.loop.create_future()

        def complete(promise, *_unused):
            reply = promise.get_reply()
            def deliver():
                if not future.done():
                    if reply is not None and reply.has_field("error"):
                        future.set_exception(RuntimeError("WebRTC negotiation failed"))
                    else:
                        future.set_result(reply)
            self.loop.call_soon_threadsafe(deliver)
        promise = self.Gst.Promise.new_with_change_func(complete, None, None)
        self.rtc.emit(command, *args, promise)
        return await asyncio.wait_for(future, 10)

    async def remote(self, description):
        kind = {"offer": self.RTC.WebRTCSDPType.OFFER, "answer": self.RTC.WebRTCSDPType.ANSWER}[description["type"]]
        if description["type"] == "offer" and self.video_bin is not None:
            # Payload types belong to the offer; MAX peers need not use 96.
            video = description["sdp"].split("m=video", 1)
            if len(video) > 1:
                match = re.search(r"a=rtpmap:(\d+) VP8/90000", video[1], re.IGNORECASE)
                if match:
                    payload = int(match.group(1))
                    self.video_bin.set_state(self.Gst.State.NULL)
                    self.video_bin.get_by_name("video_pay").set_property("pt", payload)
                    self.video_bin.get_by_name("video_caps").set_property(
                        "caps", self.Gst.Caps.from_string(VIDEO_CAPS % payload))
                    self.video_bin.sync_state_with_parent()
                else:
                    h264 = re.search(r"a=rtpmap:(\d+) H264/90000", video[1], re.IGNORECASE)
                    decoder = any(self.Gst.ElementFactory.find(n) for n in ("avdec_h264", "openh264dec"))
                    if h264 and decoder:
                        # We send VP8; a H264-only peer can still send its picture.
                        # Keep the reserved receiver but release its VP8 sender.
                        self.set_video(False)
                        transceiver = self.video_pad.get_property("transceiver")
                        self.video_bin.get_static_pad("src").unlink(self.video_pad)
                        self.rtc.release_request_pad(self.video_pad)
                        self.video_pad = None
                        self.video_bin.set_state(self.Gst.State.NULL)
                        self.pipeline.remove(self.video_bin)
                        self.video_bin = None
                        transceiver.set_property("direction", self.RTC.WebRTCRTPTransceiverDirection.RECVONLY)
                        transceiver.set_property("codec-preferences", self.Gst.Caps.from_string(
                            "application/x-rtp,media=video,encoding-name=H264,payload=%s,clock-rate=90000" % h264.group(1)))
        result, sdp = self.Sdp.SDPMessage.new_from_text(description["sdp"])
        if result != self.Sdp.SDPResult.OK:
            raise ValueError("invalid remote SDP")
        await self._promise("set-remote-description", self.RTC.WebRTCSessionDescription.new(kind, sdp))
        self.remote_set = True
        for candidate in self.pending:
            self.add_candidate(candidate)
        self.pending.clear()

    async def description(self, kind):
        reply = await self._promise("create-" + kind, None)
        desc = reply.get_value(kind)
        await self._promise("set-local-description", desc)
        return {"type": kind, "sdp": desc.sdp.as_text()}

    def add_candidate(self, value):
        if not self.remote_set:
            if len(self.pending) >= 256:
                raise ValueError("too many ICE candidates")
            self.pending.append(value)
        else:
            self.rtc.emit("add-ice-candidate", int(value.get("sdpMLineIndex", 0)), value["candidate"])

    async def stats(self):
        """Only counters, never candidate addresses, SDP or credentials."""
        reply = await self._promise("get-stats", None)
        result = []
        for n in range(reply.n_fields()):
            value = reply.get_value(reply.nth_field_name(n))
            if not isinstance(value, self.Gst.Structure) or not value.has_field("type"):
                continue
            kind = getattr(value.get_value("type"), "value_nick", "")
            if kind not in ("inbound-rtp", "outbound-rtp", "remote-inbound-rtp"):
                continue
            counters = {"type": kind}
            for field in ("packets-received", "packets-sent", "packets-lost", "jitter",
                          "round-trip-time", "bytes-received", "bytes-sent", "nack-count"):
                if value.has_field(field):
                    number = value.get_value(field)
                    if isinstance(number, (int, float)):
                        counters[field] = number
            result.append(counters)
        return result

    def close(self):
        # Never waits for the camera: an opening one sees closed between its
        # steps, and the worker releases it after whatever it is doing.
        self.closed = True
        self.video_generation += 1  # late frames of any camera are dropped
        CAMERA_WORKER.submit(self._set_video, False)
        self.frame = None
        self.video_bin = None
        self.video_pad = None
        pipeline, self.pipeline = self.pipeline, None
        rtc, self.rtc = self.rtc, None
        bus, self.bus = self.bus, None
        if bus is not None:
            bus.set_sync_handler(None, None)
        if rtc is not None:
            for handler in self.signals:
                rtc.disconnect(handler)
        self.signals.clear()
        if pipeline is not None:
            pipeline.set_state(self.Gst.State.NULL)
        self.pending.clear()
        self.candidate = self.status = None


class VoiceCall:
    """One 1:1 call, from invitation/dial tap until a terminal event.

    The websocket reader answers ping and routes replies independently of
    negotiation. Commands have deadlines; there is no reconnect or retry.
    Account owns this object and ignores every older call's callback.
    """

    DISCONNECT_GRACE = 7  # seconds; a brief Wi-Fi interruption is not a failed call

    SETTINGS = {"isAudioEnabled": True, "isVideoEnabled": False,
                "isScreenSharingEnabled": False, "isFastScreenSharingEnabled": False,
                "isAudioSharingEnabled": False}

    def __init__(self, conversation, peer, incoming, changed, agent=None,
                 audio=CallAudio, connect=None, video=False):
        self.id, self.peer, self.incoming = conversation, peer, incoming
        self.changed, self.agent, self.audio_factory = changed, agent, audio
        self.connect = connect
        self.state = "ringing" if incoming else "dialling"
        self.closed = False
        self.end_reason = None
        self.video_invitation = bool(video)
        self.video = bool(video) if not incoming else False
        self.video_wanted = self.video  # what the person asked for; video follows it
        self.sender_rebuilt = 0  # the video sender is built anew once after a failure
        self.muted = False  # the microphone switched off in the call
        self.since = None  # time.time() the talk began (active)
        self.video_error = None
        self.remote_video = None
        self.remote_audio = None  # the peer's microphone, as it says (False: off)
        self.frame = None
        self.accepted = False
        self.sequence = 0
        self.pending = {}
        self.socket = None
        self.audio = None
        self.participant = None
        self.device = 0
        self.offer = None
        self.candidates = []
        self.local_candidates = []
        self.local_sent = False
        self.jobs = set()
        self.ready = asyncio.Event()
        self.offer_ready = asyncio.Event()
        self.params = {}
        self.task = None
        self.disconnect_timer = None
        self.hangup_done = asyncio.Event()  # send attempt finished, including pending ws2 opens

    def media_settings(self):
        return dict(self.SETTINGS, isVideoEnabled=self.video, isAudioEnabled=not self.muted)

    def toggle_mute(self):
        """«Выключить/Включить микрофон»: the peer hears silence meanwhile."""
        if self.closed or self.audio is None:
            return
        self.muted = not self.muted
        if hasattr(self.audio, "set_mute"):
            self.audio.set_mute(self.muted)
        self.show(self.state)

        async def tell():
            try:
                await self.command("change-media-settings", mediaSettings=self.media_settings())
            except Exception:
                log_line("voice call: media settings not acknowledged")
        self.job(tell())

    def hangup_reason(self):
        return "HUNGUP" if self.accepted else "REJECTED" if self.incoming else "CANCELED"

    def show(self, state):
        if not self.closed:
            log_line("voice call: " + state)
            if state == "active" and self.since is None:
                self.since = time.time()
            self.state = state
            self.changed(self, state)

    def job(self, coro):
        if self.closed:
            coro.close()
            return
        task = asyncio.create_task(coro)
        self.jobs.add(task)
        def done(future):
            self.jobs.discard(future)
            if not future.cancelled() and future.exception() is not None and not self.closed:
                self.job(self.end("FAILED", "failed"))
        task.add_done_callback(done)

    async def command(self, name, **body):
        if self.closed or self.socket is None:
            raise Offline()
        self.sequence += 1
        sequence = self.sequence
        future = asyncio.get_running_loop().create_future()
        self.pending[sequence] = future
        try:
            await self.socket.send(json.dumps(dict(command=name, sequence=sequence, **body)))
            return await asyncio.wait_for(future, 10)
        finally:
            self.pending.pop(sequence, None)

    def start(self, params):
        # Kept separately from negotiation jobs: even a cancelled invitation
        # must finish opening ws2 long enough to deliver the person's hangup.
        self.task = asyncio.create_task(self.run(params))

    async def send_hangup(self):
        if self.end_reason and self.socket:
            self.sequence += 1
            try:
                await asyncio.wait_for(self.socket.send(json.dumps(
                    {"command": "hangup", "sequence": self.sequence,
                     "reason": self.end_reason})), 2)
            except Exception:
                pass
            finally:
                self.hangup_done.set()

    async def run(self, params):
        self.task = asyncio.current_task()
        self.params = params
        try:
            from websockets.asyncio.client import connect
            factory = self.connect or connect
            async with factory(call_endpoint(params, self.id, self.incoming),
                               origin="https://web.max.ru", user_agent_header=self.agent,
                               open_timeout=10, close_timeout=2, max_size=262144) as socket:
                self.socket = socket
                if self.closed:
                    await self.send_hangup()
                    return
                self.job(self.initialize())
                self.job(self.ring_deadline())
                while not self.closed:
                    raw = await asyncio.wait_for(socket.recv(), 20)
                    if raw == "ping":
                        await socket.send("pong")
                        continue
                    event = json.loads(raw)
                    if event.get("type") in ("response", "error"):
                        future = self.pending.get(event.get("sequence"))
                        if future is not None and not future.done():
                            if event["type"] == "error":
                                future.set_exception(RuntimeError("call command refused"))
                            else:
                                future.set_result(event)
                        elif event["type"] == "error":
                            raise RuntimeError("call service error")
                    elif event.get("type") == "notification":
                        await self.event(event)
        except asyncio.CancelledError:
            raise
        except Exception:
            # Exceptions can include the endpoint token; log only the phase.
            log_line("voice call: signalling failed")
            await self.end(None, "failed")
        finally:
            await self.end(None, "ended")
            if self.end_reason:
                self.hangup_done.set()  # connection failed before a hangup could be delivered

    async def initialize(self):
        await asyncio.wait_for(self.ready.wait(), 10)
        await self.command("change-media-settings", mediaSettings=dict(self.SETTINGS, isAudioEnabled=False))
        await self.command("change-participant-state", participantState={"state": {}})

    async def event(self, event):
        name = event.get("notification")
        if name == "connection":
            conversation = event.get("conversation") or {}
            if conversation.get("topology", "DIRECT") != "DIRECT":
                self.job(self.end("FAILED", "unsupported"))
                return
            self.params.update(event.get("conversationParams") or {})
            for person in conversation.get("participants", []):
                if str((person.get("externalId") or {}).get("id")) == str(self.peer):
                    self.participant = person["id"]
                    self.device = person.get("deviceIdx", 0)
            self.ready.set()
        elif name in ("registered-peer", "accepted-call", "transmitted-data"):
            if event.get("participantId") is None:
                return
            if self.participant is not None and str(self.participant) != str(event["participantId"]):
                return
            self.participant = event["participantId"]
            self.device = event.get("deviceIdx", 0)
            if name == "accepted-call" and not self.incoming and not self.accepted:
                self.accepted = True
                self.job(self.negotiate())
            elif name == "transmitted-data":
                data = event.get("data") or {}
                if "sdp" in data:
                    if data["sdp"]["type"] == "offer" and self.incoming:
                        self.offer = data["sdp"]
                        self.offer_ready.set()
                    elif data["sdp"]["type"] == "answer" and self.audio and not self.incoming:
                        self.job(self.audio.remote(data["sdp"]))
                if "candidate" in data:
                    if self.audio:
                        self.audio.add_candidate(data["candidate"])
                    elif len(self.candidates) < 256:
                        self.candidates.append(data["candidate"])
        elif name == "media-settings-changed":
            said = event.get("mediaSettings") or {}
            ours = self.participant is not None and str(event.get("participantId")) == str(self.participant)
            # Only booleans and whether it is the peer: what the peer switched (the
            # microphone was not seen on the tablet; this says whether it came).
            log_line("voice call: peer media audio=%s video=%s peer=%s" % (
                said.get("isAudioEnabled"), said.get("isVideoEnabled"), ours))
            if ours:
                self.remote_video = said.get("isVideoEnabled") is True
                # MAX leaves a switched-off one out (seen on the tablet,
                # 22 October 2026: «audio=None» while the peer was muted): only
                # True is on.
                self.remote_audio = said.get("isAudioEnabled") is True
                self.show(self.state)
        elif name in ("hungup", "closed-conversation"):
            await self.end(remote=True, remote_reason=event.get("reason"))
        elif name == "topology-changed" and event.get("topology") != "DIRECT":
            self.job(self.end("FAILED", "unsupported"))

    async def answer(self, video=None):
        if self.closed or not self.incoming or self.accepted:
            return
        self.video = self.video_invitation if video is None else bool(video)
        self.video_wanted = self.video
        self.accepted = True
        self.show("connecting")
        await asyncio.wait_for(self.ready.wait(), 10)
        await self.command("accept-call", mediaSettings=self.media_settings())
        await self.negotiate()

    async def transmit(self, data):
        target = {"participantId": self.participant, "participantType": "USER", "data": data}
        if self.device:
            target["deviceIdx"] = self.device
        await self.command("transmit-data", **target)

    def candidate(self, value):
        if self.local_sent:
            self.job(self.transmit({"candidate": value}))
        else:
            self.local_candidates.append(value)

    def audio_state(self, state):
        if self.closed:
            return
        if state == "camera-failed":
            log_line("voice call: camera off after its error")
            self.job(self.camera(False, failed=True))
        elif state == "send-video-failed":
            # Built anew once: the camera stays; failing again, video stops.
            if self.sender_rebuilt < 1 and self.audio.rebuild_sender():
                self.sender_rebuilt += 1
                log_line("voice call: video sender rebuilt")
            elif self.video_wanted:
                self.job(self.camera(False, failed=True))
        elif state == "remote-video-failed":
            log_line("voice call: the peer's video stopped")
            self.remote_video = False  # their picture goes; the own camera stays
            self.show(self.state)
        elif state == "connected":
            if self.disconnect_timer is not None:
                self.disconnect_timer.cancel()
                self.disconnect_timer = None
            self.show("active")
        elif state == "failed":
            self.job(self.end("NETWORK_ERROR", "failed"))
        elif state == "disconnected" and self.disconnect_timer is None:
            def expired():
                self.disconnect_timer = None
                if not self.closed:
                    self.job(self.end("NETWORK_ERROR", "failed"))
            self.disconnect_timer = asyncio.get_running_loop().call_later(self.DISCONNECT_GRACE, expired)

    async def negotiate(self):
        self.show("connecting")
        if self.incoming:
            await asyncio.wait_for(self.offer_ready.wait(), 15)
        if self.closed:
            return
        self.audio = self.audio_factory(asyncio.get_running_loop(), self.candidate, self.audio_state, self.params)
        if hasattr(self.audio, "frame"):
            self.audio.frame = lambda own, frame: self.frame and self.frame(own, frame)
        for candidate in self.candidates:
            self.audio.add_candidate(candidate)
        self.candidates.clear()
        if self.incoming:
            await self.audio.remote(self.offer)
        # The SDP does not wait for the camera: ICE starts at once, and the
        # picture comes when the camera is open.
        description = await self.audio.description("answer" if self.incoming else "offer")
        if self.incoming and self.offer.get("p2pRelay"):
            description["p2pRelay"] = True
        await self.transmit({"sdp": description})
        self.local_sent = True
        for candidate in self.local_candidates:
            self.job(self.transmit({"candidate": candidate}))
        self.local_candidates.clear()
        await self.command("change-media-settings", mediaSettings=self.media_settings())
        if self.video:
            self.job(self.camera(True))
        self.job(self.deadline())
        self.job(self.quality())

    def toggle_camera(self):
        """A tap on «Включить/Выключить камеру»: the wish changes at once (the
        button says so), the camera follows; taps meanwhile are folded."""
        if self.closed or self.audio is None:
            return
        self.video_wanted = not self.video_wanted
        log_line("voice call: camera %s by a tap" % ("on" if self.video_wanted else "off"))
        self.show(self.state)
        self.job(self.camera(self.video_wanted))

    async def camera(self, enabled, failed=False):
        if self.closed or self.audio is None:
            return
        if failed:
            self.video_wanted = False
        elif enabled != self.video_wanted:
            return  # a later tap asked otherwise: its own job follows
        audio = self.audio
        try:
            # Finding and opening the camera blocks: signalling, ICE and
            # hang-up go on meanwhile. One thread keeps taps in their order.
            video = await asyncio.wrap_future(CAMERA_WORKER.submit(audio.set_video, enabled))
            error = "Камера не включилась. Разговор продолжается без видео." if failed else None
        except Exception as exc:
            log_line("voice call: the camera did not start: %s %s" % (
                type(exc).__name__, exc if isinstance(exc, RuntimeError) else ""))
            await asyncio.wrap_future(CAMERA_WORKER.submit(audio.set_video, False))
            video, error = False, "Камера не включилась. Разговор продолжается без видео."
            self.video_wanted = False
        if self.closed or audio is not self.audio:
            return  # hung up meanwhile: close() released the camera
        self.video, self.video_error = video, error
        # Show the own preview immediately, even if the signalling ACK is slow.
        self.show(self.state)
        try:
            await self.command("change-media-settings", mediaSettings=self.media_settings())
        except Exception:
            # The media flow over ICE without it: a slow or refused answer
            # to a camera switch never ends the call.
            log_line("voice call: media settings not acknowledged")

    async def adapt_video(self, encoded, delivered, idle=None):
        """The encoder keeps up with the camera and the processors have room
        (idle: the system's idle share over the look), or the tablet is
        overloaded. A camera slow in dim light delivers fewer frames: that is
        no load."""
        if not self.video_wanted or not self.video or delivered <= 0:
            return
        busy = idle is not None and idle < ADAPT_IDLE
        if encoded >= delivered * ADAPT_KEPT and not busy:
            self.overloaded = 0
            return
        # Only a load that lasts counts: ADAPT_TIMES looks in a row (the first
        # seconds of a camera starting are busy by themselves).
        self.overloaded = getattr(self, "overloaded", 0) + 1
        if self.overloaded < ADAPT_TIMES:
            return
        self.overloaded = 0
        smaller = [v for v in VIDEO_SIZES if v[0] < self.audio.video_size[0]]
        if not smaller:
            # The smallest picture stays: the camera is never switched off by
            # the program, only by the person (it went off 5–10 s after its
            # switch on the tablet, 22 October 2026).
            log_line("voice call: video at its smallest, still behind")
            return
        self.audio.video_size = smaller[0]
        # The next call starts no smaller than 320×240: one heavy moment is no rule.
        VIDEO_START[0] = max(smaller[0], VIDEO_SIZES[-2], key=lambda v: v[0])
        log_line("voice call: video %dx%d (%s)" % (smaller[0][0], smaller[0][1],
                                                     "processors busy" if busy else "encoder behind"))
        await self.camera(True)

    async def quality(self):
        """Every ADAPT_EVERY s whether the encoder keeps up (a too big picture
        steps down within seconds, not a minute); the counters in the log
        every 15 s."""
        previous = None
        seen_generation, settle_until = None, 0.0
        loop_time = asyncio.get_running_loop().time
        ticks = 0
        while not self.closed:
            await asyncio.sleep(ADAPT_EVERY)
            ticks += 1
            try:
                if self.video and hasattr(self.audio, "video_frames"):
                    current = (self.audio.video_frames, self.audio.video_pushed,
                               self.audio.video_generation, system_cpu())
                    started = self.audio.video_generation != seen_generation
                    if started:  # a camera (re)started: its first seconds are not judged
                        seen_generation, settle_until = current[2], loop_time() + ADAPT_SETTLE
                    if previous is not None and previous[2] == current[2] and loop_time() >= settle_until:
                        idle = None
                        if current[3] and previous[3] and current[3][1] > previous[3][1]:
                            idle = (current[3][0] - previous[3][0]) / (current[3][1] - previous[3][1])
                        await self.adapt_video(current[0] - previous[0], current[1] - previous[1], idle)
                    previous = current
                else:
                    previous = None
                if ticks % max(1, 15 // ADAPT_EVERY) == 0:
                    counters = await self.audio.stats()
                    log_line("voice quality: " + json.dumps(counters))
            except Exception:
                pass  # statistics must never end a working call

    async def ring_deadline(self):
        await asyncio.sleep(90)
        if not self.closed and not self.accepted:
            await self.end("MISSED" if self.incoming else "CANCELED", "ended")

    async def deadline(self):
        await asyncio.sleep(30)
        if not self.closed and self.state != "active":
            await self.end("TIMEOUT", "failed")

    async def end(self, reason=None, state="ended", *, remote=False, remote_reason=None):
        if self.closed:
            return
        self.closed = True
        self.end_reason = reason
        if self.disconnect_timer is not None:
            self.disconnect_timer.cancel()
            self.disconnect_timer = None
        self.state = state
        # Reasons received from the service are untrusted. Never log raw fields,
        # and keep them separate from end_reason (which sends a local hangup).
        reported = remote_reason if remote else reason
        known = {"HUNGUP", "REJECTED", "CANCELED", "BUSY", "MISSED", "NETWORK_ERROR",
                 "FAILED", "failed", "TIMEOUT", "ANOTHER_DEVICE", "REMOVED", "KILLED",
                 "BANNED", "HAS_ACTIVE_CALL", "CALLER_IS_BLOCKED", "NOT_FRIENDS",
                 "CALLEE_IS_OFFLINE", "CALLEE_UNAVAILABLE", "CALLER_IS_REJECTED",
                 "SERVICE_UNAVAILABLE", "SOCKET_CLOSED", "ENDED", "NOT_FOUND",
                 "CALL_TIMEOUT", "OBSOLETE_CLIENT"}
        label = reported if isinstance(reported, str) and reported in known else (
            "failed" if state in ("failed", "unsupported") else "unknown")
        if label == "FAILED":
            label = "failed"
        log_line("voice call: ended reason=%s by=%s state=%s" %
                 (label, "remote" if remote else "local", state))
        current = asyncio.current_task()
        try:
            if self.audio:
                self.audio.close()
            for task in list(self.jobs):
                if task is not current:
                    task.cancel()
            for future in list(self.pending.values()):
                if not future.done():
                    future.cancel()
            if self.socket:
                await self.send_hangup()
                try:
                    await self.socket.close()
                except Exception:
                    pass
            if self.socket and self.task and self.task is not current:
                self.task.cancel()
        finally:
            # Always told, whatever the teardown did: the window takes the
            # ringing, its notification and the inhibitors away on this.
            self.changed(self, state)


class Offline(Exception):
    """No connection to that messenger now (or no such account): the
    request was not sent."""


class Backend:
    """What the window asks of the messengers, and what they tell it: one
    Account per link (PyMaxLink, or tests/fake_link.py), all in one thread
    with an asyncio loop. The window calls it only through run(), and hears
    back through GLib.idle_add: every request is answered, with Offline
    while its account has no connection. A request about a chat or a
    person goes to the account whose id it is (of(): Account.owns); a
    link of a channel to the one whose host it is."""

    def __init__(self, ui, link=None, cache=None):
        self.ui = ui
        self.cache = cache or MessageCache(CHATS)  # its own in tests that ask
        self.loop = None
        self.accounts = {}  # name -> Account, in the order added
        self.given = {}  # name -> a link given (tests); else made by make()
        for one in link if isinstance(link, (list, tuple)) else [link] if link else []:
            self.given[one.account] = one
            self.add(one)

    def make(self, name):
        """The link of a messenger by its account's name."""
        if name in self.given:
            return self.given[name]
        if name == "max":
            return PyMaxLink(DATA)
        if name == "telegram":
            return TelethonLink(os.path.join(DATA, name))
        raise KeyError(name)

    def missing(self, name):
        """Why a messenger cannot be had here (its card says it), or None."""
        if name in self.given or name == "max":
            return None
        if name == "telegram":
            if importlib.util.find_spec("telethon") is None:
                return "Для Telegram нужен пакет Telethon, он не установлен."
            if telegram_keys() is None:
                return "Нет ключей приложения Telegram: впишите api_id и api_hash " \
                       "в раздел [telegram] файла %s." % SETTINGS.path
        return None

    def add(self, link):
        """An account on this link, not started (begin() starts it)."""
        folder = DATA if link.account == "max" else os.path.join(DATA, link.account)
        account = self.accounts[link.account] = Account(self.ui, link, self.cache, folder)
        return account

    def names(self):
        """The messengers there can be, the given ones (tests) too."""
        return [n for n, _label in MESSENGERS] + [n for n in self.given if n not in dict(MESSENGERS)]

    def start(self):
        # The loop is there before its thread runs: a request made at once waits in it.
        self.loop = asyncio.new_event_loop()
        threading.Thread(target=self._thread, daemon=True).start()

    def _thread(self):
        asyncio.set_event_loop(self.loop)
        try:
            self.loop.run_until_complete(self._main())
        except BaseException as exc:
            log_line("backend ended: %r" % exc)
        finally:
            # Closed, so every request is answered Offline, never left waiting.
            self.loop.close()

    async def _main(self):
        """Every messenger switched on and signed in starts; the window is
        told of the others (signin: off, out, locked)."""
        os.makedirs(DATA, mode=0o700, exist_ok=True)
        for name in self.names():
            try:
                await self.begin(name, quiet=True)
            except Exception as exc:  # one messenger's failure leaves the others
                log_line("%s: start: %r" % (name, exc))
                GLib.idle_add(self.ui.signin, name, {"kind": "locked"})
        await asyncio.Event().wait()  # the accounts live in their own tasks

    async def begin(self, name, quiet=False):
        """Start a messenger's account: at once if a login is kept, else
        only when asked (not quiet: the person pressed «Войти»: a QR
        code comes)."""
        if not messenger_on(name) or self.missing(name):
            GLib.idle_add(self.ui.signin, name, {"kind": "off"})
            return
        account = self.accounts.get(name) or self.add(self.make(name))
        # One start at a time per account: two quick taps (or a switch while
        # the keyring answers) must not make two connections of one login.
        async with account.starting:
            if account.task is not None and not account.task.done():
                return
            if quiet:
                try:
                    kept = await account.link.signed_in()
                except Locked:
                    GLib.idle_add(self.ui.signin, name, {"kind": "locked"})
                    return
                except Exception as exc:  # the keyring did not answer (D-Bus, portal)
                    log_line("%s: the keyring: %r" % (name, exc))
                    GLib.idle_add(self.ui.signin, name, {"kind": "locked"})
                    return
                if not kept:
                    GLib.idle_add(self.ui.signin, name, {"kind": "out"})
                    return
            GLib.idle_add(self.ui.signin, name, {"kind": "getting"})
            account.task = asyncio.get_running_loop().create_task(account.live())

    async def stop(self, name):
        """A messenger switched off: disconnected, its login kept."""
        account = self.accounts.get(name)
        if account is not None:
            await account.stop()
        GLib.idle_add(self.ui.signin, name, {"kind": "off"})

    async def hangup_calls(self):
        """Finish active signalling before quit; no GTK callback is needed."""
        calls = [account.call for account in self.accounts.values() if account.call is not None]
        await asyncio.gather(*(call.end(call.hangup_reason()) for call in calls))
        # A dial request or ws2 handshake may still be finishing. Keep the
        # process alive for its cancellation send within do_shutdown's budget.
        await asyncio.gather(*(call.hangup_done.wait() for call in calls if call.end_reason))

    async def logout(self, name):
        """Out of a messenger's account: disconnected, the login and the
        messages kept of it here forgotten."""
        account = self.accounts.get(name)
        if account is None:
            return
        await account.stop()
        await account.link.logout()
        for chat_id in list(account.chats):
            self.cache.drop(chat_id)
        account.chats = {}
        GLib.idle_add(self.ui.signin, name, {"kind": "out"})

    async def call(self, action, peer=None, conversation=None, video=False):
        account = self.accounts.get("max")
        if account is None or not account.can("calls"):
            raise Offline()
        account.ask()
        if action == "dial":
            if account.call is not None:
                return
            # Only an existing dialog may be called, never a group/channel.
            chat = account.chats.get(peer)
            if chat is None or chat.kind != "DIALOG":
                raise ValueError("not a MAX dialog")
            person = account.peer(chat)
            if person is None or person == account.me:
                raise ValueError("not another person")
            call = account.new_call(str(uuid.uuid4()), person, False, video=video)
            try:
                params = await account.link.dial(call.id, person, video=True) if video else await account.link.dial(call.id, person)
                if not call.closed or call.end_reason:
                    call.start(params)
            except BaseException:
                await call.end(None, "failed")
                # No ws2 task will be started after a failed dial request.
                # Release shutdown even if it already canceled this call.
                call.hangup_done.set()
                raise
        else:
            call = account.call
            if call is None or call.id != conversation:
                return  # a late button press must not affect a replacement call
            if action == "answer":
                call.job(call.answer(video=video))
            elif action == "camera":
                call.toggle_camera()
            elif action == "mute":
                call.toggle_mute()
            elif action == "end":
                await call.end(call.hangup_reason())

    async def password(self, name, text):
        """The cloud password the sign-in asked for (Account.on_password)."""
        account = self.accounts.get(name)
        if account is not None:
            account.answer(text)

    def run(self, coro, done=None, owner=None):
        """Run a coroutine in the messengers' thread; done(result, error) in
        the window's, always: an error (Offline) if the thread is not
        running. Not called when owner (a ChatView) is gone by then.
        The returned future is used only for the bounded wait at shutdown."""
        def answer(res, err):
            if done and not getattr(owner, "gone", False):
                done(res, err)
            return False
        if self.loop is None or self.loop.is_closed():
            coro.close()
            GLib.idle_add(answer, None, Offline())
            return
        fut = asyncio.run_coroutine_threadsafe(coro, self.loop)

        def back(f):
            try:
                res, err = f.result(), None
            except Exception as exc:
                res, err = None, exc
            GLib.idle_add(answer, res, err)
        fut.add_done_callback(back)
        return fut

    def retry(self, name=None):
        """Start the links that gave up again now, not after the pause (the
        wait page's button); one messenger's only with name. One that
        waits for a closed keyring is asked again."""
        for account in self.accounts.values():
            if name in (None, account.id):
                account.retry()
        if name is not None and self.loop is not None:
            account = self.accounts.get(name)
            if account is None or account.task is None:
                asyncio.run_coroutine_threadsafe(self.begin(name, quiet=True), self.loop)

    def of(self, some_id):
        """The account whose chat or person this id is; Offline if none."""
        for account in self.accounts.values():
            if account.owns(some_id):
                return account
        raise Offline()

    def label(self, name):
        account = self.accounts.get(name)
        return account.label if account else dict(MESSENGERS).get(name, name)

    def can(self, what, some_id=None):
        """Whether the account of this id (any account, without one) can
        do this (PyMaxLink.can)."""
        if some_id is not None:
            return any(a.owns(some_id) and a.can(what) for a in self.accounts.values())
        return any(a.can(what) for a in self.accounts.values())

    # --- what the window asks, to the account it is for ---------------------------
    async def history(self, chat_id):
        return await self.of(chat_id).history(chat_id)

    async def older(self, chat_id, before):
        return await self.of(chat_id).older(chat_id, before)

    async def media_url(self, chat_id, msg_id, item):
        return await self.of(chat_id).media_url(chat_id, msg_id, item)

    async def forward(self, chat_id, msg_id, from_chat_id):
        return await self.of(chat_id).forward(chat_id, msg_id, from_chat_id)

    async def send(self, chat_id, text, files=(), reply_to=None):
        return await self.of(chat_id).send(chat_id, text, files, reply_to)

    async def add_contact(self, user_id):
        return await self.of(user_id).add_contact(user_id)

    async def remove(self, chat_id):
        return await self.of(chat_id).remove(chat_id)

    async def react(self, chat_id, msg_id, emoji):
        return await self.of(chat_id).react(chat_id, msg_id, emoji)

    async def reactions(self, chat_id, msg_ids):
        return await self.of(chat_id).reactions(chat_id, msg_ids)

    async def rename(self, user_id, name):
        return await self.of(user_id).rename(user_id, name)

    async def read(self, chat_id, msg_id):
        return await self.of(chat_id).read(chat_id, msg_id)

    async def find_phone(self, phone):
        """The people with this phone number, one per messenger that has
        them (each says whose: account, label); the error of the last asked
        if none."""
        error, found = Offline(), []
        for account in self.accounts.values():
            if account.can("phone") and account.online:
                try:
                    found.append(await account.find_phone(phone))
                except Exception as exc:
                    error = exc
        if not found:
            raise error
        return found

    def _by_link(self, link):
        host = urllib.parse.urlsplit(link).hostname or ""
        for account in self.accounts.values():
            if account.can("links") and any(host == h or host.endswith("." + h)
                                            for h in account.link.hosts):
                return account
        raise Offline()

    async def link_info(self, link):
        return await self._by_link(link).link_info(link)

    async def search(self, query):
        """Public channels and groups by name in every messenger online that
        can search; the error of the last asked if none answered."""
        error, found, asked = Offline(), [], False
        for account in self.accounts.values():
            if account.can("search") and account.online:
                try:
                    found += await account.search(query)
                    asked = True
                except Exception as exc:
                    error = exc
        if not asked:
            raise error
        return found

    async def join(self, link):
        return await self._by_link(link).join(link)

    def download(self, ref, path, timeout=600):
        """From a worker thread (Media's): an attachment a messenger's link
        fetches itself (a ref it gave, not a link) into path; raises what
        failed (Offline with no connection)."""
        if self.loop is None or self.loop.is_closed():
            raise Offline()
        account = self.of(ref)
        account.ask()
        asyncio.run_coroutine_threadsafe(account.link.download(ref, path), self.loop).result(timeout)

    async def log(self, events):
        """Telemetry events to the messengers that take them (MAX's)."""
        for account in self.accounts.values():
            if account.can("telemetry"):
                await account.log(events)


class Account:
    """One messenger's account on top of its link (CONTEXT.md: Аккаунт): the
    chat list and its summaries, names, known people, the message cache and
    its gaps, pages, reactions. Its state files are in folder (DATA for
    MAX, as before there were others). It is the link's events object
    (on_qr, on_login, on_message, on_reaction, on_delete, on_disconnect);
    live() keeps the link up: started again when it gives up, after RETRY's
    pauses (retry() cuts one short), the window told ui.failed(account,
    why, pause) and ui.connected(account, on). Requests that need the
    messenger call ask() first: Offline while not connected."""

    def __init__(self, ui, link, cache, folder):
        self.ui = ui
        self.link = link
        self.id, self.label = link.account, link.label  # "max"; "MAX"
        self.cache = cache
        self.folder = folder
        self.known_path = os.path.join(folder, "known.json")
        self.aliases_path = os.path.join(folder, "names.json")
        self.loop = None
        self.task = None  # live(), while it runs
        self.starting = asyncio.Lock()  # begin() and stop(), one at a time
        self.online = False  # logged in and connected: requests go to the messenger
        self.tries = 0  # the link's starts in a row that ended without a login
        self.wake = None  # set by retry(): the pause before the next start ends
        self.secret = None  # a future the sign-in waits on for the cloud password
        self.me = None
        self.call = None
        self.declining = set()  # invitations currently being answered BUSY
        self.names = {}
        self.portraits = {}
        self.chats = {}
        self.seeded = os.path.exists(self.known_path)
        self.known = set(load_json(self.known_path, []))
        self.agent = None  # the browser user agent the link presents, once logged in
        self.aliases = {self.key(k): v for k, v in load_json(self.aliases_path, {}).items()}

    def key(self, text):
        """An id from a file's key (JSON keys are strings): MAX's are numbers."""
        return int(text) if self.link.prefix is None else text

    def owns(self, some_id):
        """Whether a chat's or a person's id is this account's."""
        prefix = self.link.prefix
        if prefix is None:
            return isinstance(some_id, int) and not isinstance(some_id, bool)
        return isinstance(some_id, str) and some_id.startswith(prefix)

    def can(self, what):
        return what in getattr(self.link, "can", ())

    def retry(self):
        """Start the link again now, not after the pause."""
        if self.loop is not None and self.wake is not None:
            self.loop.call_soon_threadsafe(self.wake.set)

    def ask(self):
        """The messenger can be asked now; else Offline, and nothing is sent."""
        if not self.online:
            raise Offline()

    async def stop(self):
        """Disconnected: the link's run() cancelled (PyMax closes on it).
        The task is let go of only once it has ended: begin() meanwhile
        starts nothing."""
        async with self.starting:
            task = self.task
            if self.call is not None:
                await self.call.end(self.call.hangup_reason())
            self.online = False
            if task is not None:
                task.cancel()
                try:
                    await task
                except BaseException:  # its cancellation, or what it died of
                    pass
            if self.task is task:
                self.task = None

    async def live(self):
        os.makedirs(self.folder, mode=0o700, exist_ok=True)
        self.loop = asyncio.get_running_loop()
        self.wake = asyncio.Event()
        while True:  # the link lives till it gives up; then it is started again
            try:
                await self.link.run(self)
                why = "соединение закрыто"
            except Locked:  # the keyring closed: asked again by retry() only
                self.online = False
                log_line("%s: the keyring is closed" % self.id)
                GLib.idle_add(self.ui.signin, self.id, {"kind": "locked"})
                self.wake.clear()
                await self.wake.wait()
                continue
            except Exception as exc:
                why = repr(exc)
            self.online = False  # a call goes on: its own connection decides
            pause = RETRY[min(self.tries, len(RETRY) - 1)]
            self.tries += 1
            log_line("%s: link gave up (%s); again in %s s" % (self.id, why, pause))
            GLib.idle_add(self.ui.failed, self.id, why, pause)
            self.wake.clear()
            try:
                await asyncio.wait_for(self.wake.wait(), pause)
            except asyncio.TimeoutError:
                pass

    # --- the link's events ------------------------------------------------------
    def new_call(self, conversation, peer, incoming, video=False):
        def changed(call, state):
            if self.call is call:
                GLib.idle_add(self.ui.call_changed, {
                    "id": call.id, "name": self.name(call.peer, "Собеседник"),
                    "photo": self.portraits.get(call.peer), "state": state,
                    "video_invitation": call.video_invitation, "video": call.video,
                    "video_error": call.video_error, "remote_video": call.remote_video,
                    "remote_audio": call.remote_audio,
                    "video_wanted": call.video_wanted,
                    "muted": getattr(call, "muted", False), "since": getattr(call, "since", None)})
                if call.closed:
                    self.call = None
                    if (call.incoming and not call.accepted
                            and call.end_reason not in ("REJECTED", "BUSY")):
                        GLib.idle_add(self.ui.missed_call, {
                            "id": call.id, "chat": self.link.dialog_of(self.me, call.peer),
                            "peer": call.peer, "name": self.name(call.peer, "Собеседник"),
                            "time": now_ms()})
        call = self.call = VoiceCall(conversation, peer, incoming, changed, self.agent, video=video)
        def frame(own, picture):
            if self.call is call and not call.closed:
                receiver = getattr(self.ui, "call_frame", None)
                if receiver:
                    receiver(call.id, own, picture)  # bounded mailbox, no GTK here
        call.frame = frame
        changed(call, call.state)
        return call

    async def on_call_frame(self, opcode, payload):
        if opcode in (120, 121):
            if opcode == 120 and (self.call is None or not self.call.incoming or self.call.accepted):
                return
            if self.call is not None and self.call.id == payload.get("conversationId"):
                if opcode == 120:
                    self.call.accepted = True  # answered elsewhere, not missed here
                await self.call.end(remote=True, remote_reason=
                                    "ANOTHER_DEVICE" if opcode == 120 else payload.get("reason"))
            return
        if not self.online or not self.can("calls"):
            return
        log_line("voice call: invitation received")
        try:
            params = call_params(payload["vcp"])
            conversation, peer = payload["conversationId"], int(payload["callerId"])
            call_endpoint(params, conversation, True)  # validate before showing the invitation
        except Exception:
            log_line("voice call: invalid invitation")
            return
        if conversation in self.declining:
            return
        if self.call is not None:
            if self.call.id == conversation:
                return  # a repeated invitation for our own call is not a second caller
            self.declining.add(conversation)
            try:
                busy = VoiceCall(conversation, peer, True, lambda *_args: None, self.agent)
                await busy.end("BUSY")
                # A terminal VoiceCall opens ws2 only to send hangup; no
                # acceptance, media pipeline or UI callback is created.
                await busy.run(params)
            finally:
                self.declining.discard(conversation)
            return
        video = payload.get("type") == "VIDEO"
        if video and not video_calls() and calls_allowed(False):
            video = False  # «Видеозвонки» off: it rings and is answered by voice
        if not calls_allowed(video):
            # Switched off here: not rung, not refused; MAX rings the other devices.
            log_line("voice call: %s calls are off, not shown" % ("video" if video else "voice"))
            return
        call = self.new_call(conversation, peer, True, video=video)
        call.start(params)
        # Fetch a stranger's name/photo without delaying the invitation or
        # its signaling. A late lookup must not revive an ended call.
        async def identify():
            await self.lookup([peer])
            if self.call is call and not call.closed:
                call.changed(call, call.state)
        call.job(identify())

    async def on_qr(self, qr_url):
        path = os.path.join(self.folder, "qr.png")
        qr_png(qr_url, path)
        GLib.idle_add(self.ui.show_qr, self.id, path)

    async def on_password(self, wrong=False):
        """The sign-in needs the account's cloud password (Telegram's
        two-step verification): the card asks; Backend.password answers."""
        self.secret = self.loop.create_future()
        GLib.idle_add(self.ui.signin, self.id, {"kind": "password", "wrong": wrong})
        try:
            return await self.secret
        finally:
            self.secret = None

    def answer(self, text):
        if self.secret is not None and not self.secret.done():
            self.secret.set_result(text)
            GLib.idle_add(self.ui.signin, self.id, {"kind": "getting"})

    async def on_login(self, me, chats, contacts, agent, session_id):
        try:
            os.remove(os.path.join(self.folder, "qr.png"))
        except OSError:
            pass
        self.me = me.id if me else None
        self.agent = agent
        self.online = True
        self.tries = 0
        if me:
            self.names[self.me] = me.name
            GLib.idle_add(self.ui.signin, self.id, {"kind": "in", "name": self.name(self.me)})
        # On a reconnect the sync only brings chats that changed since the
        # last one, so page through the whole list as well.
        found = {c.id: c for c in chats or []}
        marker = None
        for _page in range(5):
            try:
                page = await self.link.chats_page(marker)
            except Exception:
                break
            fresh = [c for c in page if c.id not in found]
            for c in page:
                found.setdefault(c.id, c)
            if not page or not fresh:
                break
            marker = min(c.time for c in page if c.time) - 1
        chats = list(found.values())
        self.chats = found
        # The contacts come whole on the first login, then only what changed:
        # keep them on disk. The first time, everyone already in a dialog
        # counts too, so that nobody known goes quiet after an update.
        for u in contacts or []:
            if u:
                self.known.add(u.id)
                self.names.setdefault(u.id, u.name)
                self.portraits[u.id] = u.photo
        if not self.seeded:
            self.known.update(p for p in map(self.peer, chats) if p)
            self.seeded = True
        save_json(self.known_path, sorted(self.known))
        want = set()
        for c in chats:
            if c.kind == "DIALOG":
                want.update(u for u in c.members if u != self.me)
        await self.lookup(want)
        GLib.idle_add(self.ui.connected, self.id, True)
        if self.me:
            GLib.idle_add(self.ui.logged_in, self.id, self.me, session_id)
            if self.can("invites"):
                GLib.idle_add(self.ui.show_invites, self.link.invites())
        GLib.idle_add(self.ui.show_chats, self.id, [self.summary(c) for c in chats])

    async def on_message(self, msg):
        await self.lookup({msg.sender})
        known = msg.chat in self.chats  # a new chat comes with its count
        chat = await self.chat(msg.chat) if msg.chat is not None else None
        if chat is not None:
            chat.last = msg
            if msg.sender != self.me and known:
                chat.unread += 1
        out = self.message(msg)
        if msg.chat is not None:
            self.cache.add(msg.chat, [out])
        GLib.idle_add(self.ui.incoming, out, self.summary(chat) if chat is not None else None)

    async def on_disconnect(self, why):
        """The connection is lost; the link connects again by itself. A call
        goes on: its own connection (ws2, ICE) decides about it. Told once,
        not at every attempt to connect again."""
        was, self.online = self.online, False
        if was:
            log_line("%s: connection lost: %s" % (self.id, why))
            GLib.idle_add(self.ui.connected, self.id, False)

    async def on_delete(self, chat_id, msg_ids):
        """Messages deleted (by their sender for everyone, or here): out of
        the cache and the window; the chat's last message anew if it went.
        Without the chat (Telegram tells it only for channels) the ids are
        the account's own, and the chats that have them are looked for."""
        if chat_id is None:
            gone = set(msg_ids)
            for cid, chat in list(self.chats.items()):
                if (chat.last is not None and chat.last.id in gone) or \
                        any(m["id"] in gone for m in self.cache.read(cid)):
                    await self.on_delete(cid, msg_ids)
            return
        self.cache.forget(chat_id, msg_ids)
        chat = self.chats.get(chat_id)
        summary = None
        if chat is not None:
            if chat.last is not None and chat.last.id in msg_ids:
                try:
                    newest = await self.link.history(chat_id, 1)
                except Exception:
                    newest = []
                chat.last = newest[-1] if newest else None
            summary = self.summary(chat)
        GLib.idle_add(self.ui.deleted, chat_id, list(msg_ids), summary)

    async def on_reaction(self, chat_id, msg_id, reactions):
        """Someone's reaction changed; the event does not say whose, so the
        account's own stays as it was known."""
        self.cache.react(chat_id, msg_id, reactions)
        GLib.idle_add(self.ui.reacted, chat_id, msg_id, reactions, ...)

    async def on_read(self, chat_id, mark):
        """The others read the account's messages in a chat up to mark (a time
        or an id, as the link's seen_by says): ✓✓ on them."""
        chat = self.chats.get(chat_id)
        if chat is not None and mark > (chat.seen or 0):
            chat.seen = mark
            GLib.idle_add(self.ui.seen, chat_id, mark)

    # --- names, summaries, messages ---------------------------------------------
    async def lookup(self, ids):
        ids = [i for i in ids if i and i not in self.names]
        for k in range(0, len(ids), 50):
            try:
                users = await self.link.users(ids[k:k + 50])
            except Exception:
                continue
            for u in users or []:
                self.names[u.id] = u.name
                self.portraits[u.id] = u.photo

    def peer(self, chat):
        """The other person of a dialog (None in Избранное, a group, a channel)."""
        if chat.kind != "DIALOG":
            return None
        others = [u for u in chat.members if u != self.me]
        return others[0] if others else None

    def remember(self, user_id):
        """Someone whose messages are welcome: a contact, or written to here."""
        if user_id and user_id != self.me and user_id not in self.known:
            self.known.add(user_id)
            save_json(self.known_path, sorted(self.known))

    def name(self, user_id, default=""):
        """The name given here, else the one in MAX."""
        return self.aliases.get(user_id) or self.names.get(user_id, default)

    def title(self, chat):
        if chat.title:
            return chat.title
        if chat.kind == "DIALOG":
            others = [u for u in chat.members if u != self.me]
            if not others:
                return "Избранное"
            return self.name(others[0], "Собеседник")
        return "Чат"

    def preview(self, msg):
        if not msg:
            return ""
        text = msg.text.replace("\n", " ")
        if msg.call:
            what, how = call_words(msg.call, msg.sender == self.me and self.me)
            return "📞 %s, %s" % (what, how[0].lower() + how[1:])
        if not text:
            text = ", ".join(p or "фото" for p in msg.parts).capitalize()
        if msg.fwd is not None:
            text = "↪ " + text
        if msg.sender == self.me and self.me:
            text = "Вы: " + text
        return text

    def summary(self, chat):
        last = chat.last
        peer = self.peer(chat)
        return {"id": chat.id, "account": self.id, "title": self.title(chat), "type": chat.kind,
                "last": self.preview(last), "time": (last.time if last else 0) or chat.time,
                "unread": chat.unread, "peer": peer, "seen": chat.seen or 0,
                "photo": chat.photo or (self.portraits.get(peer) if peer is not None else None),
                "seen_by": getattr(self.link, "seen_by", "time"),
                "stranger": peer is not None and peer not in self.known}

    def message(self, msg):
        """A message as the window and the cache keep it (a dict)."""
        forwarded = None
        if msg.fwd is not None:  # from whom: the chat it came from, else its sender
            forwarded = msg.fwd.get("chat") or self.name(msg.fwd.get("sender")) or "…"
        body = msg.text
        if msg.notes:
            body = (body + "\n" if body else "") + " ".join("[%s]" % n for n in msg.notes)
        return {"id": msg.id, "chat": msg.chat, "sender": msg.sender,
                "who": self.name(msg.sender), "text": body, "photos": list(msg.photos),
                "time": msg.time, "mine": bool(self.me) and msg.sender == self.me,
                "reactions": [list(r) for r in msg.reactions], "yours": msg.yours,
                "media": [dict(i) for i in msg.media], "forwarded": forwarded,
                "call": dict(msg.call) if msg.call else None,
                "reply": dict(msg.reply, who=self.name(msg.reply.get("sender")) or "")
                if msg.reply else None}

    async def chat(self, chat_id):
        """The chat, from the list or asked for (one just joined, a new
        dialog that has its first message); None if MAX has none."""
        chat = self.chats.get(chat_id)
        if chat is None:
            try:
                found = await self.link.chats([chat_id])
            except Exception:
                found = []
            if found:
                chat = self.chats[chat_id] = found[0]
        return chat

    # --- what the window asks -----------------------------------------------------
    async def history(self, chat_id):
        """The newest PAGE messages of a chat, and whether they leave a gap
        after the cache (more came meanwhile than a page): then the cache is
        started anew from them."""
        chat = await self.chat(chat_id)
        if not chat:
            return [], False  # a dialog nobody has written to yet
        # Nothing new since a full cache: no request at all (new messages
        # and reactions while running come as events). A cache of a few
        # messages (a chat that came by an event) is not full: asked for.
        cached = self.cache.read(chat_id)
        last = chat.last
        if len(cached) >= PAGE and last and not chat.unread and \
                any(m["id"] == last.id for m in cached[-5:]):
            return [], False
        self.ask()
        msgs = await self.link.history(chat_id, PAGE)
        if any(m.sender == self.me for m in msgs):
            self.remember(self.peer(chat))
        await self.lookup({m.sender for m in msgs})
        msgs.sort(key=lambda m: m.time)
        if msgs:
            try:
                await self.link.read(chat_id, msgs[-1].id)
                chat.unread = 0
            except Exception:
                pass
        out = [self.message(m) for m in msgs]
        if out:  # deleted while away: in the cache, within the page, no longer in MAX
            fetched = {m["id"] for m in out}
            gone = [m["id"] for m in cached if m["time"] >= out[0]["time"] and m["id"] not in fetched]
            if gone:
                self.cache.forget(chat_id, gone)
                cached = [m for m in cached if m["id"] not in gone]
        known = {m["id"] for m in cached}
        gap = bool(cached) and len(out) >= PAGE and not known & {m["id"] for m in out} and \
            out[0]["time"] > cached[-1]["time"]
        if gap:
            self.cache.drop(chat_id)
        self.cache.add(chat_id, out)
        return out, gap

    async def older(self, chat_id, before):
        """PAGE messages older than the time before (ms), oldest first; not
        cached, the cache keeps only the newest."""
        self.ask()
        if not await self.chat(chat_id):
            return []
        msgs = await self.link.history(chat_id, PAGE, before=before)
        await self.lookup({m.sender for m in msgs})
        msgs = sorted((m for m in msgs if m.time < before), key=lambda m: m.time)
        return [self.message(m) for m in msgs]

    async def media_url(self, chat_id, msg_id, item):
        """Where a video or a file of a message can be fetched (MAX hands
        out short-lived links on request)."""
        self.ask()
        return await self.link.media_url(chat_id, msg_id, item)

    async def forward(self, chat_id, msg_id, from_chat_id):
        """Forward a message into a chat; (the new message, that chat's
        summary) as the window shows them."""
        self.ask()
        msg = await self.link.forward(chat_id, msg_id, from_chat_id)
        out = self.message(msg)
        self.cache.add(chat_id, [out])
        chat = await self.chat(chat_id)
        if chat is not None:
            chat.last = msg
        return out, self.summary(chat) if chat is not None else None

    async def send(self, chat_id, text, files=(), reply_to=None):
        self.ask()
        chat = self.chats.get(chat_id)
        # A dialog not started yet is numbered own id XOR theirs.
        self.remember(self.peer(chat) if chat else self.link.dialog_of(self.me, chat_id)
                      if self.me else None)
        more = {"reply_to": reply_to} if reply_to else {}
        msg = await self.link.send(chat_id, text, list(files), **more) if files else \
            await self.link.send(chat_id, text, **more)
        if isinstance(msg, list):  # each file a message of its own (Telegram)
            out = [self.message(m) for m in msg]
            self.cache.add(chat_id, out)
            return out
        out = self.message(msg) if msg else None
        if out:
            self.cache.add(chat_id, [out])
        return out

    async def find_phone(self, phone):
        """The person with this phone number, if they are in MAX."""
        self.ask()
        user = await self.link.find_phone(phone)
        self.names[user.id] = user.name
        return {"id": user.id, "name": self.name(user.id), "account": self.id, "label": self.label,
                "chat": self.link.dialog_of(self.me, user.id) if self.me else None}  # their dialog

    async def add_contact(self, user_id):
        self.ask()
        user = await self.link.add_contact(user_id)
        self.names[user.id] = user.name
        self.remember(user.id)

    async def search(self, query):
        """Public channels and groups by name, not joined yet, with their
        link: as link_info's answers."""
        self.ask()
        return [{"id": c.id, "title": c.title or "Без названия", "type": c.kind,
                 "members": c.count or len(c.members), "joined": False, "link": c.link,
                 "account": self.id, "label": self.label}
                for c in await self.link.search(query) if c.link and c.id not in self.chats]

    async def link_info(self, link):
        """The channel or group behind a link, before joining it."""
        self.ask()
        chat = await self.link.link_info(link)
        if chat is None:
            return None
        return {"id": chat.id, "title": chat.title or "Без названия", "type": chat.kind,
                "members": chat.count or len(chat.members),
                "joined": chat.id in self.chats}

    async def join(self, link):
        self.ask()
        chat = await self.link.join(link)
        self.chats[chat.id] = chat
        return self.summary(chat)

    async def remove(self, chat_id):
        """Leave a channel or group, delete a dialog: for this account only
        (the link can do no other)."""
        self.ask()
        chat = self.chats.get(chat_id)
        stamp = chat.time if chat else None
        if chat is not None and chat.kind in ("CHAT", "CHANNEL"):
            await self.link.leave(chat_id)
            try:  # and its messages off the list, as the app does
                await self.link.delete(chat_id, stamp)
            except Exception:
                pass
        else:
            await self.link.delete(chat_id, stamp)
        self.chats.pop(chat_id, None)
        self.cache.drop(chat_id)

    async def reactions(self, chat_id, msg_ids):
        """Reactions of messages as the messenger has them (empty: it cannot
        say); the cache keeps them."""
        if not hasattr(self.link, "reactions") or not msg_ids:
            return {}
        self.ask()
        got = await self.link.reactions(chat_id, msg_ids)
        for msg_id, reactions in got.items():
            self.cache.react(chat_id, msg_id, reactions)
        return got

    async def react(self, chat_id, msg_id, emoji):
        """Put the account's reaction on a message (None takes it off);
        (reactions, own emoji) as MAX has them afterwards, or None."""
        self.ask()
        info = await self.link.react(chat_id, msg_id, emoji)
        if info is None:
            return None  # taken, but MAX sent no counts: the window counts itself
        reactions, _ = info
        self.cache.react(chat_id, msg_id, reactions, emoji)
        return reactions, emoji

    async def rename(self, user_id, name):
        """Call someone by another name here (empty: by theirs in MAX again);
        MAX itself keeps no such names for its web client. The summaries of
        their dialogs come back renamed."""
        if name:
            self.aliases[user_id] = name
        else:
            self.aliases.pop(user_id, None)
        save_json(self.aliases_path, {str(k): v for k, v in self.aliases.items()})
        return [self.summary(c) for c in self.chats.values() if self.peer(c) == user_id]

    async def read(self, chat_id, msg_id):
        self.ask()
        await self.link.read(chat_id, msg_id)

    async def log(self, events):
        """Telemetry events (dicts shaped as PyMax's TelemetryEvent) to MAX."""
        if self.online:
            await self.link.log(events)


class MessageCache:
    """The message cache (CONTEXT.md: Кэш сообщений): the newest KEEP
    messages of each chat, so a chat opens at once. A chat's messages are
    read from its file (folder/<id>.json, 600) the first time they are
    needed and kept in memory; a change is written by a thread of its own
    `delay` s after the last one, all of a chat at once and atomically
    (.new + os.replace), and whatever is left at flush() (the program's
    end). Both threads use it; read() gives a copy."""

    def __init__(self, folder, delay=2.0):
        self.folder, self.delay = folder, delay
        self.chats = {}  # chat id -> its messages, oldest first
        self.dirty = set()  # chat ids changed and not written yet
        self.lock = threading.Lock()
        self.write_lock = threading.Lock()  # flushes one at a time, readers never wait for disks
        self.gen = {}  # chat id -> how many times it was dropped: a write made before goes
        self.timer = None

    def _path(self, chat_id):
        if isinstance(chat_id, str):  # another messenger's ("tg:…"): in a folder of its own
            prefix, _, rest = chat_id.partition(":")
            return os.path.join(self.folder, prefix, "%s.json" % rest)
        return os.path.join(self.folder, "%d.json" % chat_id)

    def _get(self, chat_id):  # under the lock
        msgs = self.chats.get(chat_id)
        if msgs is None:
            try:
                with open(self._path(chat_id)) as fh:
                    msgs = json.load(fh)
            except (OSError, ValueError):
                msgs = []
            if not isinstance(msgs, list):
                msgs = []
            self.chats[chat_id] = msgs
        return msgs

    def _changed(self, chat_id):  # under the lock
        self.dirty.add(chat_id)
        if self.timer is None:
            self.timer = threading.Timer(self.delay, self.flush)
            self.timer.daemon = True
            self.timer.start()

    def read(self, chat_id):
        """The chat's cached messages, oldest first (a copy)."""
        with self.lock:
            return [dict(m) for m in self._get(chat_id)]

    def add(self, chat_id, msgs):
        """Messages merged in (by id); the newest KEEP stay."""
        if not msgs:
            return
        with self.lock:
            known = {m["id"]: m for m in self._get(chat_id)}
            for m in msgs:
                known[m["id"]] = dict(m)
            self.chats[chat_id] = sorted(known.values(), key=lambda m: m["time"] or 0)[-KEEP:]
            self._changed(chat_id)

    def react(self, chat_id, msg_id, reactions, yours=...):
        """New reactions of one cached message (yours left alone if not given)."""
        with self.lock:
            for m in self._get(chat_id):
                if m["id"] == msg_id:
                    m["reactions"] = reactions
                    if yours is not ...:
                        m["yours"] = yours
                    self._changed(chat_id)
                    return

    def forget(self, chat_id, msg_ids):
        """Deleted messages out of a chat's cache."""
        gone = set(msg_ids)
        with self.lock:
            msgs = self._get(chat_id)
            keep = [m for m in msgs if m["id"] not in gone]
            if len(keep) != len(msgs):
                self.chats[chat_id] = keep
                self._changed(chat_id)

    def drop(self, chat_id):
        """The chat's cache gone, on disk too (a gap, or the chat removed)."""
        with self.lock:
            self.chats[chat_id] = []
            self.dirty.discard(chat_id)
            self.gen[chat_id] = self.gen.get(chat_id, 0) + 1
            try:
                os.remove(self._path(chat_id))
            except OSError:
                pass

    def flush(self):
        """Every change not yet on disk, written now. The lock is held only
        to take the chats as they are (as text); the disk is written without
        it, so opening a chat never waits for a slow eMMC. A chat dropped
        meanwhile wins: its old text is not put back."""
        # The write lock first: two flushes (the timer's, the shutdown's) take
        # their snapshots in the order they write, never an older one last.
        with self.write_lock:
            with self.lock:
                self.timer = None
                dirty, self.dirty = self.dirty, set()
                out = []
                for chat_id in dirty:
                    try:
                        out.append((chat_id, self.gen.get(chat_id, 0),
                                    json.dumps(self.chats.get(chat_id, []), ensure_ascii=False)))
                    except (TypeError, ValueError) as exc:  # one chat's, the others still go
                        log_line("cache %s: %r" % (chat_id, exc))
            for chat_id, gen, text in out:
                try:
                    path = self._path(chat_id)
                    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
                    fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                    with os.fdopen(fd, "w") as fh:
                        fh.write(text)
                    with self.lock:
                        if self.gen.get(chat_id, 0) == gen:
                            os.replace(path + ".new", path)
                        else:
                            os.remove(path + ".new")
                except OSError as exc:
                    log_line("cache %s: %r" % (chat_id, exc))
                    with self.lock:
                        if self.gen.get(chat_id, 0) == gen:  # not if dropped meanwhile
                            self.dirty.add(chat_id)  # tried again by the next flush


def load_json(path, default):
    """A small state file of DATA, or default if missing or broken."""
    try:
        with open(path) as fh:
            data = json.load(fh)
        return data if isinstance(data, type(default)) else default
    except (OSError, ValueError):
        return default


def save_json(path, data):
    """Written whole and atomically, mode 600 (it names people)."""
    save_text(path, json.dumps(data, ensure_ascii=False))


_save_lock = threading.Lock()


def save_text(path, text):
    """A file written whole and atomically, mode 600, from any thread."""
    with _save_lock:
        try:
            os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
            fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as fh:
                fh.write(text)
            os.replace(path + ".new", path)
        except OSError:
            pass


def load_setting(key):
    """A yes/no setting of [max] (telemetry, buzz…); yes until set."""
    return SETTINGS.get_bool(key, True)


def messenger_on(name):
    """Whether a messenger is switched on (the settings' card): MAX until
    switched off, the others once switched on."""
    return SETTINGS.get_bool("account_" + name, name == "max")


def load_text(key, default):
    """A text setting of [max] (the folder for files)."""
    return SETTINGS.get(key, default) or default


def save_setting(key, value):
    SETTINGS.set(key, value)


def now_ms():
    return int(time.time() * 1000)


class Telemetry:
    """What MAX's app tells the server about its use, from what really
    happens here (see the top of the file). Called in the window's thread;
    the events leave through the MAX thread in small batches. The shapes
    and fixed values are PyMax 2.4.1's (pymax/telemetry/payloads.py)."""

    def __init__(self, backend):
        self.backend = backend
        self.on = load_setting("telemetry")
        self.user = None  # the account's id, once logged in
        self.session = 0
        self.screen = SCREEN_BACKGROUND
        self.last_go = now_ms()
        self.action = 0
        self.queue = []
        self.timer = 0

    def started(self, user, session):
        """Logged in, at start and after every reconnect, as PyMax does."""
        self.user, self.session = user, session
        self.add("PERF", "login", {
            "properties": {"connection_type": 2, "vpn": 0, "class": 2,
                           "background": 1, "warm_start": 1},
            "errorType": 100})

    def go(self, screen, params=None):
        """The person went to another screen (BACKGROUND: the window hid).
        Before the login nothing moves: the window tells again after it."""
        if screen == self.screen or self.user is None:
            return
        before, self.screen = self.screen, screen
        if before == SCREEN_BACKGROUND:
            self.session += 1  # a new visit, as the app counts them
        self.action = (self.action + 1) % 0xFFFFFFFF
        nav = {"prev_time": self.last_go, "screen_to": screen, "action_id": self.action,
               "screen_from": before}
        nav.update(params or {})
        self.last_go = now_ms()
        self.add("NAV", "GO", nav)
        if screen == SCREEN_BACKGROUND:
            self.flush()

    def chat_shown(self, messages, render):
        """A chat opened: ms until its messages came, then until drawn."""
        self.add("PERF", "open_chat_to_render", {
            "spans": [{"duration": messages + render, "name": "open_chat_to_render"},
                      {"duration": messages, "name": "messages_list_created"},
                      {"duration": render, "name": "messages_render"}],
            "properties": {"class": 2, "warm": 1, "flow": 1}})

    def add(self, type_, event, params):
        if not self.on or self.user is None:
            return
        self.queue.append({"time": now_ms(), "user_id": self.user, "type": type_,
                           "event": event, "params": params, "session_id": self.session})
        if not self.timer:
            self.timer = GLib.timeout_add_seconds(FLUSH_SEC, self._tick)

    def _tick(self):
        self.timer = 0
        self.flush()
        return False

    def flush(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        events, self.queue = self.queue, []
        if events:
            self.backend.run(self.backend.log(events))

    def switch(self, on):
        self.on = on
        save_setting("telemetry", on)
        if not on:
            self.queue = []
            self.flush()


def media_ok(url):
    """A link for a photo, a video, a voice message or a file: https on MAX's
    own hosts only (a player or the browser opens it, and a sender must not
    point it at the LAN or anywhere else)."""
    parts = urllib.parse.urlsplit(url or "")
    host = (parts.hostname or "").lower()
    return parts.scheme == "https" and any(host == h or host.endswith("." + h)
                                           for h in MEDIA_HOSTS)


def photo_ok(url):
    return media_ok(url)


def where(url):
    """A link for the log: host and path, not the signature in its query
    (an attachment of a messenger fetched by its link, as it is)."""
    if is_ref(url):
        return url[:60]
    parts = urllib.parse.urlsplit(url or "")
    return "%s%s" % (parts.hostname or "?", parts.path[:60])


def is_ref(text):
    """An attachment a messenger's link fetches itself ("tg:…" as its link
    gave it), not a link: no scheme of the web or of files."""
    return isinstance(text, str) and ":" in text and "://" not in text and \
        text.split(":", 1)[0] not in ("http", "https", "file", "data", "javascript")


def secs(duration):
    """MAX gives durations in ms, some in seconds."""
    return duration / 1000 if duration > 1000 else duration


def mmss(sec):
    sec = int(sec or 0)
    return "%d:%02d" % (sec // 60, sec % 60)


def size_text(n):
    for unit in ("Б", "КБ", "МБ"):
        if n < 1024 or unit == "МБ":
            return ("%d %s" if unit == "Б" else "%.1f %s") % (n, unit)
        n /= 1024


class PhotoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not media_ok(newurl):
            return None  # urllib then raises: no hop off MAX's hosts
        return super().redirect_request(req, fp, code, msg, headers, newurl)


PHOTO_OPENER = urllib.request.build_opener(PhotoRedirect)


def log_open():
    """The media log, mode 600, started anew past 256 KB; None if it can't be."""
    try:
        os.makedirs(PHOTOS, mode=0o700, exist_ok=True)
        if os.path.getsize(LOG) > 256 * 1024:
            os.remove(LOG)
    except OSError:
        pass
    try:
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        return os.fdopen(fd, "a", buffering=1)
    except OSError:
        return None


_log = {"fh": None, "lines": 0}
_log_lock = threading.Lock()


def log_line(text):
    """A line into LOG, from any thread; the file stays open, and is started
    anew past its size (looked at every hundred lines)."""
    with _log_lock:
        if _log["fh"] is None or _log["lines"] >= 100:
            if _log["fh"] is not None:
                _log["fh"].close()
            _log["fh"], _log["lines"] = log_open(), 0
        if _log["fh"] is None:
            return
        _log["lines"] += 1
        try:
            _log["fh"].write("%s %s\n" % (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), text))
        except (OSError, ValueError):
            _log["fh"] = None


class Libmpv:
    """Voice messages through libmpv, sound only; None of it without libmpv
    (made by Media, which gives it the agent and its callbacks)."""

    def __init__(self, on_time, on_end):
        import mpv

        self.awake = Awake(NAME, "plays a voice message")

        opts = dict(video=False, load_unsafe_playlists=False, input_default_bindings=False,
                    input_vo_keyboard=False, loglevel="warn",
                    log_handler=lambda level, prefix, text: log_line(
                        "voice %s %s: %s" % (level, prefix, text.strip())))
        try:
            self.mpv = mpv.MPV(ytdl=False, **opts)
        except Exception as exc:  # a libmpv without Lua (the Flatpak's) has no ytdl at all
            log_line("voice: libmpv without ytdl (%r)" % exc)
            self.mpv = mpv.MPV(**opts)
        self.duration = None  # of what plays, once libmpv knows it (files carry none)
        self.mpv.observe_property("duration", lambda _n, v: setattr(self, "duration", v))
        self.told = None  # the half second last told: the bar needs no more

        def moved(_name, v):
            if v is not None and int(v * 2) != self.told:
                self.told = int(v * 2)
                GLib.idle_add(on_time, v, self.duration)
        self.mpv.observe_property("time-pos", moved)

        @self.mpv.event_callback("end-file")
        def _end(event):
            # A file stopped or replaced by the next one ends too (ABORTED).
            if getattr(getattr(event, "data", None), "reason", None) != 2:
                GLib.idle_add(lambda: (self.awake.release(), on_end(), False)[2])

    def play(self, url, agent):
        # the kit's Player takes no user agent, which MAX's CDN wants.
        self.mpv["user-agent"] = agent
        self.mpv.play(url)
        self.mpv.pause = False
        self.awake.hold()

    def toggle(self):
        self.mpv.pause = not self.mpv.pause
        (self.awake.release if self.mpv.pause else self.awake.hold)()
        return not self.mpv.pause

    def stop(self):
        self.mpv.command("stop")
        self.awake.release()


# How a voice message is recorded: Ogg/Opus, as MAX's apps send it, by ffmpeg
# (in the tablet's image) or GStreamer; else parecord's Ogg/Vorbis.
RECORDERS = (
    ("ffmpeg", lambda path: [
        "ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-f", "pulse", "-i", "default",
        "-ac", "1", "-ar", "48000", "-c:a", "libopus", "-b:a", "32k", "-application", "voip",
        "-f", "ogg", path]),

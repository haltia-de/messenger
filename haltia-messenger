class Max(Gtk.Application):
    def __init__(self, link=None, media=None, recorder=None):
        # HANDLES_OPEN: another program sends a file here (X-Haltia-Share in
        # the .desktop file); a second launch hands it to the running one.
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.add_main_option("background", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
                             "Start without showing the window", None)
        self.sharing = None  # files another program sent, while a chat is chosen for them
        self.share_at = 0.0  # when «Кому отправить?» was shown
        # Typed messages on their way, as bubbles at once: id -> {"chat", "text",
        # "files", "m": the bubble's dict, its "state" sending or failed}.
        self.queue = {}
        self.queued = 0
        self.win = None
        self.call_id = None
        self.chooser = None  # the file chooser open, closed if a call rings
        self.dial_confirming = False
        # GTK/portal only: the independent logind attempt below owns its fd.
        self.call_awake = Awake(NAME, "voice call", inhibit=lambda *_args: None)
        # A GTK/portal cookie may be granted without a working portal.
        # Keep an independent logind fd for haltia-sleep on the tablet.
        self.call_logind = Awake(NAME, "call", app=False)
        self.call_ringer = CallRinger()
        self.call_ringback = Ringback()  # what the caller hears while dialling
        self.call_notice = None  # the ringing call whose notification is up
        self.call_notice_at = 0.0  # monotonic time it was sent
        self.call_portrait = None
        self.call_inhibited = None  # one attempt per call, even if logind refuses it
        self.missed_path = os.path.join(DATA, "missed-calls.json")
        self.missed_calls = load_json(self.missed_path, {})  # latest notice per MAX dialog
        self.recorder = recorder or Recorder()  # voice messages from the microphone
        self.backend = Backend(self, link)  # link: PyMaxLink unless given (tests, demo)
        self.telemetry = Telemetry(self.backend)
        self.came_from = "chats"  # the page the settings go back to
        self.buzz_new = load_setting("buzz")  # a desktop notification of a new message
        # The list's rules and state; pins and notifications are kept here
        # only: MAX's own pinning and muting are not in PyMax.
        self.chatlist = ChatList(LIST, PREFS, contacts_only=load_setting("contacts_only"))
        self.counted = None  # (tab labels, subtitle, badge) as last shown
        self.tab = "chats"  # or "channels"
        self.media = media or Media()  # photos, voice, video, files: how MAX's CDNs are reached
        self.media.own = self.backend.download  # what other messengers carry: through their links
        self.playing = None  # (progress bar, button, duration) of what plays
        self.playing_chat = None  # the chat it plays in
        self.playing_msg = None  # and its message
        self.confirm_acts = load_setting("confirm")  # ask before saving and forwarding
        self.playing_pos = 0.0  # s played
        self.mpris = None  # what plays, told to the desktop (Mpris)
        self.keep_sound = SETTINGS.get_bool("keep_sound", False)  # plays on outside its chat
        self.voice_on = SETTINGS.get_bool("voice", True)  # the microphone button: voice messages sent
        self.voice_ask = SETTINGS.get_bool("voice_ask", True)  # a press asks before recording
        self.held = 0.0  # when a row was long-pressed: its release opens nothing
        self.open_chat = None
        self.views = {}  # chat id -> its ChatView, most recently used last
        self.tagged = False  # rows say their messenger (retag)
        self.view = None  # the one on the chat page
        self.background = "--background" in sys.argv[1:]

    def do_startup(self):
        Gtk.Application.do_startup(self)
        act = Gio.SimpleAction.new("open-chat", GLib.VariantType("s"))  # the id as JSON
        act.connect("activate", lambda _a, v: (self.do_activate(), self.open(json.loads(v.unpack()))))
        self.add_action(act)
        quit_action = Gio.SimpleAction.new("quit", None)
        quit_action.connect("activate", lambda *_args: self.quit())
        self.add_action(quit_action)
        self.set_accels_for_action("app.quit", ["<Primary>q"])
        show_call = Gio.SimpleAction.new("show-call", None)
        show_call.connect("activate", lambda *_args: self.do_activate())
        self.add_action(show_call)  # Showing the invitation never answers it.
        if FLATPAK:
            ask_background(self.get_dbus_connection())

    def do_shutdown(self):
        if self.win is not None:
            self.record_stop(False)  # no microphone left on after the program
        # Only process shutdown waits for the backend: at most two seconds,
        # independent of idle callbacks on the GTK loop which is stopping.
        future = self.backend.run(self.backend.hangup_calls())
        if future is not None:
            try:
                future.result(timeout=2)
            except Exception:
                future.cancel()
        self.backend.run(self.backend.stop("max"))
        self.call_awake.release()
        self.call_logind.release()
        self.call_ringer.stop()
        self.call_ringback.stop()
        self.withdraw_call_notice(now=True)  # no later: the program is going
        self.backend.cache.flush()  # what the last two seconds changed
        recent = getattr(self, "recent", None)  # no window ever built: none
        if recent is not None and recent != self.recent_saved:
            save_json(EMOJI_RECENT, recent)  # the panel left open
        Gtk.Application.do_shutdown(self)


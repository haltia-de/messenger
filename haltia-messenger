            self.mpris = Mpris(self)
        except GLib.Error as exc:  # another MAX owns it, or no bus: no MPRIS
            log_line("mpris: %r" % exc)
        # The program lives for weeks in the background: prune daily too.
        GLib.timeout_add_seconds(86400, lambda: threading.Thread(
            target=self.media.prune, daemon=True).start() or True)
        if self.win.get_visible():
            # MAX (PyMax's import, the login) after the first frame: the
            # window and the last list are drawn without sharing the GIL.
            drawn = self.win.connect("draw", lambda *_a: self.after_first_frame(drawn) and False)
        else:
            self.after_first_frame()

    def after_first_frame(self, handler=None):
        if handler is not None:
            self.win.disconnect(handler)
        GLib.idle_add(lambda: (self.backend.start(), threading.Thread(
            target=self.media.prune, daemon=True).start()) and False,
            priority=GLib.PRIORITY_LOW)

    # called from the MAX thread through idle_add
    def show_qr(self, account, path):
        """A login is needed (the first, or MAX ended the last one): its
        card shows the code, on the login page from any page (in the
        settings if open there); the cache stays."""
        self.signin(account, {"kind": "waiting", "qr": path})
        if self.stack.get_visible_child_name() != "settings":
            self.show_login()
        self.win.present()  # a login needs the person, background or not
        return False

    def show_login(self):
        self.back.hide()
        self.title.set_text(NAME)
        self.sub.set_text("")
        self.offline.hide()
        self.stack.set_visible_child_name("login")

    def signin(self, account, state):
        """An account's sign-in as it is now: off, out, getting, waiting
        (its QR code), in (with the name), locked (the keyring closed),
        failed (with the pause): its cards drawn anew. With no list yet and
        no messenger getting in, the login page asks for one."""
        if account == "max" and state["kind"] == "out":
            for chat in self.missed_calls:
                self.withdraw_notification("missed-call-" + chat)
            self.missed_calls.clear()
            save_json(self.missed_path, self.missed_calls)
            for view in self.views.values():
                view.missed_call(None)
        self.signins[account] = state
        self.draw_accounts()
        page = self.stack.get_visible_child_name()
        if state["kind"] in ("out", "off", "locked") and not self.chatlist.chats and \
                page == "wait" and not any(st["kind"] in ("getting", "in", "waiting")
                                           for st in self.signins.values()):
            self.show_login()
        return False

    def draw_accounts(self):
        for box in (self.login_cards, self.settings_cards):
            for child in box.get_children():
                child.destroy()
            for name, title in MESSENGERS:
                box.pack_start(self.account_card(name, title), False, False, 0)
            box.show_all()

    def account_card(self, name, title):
        """One messenger's card: its switch, and the sign-in as it is."""
        missing = self.backend.missing(name)
        state = self.signins.get(name) or {"kind": "getting" if messenger_on(name) and not missing
                                           else "off"}
        kind_ = state["kind"]
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.get_style_context().add_class("settings")
        card.account, card.state = name, kind_  # for the tests
        row = Gtk.Box(spacing=24)
        row.pack_start(label(title, "setting", wrap=True), True, True, 0)
        switch = Gtk.Switch(active=messenger_on(name) and not missing, valign=Gtk.Align.CENTER)
        switch.set_sensitive(not missing)
        switch.connect("notify::active", lambda sw, _p: self.switch_account(name, sw.get_active()))
        row.pack_end(switch, False, False, 0)
        card.pack_start(row, False, False, 0)
        if name in EXPERIMENTAL:
            card.pack_start(label("Экспериментально: что-то может работать не так.", "hint",
                                  wrap=True), False, False, 0)
        if missing:
            card.pack_start(label(missing, "hint", wrap=True), False, False, 0)
            return card

        def button(text, action, cls="act"):
            b = Gtk.Button(label=text)
            b.get_style_context().add_class(cls)
            b.set_halign(Gtk.Align.START)
            b.connect("clicked", lambda _b: action())
            card.pack_start(b, False, False, 0)

        def hint(text):
            card.pack_start(label(text, "hint", wrap=True), False, False, 0)

        if kind_ == "off":
            hint("Выключен: сообщения из %s не приходят. Вход сохраняется." % title)
        elif kind_ == "in":
            hint("Вход выполнен: %s" % state.get("name", ""))
            button("Выйти", lambda: self.logout(name, title), "danger")
        elif kind_ == "waiting":
            image = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file(state["qr"]))
            image.set_valign(Gtk.Align.CENTER)
            # The code and, beside it, the way to it on the phone in large steps.
            beside = Gtk.Box(spacing=32)
            beside.pack_start(image, False, False, 0)
            steps = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20, valign=Gtk.Align.CENTER)
            for n, step in enumerate(QR_STEPS.get(name, ("Откройте %s на телефоне" % title,
                                                         "Наведите камеру на этот код")), 1):
                steps.pack_start(label("%d.  %s" % (n, step), "qr-step", wrap=True), False, False, 0)
            beside.pack_start(steps, True, True, 0)
            card.pack_start(beside, False, False, 0)
        elif kind_ == "password":
            hint("Пароль не подошёл, попробуйте ещё раз." if state.get("wrong") else
                 "Вход в %s защищён облачным паролем. Введите его." % title)
            entry = Gtk.Entry(visibility=False, input_purpose=Gtk.InputPurpose.PASSWORD)
            entry.set_placeholder_text("Облачный пароль")
            entry.get_style_context().add_class("input")
            card.pack_start(entry, False, False, 0)

            def give():
                if entry.get_text():
                    self.give_password(name, entry.get_text())
            entry.connect("activate", lambda _e: give())
            button("Войти", give)
        elif kind_ == "out":
            hint("Вход не выполнен.")
            button("Войти по QR-коду", lambda: self.sign_in(name))
        elif kind_ == "locked":
            hint("Связка ключей закрыта: вход в %s хранится в ней." % title)
            button("Открыть", lambda: self.backend.retry(name))
        elif kind_ == "failed":
            hint("Нет связи с %s. Повторю через %d с." % (title, state.get("pause", 0)))
            button("Повторить", lambda: self.backend.retry(name))
        else:
            hint("Подключение…")
        return card

    def give_password(self, name, text):
        self.signin(name, {"kind": "getting"})
        self.backend.run(self.backend.password(name, text))

    def sign_in(self, name):
        self.signin(name, {"kind": "getting"})
        self.backend.run(self.backend.begin(name))

    def switch_account(self, name, on):
        """A messenger switched on (it signs in, if it has a login) or off
        (disconnected, its chats off the list, the login kept)."""
        if on == messenger_on(name):
            return
        SETTINGS.set("account_" + name, on)
        self.retag()
        if on:
            self.signin(name, {"kind": "getting"})
            self.backend.run(self.backend.begin(name, quiet=True))
        else:
            self.signin(name, {"kind": "off"})
            self.down.discard(name)
            self.connected(name, True)
            self.backend.run(self.backend.stop(name))
            self.chatlist.replace([], name)
            self.fill_list()

    def logout(self, name, title):
        if not dialogs.ask(self.win, "Выйти из %s? Переписка в нём останется, но здесь "
                           "её не будет, пока вы не войдёте снова." % title, "Выйти"):
            return

        def done(_res, err):
            if err is not None:
                log_line("logout %s: %r" % (name, err))
            self.down.discard(name)
            self.connected(name, True)
            self.chatlist.replace([], name)
            self.fill_list()
        self.backend.run(self.backend.logout(name), done)

    def logged_in(self, account, user, session):
        agent = self.backend.accounts[account].agent
        if agent and account == "max":
            self.media.agent = agent  # media links want PyMax's browser agent
        if self.backend.can("telemetry", user):
            self.telemetry.started(user, session)
        self.moved()
        return False

    def failed(self, account, _why, pause):
        """A link gave up; Backend starts it again after pause s (the
        reason is in the log). With a list shown the person stays where
        they are, under the bar; else the wait page says it, with a button."""
        self.signins[account] = {"kind": "failed", "pause": pause}
        self.draw_accounts()
        self.connected(account, False)
        if self.chatlist.chats:
            return False
        self.wait_text.set_text("Нет связи с %s.\nПовторю через %d с."
                                % (self.backend.label(account), pause))
        self.retryb.show()
        if self.stack.get_visible_child_name() != "settings":
            self.stack.set_visible_child_name("wait")
        return False

    def connected(self, account, on):
        """An account's connection is there (on) or lost: the bar says so,
        naming the messenger when there are more than one."""
        (self.down.discard if on else self.down.add)(account)
        text = "Нет связи — переподключаюсь…"
        if self.down and len(self.backend.accounts) > 1 and len(self.down) == 1:
            text = "Нет связи с %s — переподключаюсь…" % self.backend.label(next(iter(self.down)))
        self.offline.get_children()[0].set_text(text)
        self.offline.set_visible(bool(self.down) and self.stack.get_visible_child_name() != "login")
        if on:
            self.retryb.hide()
            self.wait_text.set_text(self.connecting())
            self.retry_unsent()
        return False

    def connecting(self):
        names = " и ".join(self.backend.label(a) for a in self.backend.accounts) or "MAX"
        return "Подключение к %s…" % names

    def retry(self):
        self.retryb.hide()
        self.wait_text.set_text(self.connecting())
        self.backend.retry()

    def show_chats(self, account, summaries):
        """An account's whole list after its login: only the chats that
        differ from the list shown are redrawn (a reconnect changes few)."""
        before = dict(self.chatlist.chats)
        self.chatlist.replace(summaries, account)
        changed = {i for i, s in self.chatlist.chats.items() if before.get(i) != s}
        changed |= set(before) - set(self.chatlist.chats)
        page = self.stack.get_visible_child_name()
        if page in ("wait", "login"):
            self.stack.set_visible_child_name("chats")
        elif page == "settings":
            self.came_from = "chats"
        self.fill_list(only=changed if self.rows else None)
        return False

    def incoming(self, msg, summary):
        if summary:
            was_pending = not self.chatlist.listed(summary["id"]) and self.chatlist.get(summary["id"])
            self.chatlist.update(summary)
            if was_pending and self.open_chat == summary["id"]:
                self.edit.set_visible(self.stack.get_visible_child_name() == "chat")
        if self.chatlist.hidden(msg["chat"]) and self.open_chat != msg["chat"]:
            self.fill_list(only={msg["chat"]})
            return False  # from a stranger: no bubble, no buzz, left unread
        here = self.open_chat == msg["chat"] and self.win.is_visible()
        view = self.views.get(msg["chat"])
        if view:
            view.add(msg)
        if here and not msg["mine"] and self.win.is_active():
            self.backend.run(self.backend.read(msg["chat"], msg["id"]))
            self.chatlist.read(msg["chat"])
        if not msg["mine"] and self.buzz_new and self.chatlist.loud(msg["chat"]) and not (
                here and self.win.is_active()):
            self.notify(msg)
        self.fill_list(only={msg["chat"]})
        return False

    # what the desktop is told: the count on the program's button, new messages
    def badge(self, count):
        """The unread count on the program's button, as a desktop (and the
        Haltia shell) reads it: Unity's LauncherEntry on the session bus. It
        goes by itself when the program leaves the bus."""
        bus = self.get_dbus_connection()
        if bus is None:
            return
        try:
            bus.emit_signal(None, "/" + APP_ID.replace(".", "/"), "com.canonical.Unity.LauncherEntry",
                            "Update", GLib.Variant("(sa{sv})", (
                                "application://%s.desktop" % APP_ID,
                                {"count": GLib.Variant("x", count),
                                 "count-visible": GLib.Variant("b", count > 0)})))
        except GLib.Error:
            pass

    def notify(self, msg):
        """A desktop notification of a new message (the desktop buzzes or
        sounds for it, as set there); a tap opens the chat."""
        title, body = note_text(self.chatlist.get(msg["chat"]) or {}, msg)
        note = Gio.Notification.new(title)
        note.set_body(body)
        note.set_default_action_and_target("app.open-chat", GLib.Variant("s", json.dumps(msg["chat"])))
        self.send_notification("chat-%s" % msg["chat"], note)

    # the list
    def fill_list(self, only=None):
        """Bring the list in line with the summaries. Rows are kept and only
        a chat that changed is redrawn: a new message used to rebuild every
        row, slow on the tablet with a hundred chats. With only (chat ids: a
        message, a read) just those rows are looked at and put in their place
        (row.changed()); else all, sorted and filtered anew (a tab, a pin,
        the login)."""
        ids = set(self.chatlist.chats) | set(self.rows) if only is None else set(only)
        for chat_id in ids:
            entry = self.chatlist.entry(chat_id)
            row = self.rows.get(chat_id)
            if entry is None:
                if row is not None:
                    self.rows.pop(chat_id).destroy()
                continue
            look = self.look(entry)
            if row is None:
                row = self.rows[chat_id] = self.chat_row(entry)
                self.list.add(row)  # sorted and filtered as it goes in
                row.show_all()
            elif row.look != look:
                row.remove(row.get_child())
                row.add(self.chat_row(entry).steal())
                row.show_all()
                row.summary, row.look = entry[0], look
                if only is not None:
                    row.changed()  # its place and tab anew, the others stay
            elif only is not None:
                row.changed()  # pinned or hidden since: placed anew all the same
        if only is None:
            self.list.invalidate_sort()
            self.list.invalidate_filter()
        self.show_counts()

    def show_counts(self):
        """The tabs' counts, the subtitle and the panel's button, each only
        when it changed."""
        counts = self.chatlist.counts()
        sub = None
        if self.open_chat is None and self.stack.get_visible_child_name() == "chats":
            sub = "непрочитанных: %d" % counts["loud"] if counts["loud"] else ""
        now = (counts["chats"], counts["channels"], sub, counts["loud"])
        was = self.counted or (None, None, None, None)
        if now[:2] != was[:2]:
            for b, name, tab in ((self.tab_chats, "Чаты", "chats"),
                                 (self.tab_channels, "Каналы", "channels")):
                # the label's own text: the button's set_label builds a new child (ms on the tablet)
                b.get_child().set_text("%s · %d" % (name, counts[tab]) if counts[tab] else name)
        if sub is not None and sub != self.sub.get_text():
            self.sub.set_text(sub)
        if now[3] != was[3]:
            # The button counts what may buzz: quiet chats (channels by default) are left out.
            self.badge(counts["loud"])
        self.counted = now

    def placed(self, a, b):
        """The ListBox's order of two chats: ChatList's (-1, 0, 1)."""
        ka, kb = self.chatlist.order(a), self.chatlist.order(b)
        return (ka > kb) - (ka < kb)

    def chat_row(self, entry):
        """One chat of a list (an entry of ChatList's): initials, name, last
        message, time, unread."""
        s, pinned, quiet = entry
        row = Gtk.ListBoxRow()
        row.chat_id = s["id"]
        row.summary, row.look = s, self.look(entry)
        row.steal = lambda: (row.remove(box), box)[1]  # the contents, for a kept row
        box = Gtk.Box(spacing=18)
        box.set_margin_start(16)
        box.set_margin_end(16)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.pack_start(avatar(s["title"], s["id"], s.get("photo"), self.media.photo), False, False, 0)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        mid.set_valign(Gtk.Align.CENTER)
        mid.pack_start(label(s["title"], "chat-name", ellipsize=True), False, False, 0)
        mid.pack_start(label(s["last"], "chat-last", ellipsize=True), False, False, 0)
        box.pack_start(mid, True, True, 0)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.set_valign(Gtk.Align.CENTER)
        top = "%s%s%s" % ("📌 " if pinned else "",
                          self.backend.label(s.get("account", "max")) + " · " if self.tagged else "",
                          when(s["time"]))
        right.pack_start(label(top, "chat-time", xalign=1.0), False, False, 0)
        if s["unread"]:
            badge = label(str(s["unread"]), "badge", xalign=0.5)
            if quiet:
                badge.get_style_context().add_class("quiet")
            badge.set_halign(Gtk.Align.END)
            right.pack_start(badge, False, False, 0)
        box.pack_end(right, False, False, 0)
        row.add(box)
        return row

    def on_row(self, _list, row):
        if time.monotonic() - self.held < 1.0:
            return  # the release of a long press: the menu is open
        self.open(row.chat_id)

    # tabs, pinning, notifications
    def look(self, entry):
        """What a row shows: when it changes the row is redrawn."""
        s, pinned, quiet = entry
        return (s["title"], s["last"], s["time"], s["unread"], pinned, quiet, self.tagged, s.get("photo"))

    def retag(self):
        """With more than one messenger switched on, each row says whose its
        chat is (beside its time)."""
        tagged = sum(1 for n in self.backend.names()
                     if messenger_on(n) and not self.backend.missing(n)) > 1
        if tagged != self.tagged:
            self.tagged = tagged
            self.fill_list()

    def show_tab(self, name):
        self.tab = name
        self.fill_list()
        adj = self.list.get_parent().get_vadjustment() if isinstance(
            self.list.get_parent(), Gtk.Scrollable) else None
        if adj:
            adj.set_value(0)

    def row_menu(self, _gesture, _x, y):
        row = self.list.get_row_at_y(int(y))
        if row is None:
            return
        self.held = time.monotonic()
        s = row.summary
        pinned, muted = self.chatlist.is_pinned(s["id"]), self.chatlist.quiet(s["id"])
        self.popup_menu(row, [
            ("📌 Открепить" if pinned else "📌 Закрепить сверху", lambda: self.toggle_pin(s)),
            ("🔔 Включить оповещения" if muted else "🔕 Без оповещений",
             lambda: self.toggle_mute(s))])

    def toggle_pin(self, s):
        self.chatlist.pin(s["id"])
        self.fill_list()

    def toggle_mute(self, s):
        self.chatlist.mute(s["id"])
        self.fill_list()

    def keep_draft(self):
        """The open chat's unsent words and files kept with it, and the entry
        emptied: a draft belongs to its chat, never goes with a message in
        another (a photo shared into one chat went with the next anywhere)."""
        if self.open_chat is None:
            return
        text, files = self.entry.get_text(), list(self.attached)
        if text.strip() or files:
            self.drafts[self.open_chat] = {"text": text, "attached": files}
        else:
            self.drafts.pop(self.open_chat, None)
        self.entry.set_text("")
        self.attached = []
        self.show_attached()

    def show_list(self):
        self.keep_draft()
        self.open_chat = None
        self.back.hide()
        self.title.set_text(NAME)
        self.stack.set_visible_child_name("chats")
        # Back to the list, the most common tap: only the rows that changed
        # meanwhile are placed anew, not all of them sorted and filtered again.
        self.fill_list(only=self.stale_rows())

    def stale_rows(self):
        """The chats whose row differs from what it shows, is missing or
        is left over."""
        stale = set(self.rows) - set(self.chatlist.chats)
        for chat_id in self.chatlist.chats:
            row, entry = self.rows.get(chat_id), self.chatlist.entry(chat_id)
            if row is None or entry is not None and row.look != self.look(entry):
                stale.add(chat_id)
        return stale

    # the search: a person by phone, a channel or group by link, own chats by name
    def show_find(self):
        self.keep_draft()
        self.open_chat = None
        # Here one also writes to someone new: by their number.
        self.title.set_text("Найти или написать")
        self.sub.set_text("")
        self.back.show()
        self.find_hint.set_text(FIND_HINT)
        self.stack.set_visible_child_name("find")
        self.find_entry.grab_focus()

    def find_soon(self):
        """Own chats looked through FIND_PAUSE after the last letter: not at
        every key, which made the keyboard lag on the tablet."""
        if self.find_timer is not None:
            GLib.source_remove(self.find_timer)
        self.find_timer = GLib.timeout_add(FIND_PAUSE, self._find_now)

    def _find_now(self):
        self.find_timer = None
        self.find_own()
        return False

    def find_own(self):
        """As one types: own chats whose name has it, at once; the rest
        (a person by number, channels everywhere) waits for «Найти»."""
        text = self.find_entry.get_text().strip()
        for child in self.found.get_children():
            child.destroy()
        if not text:
            self.find_hint.set_text(FIND_HINT)
            return
        if phone_of(text) or link_of(text):
            self.find_hint.set_text("Нажмите «Найти», чтобы написать человеку." if phone_of(text)
                                    else "Нажмите «Найти».")
            return
        hits = self.chatlist.find(text)
        self.find_hint.set_text("Нажмите «Найти», чтобы искать каналы и группы." if hits else
                                "Среди ваших чатов такого нет. Нажмите «Найти», чтобы искать везде.")
        if hits:
            self.show_own_hits(hits)
        self.found.show_all()

    def show_own_hits(self, hits):
        box = Gtk.ListBox()
        box.set_selection_mode(Gtk.SelectionMode.NONE)
        box.connect("row-activated", self.on_row)
        for c in hits:
            box.add(self.chat_row((c, self.chatlist.is_pinned(c["id"]),
                                   self.chatlist.quiet(c["id"]))))
        self.found.pack_start(box, False, False, 0)

    def find(self):
        text = self.find_entry.get_text().strip()
        for child in self.found.get_children():
            child.destroy()
        if not text:
            return
        phone, link = phone_of(text), link_of(text)
        if phone:
            self.find_hint.set_text("Ищу %s…" % phone)

            def person(found, err):
                if self.find_entry.get_text().strip() != text:
                    return  # asked something else meanwhile
                if err or not found:
                    self.find_hint.set_text("С номером %s никого не нашлось." % phone)
                    return
                self.find_hint.set_text("")
                for p in found:
                    self.show_person(p)

            self.backend.run(self.backend.find_phone(phone), person)
        elif link:
            self.find_hint.set_text("Открываю ссылку…")

            def chat(info, err):
                if self.find_entry.get_text().strip() != text:
                    return
                if err or not info:
                    # MAX told nothing about the link; joining may still work.
                    self.find_hint.set_text("Сведений по ссылке нет, но вступить можно попробовать.")
                    info = {"id": 0, "title": link.split("/", 3)[3], "type": "",
                            "members": 0, "joined": False}
                else:
                    self.find_hint.set_text("")
                self.show_found_chat(info, link)

            self.backend.run(self.backend.link_info(link), chat)
        else:
            hits = self.chatlist.find(text)
            if hits:
                self.show_own_hits(hits)
            # and channels and groups of everyone, by MAX's (Telegram's) own search
            self.find_hint.set_text("Ищу каналы и группы…")

            def public(found, err):
                if self.find_entry.get_text().strip() != text:
                    return  # asked something else meanwhile
                found = [f for f in found or [] if not self.chatlist.listed(f["id"])]
                if found:
                    self.find_hint.set_text("")
                    self.found.pack_start(label("Каналы и группы", "big"), False, False, 0)
                    for info in found:
                        self.show_found_chat(info, info["link"])
                elif hits:
                    self.find_hint.set_text("")
                else:
                    self.find_hint.set_text("Среди ваших чатов такого нет." if err else
                                            "Ничего не нашлось.")
                self.found.show_all()

            self.backend.run(self.backend.search(text), public)
        self.found.show_all()

    def found_card(self, title, about, key):
        """A card of a search result; its buttons go in the returned box."""
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.get_style_context().add_class("settings")
        top = Gtk.Box(spacing=18)
        top.pack_start(initials_icon(title, key), False, False, 0)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        mid.set_valign(Gtk.Align.CENTER)
        mid.pack_start(label(title, "chat-name", ellipsize=True), False, False, 0)
        mid.pack_start(label(about, "chat-last", ellipsize=True), False, False, 0)
        top.pack_start(mid, True, True, 0)
        card.pack_start(top, False, False, 0)
        buttons = Gtk.Box(spacing=12)
        card.pack_start(buttons, False, False, 0)
        self.found.pack_start(card, False, False, 0)
        return buttons

    def action(self, box, text, cls, clicked):
        b = Gtk.Button(label=text)
        b.get_style_context().add_class(cls)
        b.connect("clicked", clicked)
        box.pack_start(b, False, False, 0)
        return b

    def show_person(self, p):
        about = self.find_entry.get_text().strip()
        if self.tagged:
            about += " · " + p.get("label", "")
        buttons = self.found_card(p["name"], about, p["id"])
        if p["chat"] is not None:
            self.action(buttons, "Написать", "act", lambda _b: self.write_to(p))

        def add(btn):
            btn.set_sensitive(False)

            def done(_res, err):
                btn.set_label("Не удалось, ещё раз" if err else "В контактах")
                btn.set_sensitive(bool(err))
                if not err:
                    self.chatlist.known(p["id"])
                    self.fill_list()

            self.backend.run(self.backend.add_contact(p["id"]), done)

        self.action(buttons, "В контакты", "plain", add)
        self.found.show_all()

    def write_to(self, p):
        self.chatlist.start_dialog({"id": p["chat"], "title": p["name"], "type": "DIALOG",
                                    "account": p.get("account", "max"),
                                    "last": "", "time": 0, "unread": 0})
        self.open(p["chat"])

    def show_found_chat(self, info, link):
        channel = info["type"] == "CHANNEL"
        n = info["members"]
        about = ("канал" if channel else "группа" if info["type"] else "ссылка") + (
            " · %s: %d" % ("подписчиков" if channel else "участников", n) if n else "") + (
            " · " + info["label"] if self.tagged and info.get("label") else "")
        buttons = self.found_card(info["title"], about, info["id"] or 0)
        if info["joined"] and self.chatlist.listed(info["id"]):
            self.action(buttons, "Открыть", "act", lambda _b: self.open(info["id"]))
        else:
            def join(btn):
                btn.set_sensitive(False)

                def done(summary, err):
                    if err or not summary:
                        btn.set_label("Не удалось, ещё раз")
                        btn.set_sensitive(True)
                        return
                    self.chatlist.update(summary)
                    self.fill_list()
                    self.open(summary["id"])

                self.backend.run(self.backend.join(link), done)

            self.action(buttons, "Подписаться" if channel else "Вступить", "act", join)
        self.found.show_all()

    # a photo, large
    def show_photo(self, url):
        self.viewer_pix = None
        self.viewer_url = url
        self.viewer_zoom = 1
        # Said once, a while: how to look closer, how to go back.
        self.viewer_note.set_text("Дважды коснитесь — крупнее. Назад — «←»")
        self.viewer_note.show()
        GLib.timeout_add_seconds(4, lambda: (
            self.viewer_note.get_text().startswith("Дважды") and self.viewer_note.hide()) and False)
        self.viewer_image.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
        # Within the window, under its header (back, «Фото», save): not
        # full screen, where the shell's ✕ would cover the corner.
        self.title.set_text("Фото")
        self.back.show()
        self.stack.set_visible_child_name("photo")

        def loaded(pix):
            # Only the photo asked last: an earlier one coming late is not shown
            # (and «Сохранить» would save another than seen).
            if self.viewer_url == url and self.stack.get_visible_child_name() == "photo" \
                    and pix is not None:
                self.viewer_pix = pix
                self.fit_photo()

        self.media.photo(url, loaded, size=2048)

    def fit_photo(self):
        """The photo as large as the window lets it (twice that when zoomed),
        its shape kept."""
        pix = self.viewer_pix
        alloc = self.viewer_scroll.get_allocation()
        if pix is None or alloc.width < 2 or alloc.height < 2:
            return
        k = min(alloc.width / pix.get_width(), alloc.height / pix.get_height()) * self.viewer_zoom
        w, h = max(1, int(pix.get_width() * k)), max(1, int(pix.get_height() * k))
        current = self.viewer_image.get_pixbuf()
        if current is None or (current.get_width(), current.get_height()) != (w, h):
            self.viewer_image.set_from_pixbuf(pix.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR))

    def save_viewed(self):
        """The photo shown, kept on the tablet."""
        url = self.viewer_url
        if not url:
            return
        name = "фото-%s.jpg" % hashlib.sha1(url.encode()).hexdigest()[:10]
        where_to = self.target(load_text("folder", default_folder()), name)
        if where_to is None:
            return
        into, name, replace = where_to
        self.viewer_note.set_text("сохраняю…")
        self.viewer_note.show()
        self.set_busy(self.viewer_save, True)

        def done(path):
            self.set_busy(self.viewer_save, False)
            self.viewer_note.set_text("сохранено: %s" % os.path.basename(path) if path
                                      else "не удалось сохранить")

        self.media.save(url, into, name, done, replace)

    def zoom_photo(self, x, y):
        """Twice as large where it was tapped, or back to the whole photo."""
        if self.viewer_pix is None:
            return
        self.viewer_zoom = 2 if self.viewer_zoom == 1 else 1
        self.fit_photo()
        if self.viewer_zoom == 2:
            def there():
                for adj, at in ((self.viewer_scroll.get_hadjustment(), x),
                                (self.viewer_scroll.get_vadjustment(), y)):
                    adj.set_value(at * 2 - adj.get_page_size() / 2)
                return False
            GLib.idle_add(there)

    def close_photo(self):
        if self.stack.get_visible_child_name() != "photo":
            return
        self.viewer_zoom = 1
        self.viewer_pix = None
        self.viewer_image.clear()
        self.title.set_text((self.chatlist.get(self.open_chat) or {}).get("title", ""))
        self.stack.set_visible_child_name("chat")

    # forwarding a message
    def show_forward(self, chat_id, msg_id):
        self.forwarding = (chat_id, msg_id)
        self.sharing = None
        self.share_bar.hide()
        self.title.set_text("Переслать")
        self.sub.set_text("")
        self.fwd_entry.set_placeholder_text("Кому переслать")
        self.fwd_entry.set_text("")
        self.fill_forward()
        self.stack.set_visible_child_name("forward")

    def do_open(self, files, _n, _hint):
        """Files another program sent (haltia_kit.share launches the program
        with them; a second launch hands them over): «Кому отправить?»."""
        paths = [p for p in (share_ok(f.get_path()) for f in files if f.get_path()) if p]
        if len(paths) < len([f for f in files if f.get_path()]):
            log_line("share: a file refused")
        self.activate()
        if paths:
            self.show_share(paths)

    def show_share(self, paths):
        """Choose the chat for files sent from another program; the chat
        opens with them attached, sent by the usual «Отправить»."""
        self.forwarding = None
        self.sharing = list(paths)
        self.share_note.set_text("📎 " + ", ".join(os.path.basename(p) for p in paths))
        self.share_bar.show()
        self.share_at = time.monotonic()
        log_line("share: %d file(s), choosing a chat" % len(paths))
        self.title.set_text("Кому отправить?")
        self.sub.set_text("")
        self.back.show()
        self.fwd_entry.set_placeholder_text("Найти чат")
        self.fwd_entry.set_text("")
        self.fill_forward()
        self.stack.set_visible_child_name("forward")
        self.win.present()

    def fill_forward(self):
        """The chats a message can go to: dialogs and groups, the newest
        first (channels take only their owners' posts); built when the page
        opens, and the search only filters them (search_forward)."""
        for child in self.fwd_list.get_children():
            child.destroy()
        self.fwd_found = None
        # A message within its messenger (between messengers: not yet); a
        # file from another program to any.
        source = (self.chatlist.get(self.forwarding[0]) or {}).get("account", "max") \
            if self.forwarding else None
        for c, _pinned, _quiet in self.chatlist.entries("chats"):
            if c.get("type") != "CHANNEL" and source in (None, c.get("account", "max")):
                self.fwd_list.add(self.chat_row((c, False, False)))
        self.fwd_list.show_all()
        self.search_forward()

    def search_forward(self):
        text = self.fwd_entry.get_text().strip()
        self.fwd_found = {c["id"] for c in self.chatlist.find(text)} if text else None
        self.fwd_list.invalidate_filter()

    def forward_to(self, target):
        if self.sharing:
            if time.monotonic() - self.share_at < SHARE_SETTLE:
                # The touch that launched this (in another program) is no
                # choice: a row under it right away is not taken.
                log_line("share: a chat chosen at once, not taken")
                return
            log_line("share: a chat chosen")
            paths, self.sharing = self.sharing, None
            self.share_bar.hide()
            self.open(target)
            # Copied into a folder of the messenger's own first, by a thread (a
            # video is big): what is sent is what was chosen, whatever the sender
            # does with its file meanwhile. Then a draft, sent by «Отправить».
            def copy():
                folder = os.path.join(SHARED, "%d" % int(time.time() * 1000))
                copies = []
                try:
                    old = [e.path for e in os.scandir(SHARED)] if os.path.isdir(SHARED) else []
                    for gone in old:  # what was shared before is sent or dropped by now
                        if time.time() - os.stat(gone).st_mtime > 86400:
                            shutil.rmtree(gone, ignore_errors=True)
                    os.makedirs(folder, mode=0o700, exist_ok=True)
                    for path in paths:
                        copy = os.path.join(folder, safe_name(os.path.basename(path)))
                        shutil.copyfile(path, copy)
                        copies.append(copy)
                except OSError as exc:
                    log_line("share copy: %r" % exc)
                GLib.idle_add(lambda: attach(copies) and False)

            def attach(copies):
                if self.open_chat != target:
                    return  # left meanwhile
                for path in copies:
                    if not any(f["path"] == path for f in self.attached):
                        # from another program: goes by «Отправить» only
                        self.attached.append(dict(attachment(path), shared=True))
                self.show_attached()
                if len(copies) < len(paths):
                    self.sub.set_text("не все файлы удалось взять")
            threading.Thread(target=copy, daemon=True).start()
            return
        if not self.forwarding:
            return
        source, msg_id = self.forwarding
        title = (self.chatlist.get(target) or {}).get("title", "")
        if not self.ask("Переслать сообщение в «%s»?" % title, "Переслать"):
            return  # still choosing
        self.end_forward()
        self.sub.set_text("пересылаю…")

        def done(res, err):
            if err or not res:
                self.sub.set_text("не удалось переслать")
                return
            out, summary = res
            if summary:
                self.chatlist.update(summary)
                self.fill_list(only={summary["id"]})
            view = self.views.get(target)
            if view:
                view.add(out)
            if self.open_chat == source and self.stack.get_visible_child_name() == "chat":
                self.open(target)  # to the chat it went to, as MAX's app does
                self.sub.set_text("переслано сюда")

        self.backend.run(self.backend.forward(target, msg_id, source), done)

    def end_forward(self):
        """Back from choosing where to forward (or where to send files from
        another program: they are dropped): to the chat it came from."""
        self.forwarding = None
        self.sharing = None
        self.share_bar.hide()
        if self.open_chat is None:  # files from another program, chosen from the list
            self.show_list()
            return
        s = self.chatlist.get(self.open_chat) or {}
        self.title.set_text(s.get("title", ""))
        self.stack.set_visible_child_name("chat" if self.open_chat is not None else "chats")

    # saving what a message carries
    @staticmethod
    def set_busy(button, busy):
        """A button that cannot be pressed again, a spinner in its icon's
        place, until what it started is done."""
        if button is None:
            return
        if busy:
            button.icon = button.get_image()
            spin = Gtk.Spinner()
            spin.start()
            button.set_image(spin)
            spin.show()
        elif getattr(button, "icon", None) is not None:
            button.set_image(button.icon)
            button.icon = None
        button.set_sensitive(not busy)

    def ask_save_path(self, folder, name):
        """The save dialog, when the name is taken already: the folder and
        the name set, another of either chosen; replacing asks first. The
        path, or None if cancelled. FileChooserNative: the file chooser
        portal inside Flatpak and under KDE, GTK's own dialog elsewhere."""
        dialog = Gtk.FileChooserNative.new("Сохранить как", self.win,
                                           Gtk.FileChooserAction.SAVE, "Сохранить", "Отмена")
        dialog.set_do_overwrite_confirmation(True)
        dialog.set_current_folder(folder)
        dialog.set_current_name(name)
        # GTK's dialog focuses the name on show, which brings up the on-screen
        # keyboard over the file list; the name is usually fine (it is only
        # taken), so Сохранить has the focus, and the keyboard comes when the
        # name is tapped. A portal's dialog is the desktop's own: left alone.
        GLib.idle_add(focus_accept, self.win)
        path = dialog.get_filename() if self.run_chooser(dialog) == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        return path

    def ask_taken(self, folder, name):
        """The name is taken in the folder: "replace" it, save a "copy"
        beside it (numbered), or choose an"other" name or folder; None if
        cancelled."""
        n = dialogs.choose(self.win, "В папке «%s» уже есть файл «%s». Что сделать?"
                           % (os.path.basename(folder.rstrip("/")) or folder, name),
                           ["Заменить его", "Сохранить рядом копию",
                            "Выбрать другое имя или папку…"])
        return None if n is None else ("replace", "copy", "other")[n]

    def target(self, folder, name):
        """Where a file goes: (folder, name, replace), or None if the person
        cancelled. A free name goes as it is (asked first, with confirmations
        on); for a taken one the person is asked what to do (ask_taken), and
        the save dialog opens for another name or folder."""
        name = safe_name(name)
        if not os.path.exists(os.path.join(folder, name)):
            if not self.ask("Сохранить «%s» в папку «%s»?" % (name, folder), "Сохранить"):
                return None
            return folder, name, False
        what = self.ask_taken(folder, name)
        if what in ("replace", "copy"):
            return folder, name, what == "replace"
        if what is None:
            return None
        path = self.ask_save_path(folder, name)
        if not path:
            return None
        return os.path.dirname(path), os.path.basename(path), os.path.exists(path)

    def save_message(self, chat_id, m, items=None, button=None):
        """Every photo and file of a message (or only the items given) into
        the folder set in the settings; any kind of file, not only media.
        A name taken there opens the save dialog. The link of a video or a
        file is asked of MAX first; the button stays busy till it is all done."""
        folder = load_text("folder", default_folder())
        jobs = [] if items else \
            [(url, "фото-%s-%d.jpg" % (m["id"], n + 1)) for n, url in enumerate(m["photos"])]
        for item in items or m.get("media") or []:
            if item["kind"] == "photo":
                jobs.append((item["url"], "фото-%s-%d.jpg" % (m["id"], item.get("n", 1))))
            elif item["kind"] == "audio" and item["url"]:  # a voice message (Telegram's audio file)
                ext = os.path.splitext(urllib.parse.urlsplit(item["url"]).path)[1] or ".ogg"
                jobs.append((item["url"], item.get("name") or "голосовое-%s%s" % (m["id"], ext)))
            elif item["kind"] == "audio":  # an audio file
                jobs.append(({"kind": "file", "id": item["file"]}, item["name"]))
            elif item["kind"] == "video":
                jobs.append((item, "видео-%s.mp4" % m["id"]))
            else:
                jobs.append((item, item["name"]))
        chosen = []
        for what, name in jobs:
            where_to = self.target(folder, name)
            if where_to is not None:
                chosen.append((what,) + where_to)
        if not chosen:
            if jobs:
                self.sub.set_text("не сохранено")
            return
        jobs = chosen
        state = {"left": len(jobs), "saved": [], "failed": 0}
        self.sub.set_text("сохраняю…")
        self.set_busy(button, True)

        def one(path):
            state["left"] -= 1
            if path:
                state["saved"].append(os.path.basename(path))
            else:
                state["failed"] += 1
            if state["left"]:
                return
            self.set_busy(button, False)
            if state["failed"]:
                self.sub.set_text("не удалось сохранить: %d из %d" % (state["failed"], len(jobs)))
            elif len(state["saved"]) == 1:
                self.sub.set_text("сохранено: %s" % state["saved"][0])
            else:
                self.sub.set_text("сохранено файлов: %d" % len(state["saved"]))

        for what, into, name, replace in jobs:
            if isinstance(what, str):
                self.media.save(what, into, name, one, replace)
            else:
                def linked(url, err, into=into, name=name, replace=replace):
                    if err or not url:
                        one(None)
                    else:
                        self.media.save(url, into, name, one, replace)
                self.backend.run(self.backend.media_url(chat_id, m["id"], what), linked)


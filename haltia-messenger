def telegram_keys():
    """(api_id, api_hash) of Telegram's API: [telegram] in messenger.conf,
    else this program's own; None if there are none."""
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(SETTINGS.path, encoding="utf-8")
        api_id = int(conf.get("telegram", "api_id", fallback=0) or 0)
    except (configparser.Error, UnicodeDecodeError, ValueError):
        api_id = 0
    api_hash = conf.get("telegram", "api_hash", fallback="") if api_id else ""
    if not (api_id and api_hash):
        api_id, api_hash = TG_API_ID, TG_API_HASH
    return (api_id, api_hash) if api_id and api_hash else None



        """The header's «Позвонить» and «Видеозвонок», each only while its
        kind of call is switched on in the settings."""
        dialog = (shown and summary.get("type") == "DIALOG" and isinstance(chat_id, int)
                  and summary.get("peer") is not None and self.backend.can("calls", chat_id))
        self.call_button.set_visible(dialog and calls_allowed(False))

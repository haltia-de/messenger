MPRIS_NAME = "org.mpris.MediaPlayer2." + APP_ID
MPRIS_PATH = "/org/mpris/MediaPlayer2"
MPRIS_XML = """<node>
  <interface name="org.mpris.MediaPlayer2">
    <method name="Raise"/>
    <method name="Quit"/>
    <property name="CanQuit" type="b" access="read"/>
    <property name="CanRaise" type="b" access="read"/>
    <property name="HasTrackList" type="b" access="read"/>
    <property name="Identity" type="s" access="read"/>
    <property name="DesktopEntry" type="s" access="read"/>
    <property name="SupportedUriSchemes" type="as" access="read"/>
    <property name="SupportedMimeTypes" type="as" access="read"/>
  </interface>
  <interface name="org.mpris.MediaPlayer2.Player">
    <method name="Next"/>
    <method name="Previous"/>
    <method name="Pause"/>
    <method name="PlayPause"/>
    <method name="Stop"/>
    <method name="Play"/>
    <method name="Seek"><arg direction="in" name="Offset" type="x"/></method>
    <method name="SetPosition">
      <arg direction="in" name="TrackId" type="o"/>
      <arg direction="in" name="Position" type="x"/>
    </method>
    <method name="OpenUri"><arg direction="in" name="Uri" type="s"/></method>
    <signal name="Seeked"><arg name="Position" type="x"/></signal>
    <property name="PlaybackStatus" type="s" access="read"/>
    <property name="Rate" type="d" access="read"/>
    <property name="Metadata" type="a{sv}" access="read"/>
    <property name="Volume" type="d" access="read"/>
    <property name="Position" type="x" access="read"/>
    <property name="MinimumRate" type="d" access="read"/>
    <property name="MaximumRate" type="d" access="read"/>
    <property name="CanGoNext" type="b" access="read"/>
    <property name="CanGoPrevious" type="b" access="read"/>
    <property name="CanPlay" type="b" access="read"/>
    <property name="CanPause" type="b" access="read"/>
    <property name="CanSeek" type="b" access="read"/>
    <property name="CanControl" type="b" access="read"/>
  </interface>
</node>"""


class Mpris:
    """What plays (a voice message, an audio file), told to the desktop by
    MPRIS on the session bus, as players do: the Haltia shell shows it on the
    program's button, GNOME and KDE in their player widgets; they can pause,
    go on, stop it, or raise the window at its message. Stopped when nothing
    plays. changed() after every change of what plays."""

    def __init__(self, app):
        self.app = app
        self.bus = app.get_dbus_connection()
        self.ids = []
        if self.bus is None:
            return
        node = Gio.DBusNodeInfo.new_for_xml(MPRIS_XML)
        for iface in node.interfaces:
            self.ids.append(self.bus.register_object(
                MPRIS_PATH, iface, self._call, self._get, None))
        self.owner = Gio.bus_own_name_on_connection(self.bus, MPRIS_NAME,
                                                     Gio.BusNameOwnerFlags.NONE, None, None)

    # what it is
    def status(self):
        app = self.app
        if not app.playing:
            return "Stopped"
        return "Playing" if getattr(app.playing[1], "state", "") == "pause" else "Paused"

    def metadata(self):
        app = self.app
        if not app.playing:
            return {"mpris:trackid": GLib.Variant("o", "/org/mpris/MediaPlayer2/TrackList/NoTrack")}
        item = app.playing[4]
        chat = (app.chatlist.get(app.playing_chat) or {}).get("title", "MAX")
        meta = {"mpris:trackid": GLib.Variant("o", "/" + APP_ID.replace(".", "/") + "/track/%d"
                                              % abs(int(app.playing_msg or 0))),
                "xesam:title": GLib.Variant("s", item.get("name") or "Голосовое сообщение"),
                "xesam:artist": GLib.Variant("as", [chat]),
                "xesam:album": GLib.Variant("s", chat)}
        if app.playing[3]:
            meta["mpris:length"] = GLib.Variant("x", int(app.playing[3] * 1000000))
        return meta

    def _get(self, _bus, _sender, _path, iface, name):
        app = self.app
        playing = bool(app.playing)
        values = {
            "CanQuit": GLib.Variant("b", False), "CanRaise": GLib.Variant("b", True),
            "HasTrackList": GLib.Variant("b", False), "Identity": GLib.Variant("s", NAME),
            "DesktopEntry": GLib.Variant("s", APP_ID),
            "SupportedUriSchemes": GLib.Variant("as", []),
            "SupportedMimeTypes": GLib.Variant("as", []),
            "PlaybackStatus": GLib.Variant("s", self.status()),
            "Rate": GLib.Variant("d", 1.0), "MinimumRate": GLib.Variant("d", 1.0),
            "MaximumRate": GLib.Variant("d", 1.0), "Volume": GLib.Variant("d", 1.0),
            "Metadata": GLib.Variant("a{sv}", self.metadata()),
            "Position": GLib.Variant("x", int((app.playing_pos if playing else 0) * 1000000)),
            "CanGoNext": GLib.Variant("b", False), "CanGoPrevious": GLib.Variant("b", False),
            "CanPlay": GLib.Variant("b", playing), "CanPause": GLib.Variant("b", playing),
            "CanSeek": GLib.Variant("b", False), "CanControl": GLib.Variant("b", True)}
        return values.get(name)

    def _call(self, _bus, _sender, _path, iface, method, _params, invocation):
        app = self.app
        status = self.status()
        if method == "Raise":
            app.win.present()
            app.go_to_playing()
        elif method == "PlayPause" and status != "Stopped":
            app.toggle_sound()
        elif method == "Pause" and status == "Playing":
            app.toggle_sound()
        elif method == "Play" and status == "Paused":
            app.toggle_sound()
        elif method == "Stop":
            app.stop_sound()
        invocation.return_value(None)

    def changed(self):
        """Tell the desktop what plays now."""
        if self.bus is None:
            return
        props = {"PlaybackStatus": GLib.Variant("s", self.status()),
                 "Metadata": GLib.Variant("a{sv}", self.metadata()),
                 "CanPlay": GLib.Variant("b", bool(self.app.playing)),
                 "CanPause": GLib.Variant("b", bool(self.app.playing))}
        try:
            self.bus.emit_signal(None, MPRIS_PATH, "org.freedesktop.DBus.Properties",
                                 "PropertiesChanged", GLib.Variant(
                                     "(sa{sv}as)", ("org.mpris.MediaPlayer2.Player", props, [])))
        except GLib.Error:
            pass



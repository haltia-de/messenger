def set_switch(button, what, on):
    """A call's microphone, camera or full-screen button as a round switch
    showing its state by its picture alone, as on a phone: the icon crossed
    when off, blue when on, the microphone off red, as it matters. Its state
    in words is its tooltip and its accessible name."""
    icon, state, action = SWITCHES[what][0 if on else 1]
    if button.get_child() is not None:
        button.remove(button.get_child())
    image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
    image.set_pixel_size(48)
    button.add(image)
    image.show()
    button.set_tooltip_text("%s — %s" % (state, action))
    button.get_accessible().set_name(state)
    style = button.get_style_context()
    (style.add_class if on else style.remove_class)("on")
    (style.add_class if not on and what == "mic" else style.remove_class)("alert")
    button.state_text, button.on = state, on  # for the tests


def phone_of(text):
    """A phone number as MAX looks it up (+7…), or None if this is not one."""
    if not re.fullmatch(r"\+?[\d\s()-]+", text):
        return None
    digits = re.sub(r"\D", "", text)
    if len(digits) == 10:
        digits = "7" + digits
    elif len(digits) == 11 and digits[0] == "8":
        digits = "7" + digits[1:]
    return "+" + digits if 11 <= len(digits) <= 15 else None


def link_of(text):
    """A link to a channel or group: MAX's (max.ru/name, max.ru/join/…,
    @name) as https://max.ru/…, Telegram's (t.me/name, t.me/+…) as
    https://t.me/…; else None."""
    text = text.strip()
    if re.fullmatch(r"@[\w.]+", text):
        return "https://max.ru/" + text[1:]
    m = re.fullmatch(r"(?:https?://)?(?:web\.)?max\.ru/([\w./-]+)", text, re.I)
    if m:
        return "https://max.ru/" + m.group(1).strip("/")
    m = re.fullmatch(r"(?:https?://)?(?:t|telegram)\.me/([\w+./-]+)", text, re.I)
    return "https://t.me/" + m.group(1).strip("/") if m else None


def reactions_of(info):
    """[[emoji, count], ...] and the account's own emoji, from a ReactionInfo."""
    if not info:
        return [], None
    return ([[c.reaction, c.count] for c in info.counters or [] if c.count],
            info.your_reaction)


def user_name(user):
    for n in getattr(user, "names", None) or []:
        full = getattr(n, "name", None) or " ".join(
            x for x in (getattr(n, "first_name", None), getattr(n, "last_name", None)) if x)
        if full:
            return full
    return "Пользователь %s" % getattr(user, "id", "")


# Files sent as photos, by their name (MAX takes these as photos); others go as files.
PHOTO_FILES = (".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp")
PHOTO_TYPES = ("image/jpeg", "image/png", "image/gif", "image/webp", "image/bmp")


def attachment(path):
    """A file to be sent, as the links take it: a photo or a file."""
    name = os.path.basename(path)
    kind_ = "photo" if name.lower().endswith(PHOTO_FILES) else "file"
    return {"kind": kind_, "path": path, "name": name}


def attachment_words(files):
    """The attachments in words, for the list's preview of what was sent."""
    words = {"photo": "фото", "voice": "голосовое сообщение"}
    return ", ".join(words.get(f["kind"], "файл «%s»" % f.get("name", "")) for f in files).capitalize()


# Files played in the bubble like voice messages, by their name.
AUDIO_FILES = (".mp3", ".m4a", ".aac", ".ogg", ".oga", ".opus", ".wav", ".flac")


def media_of(a):
    """What can be played or opened of an attachment, or None. An audio file
    is played in the bubble too: its link (url None here) is asked of MAX
    when played, as for any file."""
    t = kind(getattr(a, "type", ""))
    if t == "AUDIO" and getattr(a, "url", None):
        return {"kind": "audio", "url": a.url, "duration": a.duration or 0}
    if t == "FILE" and (a.name or "").lower().endswith(AUDIO_FILES):
        return {"kind": "audio", "url": None, "file": a.file_id, "name": a.name,
                "size": a.size, "duration": 0}
    if t == "VIDEO":
        return {"kind": "video", "id": a.video_id, "thumb": a.thumbnail,
                "duration": a.duration or 0}
    if t == "FILE":
        return {"kind": "file", "id": a.file_id, "name": a.name, "size": a.size}
    return None


def attach_summary(a):
    """(what, photo url or None) for one attachment."""
    t = kind(getattr(a, "type", ""))
    if t == "PHOTO":
        return "", getattr(a, "base_url", None)
    names = {"VIDEO": "видео", "AUDIO": "голосовое сообщение", "FILE": "файл",
             "STICKER": "стикер", "CONTACT": "контакт", "POLL": "опрос", "CALL": "звонок",
             "SHARE": "ссылка"}
    if t == "FILE" and getattr(a, "name", None):
        return "файл «%s»" % a.name, None
    return names.get(t, ""), None


def call_words(call, mine):
    """(what, how) of a call in the history: «Входящий звонок», «Принят ·
    1:05» — or «Пропущен», «Отклонён», «Отменён», «Без ответа»."""
    title = "%s %s" % ("Исходящий" if mine else "Входящий", "видеозвонок" if call.get("video") else "звонок")
    end, ms = call.get("end"), int(call.get("duration") or 0)
    if ms > 0:
        how = "Принят · %s" % mmss(ms // 1000)
    elif end == "REJECTED":
        how = "Отклонён"
    elif end == "MISSED" and mine:
        how = "Без ответа"
    elif mine:
        how = "Отменён"
    else:
        how = "Пропущен"  # missed, or cancelled by the caller before an answer
    return title, how


def max_message(msg):
    """A PyMax Message as the link's own; a forwarded one shows the original
    (its text and attachments, carried inside its link), fwd saying whence."""
    shown, fwd = msg, None
    link = getattr(msg, "link", None)
    if link is not None and kind(getattr(link, "type", "")) == "FORWARD" and link.message:
        shown = link.message
        fwd = {"chat": link.chat_name, "sender": shown.sender}
    out = Message(msg.id, msg.chat_id, msg.sender, msg.time, shown_text(shown.text), fwd=fwd)
    if link is not None and kind(getattr(link, "type", "")) == "REPLY" and getattr(link, "message", None):
        quoted = link.message
        words = shown_text(quoted.text) or ", ".join(
            attach_summary(a)[0] or "фото" for a in quoted.attaches or []).capitalize()
        out.reply = {"id": quoted.id, "sender": quoted.sender, "text": words}
    for a in shown.attaches or []:
        if kind(getattr(a, "type", "")) == "CALL":
            out.call = {"video": kind(getattr(a, "call_type", "")) == "VIDEO",
                        "end": kind(getattr(a, "hangup_type", "")),
                        "duration": int(getattr(a, "duration", 0) or 0)}
            out.parts.append("звонок")
            continue
        what, url = attach_summary(a)
        item = media_of(a)
        out.parts.append(what)
        if url:
            out.photos.append(url)
        elif item:
            out.media.append(item)
        elif what:
            out.notes.append(what)
    out.reactions, out.yours = reactions_of(msg.reaction_info)
    return out


def max_chat(c, me=None):
    """A PyMax Chat as the link's own. Its participants are {id: read mark}:
    the others' newest mark is how far they have read (seen, a time)."""
    members = list(c.participants or {})
    seen = max((int(v or 0) for uid, v in (c.participants or {}).items() if uid != me),
               default=0) if me is not None else 0
    return Chat(c.id, kind(c.type), c.title or None, members,
                c.participants_count or len(members), c.new_messages or 0,
                max_message(c.last_message) if c.last_message else None, c.last_event_time or 0,
                seen=seen, photo=getattr(c, "base_icon_url", None) or None)


def max_person(user):
    return Person(user.id, user_name(user), getattr(user, "base_url", None))



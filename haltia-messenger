def forward_payload(chat_id, msg_id, from_chat_id, cid):
    """MSG_SEND for forwarding a message, as MAX's web client sends it: the
    original's id a number."""
    return {"chatId": chat_id, "notify": True,
            "message": {"cid": cid, "attaches": [],
                        "link": {"type": "FORWARD", "messageId": int(msg_id),
                                 "chatId": from_chat_id}}}


class VaultStore:
    """PyMax's session store (its StoreProtocol) in the Vault: the session,
    as JSON, under the account's name. Vault's calls are blocking (a locked
    keyring asks the desktop to unlock it): they go to a thread."""

    def __init__(self, vault, name):
        self.vault, self.name = vault, name

    async def load_session(self):
        from pymax.session.models import SessionInfo

        text = await asyncio.to_thread(self.vault.get, self.name)
        return SessionInfo.model_validate_json(text) if text else None

    async def save_session(self, info):
        await asyncio.to_thread(self.vault.put, self.name, info.model_dump_json())

    async def update_token(self, old_token, new_token, /):
        info = await self.load_session()
        if info is not None and info.token == old_token:
            await self.save_session(info.model_copy(update={"token": new_token}))

    async def load_session_by_device_id(self, device_id):
        info = await self.load_session()
        return info if info is not None and info.device_id == device_id else None

    async def load_session_by_phone(self, phone):
        info = await self.load_session()
        return info if info is not None and info.phone == phone else None

    async def delete_session(self, token, /):
        info = await self.load_session()
        if info is not None and info.token == token:
            await asyncio.to_thread(self.vault.drop, self.name)

    async def close(self):
        pass

    async def take_old(self, work_dir, db="web.db"):
        """The session PyMax kept in its SQLite file before 2.5 moves in once;
        the file goes only when it is in."""
        old = os.path.join(work_dir, db)
        if not os.path.exists(old):
            return
        if await self.load_session() is None:
            from pymax.session.store import SessionStore

            store = SessionStore(work_dir, db)
            try:
                info = await store.load_session()
            except Exception as exc:  # not PyMax's file after all: left, a new login comes
                log_line("old session %s: %r" % (db, exc))
                return
            finally:
                await store.close()
            if info is not None:
                await self.save_session(info)
        for junk in (old, old + "-journal", old + "-wal", old + "-shm"):
            try:
                os.remove(junk)
            except OSError:
                pass


SEARCH_COUNT = 20  # public channels and groups asked for by a search
VOICE_TRIES = 4  # a voice sent again while MAX says it is not ready yet
VOICE_PAUSE = 3  # s between those


def voice_wave(path, bars=80):
    """A voice message's waveform as MAX's apps send it: bars levels
    0…127 (web.max.ru: a bar's mean level × 800, at most 127), as bytes —
    in the JSON frame a string of exactly bars characters, which MAX checks
    ("Invalid media wave length" else); flat when ffmpeg cannot read the
    file."""
    levels = bytes(bars)
    try:
        pcm = subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-i", path, "-ac", "1",
                              "-ar", "8000", "-f", "s16le", "-"], capture_output=True,
                             timeout=30, check=True).stdout
        samples = memoryview(pcm[:len(pcm) // 2 * 2]).cast("h")
        n = len(samples)
        if n >= bars:
            levels = bytes(min(127, int(sum(abs(x) for x in samples[i * n // bars:(i + 1) * n // bars])
                                        / max(1, (i + 1) * n // bars - i * n // bars) / 32768 * 800))
                           for i in range(bars))
    except (OSError, subprocess.SubprocessError, TypeError, ValueError):
        pass
    return levels


def photo_token(url, answer):
    """The token of the one photo of an upload's answer: by the photoIds of
    its link if there are (MAX gave them till autumn 2026), else the only
    one; an error rather than a guess between several."""
    photos = (answer or {}).get("photos") or {}
    wanted = urllib.parse.parse_qs(urllib.parse.urlsplit(url or "").query).get("photoIds", [None])[0]
    if wanted in photos:
        return photos[wanted]["token"]
    if len(photos) == 1:
        return next(iter(photos.values()))["token"]
    raise RuntimeError("upload: %d photos in the answer" % len(photos))


class PyMaxLink:
    """The link to MAX (CONTEXT.md: Связь с MAX) through PyMax's web client:
    every request this program makes, and the events it gets, in one place.
    It hands out the link's own Person, Chat and Message (max_person,
    max_chat, max_message turn PyMax's into them) and keeps everything of
    PyMax, its internals included, to itself, so a PyMax upgrade is checked
    here. tests/fake_link.py is the other one.

    run(events) logs in and lives as long as the connection: it calls
    events.on_qr(url) when a QR code is to be scanned, on_login(me, chats,
    contacts, agent, session_id) after every (re)login, on_message(msg),
    on_reaction(chat_id, msg_id, reactions) and on_delete(chat_id, [msg ids])
    as they come, on_disconnect(why) when the connection is lost (PyMax
    connects again by itself; on_login follows). run() ends, or raises,
    only when PyMax gives up. All of it runs in the caller's asyncio loop."""

    account = "max"  # the account's name: settings, files, Backend.accounts
    label = "MAX"  # on the screen
    prefix = None  # its chat and people ids: MAX's are numbers
    hosts = ("max.ru",)  # links of its channels and groups
    # What it can besides messages (Account.can): find by phone, join by
    # link, reactions, forwarding, telemetry, its own invite setting.
    can = frozenset({"phone", "links", "search", "react", "forward", "telemetry", "invites"})

    @staticmethod
    def dialog_of(me, user):
        """The id of the dialog of me with user: MAX numbers it own id XOR
        theirs (so the other one is found the same way)."""
        return me ^ user

    def __init__(self, work_dir, vault=None):
        self.can = type(self).can | ({"calls"} if calls_supported() else set())
        self.work_dir = work_dir
        self.vault = vault  # secrets() unless given
        self.client = None
        self.events = None
        self.settings = {}  # the account's own settings, from the last login
        self.tasks = set()  # events of its own (deletions) on their way

    async def run(self, events):
        from pymax import WebClient
        from pymax.config import ExtraConfig

        self.events = events
        store = VaultStore(self.vault or secrets(), self.account)  # the login in the keyring
        await store.take_old(self.work_dir)
        # PyMax's own telemetry (a random simulation) stays off: Telemetry
        # sends what really happens instead.
        self.client = WebClient(session_name="web.db", work_dir=self.work_dir,
                                extra_config=ExtraConfig(telemetry=False, log_level="WARNING",
                                                         reconnect_delay=3.0, store=store),
                                qr_provider=self)
        self._watch_login()
        self.client.on_start()(self._started)
        self.client.on_message()(self._message)
        self.client.on_reaction_update()(self._reaction)
        self.client.on_disconnect()(self._disconnected)
        await self.client.start()

    def _watch_deletions(self, client):
        """Deletions: MAX tells them by NOTIF_MSG_DELETE, or by a message whose
        status is REMOVED; PyMax 2.4.1 maps the second into a delete event it
        cannot read, and the frame is lost. So the frames are looked at here
        first, as they come. PyMax's runtime exists only once started: done
        at the login, once."""
        dispatcher = getattr(getattr(client, "_app", None), "dispatcher", None)
        if dispatcher is None or getattr(dispatcher, "haltia_peeks", False):
            return
        dispatch = dispatcher.dispatch

        async def peek_then_dispatch(frame):
            self._peek(frame)
            await dispatch(frame)
        dispatcher.dispatch = peek_then_dispatch
        dispatcher.haltia_peeks = True

    def _peek(self, frame):
        """A deletion in a frame from MAX: events.on_delete(chat, [ids])."""
        from pymax.protocol import Opcode
        from pymax.types.domain import Message

        try:
            payload = frame.payload if isinstance(frame.payload, dict) else {}
            if int(frame.opcode) in (137, 120, 121):
                task = asyncio.ensure_future(self.events.on_call_frame(int(frame.opcode), payload))
                self.tasks.add(task)
                task.add_done_callback(self.tasks.discard)
                return
            if frame.opcode == Opcode.NOTIF_MSG_DELETE:
                chat_id, ids = payload.get("chatId"), payload.get("messageIds") or []
            elif frame.opcode == Opcode.NOTIF_MESSAGE and \
                    "REMOVED" in str((payload.get("message") or payload).get("status")):
                msg = Message.model_validate(payload)
                chat_id, ids = msg.chat_id or payload.get("chatId"), [msg.id]
            else:
                return
            if chat_id is not None and ids:
                task = asyncio.ensure_future(
                    self.events.on_delete(int(chat_id), [int(i) for i in ids]))
                self.tasks.add(task)  # held till done: the loop keeps only a weak reference
                task.add_done_callback(self.tasks.discard)
        except Exception as exc:  # a frame of another shape: not for us
            log_line("delete frame: %r" % exc)

    def _watch_login(self):
        """Keep the account's own settings from each login answer: PyMax
        reads only the hash of its "config", the settings are in its
        "user" part (CHATS_INVITE and the like). The answer is caught where
        PyMax's auth turns it into a LoginResponse, as PyMax's runtime (and
        its invoke) exists only once start() runs."""
        from pymax.api.auth import service as auth

        real = getattr(auth.require_payload_model, "haltia_real", auth.require_payload_model)

        def keep(response, model, *args, **kwargs):
            if getattr(model, "__name__", "") == "LoginResponse":
                config = (getattr(response, "payload", None) or {}).get("config") or {}
                if isinstance(config.get("user"), dict):
                    self.settings = config["user"]
            return real(response, model, *args, **kwargs)

        keep.haltia_real = real
        auth.require_payload_model = keep

    def invites(self):
        """Who may add the account to chats, as MAX said at the last login:
        "CONTACTS", "ALL", or None when not said. Only MAX's own app may
        change it."""
        return self.settings.get("CHATS_INVITE")

    async def signed_in(self):
        """Whether a login is kept (then run() needs no QR code); Locked if
        the keyring is closed."""
        if os.path.exists(os.path.join(self.work_dir, "web.db")):
            return True  # 2.4's, moved into the keyring by run()
        return await asyncio.to_thread((self.vault or secrets()).get, self.account) is not None

    async def logout(self):
        """The login forgotten here (the next run() shows a QR code)."""
        await asyncio.to_thread((self.vault or secrets()).drop, self.account)

    async def show_qr(self, qr_url):  # PyMax's QrHandler
        await self.events.on_qr(qr_url)

    async def _started(self, client):
        self._watch_deletions(client)
        device = client._app.config.device
        try:  # the browser PyMax presents itself as; media links want the same
            agent = device.user_agent.header_user_agent
        except AttributeError:
            agent = None
        me = client.me.contact if client.me else None
        await self.events.on_login(max_person(me) if me else None,
                                   [max_chat(c) for c in client.chats or []],
                                   [max_person(u) for u in client.contacts or [] if u],
                                   agent, device.client_session_id)

    async def _disconnected(self, exc, _reconnect, _delay):
        await self.events.on_disconnect(repr(exc))

    async def _message(self, msg, _client):
        await self.events.on_message(max_message(msg))

    async def _reaction(self, event, _client):
        reactions = [[c.reaction, c.count] for c in event.counters or [] if c.count]
        await self.events.on_reaction(event.chat_id, int(event.message_id), reactions)

    async def dial(self, conversation, peer):
        device = self.client._app.session.device_id
        internal = {"deviceId": device, "sdkVersion": "2.8.9",
                    "clientAppKey": "CNHIJPLGDIHBABABA", "platform": "WEB",
                    "protocolVersion": 5, "domainId": "", "capabilities": "2A03F"}
        reply = await self.client._app.invoke(78, {
            "conversationId": conversation, "calleeIds": [peer], "isVideo": False,
            "internalParams": json.dumps(internal)})
        return json.loads(reply.payload["internalCallerParams"])

    @property
    def _api(self):
        return self.client._app.api

    # chats and people
    async def chats_page(self, marker=None):
        """A page of the chat list, the newest first, older than marker (ms)."""
        return [max_chat(c) for c in await self._api.chats.fetch_chats(marker) or []]

    async def chats(self, ids):
        return [max_chat(c) for c in await self._api.chats.get_chats(list(ids)) or [] if c]

    async def users(self, ids):
        return [max_person(u) for u in await self._api.users.get_users(list(ids)) or [] if u]

    async def find_phone(self, phone):
        """The person with this phone number; an error if nobody in MAX has it."""
        return max_person(await self._api.users.search_by_phone(phone))

    async def add_contact(self, user_id):
        return max_person(await self._api.users.add_contact(user_id))

    async def search(self, query, count=SEARCH_COUNT):
        """Public channels and groups by name, as MAX's own search finds
        them (PUBLIC_SEARCH, as web.max.ru sends it; PyMax has no call):
        Chats with their link. People and bots found are left out."""
        from pymax.api.response import payload_dict
        from pymax.protocol import Opcode

        frame = await self.client._app.invoke(Opcode.PUBLIC_SEARCH,
                                              {"query": query, "count": count, "type": "ALL"})
        out = []
        for item in payload_dict(frame).get("result") or []:
            c = item.get("chat") if isinstance(item, dict) else None
            if not isinstance(c, dict) or c.get("id") is None or c.get("type") not in ("CHANNEL", "CHAT"):
                continue
            out.append(Chat(c["id"], c["type"], c.get("title") or "", [],
                            c.get("participantsCount") or 0, link=c.get("link")))
        return out

    async def link_info(self, link):
        """The channel or group behind a link, or None. PyMax's own call
        takes invite links only (join/…), so public max.ru/name links go
        as the web client sends them."""
        from pymax.api.chats.enums import ChatPayloadKey
        from pymax.api.chats.payloads import LinkInfoPayload
        from pymax.api.response import parse_payload_item_model
        from pymax.protocol import Opcode
        from pymax.types.domain import Chat

        at = link.find("join/")  # invite links go as join/…, public ones whole
        frame = LinkInfoPayload(link=link[at:] if at != -1 else link)
        response = await self.client._app.invoke(Opcode.LINK_INFO, frame.to_payload())
        chat = parse_payload_item_model(response, ChatPayloadKey.CHAT, Chat)
        return max_chat(chat) if chat is not None else None

    async def join(self, link):
        return max_chat(await self._api.chats.join_channel(link))  # groups too

    async def leave(self, chat_id):
        """Out of a group or channel."""
        await self._api.chats.leave_group(chat_id)

    async def delete(self, chat_id, last_event_time=None):
        """A chat off this account's list. Only for this account: there is
        no way here to delete it for the others in it."""
        await self._api.chats.delete_chat(chat_id, last_event_time=last_event_time,
                                          for_all=False)

    # messages
    async def history(self, chat_id, backward, before=None):
        """Up to backward messages, the newest ones, or those older than
        before (ms)."""
        if before is None:
            msgs = await self._api.messages.fetch_history(chat_id=chat_id, backward=backward)
        else:
            msgs = await self._api.messages.fetch_history(chat_id=chat_id, backward=backward,
                                                          forward=0, from_=before - 1)
        return [max_message(m) for m in msgs or [] if before is None or m.time < before]

    async def read(self, chat_id, msg_id):
        await self._api.messages.read_message(msg_id, chat_id)

    async def send(self, chat_id, text, files=()):
        """A message, with files (attachment(): photos, files; voice with
        its duration in ms) if any. A voice MAX has not made ready yet
        (…attachment….not.ready) goes again, uploaded anew, a few times."""
        from pymax.exceptions import ApiError
        from pymax.files import File, Photo, Voice

        self._fix_uploads()
        for attempt in range(VOICE_TRIES):
            sent = []
            for f in files:
                if f["kind"] == "photo":
                    sent.append(Photo(path=f["path"]))
                elif f["kind"] == "voice":
                    sent.append(Voice(path=f["path"], duration=int(f["duration"])))
                else:
                    sent.append(File(path=f["path"], name=f.get("name")))
            try:
                msg = await self._api.messages.send_message(chat_id, text or None,
                                                            attachments=sent or None)
                break
            except ApiError as exc:
                if not (exc.error or "").endswith("not.ready") or attempt == VOICE_TRIES - 1:
                    raise
                log_line("send: %s, again" % exc.error)
                await asyncio.sleep(VOICE_PAUSE)
        return max_message(msg) if msg else None

    def _fix_uploads(self):
        """PyMax 2.4.1's photo and voice uploads, replaced on this client
        (its issues #108 and #103): MAX no longer puts photoIds in a photo's
        upload link, and takes a voice as a multipart form, answered by
        audioId; its errors come in a 200's body."""
        uploads = self._api.uploads
        if getattr(uploads, "fixed", False):
            return
        uploads.upload_photo = self._upload_photo
        uploads.upload_voice = self._upload_voice
        uploads.fixed = True

    async def _post_form(self, url, data, name, ctype):
        import aiohttp

        form = aiohttp.FormData()
        form.add_field("file", data, filename=name, content_type=ctype)
        async with aiohttp.ClientSession(proxy=self.client._app.config.proxy) as session, \
                session.post(url, data=form) as response:
            body = await response.text()
            if response.status != 200:
                raise RuntimeError("upload: HTTP %d" % response.status)
        try:
            answer = json.loads(body) if body.strip() else {}
        except ValueError:
            answer = {}
        if isinstance(answer, dict) and answer.get("error_code"):
            raise RuntimeError("upload: %s" % (answer.get("error_data") or answer["error_code"]))
        return answer

    async def _upload_photo(self, photo, profile=False):
        from pymax.api.response import payload_dict
        from pymax.api.uploads.payloads import AttachPhotoPayload, UploadPayload
        from pymax.protocol import Opcode

        frame = await self.client._app.invoke(Opcode.PHOTO_UPLOAD,
                                              payload=UploadPayload(profile=profile).to_payload())
        url = payload_dict(frame).get("url")
        ext, ctype = photo.validate_photo() or ("jpg", "image/jpeg")
        answer = await self._post_form(url, await photo.read(), "image." + ext, ctype)
        return AttachPhotoPayload(photo_token=photo_token(url, answer))

    async def _upload_voice(self, voice):
        from pymax.api.uploads.models import VideoUploadResponse
        from pymax.api.uploads.payloads import UploadPayload, VoiceAttachPayload
        from pymax.protocol import Opcode

        frame = await self.client._app.invoke(Opcode.VIDEO_UPLOAD, payload=UploadPayload(
            type=2, uploader_type=1).to_payload())
        info = VideoUploadResponse.model_validate(frame.payload).info[0]
        await self._post_form(info.url, await voice.read(), voice.name or "voice.ogg", "audio/ogg")
        # As MAX's own app sends it: by the upload's token, at once (no
        # NOTIF_ATTACH comes for a voice), its waveform as a string.
        wave = await asyncio.to_thread(voice_wave, getattr(voice, "path", None))
        return VoiceAttachPayload(video_id=info.video_id, token=info.token,
                                  duration=await voice.get_duration(), wave=wave)

    async def forward(self, chat_id, msg_id, from_chat_id):
        """A message (its attachments with it) into another chat, as MAX
        forwards: the new message links to the original. Sent here rather
        than by PyMax 2.4.1's forward_message, which gives the message id as
        a string: MAX refuses that ("proto.payload: Expected number") and
        drops the connection."""
        from pymax.api.binding import bind_api_model
        from pymax.api.response import require_payload_model
        from pymax.protocol import Opcode
        from pymax.types.domain import Message

        payload = forward_payload(chat_id, msg_id, from_chat_id,
                                  -self._api.messages._next_cid())
        response = await self.client._app.invoke(Opcode.MSG_SEND, payload)
        return max_message(bind_api_model(self.client._app, require_payload_model(response, Message)))

    async def react(self, chat_id, msg_id, emoji):
        """The account's reaction put on (None: taken off); MAX's counts
        afterwards ([[emoji, count]], own emoji), or None when it sends none."""
        if emoji:
            info = await self._api.messages.add_reaction(chat_id, msg_id, emoji)
        else:
            info = await self._api.messages.remove_reaction(chat_id, msg_id)
        return reactions_of(info) if info else None

    async def media_url(self, chat_id, msg_id, item):
        """The short-lived link MAX gives for a video or a file of a message.
        Only MAX's own link: an "external" one (a video elsewhere) is not
        given, since the player would fetch whatever it names."""
        if item["kind"] == "video":
            got = await self._api.messages.get_video_by_id(chat_id, msg_id, item["id"])
        else:
            got = await self._api.messages.get_file_by_id(chat_id, msg_id, item["id"])
        return getattr(got, "url", None) if got else None

    # the account
    async def log(self, events):
        """Telemetry events (dicts shaped as PyMax's TelemetryEvent); dropped
        while not connected."""
        from pymax.protocol import Opcode
        from pymax.telemetry.payloads import TelemetryEvent, TelemetryPayload

        app = self.client._app if self.client else None
        if not (app and app.started and app.me and app.connection.is_open):
            return
        payload = TelemetryPayload(events=[TelemetryEvent(**e) for e in events]).to_payload()
        await app.invoke(Opcode.LOG, payload, timeout=app.config.request_timeout)

# --- Telegram ----------------------------------------------------------------------
# Its ids here are strings, "tg:" and Telethon's marked peer id: a person's
# and their dialog's the same ("tg:42"), a group's negative, a channel's
# -100…. What a message carries is fetched by the link: a ref "tg:<chat>/<msg>"
# (its photo, voice, video, file), "/thumb" after it for a video's preview.

TG_SERVICE = {"MessageActionChatAddUser": "добавлен участник",
              "MessageActionChatDeleteUser": "участник вышел",
              "MessageActionChatJoinedByLink": "вступил по ссылке",
              "MessageActionChatJoinedByRequest": "вступил по заявке",
              "MessageActionChatEditTitle": "новое название",
              "MessageActionChatEditPhoto": "новое фото чата",
              "MessageActionPinMessage": "закреплено сообщение",
              "MessageActionChatCreate": "чат создан",
              "MessageActionChannelCreate": "канал создан",
              "MessageActionPhoneCall": "звонок"}


def tg_id(peer_id):
    return "tg:%d" % peer_id


def tg_number(some_id):
    """Telethon's marked peer id of a "tg:…" id."""
    return int(some_id.split(":", 1)[1].split("/", 1)[0])


def tg_person(entity):
    """A Person of Telethon's user (a channel or group as a sender: its title)."""
    from telethon import utils

    if hasattr(entity, "title"):
        name = entity.title
    elif getattr(entity, "deleted", False):
        name = "Удалённый аккаунт"
    else:
        name = " ".join(x for x in (entity.first_name, entity.last_name) if x) or \
            (entity.username or "")
    return Person(tg_id(utils.get_peer_id(entity)), name)


def tg_reactions(reactions):
    """[[emoji, count]] and the own one of Telegram's MessageReactions; its
    custom emoji left out, its emoji as REACTIONS has them."""
    from telethon.tl import types

    back = {v: k for k, v in TG_REACTION.items()}
    counts, yours = [], None
    for r in getattr(reactions, "results", None) or []:
        if isinstance(r.reaction, types.ReactionEmoji) and r.count:
            emoji = back.get(r.reaction.emoticon, r.reaction.emoticon)
            counts.append([emoji, r.count])
            if r.chosen_order is not None:
                yours = emoji
    return counts, yours


def tg_message(msg, me=None):
    """A Message of Telethon's: its text, photos, voice, audio, video and
    files as refs the link fetches, what is not shown as notes. Its sender
    is me (the account's id) when it is outgoing: Telegram leaves it out
    in a dialog."""
    from telethon.tl import types

    chat = tg_id(msg.chat_id)
    ref = "%s/%d" % (chat, msg.id)
    sender = me if msg.out and me else tg_id(msg.sender_id) if msg.sender_id else chat
    out = Message(msg.id, chat, sender, int(msg.date.timestamp() * 1000),
                  getattr(msg, "message", None) or "")
    if isinstance(msg, types.MessageService):
        out.notes.append(TG_SERVICE.get(type(msg.action).__name__, "служебное сообщение"))
        return out
    f = msg.file
    if msg.photo:
        out.photos.append(ref)
        out.parts.append("")
    elif msg.voice:
        out.media.append({"kind": "audio", "url": ref, "duration": f.duration or 0})
        out.parts.append("голосовое сообщение")
    elif msg.video or msg.video_note or msg.gif:
        thumbs = getattr(msg.document, "thumbs", None)
        out.media.append({"kind": "video", "id": ref, "thumb": ref + "/thumb" if thumbs else "",
                          "duration": f.duration or 0})
        out.parts.append("видео")
    elif msg.sticker:
        out.notes.append("стикер")
        out.parts.append("стикер")
    elif msg.audio:
        name = f.name or " — ".join(x for x in (f.performer, f.title) if x) or "аудио"
        out.media.append({"kind": "audio", "url": ref, "duration": f.duration or 0,
                          "name": name, "size": f.size or 0})
        out.parts.append("аудио «%s»" % name)
    elif msg.document:
        name = f.name or "файл"
        out.media.append({"kind": "file", "id": ref, "name": name, "size": f.size or 0})
        out.parts.append("файл «%s»" % name)
    elif msg.geo or msg.venue:
        out.notes.append("место на карте")
        out.parts.append("место на карте")
    elif msg.contact:
        out.notes.append("контакт")
        out.parts.append("контакт")
    elif msg.poll:
        out.notes.append("опрос")
        out.parts.append("опрос")
    out.reactions, out.yours = tg_reactions(msg.reactions)
    if msg.fwd_from is not None:
        fwd = msg.forward
        origin = getattr(fwd, "chat", None) or getattr(fwd, "sender", None)
        name = tg_person(origin).name if origin is not None else msg.fwd_from.from_name
        out.fwd = {"chat": name, "sender": tg_id(fwd.sender_id) if getattr(fwd, "sender_id", None)
                   else None}
    return out


def tg_chat(entity, me, unread=0, last=None):
    """A Chat of Telethon's user (a dialog with them), group or channel."""
    from telethon import utils
    from telethon.tl import types

    cid = tg_id(utils.get_peer_id(entity))
    if isinstance(entity, types.User):
        kind, title = "DIALOG", None
        members = [me] if entity.is_self else [me, cid]
    else:
        broadcast = isinstance(entity, types.Channel) and entity.broadcast
        kind, title, members = "CHANNEL" if broadcast else "CHAT", entity.title, [me]
    count = getattr(entity, "participants_count", None) or len(members)
    chat = Chat(cid, kind, title, members, count, unread)
    if last is not None:
        chat.last = tg_message(last, me)
        chat.time = chat.last.time
    return chat


class TelethonLink:
    """The link to Telegram through Telethon (MTProto), as PyMaxLink is to
    MAX: the same operations and events, the link's own Person, Chat and
    Message (tg_person, tg_chat, tg_message), and Telethon kept to itself.

    run(events) signs in by a QR code (events.on_qr(url), a new one when it
    expires), asks the cloud password when the account has one
    (events.on_password(wrong) answers it), keeps the login as Telethon's
    StringSession in the keyring, and lives as long as Telethon's
    connection (it connects again by itself; run() ends when it gives up)."""

    account = "telegram"
    label = "Telegram"
    prefix = "tg:"
    hosts = TG_HOSTS
    can = frozenset({"phone", "links", "search", "react", "forward"})

    @staticmethod
    def dialog_of(_me, user):
        """A dialog's id is the person's."""
        return user

    def __init__(self, work_dir, vault=None):
        self.work_dir = work_dir
        self.vault = vault  # secrets() unless given
        self.client = None
        self.events = None
        self.me = None
        self.people = {}  # id -> Person met (the dialogs', senders'): users() asks only for others

    def _met(self, msg):
        """The sender of a message, as Telethon brought it along."""
        sender = getattr(msg, "sender", None)
        if sender is not None:
            person = tg_person(sender)
            self.people[person.id] = person

    def _client(self, session):
        from telethon import TelegramClient
        from telethon.sessions import StringSession

        keys = telegram_keys()
        if keys is None:
            raise RuntimeError("no Telegram API keys")
        return TelegramClient(StringSession(session or ""), *keys, device_model="Linux",
                              system_version="GTK", app_version="haltia-messenger", lang_code="ru",
                              system_lang_code="ru", base_logger="haltia-messenger.telegram")

    async def run(self, events):
        from telethon import events as tev
        from telethon.errors import PasswordHashInvalidError, SessionPasswordNeededError
        from telethon.tl import functions, types

        self.events = events
        vault = self.vault or secrets()
        kept = await asyncio.to_thread(vault.get, self.account)
        client = self.client = self._client(kept)
        try:
            await client.connect()
            if not await client.is_user_authorized():
                qr = await client.qr_login()
                while True:
                    await events.on_qr(qr.url)
                    try:
                        await qr.wait()
                        break
                    except asyncio.TimeoutError:
                        await qr.recreate()
                    except SessionPasswordNeededError:
                        wrong = False
                        while True:
                            password = await events.on_password(wrong)
                            try:
                                await client.sign_in(password=password)
                                break
                            except PasswordHashInvalidError:
                                wrong = True
                        break
                await asyncio.to_thread(vault.put, self.account, client.session.save())
            client.add_event_handler(self._message, tev.NewMessage())
            client.add_event_handler(self._deleted, tev.MessageDeleted())
            client.add_event_handler(self._reaction, tev.Raw(types.UpdateMessageReactions))
            me = await client.get_me()
            self.me = tg_id(me.id)
            chats = []
            async for d in client.iter_dialogs(limit=300):
                chats.append(tg_chat(d.entity, self.me, d.unread_count, d.message))
                person = tg_person(d.entity)
                self.people[person.id] = person
            try:
                found = await client(functions.contacts.GetContactsRequest(hash=0))
                contacts = [tg_person(u) for u in getattr(found, "users", [])]
            except Exception as exc:
                log_line("telegram contacts: %r" % exc)
                contacts = []
            await events.on_login(tg_person(me), chats, contacts, None, 0)
            await client.run_until_disconnected()
        finally:
            await client.disconnect()

    async def signed_in(self):
        return await asyncio.to_thread((self.vault or secrets()).get, self.account) is not None

    async def logout(self):
        """Out of the account on Telegram's side too (its session ended
        there), then forgotten here."""
        vault = self.vault or secrets()
        kept = await asyncio.to_thread(vault.get, self.account)
        if kept:
            client = self._client(kept)
            try:
                await asyncio.wait_for(client.connect(), 15)
                await asyncio.wait_for(client.log_out(), 15)
            except Exception as exc:
                log_line("telegram logout: %r" % exc)
            finally:
                await client.disconnect()
        await asyncio.to_thread(vault.drop, self.account)

    # events
    async def _message(self, event):
        self._met(event.message)
        await self.events.on_message(tg_message(event.message, self.me))

    async def _deleted(self, event):
        # Telegram tells the chat only for channels; Account finds the others.
        chat = tg_id(event.chat_id) if event.chat_id else None
        await self.events.on_delete(chat, list(event.deleted_ids))

    async def _reaction(self, update):
        from telethon import utils

        counts, _yours = tg_reactions(update.reactions)
        await self.events.on_reaction(tg_id(utils.get_peer_id(update.peer)), update.msg_id, counts)

    async def _peer(self, some_id):
        return await self.client.get_input_entity(tg_number(some_id))

    # chats and people
    async def chats_page(self, marker=None):
        return []  # the login brings the list whole

    async def chats(self, ids):
        out = []
        for cid in ids:
            entity = await self.client.get_entity(tg_number(cid))
            last = await self.client.get_messages(entity, limit=1)
            out.append(tg_chat(entity, self.me, 0, last[0] if last else None))
        return out

    async def users(self, ids):
        """The people of these ids: those met already as they were, the
        others asked for."""
        for uid in ids:
            if uid not in self.people:
                try:
                    self.people[uid] = tg_person(await self.client.get_entity(tg_number(uid)))
                except Exception as exc:  # not met by this session: no name
                    log_line("telegram user %s: %r" % (uid, exc))
        return [self.people[uid] for uid in ids if uid in self.people]

    async def find_phone(self, phone):
        from telethon.tl import functions

        found = await self.client(functions.contacts.ResolvePhoneRequest(phone=phone.lstrip("+")))
        if not found.users:
            raise LookupError("not in Telegram")
        return tg_person(found.users[0])

    async def add_contact(self, user_id):
        from telethon.tl import functions

        user = await self.client.get_entity(tg_number(user_id))
        await self.client(functions.contacts.AddContactRequest(
            id=user, first_name=user.first_name or "", last_name=user.last_name or "",
            phone="", add_phone_privacy_exception=False))
        return tg_person(user)

    async def link_info(self, link):
        from telethon import utils
        from telethon.tl import functions, types

        name, invite = utils.parse_username(link)
        if invite:
            found = await self.client(functions.messages.CheckChatInviteRequest(hash=name))
            if isinstance(found, (types.ChatInviteAlready, types.ChatInvitePeek)):
                return tg_chat(found.chat, self.me)
            return Chat(None, "CHANNEL" if found.broadcast else "CHAT", found.title, [],
                        found.participants_count)
        if not name:
            return None
        entity = await self.client.get_entity(name)
        return None if isinstance(entity, types.User) else tg_chat(entity, self.me)

    async def search(self, query, count=SEARCH_COUNT):
        """Public channels and groups by name (Telegram's contacts.search):
        those with a username, linked as https://t.me/name."""
        from telethon.tl import functions, types

        found = await self.client(functions.contacts.SearchRequest(q=query, limit=count))
        out = []
        for c in found.chats:
            if isinstance(c, types.Channel) and c.username:
                chat = tg_chat(c, self.me)
                chat.link = "https://t.me/" + c.username
                out.append(chat)
        return out

    async def join(self, link):
        from telethon import utils
        from telethon.tl import functions

        name, invite = utils.parse_username(link)
        if invite:
            done = await self.client(functions.messages.ImportChatInviteRequest(hash=name))
        else:
            done = await self.client(functions.channels.JoinChannelRequest(
                await self.client.get_input_entity(name)))
        return tg_chat(done.chats[0], self.me)

    async def leave(self, chat_id):
        await self.client.delete_dialog(await self._peer(chat_id))

    async def delete(self, chat_id, last_event_time=None):
        """The dialog's messages deleted for this account only."""
        await self.client.delete_dialog(await self._peer(chat_id), revoke=False)

    # messages
    async def history(self, chat_id, backward, before=None):
        when_ = datetime.fromtimestamp(before / 1000, timezone.utc) if before else None
        msgs = await self.client.get_messages(await self._peer(chat_id), limit=backward,
                                              offset_date=when_)
        for m in msgs:
            self._met(m)
        return [tg_message(m, self.me) for m in msgs]

    async def read(self, chat_id, msg_id):
        await self.client.send_read_acknowledge(await self._peer(chat_id), max_id=msg_id)

    async def send(self, chat_id, text, files=()):
        """The text, or each file a message of its own (the text under the
        first): the messages, in order."""
        from telethon.tl import types

        peer = await self._peer(chat_id)
        if not files:
            return tg_message(await self.client.send_message(peer, text), self.me)
        sent, caption = [], text
        for f in files:
            if f["kind"] == "voice":
                msg = await self.client.send_file(
                    peer, f["path"], caption=caption, voice_note=True,
                    attributes=[types.DocumentAttributeAudio(duration=f["duration"] // 1000,
                                                             voice=True)])
            elif f["kind"] == "photo":
                msg = await self.client.send_file(peer, f["path"], caption=caption)
            else:
                msg = await self.client.send_file(
                    peer, f["path"], caption=caption, force_document=True,
                    attributes=[types.DocumentAttributeFilename(f.get("name") or
                                                                os.path.basename(f["path"]))])
            sent.append(tg_message(msg, self.me))
            caption = ""
        return sent

    async def forward(self, chat_id, msg_id, from_chat_id):
        msg = await self.client.forward_messages(await self._peer(chat_id), msg_id,
                                                 await self._peer(from_chat_id))
        return tg_message(msg, self.me)

    async def react(self, chat_id, msg_id, emoji):
        from telethon.tl import functions, types

        reaction = [types.ReactionEmoji(emoticon=TG_REACTION.get(emoji, emoji))] if emoji else []
        done = await self.client(functions.messages.SendReactionRequest(
            peer=await self._peer(chat_id), msg_id=msg_id, reaction=reaction))
        for update in getattr(done, "updates", []):
            if isinstance(update, types.UpdateMessageReactions) and update.msg_id == msg_id:
                return tg_reactions(update.reactions)[0], emoji
        return None

    async def media_url(self, _chat_id, _msg_id, item):
        """Its ref: Media fetches it through download()."""
        return item.get("id") or item.get("url")

    async def download(self, ref, path):
        """A message's photo, voice, video or file (its preview: /thumb)
        into path."""
        parts = ref.split(":", 1)[1].split("/")
        msg = await self.client.get_messages(await self._peer(ref), ids=int(parts[1]))
        if msg is None or not msg.media:
            raise LookupError("no such message: %s" % ref)
        with open(path, "wb") as out:
            await self.client.download_media(msg, file=out,
                                             thumb=-1 if parts[2:] == ["thumb"] else None)


def call_params(vcp):
    """Decode the bounded raw LZ4 block in MAX's incoming invitation.

    No frame header or optional system library: the wire format is
    <uncompressed length>:<base64 block>. Invitations stay in memory.
    """
    size, encoded = vcp.split(":", 1)
    size = int(size)
    if not 0 < size <= 65536 or len(encoded) > 131072:
        raise ValueError("call invitation too large")
    data = base64.b64decode(encoded, validate=True)
    out, pos = bytearray(), 0

    def length(n):
        nonlocal pos
        if n == 15:
            while True:
                more = data[pos]
                pos += 1
                n += more
                if more != 255:
                    break
        return n

    while pos < len(data):
        token = data[pos]
        pos += 1
        n = length(token >> 4)
        if pos + n > len(data) or len(out) + n > size:
            raise ValueError("bad call literals")
        out.extend(data[pos:pos + n])
        pos += n
        if pos == len(data):
            break
        offset = data[pos] | data[pos + 1] << 8
        pos += 2
        n = length(token & 15) + 4
        if not 0 < offset <= len(out) or len(out) + n > size:
            raise ValueError("bad call match")
        for _ in range(n):
            out.append(out[-offset])
    if len(out) != size:
        raise ValueError("bad call length")
    return json.loads(out)


def call_endpoint(params, conversation, incoming):
    """Only the call service supplied by MAX, never an arbitrary websocket."""
    endpoint = params.get("wse") if incoming else params.get("endpoint")
    url = urllib.parse.urlsplit(endpoint or "")
    if url.scheme != "wss" or not url.hostname or not \
            (url.hostname == "okcdn.ru" or url.hostname.endswith(".okcdn.ru")) or \
            url.path != "/ws2" or url.username or url.password or url.fragment:
        raise ValueError("invalid call endpoint")
    query = dict(urllib.parse.parse_qsl(url.query))
    if incoming:
        query.update(userId=str(params["trnu"].rsplit(":", 1)[1]),
                     entityType="USER", conversationId=conversation, token=params["tkn"])
    query.update(platform="WEB", appVersion="1.1", version="5", device="browser",
                 capabilities="2A03F", clientType="ONE_ME", tgt="accept" if incoming else "start")
    return urllib.parse.urlunsplit(url._replace(query=urllib.parse.urlencode(query)))


def call_media():
    """Load the optional media typelibs without opening an audio device."""
    for namespace in ("Gst", "GstWebRTC", "GstSdp"):
        gi.require_version(namespace, "1.0")
    from gi.repository import Gst, GstWebRTC, GstSdp
    return Gst, GstWebRTC, GstSdp


@functools.lru_cache(maxsize=1)
def calls_supported():
    """Probe once per process, including a negative result; no microphone."""
    try:
        Gst, _rtc, _sdp = call_media()
        Gst.init(None)
        return all(Gst.ElementFactory.find(name) is not None for name in
                   ("webrtcbin", "opusenc", "nicesrc", "pulsesrc"))
    except (ImportError, ValueError, GLib.Error):
        return False


class CallAudio:
    """One Opus WebRTC peer, owned by VoiceCall in the backend loop.

    Gst callbacks cross into that loop; they never touch GTK. Constructed
    only after Answer/Call, so an invitation cannot open the microphone.
    source/sink are replaceable for the local, account-free media test.
    """

    def __init__(self, loop, candidate, status, params, source="pulsesrc",
                 sink="pulsesink sync=false"):
        Gst, GstWebRTC, GstSdp = call_media()
        self.Gst, self.RTC, self.Sdp = Gst, GstWebRTC, GstSdp
        Gst.init(None)
        self.loop, self.candidate, self.status = loop, candidate, status
        self.closed = False
        self.remote_set = False
        self.pending = []
        self.sink = sink
        self.pipeline = None
        self.rtc = None
        self.bus = None
        self.signals = []
        try:
            # RFC 7587 section 7 requires /2 in Opus SDP even for mono.
            # Keep it in RTP caps: without it the MAX peer never answers.
            self.pipeline = Gst.parse_launch(
                "webrtcbin name=rtc bundle-policy=max-bundle " + source +
                " ! audioconvert ! audioresample ! audio/x-raw,rate=48000,channels=1 "
                "! opusenc bitrate=32000 inband-fec=true ! rtpopuspay pt=111 "
                "! application/x-rtp,media=audio,encoding-name=OPUS,payload=111,clock-rate=48000,"
                "encoding-params=(string)2 ! rtc.")
            self.rtc = self.pipeline.get_by_name("rtc")
            for name, callback in (("on-ice-candidate", self._candidate),
                                   ("pad-added", self._received),
                                   ("notify::connection-state", self._state)):
                self.signals.append(self.rtc.connect(name, callback))
            # Keep the video m-line used by MAX, without a camera or video sink.
            caps = Gst.Caps.from_string("application/x-rtp,media=video,encoding-name=VP8,payload=96,clock-rate=90000")
            self.rtc.emit("add-transceiver", GstWebRTC.WebRTCRTPTransceiverDirection.INACTIVE, caps)
            turn = params.get("turn") or {}
            stun = params.get("stun") or {}
            stuns = stun.get("urls") or params.get("stne", "").split(",")
            turns = turn.get("urls") or params.get("trne", "").split(",")
            if isinstance(stuns, str):
                stuns = [stuns]
            if isinstance(turns, str):
                turns = [turns]
            if stuns and stuns[0]:
                self.rtc.set_property("stun-server", stuns[0].replace("stun:", "stun://", 1))
            for server in filter(None, turns):
                scheme, address = server.split(":", 1)
                if scheme not in ("turn", "turns"):
                    raise ValueError("invalid TURN scheme")
                user = urllib.parse.quote(turn.get("username", params.get("trnu", "")), safe="")
                password = urllib.parse.quote(turn.get("credential", params.get("trnp", "")), safe="")
                if not self.rtc.emit("add-turn-server", "%s://%s:%s@%s" %
                                     (scheme, user, password, address.removeprefix("//"))):
                    raise ValueError("invalid TURN server")
            if params.get("p2p_forbidden"):
                self.rtc.set_property("ice-transport-policy", GstWebRTC.WebRTCICETransportPolicy.RELAY)
            self.bus = self.pipeline.get_bus()
            self.bus.set_sync_handler(self._bus, None)
            if self.pipeline.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
                raise RuntimeError("audio pipeline failed")
        except BaseException:
            self.close()
            raise

    def _candidate(self, _rtc, index, candidate):
        self.loop.call_soon_threadsafe(self._deliver, self.candidate,
                                      {"candidate": candidate, "sdpMLineIndex": index})

    def _deliver(self, callback, value):
        if not self.closed:
            callback(value)

    def _state(self, rtc, _spec):
        state = rtc.get_property("connection-state").value_nick
        self.loop.call_soon_threadsafe(self._deliver, self.status, state)

    def _bus(self, _bus, message, _data):
        if message.type == self.Gst.MessageType.ERROR:
            # Never log Gst errors: debug details can contain TURN credentials.
            self.loop.call_soon_threadsafe(self._deliver, self.status, "failed")
        return self.Gst.BusSyncReply.DROP

    def _received(self, _rtc, pad):
        pipeline = self.pipeline
        if pad.direction != self.Gst.PadDirection.SRC or self.closed or pipeline is None:
            return
        # Link on this streaming thread before its first packet arrives.
        caps = pad.get_current_caps() or pad.query_caps(None)
        if caps.get_structure(0).get_string("media") != "audio":
            return
        audio = self.Gst.parse_bin_from_description(
            "queue ! rtpopusdepay ! opusdec ! audioconvert ! audioresample ! " + self.sink, True)
        pipeline.add(audio)
        pad.link(audio.get_static_pad("sink"))
        audio.sync_state_with_parent()

    async def _promise(self, command, *args):
        future = self.loop.create_future()

        def complete(promise, *_unused):
            reply = promise.get_reply()
            def deliver():
                if not future.done():
                    if reply is not None and reply.has_field("error"):
                        future.set_exception(RuntimeError("WebRTC negotiation failed"))
                    else:
                        future.set_result(reply)
            self.loop.call_soon_threadsafe(deliver)
        promise = self.Gst.Promise.new_with_change_func(complete, None, None)
        self.rtc.emit(command, *args, promise)
        return await asyncio.wait_for(future, 10)

    async def remote(self, description):
        kind = {"offer": self.RTC.WebRTCSDPType.OFFER, "answer": self.RTC.WebRTCSDPType.ANSWER}[description["type"]]
        result, sdp = self.Sdp.SDPMessage.new_from_text(description["sdp"])
        if result != self.Sdp.SDPResult.OK:
            raise ValueError("invalid remote SDP")
        await self._promise("set-remote-description", self.RTC.WebRTCSessionDescription.new(kind, sdp))
        self.remote_set = True
        for candidate in self.pending:
            self.add_candidate(candidate)
        self.pending.clear()

    async def description(self, kind):
        reply = await self._promise("create-" + kind, None)
        desc = reply.get_value(kind)
        await self._promise("set-local-description", desc)
        return {"type": kind, "sdp": desc.sdp.as_text()}

    def add_candidate(self, value):
        if not self.remote_set:
            if len(self.pending) >= 256:
                raise ValueError("too many ICE candidates")
            self.pending.append(value)
        else:
            self.rtc.emit("add-ice-candidate", int(value.get("sdpMLineIndex", 0)), value["candidate"])

    async def stats(self):
        """Only counters, never candidate addresses, SDP or credentials."""
        reply = await self._promise("get-stats", None)
        result = []
        for n in range(reply.n_fields()):
            value = reply.get_value(reply.nth_field_name(n))
            if not isinstance(value, self.Gst.Structure) or not value.has_field("type"):
                continue
            kind = getattr(value.get_value("type"), "value_nick", "")
            if kind not in ("inbound-rtp", "outbound-rtp", "remote-inbound-rtp"):
                continue
            counters = {"type": kind}
            for field in ("packets-received", "packets-sent", "packets-lost", "jitter",
                          "round-trip-time", "bytes-received", "bytes-sent", "nack-count"):
                if value.has_field(field):
                    number = value.get_value(field)
                    if isinstance(number, (int, float)):
                        counters[field] = number
            result.append(counters)
        return result

    def close(self):
        self.closed = True
        pipeline, self.pipeline = self.pipeline, None
        rtc, self.rtc = self.rtc, None
        bus, self.bus = self.bus, None
        if bus is not None:
            bus.set_sync_handler(None, None)
        if rtc is not None:
            for handler in self.signals:
                rtc.disconnect(handler)
        self.signals.clear()
        if pipeline is not None:
            pipeline.set_state(self.Gst.State.NULL)
        self.pending.clear()
        self.candidate = self.status = None


class VoiceCall:
    """One 1:1 call, from invitation/dial tap until a terminal event.

    The websocket reader answers ping and routes replies independently of
    negotiation. Commands have deadlines; there is no reconnect or retry.
    Account owns this object and ignores every older call's callback.
    """

    DISCONNECT_GRACE = 7  # seconds; a brief Wi-Fi interruption is not a failed call

    SETTINGS = {"isAudioEnabled": True, "isVideoEnabled": False,
                "isScreenSharingEnabled": False, "isFastScreenSharingEnabled": False,
                "isAudioSharingEnabled": False}

    def __init__(self, conversation, peer, incoming, changed, agent=None,
                 audio=CallAudio, connect=None):
        self.id, self.peer, self.incoming = conversation, peer, incoming
        self.changed, self.agent, self.audio_factory = changed, agent, audio
        self.connect = connect
        self.state = "ringing" if incoming else "dialling"
        self.closed = False
        self.end_reason = None
        self.accepted = False
        self.sequence = 0
        self.pending = {}
        self.socket = None
        self.audio = None
        self.participant = None
        self.device = 0
        self.offer = None
        self.candidates = []
        self.local_candidates = []
        self.local_sent = False
        self.jobs = set()
        self.ready = asyncio.Event()
        self.offer_ready = asyncio.Event()
        self.params = {}
        self.task = None
        self.disconnect_timer = None

    def hangup_reason(self):
        return "HUNGUP" if self.accepted else "REJECTED" if self.incoming else "CANCELED"

    def show(self, state):
        if not self.closed:
            log_line("voice call: " + state)
            self.state = state
            self.changed(self, state)

    def job(self, coro):
        if self.closed:
            coro.close()
            return
        task = asyncio.create_task(coro)
        self.jobs.add(task)
        def done(future):
            self.jobs.discard(future)
            if not future.cancelled() and future.exception() is not None and not self.closed:
                self.job(self.end("FAILED", "failed"))
        task.add_done_callback(done)

    async def command(self, name, **body):
        if self.closed or self.socket is None:
            raise Offline()
        self.sequence += 1
        sequence = self.sequence
        future = asyncio.get_running_loop().create_future()
        self.pending[sequence] = future
        try:
            await self.socket.send(json.dumps(dict(command=name, sequence=sequence, **body)))
            return await asyncio.wait_for(future, 10)
        finally:
            self.pending.pop(sequence, None)

    def start(self, params):
        # Kept separately from negotiation jobs: even a cancelled invitation
        # must finish opening ws2 long enough to deliver the person's hangup.
        self.task = asyncio.create_task(self.run(params))

    async def send_hangup(self):
        if self.end_reason and self.socket:
            self.sequence += 1
            try:
                await asyncio.wait_for(self.socket.send(json.dumps(
                    {"command": "hangup", "sequence": self.sequence,
                     "reason": self.end_reason})), 2)
            except Exception:
                pass

    async def run(self, params):
        self.task = asyncio.current_task()
        self.params = params
        try:
            from websockets.asyncio.client import connect
            factory = self.connect or connect
            async with factory(call_endpoint(params, self.id, self.incoming),
                               origin="https://web.max.ru", user_agent_header=self.agent,
                               open_timeout=10, close_timeout=2, max_size=262144) as socket:
                self.socket = socket
                if self.closed:
                    await self.send_hangup()
                    return
                self.job(self.initialize())
                self.job(self.ring_deadline())
                while not self.closed:
                    raw = await asyncio.wait_for(socket.recv(), 20)
                    if raw == "ping":
                        await socket.send("pong")
                        continue
                    event = json.loads(raw)
                    if event.get("type") in ("response", "error"):
                        future = self.pending.get(event.get("sequence"))
                        if future is not None and not future.done():
                            if event["type"] == "error":
                                future.set_exception(RuntimeError("call command refused"))
                            else:
                                future.set_result(event)
                        elif event["type"] == "error":
                            raise RuntimeError("call service error")
                    elif event.get("type") == "notification":
                        await self.event(event)
        except asyncio.CancelledError:
            raise
        except Exception:
            # Exceptions can include the endpoint token; log only the phase.
            log_line("voice call: signalling failed")
            await self.end(None, "failed")
        finally:
            await self.end(None, "ended")

    async def initialize(self):
        await asyncio.wait_for(self.ready.wait(), 10)
        await self.command("change-media-settings", mediaSettings=dict(self.SETTINGS, isAudioEnabled=False))
        await self.command("change-participant-state", participantState={"state": {}})

    async def event(self, event):
        name = event.get("notification")
        if name == "connection":
            conversation = event.get("conversation") or {}
            if conversation.get("topology", "DIRECT") != "DIRECT":
                self.job(self.end("FAILED", "unsupported"))
                return
            self.params.update(event.get("conversationParams") or {})
            for person in conversation.get("participants", []):
                if str((person.get("externalId") or {}).get("id")) == str(self.peer):
                    self.participant = person["id"]
                    self.device = person.get("deviceIdx", 0)
            self.ready.set()
        elif name in ("registered-peer", "accepted-call", "transmitted-data"):
            if event.get("participantId") is None:
                return
            if self.participant is not None and str(self.participant) != str(event["participantId"]):
                return
            self.participant = event["participantId"]
            self.device = event.get("deviceIdx", 0)
            if name == "accepted-call" and not self.incoming and not self.accepted:
                self.accepted = True
                self.job(self.negotiate())
            elif name == "transmitted-data":
                data = event.get("data") or {}
                if "sdp" in data:
                    if data["sdp"]["type"] == "offer" and self.incoming:
                        self.offer = data["sdp"]
                        self.offer_ready.set()
                    elif data["sdp"]["type"] == "answer" and self.audio and not self.incoming:
                        self.job(self.audio.remote(data["sdp"]))
                if "candidate" in data:
                    if self.audio:
                        self.audio.add_candidate(data["candidate"])
                    elif len(self.candidates) < 256:
                        self.candidates.append(data["candidate"])
        elif name in ("hungup", "closed-conversation"):
            await self.end(None, "ended")
        elif name == "topology-changed" and event.get("topology") != "DIRECT":
            self.job(self.end("FAILED", "unsupported"))

    async def answer(self):
        if self.closed or not self.incoming or self.accepted:
            return
        self.accepted = True
        self.show("connecting")
        await asyncio.wait_for(self.ready.wait(), 10)
        await self.command("accept-call", mediaSettings=self.SETTINGS)
        await self.negotiate()

    async def transmit(self, data):
        target = {"participantId": self.participant, "participantType": "USER", "data": data}
        if self.device:
            target["deviceIdx"] = self.device
        await self.command("transmit-data", **target)

    def candidate(self, value):
        if self.local_sent:
            self.job(self.transmit({"candidate": value}))
        else:
            self.local_candidates.append(value)

    def audio_state(self, state):
        if self.closed:
            return
        if state == "connected":
            if self.disconnect_timer is not None:
                self.disconnect_timer.cancel()
                self.disconnect_timer = None
            self.show("active")
        elif state == "failed":
            self.job(self.end("NETWORK_ERROR", "failed"))
        elif state == "disconnected" and self.disconnect_timer is None:
            def expired():
                self.disconnect_timer = None
                if not self.closed:
                    self.job(self.end("NETWORK_ERROR", "failed"))
            self.disconnect_timer = asyncio.get_running_loop().call_later(self.DISCONNECT_GRACE, expired)

    async def negotiate(self):
        self.show("connecting")
        if self.incoming:
            await asyncio.wait_for(self.offer_ready.wait(), 15)
        if self.closed:
            return
        self.audio = self.audio_factory(asyncio.get_running_loop(), self.candidate, self.audio_state, self.params)
        for candidate in self.candidates:
            self.audio.add_candidate(candidate)
        self.candidates.clear()
        if self.incoming:
            await self.audio.remote(self.offer)
        description = await self.audio.description("answer" if self.incoming else "offer")
        if self.incoming and self.offer.get("p2pRelay"):
            description["p2pRelay"] = True
        await self.transmit({"sdp": description})
        self.local_sent = True
        for candidate in self.local_candidates:
            self.job(self.transmit({"candidate": candidate}))
        self.local_candidates.clear()
        await self.command("change-media-settings", mediaSettings=self.SETTINGS)
        self.job(self.deadline())
        self.job(self.quality())

    async def quality(self):
        while not self.closed:
            await asyncio.sleep(15)
            try:
                counters = await self.audio.stats()
                log_line("voice quality: " + json.dumps(counters))
            except Exception:
                pass  # statistics must never end a working call

    async def ring_deadline(self):
        await asyncio.sleep(90)
        if not self.closed and not self.accepted:
            await self.end("MISSED" if self.incoming else "CANCELED", "ended")

    async def deadline(self):
        await asyncio.sleep(30)
        if not self.closed and self.state != "active":
            await self.end("TIMEOUT", "failed")

    async def end(self, reason=None, state="ended"):
        if self.closed:
            return
        self.closed = True
        self.end_reason = reason
        if self.disconnect_timer is not None:
            self.disconnect_timer.cancel()
            self.disconnect_timer = None
        self.state = state
        log_line("voice call: " + state)
        if self.audio:
            self.audio.close()
        current = asyncio.current_task()
        for task in list(self.jobs):
            if task is not current:
                task.cancel()
        for future in list(self.pending.values()):
            if not future.done():
                future.cancel()
        if self.socket:
            await self.send_hangup()
            try:
                await self.socket.close()
            except Exception:
                pass
        if self.socket and self.task and self.task is not current:
            self.task.cancel()
        self.changed(self, state)


class Offline(Exception):
    """No connection to that messenger now (or no such account): the
    request was not sent."""


class Backend:
    """What the window asks of the messengers, and what they tell it: one
    Account per link (PyMaxLink, or tests/fake_link.py), all in one thread
    with an asyncio loop. The window calls it only through run(), and hears
    back through GLib.idle_add: every request is answered, with Offline
    while its account has no connection. A request about a chat or a
    person goes to the account whose id it is (of(): Account.owns); a
    link of a channel to the one whose host it is."""

    def __init__(self, ui, link=None, cache=None):
        self.ui = ui
        self.cache = cache or MessageCache(CHATS)  # its own in tests that ask
        self.loop = None
        self.accounts = {}  # name -> Account, in the order added
        self.given = {}  # name -> a link given (tests); else made by make()
        for one in link if isinstance(link, (list, tuple)) else [link] if link else []:
            self.given[one.account] = one
            self.add(one)

    def make(self, name):
        """The link of a messenger by its account's name."""
        if name in self.given:
            return self.given[name]
        if name == "max":
            return PyMaxLink(DATA)
        if name == "telegram":
            return TelethonLink(os.path.join(DATA, name))
        raise KeyError(name)

    def missing(self, name):
        """Why a messenger cannot be had here (its card says it), or None."""
        if name in self.given or name == "max":
            return None
        if name == "telegram":
            if importlib.util.find_spec("telethon") is None:
                return "Для Telegram нужен пакет Telethon, он не установлен."
            if telegram_keys() is None:
                return "Нет ключей приложения Telegram: впишите api_id и api_hash " \
                       "в раздел [telegram] файла %s." % SETTINGS.path
        return None

    def add(self, link):
        """An account on this link, not started (begin() starts it)."""
        folder = DATA if link.account == "max" else os.path.join(DATA, link.account)
        account = self.accounts[link.account] = Account(self.ui, link, self.cache, folder)
        return account

    def names(self):
        """The messengers there can be, the given ones (tests) too."""
        return [n for n, _label in MESSENGERS] + [n for n in self.given if n not in dict(MESSENGERS)]

    def start(self):
        # The loop is there before its thread runs: a request made at once waits in it.
        self.loop = asyncio.new_event_loop()
        threading.Thread(target=self._thread, daemon=True).start()

    def _thread(self):
        asyncio.set_event_loop(self.loop)
        self.loop.run_until_complete(self._main())

    async def _main(self):
        """Every messenger switched on and signed in starts; the window is
        told of the others (signin: off, out, locked)."""
        os.makedirs(DATA, mode=0o700, exist_ok=True)
        for name in self.names():
            await self.begin(name, quiet=True)
        await asyncio.Event().wait()  # the accounts live in their own tasks

    async def begin(self, name, quiet=False):
        """Start a messenger's account: at once if a login is kept, else
        only when asked (not quiet: the person pressed «Войти»: a QR
        code comes)."""
        if not messenger_on(name) or self.missing(name):
            GLib.idle_add(self.ui.signin, name, {"kind": "off"})
            return
        account = self.accounts.get(name) or self.add(self.make(name))
        if account.task is not None:
            return
        if quiet:
            try:
                kept = await account.link.signed_in()
            except Locked:
                GLib.idle_add(self.ui.signin, name, {"kind": "locked"})
                return
            if not kept:
                GLib.idle_add(self.ui.signin, name, {"kind": "out"})
                return
        GLib.idle_add(self.ui.signin, name, {"kind": "getting"})
        account.task = asyncio.get_running_loop().create_task(account.live())

    async def stop(self, name):
        """A messenger switched off: disconnected, its login kept."""
        account = self.accounts.get(name)
        if account is not None:
            await account.stop()
        GLib.idle_add(self.ui.signin, name, {"kind": "off"})

    async def logout(self, name):
        """Out of a messenger's account: disconnected, the login and the
        messages kept of it here forgotten."""
        account = self.accounts.get(name)
        if account is None:
            return
        await account.stop()
        await account.link.logout()
        for chat_id in list(account.chats):
            self.cache.drop(chat_id)
        account.chats = {}
        GLib.idle_add(self.ui.signin, name, {"kind": "out"})

    async def call(self, action, peer=None, conversation=None):
        account = self.accounts.get("max")
        if account is None or not account.can("calls"):
            raise Offline()
        account.ask()
        if action == "dial":
            if account.call is not None:
                return
            # Only an existing dialog may be called, never a group/channel.
            chat = account.chats.get(peer)
            if chat is None or chat.kind != "DIALOG":
                raise ValueError("not a MAX dialog")
            person = account.peer(chat)
            if person is None or person == account.me:
                raise ValueError("not another person")
            call = account.new_call(str(uuid.uuid4()), person, False)
            try:
                params = await account.link.dial(call.id, person)
                if not call.closed or call.end_reason:
                    call.start(params)
            except BaseException:
                await call.end(None, "failed")
                raise
        else:
            call = account.call
            if call is None or call.id != conversation:
                return  # a late button press must not affect a replacement call
            if action == "answer":
                call.job(call.answer())
            elif action == "end":
                await call.end(call.hangup_reason())

    async def password(self, name, text):
        """The cloud password the sign-in asked for (Account.on_password)."""
        account = self.accounts.get(name)
        if account is not None:
            account.answer(text)

    def run(self, coro, done=None, owner=None):
        """Run a coroutine in the messengers' thread; done(result, error) in
        the window's, always: an error (Offline) if the thread is not
        running. Not called when owner (a ChatView) is gone by then."""
        def answer(res, err):
            if done and not getattr(owner, "gone", False):
                done(res, err)
            return False
        if self.loop is None or self.loop.is_closed():
            coro.close()
            GLib.idle_add(answer, None, Offline())
            return
        fut = asyncio.run_coroutine_threadsafe(coro, self.loop)

        def back(f):
            try:
                res, err = f.result(), None
            except Exception as exc:
                res, err = None, exc
            GLib.idle_add(answer, res, err)
        fut.add_done_callback(back)

    def retry(self, name=None):
        """Start the links that gave up again now, not after the pause (the
        wait page's button); one messenger's only with name. One that
        waits for a closed keyring is asked again."""
        for account in self.accounts.values():
            if name in (None, account.id):
                account.retry()
        if name is not None and self.loop is not None:
            account = self.accounts.get(name)
            if account is None or account.task is None:
                asyncio.run_coroutine_threadsafe(self.begin(name, quiet=True), self.loop)

    def of(self, some_id):
        """The account whose chat or person this id is; Offline if none."""
        for account in self.accounts.values():
            if account.owns(some_id):
                return account
        raise Offline()

    def label(self, name):
        account = self.accounts.get(name)
        return account.label if account else dict(MESSENGERS).get(name, name)

    def can(self, what, some_id=None):
        """Whether the account of this id (any account, without one) can
        do this (PyMaxLink.can)."""
        if some_id is not None:
            return any(a.owns(some_id) and a.can(what) for a in self.accounts.values())
        return any(a.can(what) for a in self.accounts.values())

    # --- what the window asks, to the account it is for ---------------------------
    async def history(self, chat_id):
        return await self.of(chat_id).history(chat_id)

    async def older(self, chat_id, before):
        return await self.of(chat_id).older(chat_id, before)

    async def media_url(self, chat_id, msg_id, item):
        return await self.of(chat_id).media_url(chat_id, msg_id, item)

    async def forward(self, chat_id, msg_id, from_chat_id):
        return await self.of(chat_id).forward(chat_id, msg_id, from_chat_id)

    async def send(self, chat_id, text, files=()):
        return await self.of(chat_id).send(chat_id, text, files)

    async def add_contact(self, user_id):
        return await self.of(user_id).add_contact(user_id)

    async def remove(self, chat_id):
        return await self.of(chat_id).remove(chat_id)

    async def react(self, chat_id, msg_id, emoji):
        return await self.of(chat_id).react(chat_id, msg_id, emoji)

    async def rename(self, user_id, name):
        return await self.of(user_id).rename(user_id, name)

    async def read(self, chat_id, msg_id):
        return await self.of(chat_id).read(chat_id, msg_id)

    async def find_phone(self, phone):
        """The people with this phone number, one per messenger that has
        them (each says whose: account, label); the error of the last asked
        if none."""
        error, found = Offline(), []
        for account in self.accounts.values():
            if account.can("phone") and account.online:
                try:
                    found.append(await account.find_phone(phone))
                except Exception as exc:
                    error = exc
        if not found:
            raise error
        return found

    def _by_link(self, link):
        host = urllib.parse.urlsplit(link).hostname or ""
        for account in self.accounts.values():
            if account.can("links") and any(host == h or host.endswith("." + h)
                                            for h in account.link.hosts):
                return account
        raise Offline()

    async def link_info(self, link):
        return await self._by_link(link).link_info(link)

    async def search(self, query):
        """Public channels and groups by name in every messenger online that
        can search; the error of the last asked if none answered."""
        error, found, asked = Offline(), [], False
        for account in self.accounts.values():
            if account.can("search") and account.online:
                try:
                    found += await account.search(query)
                    asked = True
                except Exception as exc:
                    error = exc
        if not asked:
            raise error
        return found

    async def join(self, link):
        return await self._by_link(link).join(link)

    def download(self, ref, path, timeout=600):
        """From a worker thread (Media's): an attachment a messenger's link
        fetches itself (a ref it gave, not a link) into path; raises what
        failed (Offline with no connection)."""
        if self.loop is None or self.loop.is_closed():
            raise Offline()
        account = self.of(ref)
        account.ask()
        asyncio.run_coroutine_threadsafe(account.link.download(ref, path), self.loop).result(timeout)

    async def log(self, events):
        """Telemetry events to the messengers that take them (MAX's)."""
        for account in self.accounts.values():
            if account.can("telemetry"):
                await account.log(events)


class Account:
    """One messenger's account on top of its link (CONTEXT.md: Аккаунт): the
    chat list and its summaries, names, known people, the message cache and
    its gaps, pages, reactions. Its state files are in folder (DATA for
    MAX, as before there were others). It is the link's events object
    (on_qr, on_login, on_message, on_reaction, on_delete, on_disconnect);
    live() keeps the link up: started again when it gives up, after RETRY's
    pauses (retry() cuts one short), the window told ui.failed(account,
    why, pause) and ui.connected(account, on). Requests that need the
    messenger call ask() first: Offline while not connected."""

    def __init__(self, ui, link, cache, folder):
        self.ui = ui
        self.link = link
        self.id, self.label = link.account, link.label  # "max"; "MAX"
        self.cache = cache
        self.folder = folder
        self.known_path = os.path.join(folder, "known.json")
        self.aliases_path = os.path.join(folder, "names.json")
        self.loop = None
        self.task = None  # live(), while it runs
        self.online = False  # logged in and connected: requests go to the messenger
        self.tries = 0  # the link's starts in a row that ended without a login
        self.wake = None  # set by retry(): the pause before the next start ends
        self.secret = None  # a future the sign-in waits on for the cloud password
        self.me = None
        self.call = None
        self.names = {}
        self.chats = {}
        self.seeded = os.path.exists(self.known_path)
        self.known = set(load_json(self.known_path, []))
        self.agent = None  # the browser user agent the link presents, once logged in
        self.aliases = {self.key(k): v for k, v in load_json(self.aliases_path, {}).items()}

    def key(self, text):
        """An id from a file's key (JSON keys are strings): MAX's are numbers."""
        return int(text) if self.link.prefix is None else text

    def owns(self, some_id):
        """Whether a chat's or a person's id is this account's."""
        prefix = self.link.prefix
        if prefix is None:
            return isinstance(some_id, int) and not isinstance(some_id, bool)
        return isinstance(some_id, str) and some_id.startswith(prefix)

    def can(self, what):
        return what in getattr(self.link, "can", ())

    def retry(self):
        """Start the link again now, not after the pause."""
        if self.loop is not None and self.wake is not None:
            self.loop.call_soon_threadsafe(self.wake.set)

    def ask(self):
        """The messenger can be asked now; else Offline, and nothing is sent."""
        if not self.online:
            raise Offline()

    async def stop(self):
        """Disconnected: the link's run() cancelled (PyMax closes on it)."""
        task, self.task = self.task, None
        if self.call is not None:
            await self.call.end(self.call.hangup_reason())
        self.online = False
        if task is not None:
            task.cancel()
            try:
                await task
            except BaseException:  # its cancellation, or what it died of
                pass

    async def live(self):
        os.makedirs(self.folder, mode=0o700, exist_ok=True)
        self.loop = asyncio.get_running_loop()
        self.wake = asyncio.Event()
        while True:  # the link lives till it gives up; then it is started again
            try:
                await self.link.run(self)
                why = "соединение закрыто"
            except Locked:  # the keyring closed: asked again by retry() only
                self.online = False
                log_line("%s: the keyring is closed" % self.id)
                GLib.idle_add(self.ui.signin, self.id, {"kind": "locked"})
                self.wake.clear()
                await self.wake.wait()
                continue
            except Exception as exc:
                why = repr(exc)
            self.online = False
            if self.call is not None:
                await self.call.end(None, "failed")
            pause = RETRY[min(self.tries, len(RETRY) - 1)]
            self.tries += 1
            log_line("%s: link gave up (%s); again in %s s" % (self.id, why, pause))
            GLib.idle_add(self.ui.failed, self.id, why, pause)
            self.wake.clear()
            try:
                await asyncio.wait_for(self.wake.wait(), pause)
            except asyncio.TimeoutError:
                pass

    # --- the link's events ------------------------------------------------------
    def new_call(self, conversation, peer, incoming):
        def changed(call, state):
            if self.call is call:
                GLib.idle_add(self.ui.call_changed, {
                    "id": call.id, "name": self.name(call.peer, "Собеседник"), "state": state})
                if call.closed:
                    self.call = None
        call = self.call = VoiceCall(conversation, peer, incoming, changed, self.agent)
        changed(call, call.state)
        return call

    async def on_call_frame(self, opcode, payload):
        if opcode in (120, 121):
            if opcode == 120 and (self.call is None or not self.call.incoming or self.call.accepted):
                return
            if self.call is not None and self.call.id == payload.get("conversationId"):
                await self.call.end()
            return
        if not self.online or not self.can("calls") or self.call is not None:
            return
        log_line("voice call: invitation received")
        try:
            params = call_params(payload["vcp"])
            conversation, peer = payload["conversationId"], int(payload["callerId"])
            call_endpoint(params, conversation, True)  # validate before showing the invitation
        except Exception:
            log_line("voice call: invalid invitation")
            return
        call = self.new_call(conversation, peer, True)
        call.start(params)

    async def on_qr(self, qr_url):
        path = os.path.join(self.folder, "qr.png")
        qr_png(qr_url, path)
        GLib.idle_add(self.ui.show_qr, self.id, path)

    async def on_password(self, wrong=False):
        """The sign-in needs the account's cloud password (Telegram's
        two-step verification): the card asks; Backend.password answers."""
        self.secret = self.loop.create_future()
        GLib.idle_add(self.ui.signin, self.id, {"kind": "password", "wrong": wrong})
        try:
            return await self.secret
        finally:
            self.secret = None

    def answer(self, text):
        if self.secret is not None and not self.secret.done():
            self.secret.set_result(text)
            GLib.idle_add(self.ui.signin, self.id, {"kind": "getting"})

    async def on_login(self, me, chats, contacts, agent, session_id):
        try:
            os.remove(os.path.join(self.folder, "qr.png"))
        except OSError:
            pass
        self.me = me.id if me else None
        self.agent = agent
        self.online = True
        self.tries = 0
        if me:
            self.names[self.me] = me.name
            GLib.idle_add(self.ui.signin, self.id, {"kind": "in", "name": self.name(self.me)})
        # On a reconnect the sync only brings chats that changed since the
        # last one, so page through the whole list as well.
        found = {c.id: c for c in chats or []}
        marker = None
        for _page in range(5):
            try:
                page = await self.link.chats_page(marker)
            except Exception:
                break
            fresh = [c for c in page if c.id not in found]
            for c in page:
                found.setdefault(c.id, c)
            if not page or not fresh:
                break
            marker = min(c.time for c in page if c.time) - 1
        chats = list(found.values())
        self.chats = found
        # The contacts come whole on the first login, then only what changed:
        # keep them on disk. The first time, everyone already in a dialog
        # counts too, so that nobody known goes quiet after an update.
        for u in contacts or []:
            if u:
                self.known.add(u.id)
                self.names.setdefault(u.id, u.name)
        if not self.seeded:
            self.known.update(p for p in map(self.peer, chats) if p)
            self.seeded = True
        save_json(self.known_path, sorted(self.known))
        want = set()
        for c in chats:
            if c.kind == "DIALOG":
                want.update(u for u in c.members if u != self.me)
        await self.lookup(want)
        GLib.idle_add(self.ui.connected, self.id, True)
        if self.me:
            GLib.idle_add(self.ui.logged_in, self.id, self.me, session_id)
            if self.can("invites"):
                GLib.idle_add(self.ui.show_invites, self.link.invites())
        GLib.idle_add(self.ui.show_chats, self.id, [self.summary(c) for c in chats])

    async def on_message(self, msg):
        await self.lookup({msg.sender})
        known = msg.chat in self.chats  # a new chat comes with its count
        chat = await self.chat(msg.chat) if msg.chat is not None else None
        if chat is not None:
            chat.last = msg
            if msg.sender != self.me and known:
                chat.unread += 1
        out = self.message(msg)
        if msg.chat is not None:
            self.cache.add(msg.chat, [out])
        GLib.idle_add(self.ui.incoming, out, self.summary(chat) if chat is not None else None)

    async def on_disconnect(self, why):
        """The connection is lost; the link connects again by itself."""
        self.online = False
        if self.call is not None:
            await self.call.end(None, "failed")
        log_line("%s: connection lost: %s" % (self.id, why))
        GLib.idle_add(self.ui.connected, self.id, False)

    async def on_delete(self, chat_id, msg_ids):
        """Messages deleted (by their sender for everyone, or here): out of
        the cache and the window; the chat's last message anew if it went.
        Without the chat (Telegram tells it only for channels) the ids are
        the account's own, and the chats that have them are looked for."""
        if chat_id is None:
            gone = set(msg_ids)
            for cid, chat in list(self.chats.items()):
                if (chat.last is not None and chat.last.id in gone) or \
                        any(m["id"] in gone for m in self.cache.read(cid)):
                    await self.on_delete(cid, msg_ids)
            return
        self.cache.forget(chat_id, msg_ids)
        chat = self.chats.get(chat_id)
        summary = None
        if chat is not None:
            if chat.last is not None and chat.last.id in msg_ids:
                try:
                    newest = await self.link.history(chat_id, 1)
                except Exception:
                    newest = []
                chat.last = newest[-1] if newest else None
            summary = self.summary(chat)
        GLib.idle_add(self.ui.deleted, chat_id, list(msg_ids), summary)

    async def on_reaction(self, chat_id, msg_id, reactions):
        """Someone's reaction changed; the event does not say whose, so the
        account's own stays as it was known."""
        self.cache.react(chat_id, msg_id, reactions)
        GLib.idle_add(self.ui.reacted, chat_id, msg_id, reactions, ...)

    # --- names, summaries, messages ---------------------------------------------
    async def lookup(self, ids):
        ids = [i for i in ids if i and i not in self.names]
        for k in range(0, len(ids), 50):
            try:
                users = await self.link.users(ids[k:k + 50])
            except Exception:
                continue
            for u in users or []:
                self.names[u.id] = u.name

    def peer(self, chat):
        """The other person of a dialog (None in Избранное, a group, a channel)."""
        if chat.kind != "DIALOG":
            return None
        others = [u for u in chat.members if u != self.me]
        return others[0] if others else None

    def remember(self, user_id):
        """Someone whose messages are welcome: a contact, or written to here."""
        if user_id and user_id != self.me and user_id not in self.known:
            self.known.add(user_id)
            save_json(self.known_path, sorted(self.known))

    def name(self, user_id, default=""):
        """The name given here, else the one in MAX."""
        return self.aliases.get(user_id) or self.names.get(user_id, default)

    def title(self, chat):
        if chat.title:
            return chat.title
        if chat.kind == "DIALOG":
            others = [u for u in chat.members if u != self.me]
            if not others:
                return "Избранное"
            return self.name(others[0], "Собеседник")
        return "Чат"

    def preview(self, msg):
        if not msg:
            return ""
        text = msg.text.replace("\n", " ")
        if not text:
            text = ", ".join(p or "фото" for p in msg.parts).capitalize()
        if msg.fwd is not None:
            text = "↪ " + text
        if msg.sender == self.me and self.me:
            text = "Вы: " + text
        return text

    def summary(self, chat):
        last = chat.last
        peer = self.peer(chat)
        return {"id": chat.id, "account": self.id, "title": self.title(chat), "type": chat.kind,
                "last": self.preview(last), "time": (last.time if last else 0) or chat.time,
                "unread": chat.unread, "peer": peer,
                "stranger": peer is not None and peer not in self.known}

    def message(self, msg):
        """A message as the window and the cache keep it (a dict)."""
        forwarded = None
        if msg.fwd is not None:  # from whom: the chat it came from, else its sender
            forwarded = msg.fwd.get("chat") or self.name(msg.fwd.get("sender")) or "…"
        body = msg.text
        if msg.notes:
            body = (body + "\n" if body else "") + " ".join("[%s]" % n for n in msg.notes)
        return {"id": msg.id, "chat": msg.chat, "sender": msg.sender,
                "who": self.name(msg.sender), "text": body, "photos": list(msg.photos),
                "time": msg.time, "mine": bool(self.me) and msg.sender == self.me,
                "reactions": [list(r) for r in msg.reactions], "yours": msg.yours,
                "media": [dict(i) for i in msg.media], "forwarded": forwarded}

    async def chat(self, chat_id):
        """The chat, from the list or asked for (one just joined, a new
        dialog that has its first message); None if MAX has none."""
        chat = self.chats.get(chat_id)
        if chat is None:
            try:
                found = await self.link.chats([chat_id])
            except Exception:
                found = []
            if found:
                chat = self.chats[chat_id] = found[0]
        return chat

    # --- what the window asks -----------------------------------------------------
    async def history(self, chat_id):
        """The newest PAGE messages of a chat, and whether they leave a gap
        after the cache (more came meanwhile than a page): then the cache is
        started anew from them."""
        chat = await self.chat(chat_id)
        if not chat:
            return [], False  # a dialog nobody has written to yet
        # Nothing new since a full cache: no request at all (new messages
        # and reactions while running come as events). A cache of a few
        # messages (a chat that came by an event) is not full: asked for.
        cached = self.cache.read(chat_id)
        last = chat.last
        if len(cached) >= PAGE and last and not chat.unread and \
                any(m["id"] == last.id for m in cached[-5:]):
            return [], False
        self.ask()
        msgs = await self.link.history(chat_id, PAGE)
        if any(m.sender == self.me for m in msgs):
            self.remember(self.peer(chat))
        await self.lookup({m.sender for m in msgs})
        msgs.sort(key=lambda m: m.time)
        if msgs:
            try:
                await self.link.read(chat_id, msgs[-1].id)
                chat.unread = 0
            except Exception:
                pass
        out = [self.message(m) for m in msgs]
        if out:  # deleted while away: in the cache, within the page, no longer in MAX
            fetched = {m["id"] for m in out}
            gone = [m["id"] for m in cached if m["time"] >= out[0]["time"] and m["id"] not in fetched]
            if gone:
                self.cache.forget(chat_id, gone)
                cached = [m for m in cached if m["id"] not in gone]
        known = {m["id"] for m in cached}
        gap = bool(cached) and len(out) >= PAGE and not known & {m["id"] for m in out} and \
            out[0]["time"] > cached[-1]["time"]
        if gap:
            self.cache.drop(chat_id)
        self.cache.add(chat_id, out)
        return out, gap

    async def older(self, chat_id, before):
        """PAGE messages older than the time before (ms), oldest first; not
        cached, the cache keeps only the newest."""
        self.ask()
        if not await self.chat(chat_id):
            return []
        msgs = await self.link.history(chat_id, PAGE, before=before)
        await self.lookup({m.sender for m in msgs})
        msgs = sorted((m for m in msgs if m.time < before), key=lambda m: m.time)
        return [self.message(m) for m in msgs]

    async def media_url(self, chat_id, msg_id, item):
        """Where a video or a file of a message can be fetched (MAX hands
        out short-lived links on request)."""
        self.ask()
        return await self.link.media_url(chat_id, msg_id, item)

    async def forward(self, chat_id, msg_id, from_chat_id):
        """Forward a message into a chat; (the new message, that chat's
        summary) as the window shows them."""
        self.ask()
        msg = await self.link.forward(chat_id, msg_id, from_chat_id)
        out = self.message(msg)
        self.cache.add(chat_id, [out])
        chat = await self.chat(chat_id)
        if chat is not None:
            chat.last = msg
        return out, self.summary(chat) if chat is not None else None

    async def send(self, chat_id, text, files=()):
        self.ask()
        chat = self.chats.get(chat_id)
        # A dialog not started yet is numbered own id XOR theirs.
        self.remember(self.peer(chat) if chat else self.link.dialog_of(self.me, chat_id)
                      if self.me else None)
        msg = await self.link.send(chat_id, text, list(files)) if files else \
            await self.link.send(chat_id, text)
        if isinstance(msg, list):  # each file a message of its own (Telegram)
            out = [self.message(m) for m in msg]
            self.cache.add(chat_id, out)
            return out
        out = self.message(msg) if msg else None
        if out:
            self.cache.add(chat_id, [out])
        return out

    async def find_phone(self, phone):
        """The person with this phone number, if they are in MAX."""
        self.ask()
        user = await self.link.find_phone(phone)
        self.names[user.id] = user.name
        return {"id": user.id, "name": self.name(user.id), "account": self.id, "label": self.label,
                "chat": self.link.dialog_of(self.me, user.id) if self.me else None}  # their dialog

    async def add_contact(self, user_id):
        self.ask()
        user = await self.link.add_contact(user_id)
        self.names[user.id] = user.name
        self.remember(user.id)

    async def search(self, query):
        """Public channels and groups by name, not joined yet, with their
        link: as link_info's answers."""
        self.ask()
        return [{"id": c.id, "title": c.title or "Без названия", "type": c.kind,
                 "members": c.count or len(c.members), "joined": False, "link": c.link,
                 "account": self.id, "label": self.label}
                for c in await self.link.search(query) if c.link and c.id not in self.chats]

    async def link_info(self, link):
        """The channel or group behind a link, before joining it."""
        self.ask()
        chat = await self.link.link_info(link)
        if chat is None:
            return None
        return {"id": chat.id, "title": chat.title or "Без названия", "type": chat.kind,
                "members": chat.count or len(chat.members),
                "joined": chat.id in self.chats}

    async def join(self, link):
        self.ask()
        chat = await self.link.join(link)
        self.chats[chat.id] = chat
        return self.summary(chat)

    async def remove(self, chat_id):
        """Leave a channel or group, delete a dialog: for this account only
        (the link can do no other)."""
        self.ask()
        chat = self.chats.get(chat_id)
        stamp = chat.time if chat else None
        if chat is not None and chat.kind in ("CHAT", "CHANNEL"):
            await self.link.leave(chat_id)
            try:  # and its messages off the list, as the app does
                await self.link.delete(chat_id, stamp)
            except Exception:
                pass
        else:
            await self.link.delete(chat_id, stamp)
        self.chats.pop(chat_id, None)
        self.cache.drop(chat_id)

    async def react(self, chat_id, msg_id, emoji):
        """Put the account's reaction on a message (None takes it off);
        (reactions, own emoji) as MAX has them afterwards, or None."""
        self.ask()
        info = await self.link.react(chat_id, msg_id, emoji)
        if info is None:
            return None  # taken, but MAX sent no counts: the window counts itself
        reactions, _ = info
        self.cache.react(chat_id, msg_id, reactions, emoji)
        return reactions, emoji

    async def rename(self, user_id, name):
        """Call someone by another name here (empty: by theirs in MAX again);
        MAX itself keeps no such names for its web client. The summaries of
        their dialogs come back renamed."""
        if name:
            self.aliases[user_id] = name
        else:
            self.aliases.pop(user_id, None)
        save_json(self.aliases_path, {str(k): v for k, v in self.aliases.items()})
        return [self.summary(c) for c in self.chats.values() if self.peer(c) == user_id]

    async def read(self, chat_id, msg_id):
        self.ask()
        await self.link.read(chat_id, msg_id)

    async def log(self, events):
        """Telemetry events (dicts shaped as PyMax's TelemetryEvent) to MAX."""
        if self.online:
            await self.link.log(events)


class MessageCache:
    """The message cache (CONTEXT.md: Кэш сообщений): the newest KEEP
    messages of each chat, so a chat opens at once. A chat's messages are
    read from its file (folder/<id>.json, 600) the first time they are
    needed and kept in memory; a change is written by a thread of its own
    `delay` s after the last one, all of a chat at once and atomically
    (.new + os.replace), and whatever is left at flush() (the program's
    end). Both threads use it; read() gives a copy."""

    def __init__(self, folder, delay=2.0):
        self.folder, self.delay = folder, delay
        self.chats = {}  # chat id -> its messages, oldest first
        self.dirty = set()  # chat ids changed and not written yet
        self.lock = threading.Lock()
        self.timer = None

    def _path(self, chat_id):
        if isinstance(chat_id, str):  # another messenger's ("tg:…"): in a folder of its own
            prefix, _, rest = chat_id.partition(":")
            return os.path.join(self.folder, prefix, "%s.json" % rest)
        return os.path.join(self.folder, "%d.json" % chat_id)

    def _get(self, chat_id):  # under the lock
        msgs = self.chats.get(chat_id)
        if msgs is None:
            try:
                with open(self._path(chat_id)) as fh:
                    msgs = json.load(fh)
            except (OSError, ValueError):
                msgs = []
            if not isinstance(msgs, list):
                msgs = []
            self.chats[chat_id] = msgs
        return msgs

    def _changed(self, chat_id):  # under the lock
        self.dirty.add(chat_id)
        if self.timer is None:
            self.timer = threading.Timer(self.delay, self.flush)
            self.timer.daemon = True
            self.timer.start()

    def read(self, chat_id):
        """The chat's cached messages, oldest first (a copy)."""
        with self.lock:
            return [dict(m) for m in self._get(chat_id)]

    def add(self, chat_id, msgs):
        """Messages merged in (by id); the newest KEEP stay."""
        if not msgs:
            return
        with self.lock:
            known = {m["id"]: m for m in self._get(chat_id)}
            for m in msgs:
                known[m["id"]] = dict(m)
            self.chats[chat_id] = sorted(known.values(), key=lambda m: m["time"] or 0)[-KEEP:]
            self._changed(chat_id)

    def react(self, chat_id, msg_id, reactions, yours=...):
        """New reactions of one cached message (yours left alone if not given)."""
        with self.lock:
            for m in self._get(chat_id):
                if m["id"] == msg_id:
                    m["reactions"] = reactions
                    if yours is not ...:
                        m["yours"] = yours
                    self._changed(chat_id)
                    return

    def forget(self, chat_id, msg_ids):
        """Deleted messages out of a chat's cache."""
        gone = set(msg_ids)
        with self.lock:
            msgs = self._get(chat_id)
            keep = [m for m in msgs if m["id"] not in gone]
            if len(keep) != len(msgs):
                self.chats[chat_id] = keep
                self._changed(chat_id)

    def drop(self, chat_id):
        """The chat's cache gone, on disk too (a gap, or the chat removed)."""
        with self.lock:
            self.chats[chat_id] = []
            self.dirty.discard(chat_id)
            try:
                os.remove(self._path(chat_id))
            except OSError:
                pass

    def flush(self):
        """Every change not yet on disk, written now."""
        with self.lock:
            self.timer = None
            dirty, self.dirty = self.dirty, set()
            for chat_id in dirty:
                try:
                    path = self._path(chat_id)
                    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
                    fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                    with os.fdopen(fd, "w") as fh:
                        json.dump(self.chats.get(chat_id, []), fh, ensure_ascii=False)
                    os.replace(path + ".new", path)
                except OSError as exc:
                    log_line("cache %s: %r" % (chat_id, exc))


def load_json(path, default):
    """A small state file of DATA, or default if missing or broken."""
    try:
        with open(path) as fh:
            data = json.load(fh)
        return data if isinstance(data, type(default)) else default
    except (OSError, ValueError):
        return default


def save_json(path, data):
    """Written whole and atomically, mode 600 (it names people)."""
    save_text(path, json.dumps(data, ensure_ascii=False))


_save_lock = threading.Lock()


def save_text(path, text):
    """A file written whole and atomically, mode 600, from any thread."""
    with _save_lock:
        try:
            os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
            fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as fh:
                fh.write(text)
            os.replace(path + ".new", path)
        except OSError:
            pass


def load_setting(key):
    """A yes/no setting of [max] (telemetry, buzz…); yes until set."""

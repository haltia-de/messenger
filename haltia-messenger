    def moved(self):
        """Tell telemetry which screen is in front."""
        if not self.win.is_visible():
            return
        page = self.stack.get_visible_child_name()
        if page == "chats":
            self.telemetry.go(SCREEN_CHATS, MAIN_TAB)
        elif page == "find":
            self.telemetry.go(SCREEN_SEARCH)
        elif page == "chat":
            s = self.about(self.open_chat)
            self.telemetry.go(SCREEN_CHAT, {"source_type": 1 if s.get("type") == "DIALOG" else 2,
                                            "source_id": self.open_chat})
        elif page == "settings":
            self.telemetry.go(SCREEN_SETTINGS)

    # a chat
    def about(self, chat_id):
        """The chat's summary, also of a dialog not yet written to."""
        return self.chatlist.get(chat_id) or {}

    def view_for(self, chat_id):
        """The chat's ChatView: kept from before, else built from the cache."""
        view = self.views.pop(chat_id, None)
        if view is None:
            view = ChatView(
                chat_id, self.about(chat_id).get("type"), self.backend.cache.read(chat_id),
                fetch_older=lambda before, done: self.backend.run(
                    self.backend.older(chat_id, before), done, owner=self.views.get(chat_id)),
                on_hold=lambda msg_id, widget: self.pick_reaction(chat_id, msg_id, widget),
                on_media=lambda m, item, ctl: self.media_tapped(chat_id, m, item, ctl),
                on_react=lambda msg_id, emoji: self.react(chat_id, msg_id, emoji),
                photo=self.media.photo, on_photo=self.show_photo,
                on_forward=lambda msg_id: self.show_forward(chat_id, msg_id),
                on_save=lambda m, item, b: self.save_message(chat_id, m, [item], b),
                missed=self.missed_calls.get(str(chat_id)),
                seen=self.about(chat_id).get("seen", 0),
                seen_by=self.about(chat_id).get("seen_by", "time"),
                on_unsent=self.unsent)
            for q in self.queue.values():  # its messages not sent yet, at the bottom
                if q["chat"] == chat_id:
                    view.add(q["m"])
        self.views[chat_id] = view  # most recently used last
        while len(self.views) > VIEWS:
            old_id = next(iter(self.views))
            old = self.views.pop(old_id)
            if old is self.view:
                self.views[old_id] = old
                break
            old.destroy()
        return view

    def dial_call(self, video=False):
        chat_id = self.open_chat
        if self.call_id is not None or self.dial_confirming or chat_id is None:
            return
        summary = self.about(chat_id)
        if summary.get("type") != "DIALOG" or not self.backend.can("calls", chat_id):
            return
        self.dial_confirming = True
        try:
            confirmed = dialogs.ask(self.win, ("Позвонить %s по видео?" if video else "Позвонить %s?") % summary.get("title", "собеседнику"),
                                    "Позвонить")
        finally:
            self.dial_confirming = False
        # A dialog runs a nested GTK loop: an incoming call or a changed
        # chat while it was open must not dial the old target afterwards.
        if confirmed and self.call_id is None and self.open_chat == chat_id:
            self.stop_sound()
            self.record_stop(False)
            self.backend.run(self.backend.call("dial", peer=chat_id, **({"video": True} if video else {})), self.call_result)

    def call_action(self, action, video=False):
        if self.call_id is None:
            self.call_box.hide()
            self.call_pages.set_visible_child_name("messages")
            return
        if action in ("camera", "mute"):
            # One touch is one switch: a second within a second (a touch the
            # screen gives twice) would switch it back, «as if pressed».
            now = time.monotonic()
            if now - self.call_tapped.get(action, 0) < 1.0:
                log_line("voice call: a second %s tap within a second, not taken" % action)
                return
            self.call_tapped[action] = now
        self.call_answer.set_sensitive(False)
        self.call_ringer.stop()
        if action == "answer":
            self.stop_sound()
            self.record_stop(False)
        self.backend.run(self.backend.call(action, conversation=self.call_id, **({"video": True} if video else {})), self.call_result)

    def call_result(self, _result, error):
        if error and self.call_id is None:
            self.call_name.set_text("")
            self.call_portrait = None  # invalidate any outstanding photo callback
            self.call_photo.set_from_icon_name("avatar-default-symbolic", Gtk.IconSize.DIALOG)
            self.call_hint.hide()
            self.call_video_area.hide()
            self.call_identity.show()
            self.call_camera.hide()
            self.call_mute.hide()
            self.call_button.set_sensitive(True)
            self.call_answer.hide()
            # No screen to close: back in the chat, told under its title.
            self.call_box.hide()
            self.call_pages.set_visible_child_name("messages")
            self.sub.set_text("Не удалось соединиться. Позвоните ещё раз, когда будете готовы.")

    def set_call_full(self, on):
        """The talk full screen, or back to the window as it was."""
        if on == self.call_full_on:
            return
        self.call_full_on = on
        (self.win.fullscreen if on else self.win.unfullscreen)()
        set_switch(self.call_full, "full", on)

    def call_tick(self):
        """The talk's time and the microphone, once a second while it lasts."""
        if self.call_id is None or self.call_since is None:
            self.call_clock = None
            return False
        if self.call_note:
            return True
        said = "Разговор %s" % mmss(int(time.time() - self.call_since))
        self.call_label.set_text(said + (" · микрофон выключен" if self.call_muted else ""))
        return True

    def call_frame(self, conversation, own, frame):
        # Called by Gst streaming threads: one latest frame per stream, one
        # pending GTK delivery. Neither GTK nor account state is read here.
        with self.call_frame_lock:
            self.call_frames[own] = (conversation, frame)
            if self.call_frame_pending:
                return
            self.call_frame_pending = True
        GLib.idle_add(self._call_frames)

    def _call_frames(self):
        with self.call_frame_lock:
            frames, self.call_frames = self.call_frames, {}
            self.call_frame_pending = False
        for own, (conversation, frame) in frames.items():
            if conversation == self.call_id and (not own or self.call_video):
                (self.call_own if own else self.call_remote).picture(frame)
                if not own:
                    self.call_remote_seen = time.monotonic()
                    if self.call_remote_timer is None:
                        self.call_remote_timer = GLib.timeout_add(500, self._call_remote_stale)
        self.show_call_video()
        return False

    def _call_remote_stale(self):
        # The peer's video is what arrives, not what it announced: a peer
        # that stops sending without media-settings-changed leaves no black screen.
        if self.call_id is not None and time.monotonic() - self.call_remote_seen < REMOTE_STALE:
            return True
        self.call_remote_timer = None
        self.call_remote.picture(None)
        self.show_call_video()
        return False

    def show_call_video(self):
        """The video area while there is a picture to show, else the portrait;
        the peer's picture missing while the own shows is said, not black."""
        shown = self.call_remote.surface is not None or self.call_own.surface is not None
        self.call_video_area.set_visible(shown)
        self.call_identity.set_visible(not shown)
        self.call_remote_off.set_visible(shown and self.call_remote.surface is None)

    def call_changed(self, call):
        state = call["state"]
        if self.call_id is not None and self.call_id != call["id"]:
            return False
        terminal = state in ("ended", "failed", "unsupported")
        self.call_id = None if terminal else call["id"]
        text = {"ringing": "Входящий звонок", "dialling": "Звоним…",
                "connecting": "Соединяемся…", "active": "Разговор",
                "ended": "Звонок завершён", "failed": "Связь прервалась",
                "unsupported": "Этот вид соединения пока не поддерживается"}[state]
        self.call_video = bool(call.get("video")) and not terminal
        self.call_video_invitation = bool(call.get("video_invitation"))
        if state == "ringing" and self.call_video_invitation:
            text = "Видеозвонок"  # from whom: the name above
        self.call_muted = bool(call.get("muted"))
        self.call_note = call.get("video_error")  # said instead of the talk's time
        self.call_mute.set_visible(state == "active")
        self.call_full.set_visible(state in ("connecting", "active"))
        if state not in ("connecting", "active"):
            self.set_call_full(False)  # the talk over (or not begun): the window as it was
        set_switch(self.call_mute, "mic", not self.call_muted)
        self.call_since = call.get("since") if state == "active" else None
        if state == "active" and self.call_clock is None:
            self.call_clock = GLib.timeout_add_seconds(1, self.call_tick)
        self.call_camera.set_visible(state == "active" and video_on())
        wanted = call.get("video_wanted", self.call_video)
        set_switch(self.call_camera, "camera", wanted)
        # While the camera follows a tap, a second tap is not taken for another.
        self.call_camera.set_sensitive(wanted == self.call_video)
        self.call_own_box.set_visible(self.call_video)
        if call.get("remote_video") is False:
            self.call_remote.picture(None)  # said so: no need to wait for frames to stop
        live = state in ("connecting", "active")
        notes = []
        if live and call.get("remote_audio") is False:
            notes.append("🔇 Собеседник выключил микрофон")
        if live and call.get("remote_video") is False and (self.call_video or call.get("video_invitation")):
            notes.append("📷 Камера собеседника выключена")
        self.call_peer.set_text("\n".join(notes))
        self.call_peer.set_visible(bool(notes))
        if not self.call_video:
            self.call_own.picture(None)
        if terminal or state in ("ringing", "dialling"):
            self.call_remote.picture(None)
        self.show_call_video()
        if call.get("video_error"):
            text = call["video_error"]
        self.call_video_caption.set_text(call["name"] + (" · " + call["video_error"] if call.get("video_error") else ""))
        self.call_name.set_text(call["name"])
        self.call_hint.show()
        self.call_label.set_text(text)
        if state == "active" and not call.get("video_error"):
            self.call_tick()
        portrait = (call["id"], call.get("photo"))
        if portrait != self.call_portrait:
            self.call_portrait = portrait
            self.call_photo.set_from_icon_name("avatar-default-symbolic", Gtk.IconSize.DIALOG)
            def drawn(pixbuf):
                if self.call_portrait == portrait and pixbuf is not None:
                    self.call_photo.set_from_pixbuf(pixbuf)
            if portrait[1]:
                self.media.photo(portrait[1], drawn, size=180)
        self.call_answer.set_visible(state == "ringing")
        self.call_answer.set_sensitive(state == "ringing")
        self.call_end.show()
        self.call_end.set_label("Отклонить" if state == "ringing" else "Завершить")
        if terminal:
            # Straight back to the messages, nothing more to tap: how it
            # ended is said under the title, and kept in the chat's history.
            self.call_box.hide()
            self.call_pages.set_visible_child_name("messages")
            self.sub.set_text(text if state != "ended" else "Звонок завершён")
        else:
            self.call_box.show()
            self.call_pages.set_visible_child_name("call")
        self.call_button.set_sensitive(terminal)
        self.video_button.set_sensitive(terminal)
        if state in ("ringing", "dialling", "connecting", "active"):
            if self.call_inhibited != call["id"]:
                self.call_inhibited = call["id"]
                self.call_logind.hold()
                self.call_awake.hold()
        else:
            self.call_logind.release()
            self.call_awake.release()
            self.call_inhibited = None
        if state == "ringing":
            # The kit's questions and the file choosers run nested loops over
            # the window: answered «Отмена», they cannot cover the controls.
            self.clear_for_call()
            if self.call_notice != call["id"]:
                self.call_notice = call["id"]
                self.stop_sound()
                self.record_stop(False)
                self.win.set_focus(None)
                self.call_ringer.start()
                self.win.present()
                notification = Gio.Notification.new("Видеозвонок" if self.call_video_invitation else "Входящий звонок")
                notification.set_body(call["name"])
                notification.set_priority(Gio.NotificationPriority.URGENT)
                notification.set_category("call.incoming")
                notification.set_default_action("app.show-call")
                # GIO supplies desktop-entry=APP_ID on freedesktop desktops.
                self.send_notification(call_notice_id(call["id"]), notification)
                self.call_notice_at = time.monotonic()
        else:
            self.call_ringer.stop()
            self.withdraw_call_notice()
        if state == "dialling":
            self.call_ringback.start()
        else:
            self.call_ringback.stop()
        return False

    def withdraw_call_notice(self, now=False):
        """Take the ringing call's notification away (a critical one stays in
        mako till closed). GIO's freedesktop backend sends CloseNotification
        only once Notify has answered with the server's id, and drops a
        withdrawal made before: one that soon waits till CALL_NOTICE_SETTLE.
        Each call has its own id, so a later call's notification stays."""
        if self.call_notice is None:
            return
        key, self.call_notice = call_notice_id(self.call_notice), None
        wait = CALL_NOTICE_SETTLE - (time.monotonic() - self.call_notice_at)
        if now or wait <= 0:
            self.withdraw_notification(key)
        else:
            GLib.timeout_add(int(wait * 1000), lambda: self.withdraw_notification(key) and False)

    def missed_call(self, notice):
        """Remember the last unanswered incoming call and open its chat on tap."""
        key = str(notice["chat"])
        if self.missed_calls.get(key, {}).get("id") == notice["id"]:
            return False
        self.missed_calls[key] = dict(notice)
        save_json(self.missed_path, self.missed_calls)
        view = self.views.get(notice["chat"])
        if view is not None:
            view.missed_call(notice)
        note = Gio.Notification.new("Пропущенный звонок от " + notice["name"])
        note.set_category("call.missed")
        note.set_default_action_and_target("app.open-chat", GLib.Variant("s", json.dumps(notice["chat"])))
        self.send_notification("missed-call-" + key, note)
        return False

    def open(self, chat_id):
        start = time.monotonic()
        if self.open_chat != chat_id:
            self.keep_draft()  # the chat left keeps its own
            draft = self.drafts.pop(chat_id, None)
            if draft:
                self.entry.set_text(draft["text"])
                self.attached = list(draft["attached"])
                self.show_attached()
        if self.replying and self.replying[0] != chat_id:
            self.reply_to(None)  # an answer belongs to its chat
        if self.record_chat is not None and self.record_chat != chat_id:
            self.record_stop(False)  # another chat: the voice said for this one does not go there
        if self.call_id is None:
            self.call_box.hide()
            self.call_pages.set_visible_child_name("messages")
        self.withdraw_notification("chat-%s" % chat_id)  # Telegram's ids are strings
        self.withdraw_notification("missed-call-%s" % chat_id)
        notice = self.missed_calls.get(str(chat_id))
        if notice and not self.chatlist.get(chat_id):
            self.chatlist.start_dialog({"id": chat_id, "account": "max", "type": "DIALOG",
                                       "title": notice["name"], "peer": notice["peer"],
                                       "last": "", "time": 0, "unread": 0, "stranger": True})
        s = self.about(chat_id)
        self.open_chat = chat_id
        self.watch_reactions(chat_id)
        self.confirm.hide()
        self.naming.hide()
        self.edit.set_visible(self.chatlist.listed(chat_id))
        self.show_call_buttons(chat_id, s, True)
        if self.playing and self.playing_chat != chat_id and not self.keep_sound:
            self.stop_sound()  # another chat in front: the sound of the last one stops
        GLib.idle_add(lambda: self.show_nowplay() and False)
        view = self.view_for(chat_id)
        if self.view is not view:
            if self.view is not None:
                self.view.leave()
                self.chat_area.remove(self.view.widget)
            self.chat_area.pack_start(view.widget, True, True, 0)
            self.view = view
        self.title.set_text(s.get("title", ""))
        for child in self.head_face.get_children():
            child.destroy()
        face = avatar(s.get("title", ""), chat_id, s.get("photo"), self.media.photo, size=56)
        self.head_face.pack_start(face, False, False, 0)
        face.show_all()
        self.sub.set_text("" if not view.empty else "загрузка…")
        self.back.show()
        self.inputbar.set_visible(s.get("type") != "CHANNEL")
        self.stack.set_visible_child_name("chat")
        # Nothing focused: the on-screen keyboard comes when the entry is tapped,
        # not over the messages being read (and never in a channel).
        self.win.set_focus(None)
        view.enter()

        def done(res, err):
            came = time.monotonic()
            if err:
                if self.open_chat == chat_id:
                    self.sub.set_text("" if not view.empty else "не удалось загрузить")
                return
            msgs, gap = res

            def drawn():
                if self.open_chat == chat_id:
                    self.telemetry.chat_shown(int((came - start) * 1000),
                                              int((time.monotonic() - came) * 1000))
            view.newest(msgs or [], gap, done=drawn)
            if self.open_chat == chat_id:
                self.sub.set_text("")
            if self.chatlist.listed(chat_id):
                self.chatlist.read(chat_id)
                self.fill_list(only={chat_id})

        self.backend.run(self.backend.history(chat_id), done, owner=view)

    # voice messages, videos, files
    def media_tapped(self, chat_id, m, item, controls):
        """A media control of a chat tapped (ChatView's on_media)."""
        if item["kind"] == "audio":
            play = controls["button"]
            if item["url"] or (self.playing and self.playing[1] is play):
                self.play_sound(chat_id, m, item, play, controls["bar"], controls["length"],
                                item["url"])
                return
            play.set_sensitive(False)  # an audio file: its link first

            def done(url, err):
                play.set_sensitive(True)
                if err or not url:
                    log_line("audio file no link: %r" % (err,))
                    self.sub.set_text("не удалось открыть")
                    return
                self.play_sound(chat_id, m, item, play, controls["bar"], controls["length"], url)

            self.backend.run(self.backend.media_url(
                chat_id, m["id"], {"kind": "file", "id": item["file"]}), done)
        else:
            self.open_media(chat_id, m["id"], item, controls["button"])

    def play_sound(self, chat_id, m, item, play, bar, length, url):
        """What plays and where its button is are the window's; the playing
        is Media's. It plays only while its chat is in front: leaving it (for
        the list, another chat, the search, the settings) or hiding the
        window stops it (stop_sound)."""
        if self.playing and self.playing[1] is play:
            self.toggle_sound()
            return
        self.sound_end()
        if not self.media.voice(url):
            set_play(play, "fail")  # no libmpv here, or a link not to be opened
            return
        self.playing = [bar, play, length, secs(item["duration"]), item]
        self.playing_chat, self.playing_msg, self.playing_pos = chat_id, m["id"], 0.0
        # Its bubble gone (the chat cut or deleted): the sound stops too.
        if not getattr(play, "sound_watched", False):  # once per button, however often played
            play.sound_watched = True
            play.connect("destroy", lambda b: self.playing and self.playing[1] is b and (
                self.media.stop(), setattr(self, "playing", None),
                self.mpris and self.mpris.changed()))
        set_play(play, "pause")
        self.show_nowplay()
        if self.mpris:
            self.mpris.changed()

    def go_to_playing(self):
        """The chat of what plays, at its message."""
        if not self.playing or self.playing_chat is None:
            return
        self.open(self.playing_chat)
        view = self.views.get(self.playing_chat)
        if view is not None:
            view.show_message(self.playing_msg)

    def stop_sound(self):
        """Whatever plays stops, and its button shows ▶ again."""
        if self.playing:
            self.media.stop()
            self.sound_end()

    def toggle_sound(self):
        if self.playing:
            on = self.media.toggle()
            set_play(self.playing[1], "pause" if on else "play")
            set_play(self.nowplay_toggle, "pause" if on else "play")
            if self.mpris:
                self.mpris.changed()

    def show_nowplay(self):
        """The bar of what plays, with «Звук играет и вне чата»: from the
        moment it starts, in its chat too, so it is plain that it plays on
        when the chat is left (without the setting it stops there: no bar)."""
        show = bool(self.playing) and self.keep_sound
        if show:
            title = (self.chatlist.get(self.playing_chat) or {}).get("title", "")
            self.nowplay_label.set_text("🎵  %s  ·  %s" % (title, self.playing[2].get_text()))
            set_play(self.nowplay_toggle, self.playing[1].state)
        self.nowplay.set_visible(show)

    def sound_time(self, pos, total=None):
        """How far it played; the length is the message's, else the player's
        (an audio file carries none)."""
        if self.playing:
            self.playing_pos = pos
            bar, _play, length, known, _item = self.playing
            if not known and total:
                self.playing[3] = known = total
            if known:
                bar.set_fraction(min(1.0, pos / known))
            length.set_text(mmss(pos))
            if self.nowplay.get_visible():
                self.show_nowplay()
        return False

    def sound_end(self):
        if self.playing:
            bar, play, length, known, item = self.playing
            bar.set_fraction(0)
            set_play(play, "play")
            length.set_text(mmss(known) if known else size_text(item.get("size") or 0))
            self.playing = None
            self.show_nowplay()
            if self.mpris:
                self.mpris.changed()
        return False

    def open_media(self, chat_id, msg_id, item, button):
        """A video full screen in the shell's player, a file in the desktop's
        program for it; MAX gives the link on request."""
        button.set_sensitive(False)

        def done(url, err):
            button.set_sensitive(True)
            if err or not url:
                log_line("%s no link: %r" % (item["kind"], err))
                self.sub.set_text("не удалось открыть")
            elif item["kind"] == "video":
                self.sound_end()  # the voice playing stops for it
                if not self.media.video(url, self.title.get_text()):
                    self.sub.set_text("не удалось открыть видео")
            elif not openable(item.get("name")):
                self.sub.set_text("такой файл здесь не открывается — сохраните его")
            else:
                # Fetched, then opened by the desktop's program for its type.
                button.set_sensitive(False)
                if not self.media.file(url, item.get("name") or "файл", lambda opened: (
                        button.set_sensitive(True),
                        opened or self.sub.set_text("нечем открыть файл"))):
                    button.set_sensitive(True)
                    self.sub.set_text("нечем открыть файл")

        self.backend.run(self.backend.media_url(chat_id, msg_id, item), done)

    # reactions
    def pick_reaction(self, chat_id, msg_id, bubble):
        view = self.views.get(chat_id)
        m = view.message(msg_id) if view else None
        if m is None or m.get("state"):
            return  # one not sent yet has no reactions or menu: «Повторить», «Убрать»
        yours = m.get("yours")
        pop = Gtk.Popover.new(bubble)
        row = Gtk.Box(spacing=4)
        row.set_margin_start(6)
        row.set_margin_end(6)
        row.set_margin_top(6)
        row.set_margin_bottom(6)
        for emoji in REACTIONS:
            b = Gtk.Button(label=emoji)
            b.get_style_context().add_class("emoji")
            if emoji == yours:
                b.get_style_context().add_class("yours")  # a tap takes it off
            b.set_can_focus(False)
            b.connect("clicked", lambda _b, e=emoji: (
                pop.popdown(), self.react(chat_id, msg_id, None if e == yours else e)))
            row.pack_start(b, False, False, 0)
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        column.pack_start(row, False, False, 0)
        acts = []  # saving is each item's own button
        if m.get("text"):
            acts.append(("📋 Копировать текст", lambda: self.copy_text(chat_id, m["text"])))
        if self.inputbar.get_visible() and self.open_chat == chat_id:  # not in a channel
            acts.insert(0, ("↩️ Ответить", lambda: self.reply_to(m)))
        if view.on_forward is not None:
            acts.append(("↪️ Переслать", lambda: self.show_forward(chat_id, msg_id)))
        for text, act in acts:
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("menu")
            b.get_child().set_xalign(0.0)
            b.set_can_focus(False)
            b.connect("clicked", lambda _b, a=act: (pop.popdown(), a()))
            column.pack_start(b, False, False, 0)
        pop.add(column)
        pop.connect("closed", lambda p: GLib.idle_add(p.destroy))
        column.show_all()
        pop.popup()
        self.menu = pop  # the one open, for the tests

    def reply_to(self, m):
        """Answer this message with the next one sent (None: not)."""
        self.replying = (self.open_chat, m) if m else None
        if m:
            words = (m.get("text") or "Сообщение").replace("\n", " ")
            who = "вам" if m.get("mine") else m.get("who") or ""
            self.reply_note.set_text("↩ Ответ %s: %s" % (who, words) if who else "↩ Ответ: " + words)
        self.replybar.set_visible(bool(m))

    def copy_text(self, chat_id, text):
        """A message's text to the clipboard, said so under the title a while."""
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
        said = "Текст скопирован"
        self.sub.set_text(said)
        GLib.timeout_add_seconds(3, lambda: (
            self.open_chat == chat_id and self.sub.get_text() == said and self.sub.set_text(""))
            and False)

    def react(self, chat_id, msg_id, emoji):
        """Put the account's reaction (None: take it off), then show what
        MAX says, or count it here if MAX sent no counts."""
        def done(res, err):
            if err:
                log_line("reaction not put: %s %s" % (type(err).__name__, getattr(err, "error", "") or ""))
                if self.open_chat == chat_id:
                    self.sub.set_text("реакция не отправлена, попробуйте ещё раз")
                return
            if res is None:
                view = self.views.get(chat_id)
                m = view.message(msg_id) if view else None
                if m is None:
                    return
                counts = dict(m.get("reactions") or [])
                if m.get("yours") in counts:
                    counts[m["yours"]] -= 1
                if emoji:
                    counts[emoji] = counts.get(emoji, 0) + 1
                res = [[e, n] for e, n in counts.items() if n > 0], emoji
                self.backend.cache.react(chat_id, msg_id, *res)
            self.reacted(chat_id, msg_id, *res)

        self.backend.run(self.backend.react(chat_id, msg_id, emoji), done)

    def deleted(self, chat_id, msg_ids, summary):
        """Messages deleted in a chat (Backend.on_delete)."""
        view = self.views.get(chat_id)
        if view:
            view.remove(msg_ids)
        if summary and self.chatlist.listed(chat_id):
            self.chatlist.update(summary)
            self.fill_list(only={chat_id})
        return False

    def watch_reactions(self, chat_id):
        """The reactions of the newest messages of a chat opened, as the
        official app asks them: those put while away came in no event (MAX's
        events come live; the cached messages have the old counts)."""
        def ask():
            view = self.views.get(chat_id)
            if self.open_chat == chat_id and view is not None:
                self.backend.run(self.backend.reactions(chat_id, view.newest_ids()), lambda got, err: (
                    None if err or not got else
                    [self.reacted(chat_id, i, r, ...) for i, r in got.items()]))
            return False
        GLib.timeout_add(1500, ask)  # once the history is in

    def reacted(self, chat_id, msg_id, reactions, yours):
        """New reactions of a message (yours: ... when not known to change)."""
        view = self.views.get(chat_id)
        if view:
            view.reacted(msg_id, reactions, yours)
        return False

    def seen(self, chat_id, mark):
        """The others read a chat up to mark (Backend: on_read)."""
        s = self.chatlist.get(chat_id)
        if s is not None:
            s["seen"] = max(s.get("seen") or 0, mark)
        view = self.views.get(chat_id)
        if view:
            view.seen(mark)
        return False

    # emoji in the message
    def emoji_panel(self, show):
        if not show:
            pop = self.emoji_pop
            if pop:
                pop.popdown()
                self.emoji_closed(pop)  # now: its "closed" comes after the animation, if at all
            return
        if self.recent is None:
            self.recent = [e for e in load_json(EMOJI_RECENT, []) if isinstance(e, str)]
            self.recent_saved = list(self.recent)
        if self.emoji_built is None:  # built once: some hundreds of buttons
            pop = Gtk.Popover.new(self.smile)
            pop.set_modal(False)  # the entry keeps the focus, the keyboard stays
            pop.set_position(Gtk.PositionType.TOP)
            column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            for margin in ("start", "end", "top", "bottom"):
                getattr(column, "set_margin_" + margin)(8)
            recent_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            column.pack_start(recent_box, False, False, 0)
            for name, line in EMOJI:
                self.emoji_group(column, name, line.split())
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.set_kinetic_scrolling(True)
            scroll.set_size_request(760, 360)
            scroll.add(column)
            pop.add(scroll)
            pop.connect("closed", self.emoji_closed)
            scroll.show_all()
            self.emoji_built = [pop, recent_box, []]
        pop, recent_box, shown = self.emoji_built
        if shown != self.recent:  # the recent ones anew, only when they changed
            for child in recent_box.get_children():
                child.destroy()
            if self.recent:
                self.emoji_group(recent_box, "Недавние", self.recent)
            recent_box.show_all()
            self.emoji_built[2] = list(self.recent)
        self.emoji_pop = pop
        pop.popup()

    def emoji_group(self, column, name, emoji):
        column.pack_start(label(name, "emoji-group"), False, False, 4)
        grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           max_children_per_line=10, min_children_per_line=6)
        grid.set_can_focus(False)
        for e in emoji:
            b = Gtk.Button(label=e)
            b.get_style_context().add_class("emoji")
            b.set_can_focus(False)
            b.set_focus_on_click(False)
            b.connect("clicked", lambda _b, e=e: self.put_emoji(e))
            grid.add(b)

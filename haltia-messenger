def now_ms():
    return int(time.time() * 1000)


class Telemetry:
    """What MAX's app tells the server about its use, from what really
    happens here (see the top of the file). Called in the window's thread;
    the events leave through the MAX thread in small batches. The shapes
    and fixed values are PyMax 2.4.1's (pymax/telemetry/payloads.py)."""

    def __init__(self, backend):
        self.backend = backend
        self.on = load_setting("telemetry")
        self.user = None  # the account's id, once logged in
        self.session = 0
        self.screen = SCREEN_BACKGROUND
        self.last_go = now_ms()
        self.action = 0
        self.queue = []
        self.timer = 0

    def started(self, user, session):
        """Logged in, at start and after every reconnect, as PyMax does."""
        self.user, self.session = user, session
        self.add("PERF", "login", {
            "properties": {"connection_type": 2, "vpn": 0, "class": 2,
                           "background": 1, "warm_start": 1},
            "errorType": 100})

    def go(self, screen, params=None):
        """The person went to another screen (BACKGROUND: the window hid).
        Before the login nothing moves: the window tells again after it."""
        if screen == self.screen or self.user is None:
            return
        before, self.screen = self.screen, screen
        if before == SCREEN_BACKGROUND:
            self.session += 1  # a new visit, as the app counts them
        self.action = (self.action + 1) % 0xFFFFFFFF
        nav = {"prev_time": self.last_go, "screen_to": screen, "action_id": self.action,
               "screen_from": before}
        nav.update(params or {})
        self.last_go = now_ms()
        self.add("NAV", "GO", nav)
        if screen == SCREEN_BACKGROUND:
            self.flush()

    def chat_shown(self, messages, render):
        """A chat opened: ms until its messages came, then until drawn."""
        self.add("PERF", "open_chat_to_render", {
            "spans": [{"duration": messages + render, "name": "open_chat_to_render"},
                      {"duration": messages, "name": "messages_list_created"},
                      {"duration": render, "name": "messages_render"}],
            "properties": {"class": 2, "warm": 1, "flow": 1}})

    def add(self, type_, event, params):
        if not self.on or self.user is None:
            return
        self.queue.append({"time": now_ms(), "user_id": self.user, "type": type_,
                           "event": event, "params": params, "session_id": self.session})
        if not self.timer:
            self.timer = GLib.timeout_add_seconds(FLUSH_SEC, self._tick)

    def _tick(self):
        self.timer = 0
        self.flush()
        return False

    def flush(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        events, self.queue = self.queue, []
        if events:
            self.backend.run(self.backend.log(events))

    def switch(self, on):
        self.on = on
        save_setting("telemetry", on)
        if not on:
            self.queue = []
            self.flush()


def media_ok(url):
    """A link for a photo, a video, a voice message or a file: https on MAX's
    own hosts only (a player or the browser opens it, and a sender must not
    point it at the LAN or anywhere else)."""
    parts = urllib.parse.urlsplit(url or "")
    host = (parts.hostname or "").lower()
    return parts.scheme == "https" and any(host == h or host.endswith("." + h)
                                           for h in MEDIA_HOSTS)


def photo_ok(url):
    return media_ok(url)


def where(url):
    """A link for the log: host and path, not the signature in its query
    (an attachment of a messenger fetched by its link, as it is)."""
    if is_ref(url):
        return url[:60]
    parts = urllib.parse.urlsplit(url or "")
    return "%s%s" % (parts.hostname or "?", parts.path[:60])


def is_ref(text):
    """An attachment a messenger's link fetches itself ("tg:…" as its link
    gave it), not a link: no scheme of the web or of files."""
    return isinstance(text, str) and ":" in text and "://" not in text and \
        text.split(":", 1)[0] not in ("http", "https", "file", "data", "javascript")


def secs(duration):
    """MAX gives durations in ms, some in seconds."""
    return duration / 1000 if duration > 1000 else duration


def mmss(sec):
    sec = int(sec or 0)
    return "%d:%02d" % (sec // 60, sec % 60)


def size_text(n):
    for unit in ("Б", "КБ", "МБ"):
        if n < 1024 or unit == "МБ":
            return ("%d %s" if unit == "Б" else "%.1f %s") % (n, unit)
        n /= 1024


class PhotoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not media_ok(newurl):
            return None  # urllib then raises: no hop off MAX's hosts
        return super().redirect_request(req, fp, code, msg, headers, newurl)


PHOTO_OPENER = urllib.request.build_opener(PhotoRedirect)


def log_open():
    """The media log, mode 600, started anew past 256 KB; None if it can't be."""
    try:
        os.makedirs(PHOTOS, mode=0o700, exist_ok=True)
        if os.path.getsize(LOG) > 256 * 1024:
            os.remove(LOG)
    except OSError:
        pass
    try:
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        return os.fdopen(fd, "a", buffering=1)
    except OSError:
        return None


_log = {"fh": None, "lines": 0}
_log_lock = threading.Lock()


def log_line(text):
    """A line into LOG, from any thread; the file stays open, and is started
    anew past its size (looked at every hundred lines)."""
    with _log_lock:
        if _log["fh"] is None or _log["lines"] >= 100:
            if _log["fh"] is not None:
                _log["fh"].close()
            _log["fh"], _log["lines"] = log_open(), 0
        if _log["fh"] is None:
            return
        _log["lines"] += 1
        try:
            _log["fh"].write("%s %s\n" % (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), text))
        except (OSError, ValueError):
            _log["fh"] = None


class Libmpv:
    """Voice messages through libmpv, sound only; None of it without libmpv
    (made by Media, which gives it the agent and its callbacks)."""

    def __init__(self, on_time, on_end):
        import mpv

        self.awake = Awake(NAME, "plays a voice message")

        opts = dict(video=False, load_unsafe_playlists=False, input_default_bindings=False,
                    input_vo_keyboard=False, loglevel="warn",
                    log_handler=lambda level, prefix, text: log_line(
                        "voice %s %s: %s" % (level, prefix, text.strip())))
        try:
            self.mpv = mpv.MPV(ytdl=False, **opts)
        except Exception as exc:  # a libmpv without Lua (the Flatpak's) has no ytdl at all
            log_line("voice: libmpv without ytdl (%r)" % exc)
            self.mpv = mpv.MPV(**opts)
        self.duration = None  # of what plays, once libmpv knows it (files carry none)
        self.mpv.observe_property("duration", lambda _n, v: setattr(self, "duration", v))
        self.told = None  # the half second last told: the bar needs no more

        def moved(_name, v):
            if v is not None and int(v * 2) != self.told:
                self.told = int(v * 2)
                GLib.idle_add(on_time, v, self.duration)
        self.mpv.observe_property("time-pos", moved)

        @self.mpv.event_callback("end-file")
        def _end(event):
            # A file stopped or replaced by the next one ends too (ABORTED).
            if getattr(getattr(event, "data", None), "reason", None) != 2:
                GLib.idle_add(lambda: (self.awake.release(), on_end(), False)[2])

    def play(self, url, agent):
        # the kit's Player takes no user agent, which MAX's CDN wants.
        self.mpv["user-agent"] = agent
        self.mpv.play(url)
        self.mpv.pause = False
        self.awake.hold()

    def toggle(self):
        self.mpv.pause = not self.mpv.pause
        (self.awake.release if self.mpv.pause else self.awake.hold)()
        return not self.mpv.pause

    def stop(self):
        self.mpv.command("stop")
        self.awake.release()


# How a voice message is recorded: Ogg/Opus, as MAX's apps send it, by ffmpeg
# (in the tablet's image) or GStreamer; else parecord's Ogg/Vorbis.
RECORDERS = (
    ("ffmpeg", lambda path: [
        "ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-f", "pulse", "-i", "default",
        "-ac", "1", "-ar", "48000", "-c:a", "libopus", "-b:a", "32k", "-application", "voip",
        "-f", "ogg", path]),
    ("gst-launch-1.0", lambda path: [
        "gst-launch-1.0", "-q", "-e", "autoaudiosrc", "!", "audioconvert", "!", "audioresample",
        "!", "audio/x-raw,rate=48000,channels=1", "!", "opusenc", "!", "oggmux", "!",
        "filesink", "location=" + path]),
    ("parecord", lambda path: ["parecord", "--file-format=oga", path]),
)
SHORTEST = 1000  # ms: a press shorter than this was not a message


class Recorder:
    """A voice message from the microphone into an Ogg file in PHOTOS (the
    first of RECORDERS there is). start() begins; stop(done, keep) ends it
    (SIGINT: the recorder finishes its file) by a thread and gives done
    ((path, duration ms) or None) on the GTK side: None when not kept,
    shorter than SHORTEST, or nothing written. Its hands (popen, which)
    come in at creation; tests give their own."""

    def __init__(self, popen=subprocess.Popen, which=shutil.which):
        self.popen, self.which = popen, which
        self.proc = self.path = None
        self.began = 0.0

    def available(self):
        return any(self.which(name) for name, _cmd in RECORDERS)

    def start(self):
        """True if recording now."""
        for name, cmd in RECORDERS:
            if self.which(name):
                break
        else:
            log_line("voice recording: no recorder")
            return False
        os.makedirs(PHOTOS, mode=0o700, exist_ok=True)
        fd, self.path = tempfile.mkstemp(dir=PHOTOS, prefix="voice-", suffix=".ogg")
        os.close(fd)
        try:
            self.proc = self.popen(cmd(self.path), stdin=subprocess.DEVNULL,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as exc:
            log_line("voice recording: %r" % exc)
            os.remove(self.path)
            self.proc = self.path = None
            return False
        self.began = time.monotonic()
        return True

    def recording(self):
        return self.proc is not None

    def seconds(self):
        return time.monotonic() - self.began if self.proc else 0

    def stop(self, done, keep=True):
        proc, path, self.proc, self.path = self.proc, self.path, None, None
        if proc is None:
            GLib.idle_add(lambda: done(None) and False)
            return
        ms = int((time.monotonic() - self.began) * 1000)

        def finish():
            try:
                proc.send_signal(signal.SIGINT)
                proc.wait(timeout=5)
            except Exception:  # it hangs: its file is not to be trusted
                proc.kill()
                ms_kept = 0
            else:
                ms_kept = ms
            got = None
            if keep and ms_kept >= SHORTEST and os.path.exists(path) and os.path.getsize(path) > 0:
                got = (path, ms_kept)
            else:
                remove_file(path)
            GLib.idle_add(lambda: done(got) and False)
        threading.Thread(target=finish, daemon=True).start()


def remove_file(path):
    try:
        os.remove(path)
    except OSError:
        pass


def spawn_player(cmd):
    """Start a player, its output to the media log; OSError if it is not there."""
    out = log_open() or subprocess.DEVNULL
    try:
        subprocess.Popen(cmd, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=out, stderr=out)
    finally:
        if out is not subprocess.DEVNULL:
            out.close()


def open_in_browser(url):
    """A link in the desktop's browser; False if there is none."""
    try:
        return Gtk.show_uri_on_window(None, url, Gdk.CURRENT_TIME)
    except GLib.Error:
        return False


def download_file(url, headers, path):
    """A file to disk as it comes, never wholly in memory (videos are big)."""
    req = urllib.request.Request(url, headers=headers)
    with PHOTO_OPENER.open(req, timeout=30) as fh, open(path, "wb") as out:
        shutil.copyfileobj(fh, out, 64 * 1024)


def safe_name(name):
    """A file name from a message, made harmless: no directories, no hidden
    file, nothing unprintable."""
    name = os.path.basename((name or "").replace("\\", "/"))
    name = "".join(c for c in name if c.isprintable()).strip().lstrip(".")
    return name[:120] or "файл"


def default_folder():
    """Where files are saved unless set otherwise: «Загрузки/MAX»."""
    down = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or \
        os.path.expanduser("~/Downloads")
    return os.path.join(down, "MAX")


def qr_png(text, path, box=12, border=2):
    """The QR code of text as a black and white PNG: qrcode's matrix drawn
    here, so no Pillow (qrcode's own images need it; Flatpak and Debian's
    python3-qrcode come without)."""
    import qrcode

    qr = qrcode.QRCode(box_size=box, border=border)
    qr.add_data(text)
    qr.make(fit=True)
    rows = qr.get_matrix()  # the border included
    side = len(rows) * box
    data = bytearray()
    for row in rows:
        line = b"".join(b"\x00\x00\x00" * box if dark else b"\xff\xff\xff" * box for dark in row)
        data += line * box
    pixbuf = GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(data)), GdkPixbuf.Colorspace.RGB,
                                             False, 8, side, side, side * 3)
    pixbuf.savev(path, "png", [], [])


def focus_accept(parent, tries=20):
    """Focus the accept button of GTK's file dialog shown for parent (what a
    FileChooserNative shows outside a portal); a portal's dialog is another
    program's, so after some idle turns without one this gives up."""
    for w in Gtk.Window.list_toplevels():
        if isinstance(w, Gtk.FileChooserDialog) and w.get_visible() \
                and w.get_transient_for() is parent:
            accept = w.get_widget_for_response(Gtk.ResponseType.ACCEPT)
            if accept is not None:
                accept.set_can_default(True)
                w.set_default_response(Gtk.ResponseType.ACCEPT)
                accept.grab_focus()
            return False
    if tries > 1:
        GLib.idle_add(focus_accept, parent, tries - 1)
    return False



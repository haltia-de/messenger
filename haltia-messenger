    def can_rename(self, chat_id):
        s = self.chatlist.get(chat_id) if self.chatlist.listed(chat_id) else None
        return bool(s and s.get("type") == "DIALOG" and s.get("peer"))

    def ask_rename(self):
        s = self.chatlist.get(self.open_chat)
        if not self.can_rename(self.open_chat):
            return
        self.confirm.hide()
        self.name_entry.set_text(s["title"])

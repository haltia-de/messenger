    def emoji_closed(self, pop):
        if self.emoji_pop is pop:
            self.emoji_pop = None
            self.smile.set_active(False)
        if self.recent is not None and self.recent != self.recent_saved:
            save_json(EMOJI_RECENT, self.recent)  # once per panel, not per emoji
            self.recent_saved = list(self.recent)

    def put_emoji(self, emoji):
        """An emoji where the cursor is; it goes first among the recent ones."""
        pos = self.entry.insert_text(emoji, self.entry.get_position())
        self.entry.set_position(pos)
        self.recent = ([emoji] + [e for e in self.recent or [] if e != emoji])[:RECENT]

    def send(self, voice=None, by_key=False):
        """The entry's text and the files waiting above it (or a voice
        message just recorded: voice) into the open chat. A typed one leaves
        the entry at once and waits in the chat as a bubble (🕓) till it is
        sent; one that could not go stays there (⚠, «Повторить»), and goes
        by itself when the connection is back. Files another program sent
        go only by the «Отправить» button, never by a key (by_key)."""
        if voice is None and self.recorder.recording():
            self.record_stop(True)  # «Отправить» while it records: the voice goes
            return
        text = "" if voice else self.entry.get_text().strip()
        files = [voice] if voice else list(self.attached)
        chat_id = self.open_chat
        if not (text or files) or chat_id is None:
            return
        if by_key and any(f.get("shared") for f in files):
            self.sub.set_text("Нажмите «Отправить»")
            return
        if voice:
            self.send_voice(chat_id, voice)
            return
        # The draft goes now: what is typed or attached meanwhile is new, and
        # Enter again has nothing to send twice.
        self.entry.set_text("")
        self.attached = []
        self.show_attached()
        self.smile.set_active(False)
        answered = self.replying[1] if self.replying and self.replying[0] == chat_id else None
        self.reply_to(None)
        self.queued += 1
        shown = "\n".join(t for t in (text, "📎 " + ", ".join(f["name"] for f in files)
                                         if files else "") if t)
        m = {"id": "out-%d" % self.queued, "chat": chat_id, "sender": None, "who": "",
             "text": shown, "photos": [], "media": [], "time": int(time.time() * 1000),
             "mine": True, "reactions": [], "yours": None, "forwarded": None, "state": "sending",
             "reply": {"id": answered["id"], "who": answered.get("who") or "",
                       "text": answered.get("text") or ""} if answered else None}
        self.queue[m["id"]] = {"chat": chat_id, "text": text, "files": files, "m": m,
                               "reply_to": answered["id"] if answered else None}
        view = self.views.get(chat_id)
        if view:
            view.add(m)
        self.deliver(m["id"])

    def deliver(self, out_id, then=None):
        """Send a queued message (again); then() once it is answered."""
        q = self.queue.get(out_id)
        if q is None or q.get("busy"):  # gone, or on its way already: never twice
            if then:
                then()
            return
        q["busy"] = True
        chat_id, text, files, m = q["chat"], q["text"], q["files"], q["m"]
        m["state"] = "sending"
        view = self.views.get(chat_id)
        if view:
            view.restate(out_id)

        def done(msg, err):
            q["busy"] = False
            if then:
                GLib.idle_add(lambda: then() and False)
            if out_id not in self.queue:
                return  # «Убрать» meanwhile
            view = self.views.get(chat_id)
            if err:
                log_line("send message: %r" % err)
                m["state"] = "failed"
                if view:
                    view.restate(out_id)
                return
            del self.queue[out_id]
            if view:
                view.remove([out_id])
                for one in (msg if isinstance(msg, list) else [msg] if msg else []):
                    view.add(one)
            # a dialog from the search is in the list now
            self.chatlist.wrote(chat_id, text or attachment_words(files))
            self.edit.set_visible(self.open_chat == chat_id and self.chatlist.listed(chat_id))

        reply_to = q.get("reply_to")
        if files or reply_to:
            self.backend.run(self.backend.send(chat_id, text, files, reply_to), done)
        else:
            self.backend.run(self.backend.send(chat_id, text), done)

    def unsent(self, out_id, act):
        """«Повторить» or «Убрать» on a message that could not go. A removed
        one comes back to the entry if nothing is typed there: never lost."""
        q = self.queue.get(out_id)
        if q is None:
            return
        if act == "retry":
            self.deliver(out_id)
            return
        del self.queue[out_id]
        view = self.views.get(q["chat"])
        if view:
            view.remove([out_id])
        if self.open_chat == q["chat"] and not self.entry.get_text().strip() and not self.attached:
            self.entry.set_text(q["text"])
            self.attached = list(q["files"])
            self.show_attached()

    def retry_unsent(self):
        """The connection is back: what could not go goes now, one after
        another, so the chat gets them in the order they were written."""
        waiting = [i for i, q in self.queue.items() if q["m"]["state"] == "failed"]

        def one():
            if waiting:
                self.deliver(waiting.pop(0), one)
        one()

    def send_voice(self, chat_id, voice):
        """A voice message just recorded; one that cannot go is not kept."""
        self.sendb.set_sensitive(False)

        def done(msg, err):
            self.sendb.set_sensitive(True)
            remove_file(voice["path"])
            if err:
                log_line("send voice: %r" % err)
                self.sub.set_text("Нет связи — голосовое не отправлено"
                                  if isinstance(err, Offline) else "голосовое не отправлено, попробуйте ещё раз")
                return
            self.sub.set_text("")
            view = self.views.get(chat_id)
            for one in (msg if isinstance(msg, list) else [msg] if msg else []):
                if view:
                    view.add(one)
            self.chatlist.wrote(chat_id, attachment_words([voice]))
            self.edit.set_visible(self.open_chat == chat_id and self.chatlist.listed(chat_id))

        self.backend.run(self.backend.send(chat_id, "", [voice]), done)

    # --- attachments ------------------------------------------------------------
    def attach(self):
        for path in self.choose_files():
            if not any(f["path"] == path for f in self.attached):
                self.attached.append(attachment(path))
        self.show_attached()

    def choose_files(self):
        """Files picked to send (the portal's dialog in Flatpak and KDE);
        [] when cancelled. Tests replace it."""
        dialog = Gtk.FileChooserNative.new("Прикрепить", self.win, Gtk.FileChooserAction.OPEN,
                                           "Прикрепить", "Отмена")
        dialog.set_select_multiple(True)
        photos = Gtk.FileFilter()
        photos.set_name("Фото")
        for ext in PHOTO_FILES:
            photos.add_pattern("*" + ext)
            photos.add_pattern("*" + ext.upper())
        for mime in PHOTO_TYPES:  # a chooser may start in the pictures by them
            photos.add_mime_type(mime)
        everything = Gtk.FileFilter()
        everything.set_name("Все файлы")
        everything.add_pattern("*")
        dialog.add_filter(photos)  # the first one is chosen: photos, with their previews
        dialog.add_filter(everything)
        chosen = self.run_chooser(dialog) == Gtk.ResponseType.ACCEPT
        paths = [p for p in dialog.get_filenames() if os.path.isfile(p)] if chosen else []
        dialog.destroy()
        return paths

    def show_attached(self):
        """The files waiting to be sent, above the entry."""
        for child in self.attachbar.get_children():
            child.destroy()
        for f in self.attached:
            chip = Gtk.Box(spacing=8)
            chip.get_style_context().add_class("attachment")
            chip.attachment = f
            if f["kind"] == "photo":
                try:
                    pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(f["path"], 96, 96, True)
                    chip.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)
                except GLib.Error:
                    chip.pack_start(label(f["name"], "attachment-name", ellipsize=True),
                                    False, False, 0)
            else:
                chip.pack_start(label("📄 " + f["name"], "attachment-name", ellipsize=True),
                                False, False, 0)
            drop = Gtk.Button.new_from_icon_name("window-close-symbolic", Gtk.IconSize.BUTTON)
            drop.get_style_context().add_class("plain")
            drop.set_can_focus(False)
            drop.set_tooltip_text("Не отправлять")
            drop.connect("clicked", lambda _b, f=f: self.unattach(f))
            chip.pack_start(drop, False, False, 0)
            self.attachbar.pack_start(chip, False, False, 0)
            chip.show_all()  # not the bar's show_all: its no-show-all stops it
        self.attachbar.set_visible(bool(self.attached))

    def unattach(self, f):
        self.attached = [a for a in self.attached if a is not f]
        self.show_attached()

    # --- a voice message --------------------------------------------------------
    def record_start(self):
        if self.record_locked:
            self.record_stop(True)  # the microphone tapped again: it goes
            return
        if self.call_id is not None or self.open_chat is None or self.recorder.recording():
            return
        self.stop_sound()  # no voice played into the microphone
        if not self.recorder.start():
            self.sub.set_text("Запись голоса здесь недоступна")
            return
        self.mic.get_style_context().add_class("recording")
        self.entry.hide()
        self.record_label.show()
        self.record_chat = self.open_chat
        self.record_began = time.monotonic()
        self.show_recording()
        self.record_timer = GLib.timeout_add(250, self.show_recording)

    def record_released(self):
        """The finger off the microphone: a hold sends, a tap records on.
        Asked first (voice_ask): a yes records on till «Отправить»."""
        if self.voice_ask and not self.recorder.recording():
            if dialogs.ask(self.win, "Записать голосовое сообщение?", "Записать"):
                self.record_start()
                if self.recorder.recording():
                    self.record_locked = True
                    self.record_cancel.show()
                    self.show_recording()
            return
        if not self.recorder.recording() or self.record_locked:
            return
        if time.monotonic() - self.record_began < TAP_RECORD:
            self.record_locked = True
            self.record_cancel.show()
            self.show_recording()
        else:
            self.record_stop(True)

    def show_recording(self):
        if self.recorder.recording() and self.recorder.seconds() >= VOICE_LONGEST:
            self.record_stop(True)  # never on without end: what was said goes
            return False
        self.record_label.set_text(
            ("● %s — говорите, затем «Отправить»" if self.record_locked else
             "● %s — отпустите, чтобы отправить") % mmss(self.recorder.seconds()))
        return self.recorder.recording()

    def record_stop(self, keep):
        if not self.recorder.recording():
            return
        if self.record_timer is not None:
            GLib.source_remove(self.record_timer)
            self.record_timer = None
        self.mic.get_style_context().remove_class("recording")
        self.record_label.hide()
        self.record_cancel.hide()
        self.record_locked = False
        self.entry.show()
        chat_id, self.record_chat = self.record_chat, None

        def done(got):
            if got is None:
                if keep:
                    self.sub.set_text("Слишком коротко: скажите подольше")
                return
            path, ms = got
            if self.open_chat != chat_id:
                remove_file(path)  # the chat left meanwhile: not sent elsewhere
                return
            self.send({"kind": "voice", "path": path, "duration": ms, "name": "voice.ogg"})
        self.recorder.stop(done, keep)


if __name__ == "__main__":
    # Started by XDG autostart with no graphical session: nothing to do.
    if not Gtk.init_check(sys.argv)[0]:
        sys.exit(0)
    app = Max()
    # A session ending (SIGTERM) or Ctrl+C: shut down as from the menu, so a
    # call is hung up, the cache written and the microphone stopped.
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, lambda: app.quit() or False)
    app.run(sys.argv)

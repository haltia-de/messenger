# --- small helpers ----------------------------------------------------------
def kind(value):
    """An enum or a string, as a plain upper-case string."""
    value = getattr(value, "value", value)
    return str(value or "").upper()


def when(ms, full=False):
    if not ms:
        return ""
    t = datetime.fromtimestamp(ms / 1000)
    if t.date() == date.today() and not full:
        return t.strftime("%-H:%M")
    if full:
        return t.strftime("%-H:%M")
    return "%d %s" % (t.day, MONTHS[t.month - 1])


def day_label(ms):
    d = datetime.fromtimestamp(ms / 1000).date()
    delta = (date.today() - d).days
    if delta == 0:
        return "Сегодня"
    if delta == 1:
        return "Вчера"
    return "%d %s" % (d.day, MONTHS[d.month - 1])


def plain(text):
    """Text from a message for a line elsewhere (a notification): no control
    characters, line breaks as spaces."""
    return "".join(c if c.isprintable() else " " for c in (text or "")).strip()


# Messages MAX itself puts into chats come as keys its own clients translate.
SERVICE_TEXTS = {
    "welcome.saved.dialog.message":
        "Это Избранное. Сохраняйте сюда сообщения, файлы и заметки: их видите только вы.",
}
SERVICE_KEY = re.compile(r"[a-z]+(?:\.[a-z][a-z_]*){3,}")  # four parts or more: not a site's name


def shown_text(text):
    """A message's text as it is shown: a key of MAX's own messages in
    words, an unknown one as «Служебное сообщение» rather than the key."""
    text = text or ""
    if text in SERVICE_TEXTS:
        return SERVICE_TEXTS[text]
    return "Служебное сообщение" if SERVICE_KEY.fullmatch(text) else text


def note_text(summary, msg):
    """(title, body) of the notification of a message. The text is a
    sender's, and notification daemons read markup in the body (links,
    pictures): it goes escaped, as text; neither keeps control characters."""
    body = msg["text"] or ("фото" if msg["photos"] else "вложение")
    if summary.get("type") in ("CHAT", "CHANNEL") and msg.get("who"):
        body = "%s: %s" % (msg["who"], body)
    return (plain(summary.get("title") or "MAX"),
            GLib.markup_escape_text(plain(body)[:200]))



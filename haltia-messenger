        self.naming.show()
        self.name_entry.grab_focus()

    def rename(self):
        chat_id = self.open_chat
        s = self.chatlist.get(chat_id)
        if not s or not s.get("peer"):
            return
        name = " ".join(self.name_entry.get_text().split())[:64]

        def done(renamed, err):
            if err:
                self.sub.set_text("не удалось переименовать")
                return
            self.naming.hide()
            for r in renamed or []:
                self.chatlist.retitle(r["id"], r["title"])
            if self.open_chat == chat_id:
                self.title.set_text(self.chatlist.get(chat_id)["title"])
            self.fill_list()

        self.backend.run(self.backend.rename(s["peer"], name), done)

    # deleting a dialog, leaving a group or a channel
    def chat_menu(self):
        """The open chat's menu, under the edit button."""
        chat_id = self.open_chat
        s = self.chatlist.get(chat_id) if self.chatlist.listed(chat_id) else None
        if not s:
            return
        quiet = self.chatlist.quiet(chat_id)
        leave = {"CHANNEL": "🚪 Отписаться от канала", "CHAT": "🚪 Выйти из группы"}.get(
            s["type"], "🗑 Удалить переписку")
        items = [("✏️ Переименовать", self.ask_rename)] if self.can_rename(chat_id) else []
        items += [("📌 Открепить" if self.chatlist.is_pinned(chat_id) else "📌 Закрепить сверху",
                   lambda: self.toggle_pin(s)),
                  ("🔔 Включить оповещения" if quiet else "🔕 Без оповещений",
                   lambda: self.toggle_mute(s)),
                  (leave, self.ask_remove)]
        self.popup_menu(self.edit, items)

    def popup_menu(self, under, items):
        """A menu of (text, action) under a widget; it closes on a choice."""
        pop = Gtk.Popover.new(under)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        for text, act in items:
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("menu")
            b.get_child().set_xalign(0.0)
            b.connect("clicked", lambda _b, a=act: (pop.popdown(), a()))
            box.pack_start(b, False, False, 0)
        pop.add(box)
        pop.connect("closed", lambda p: GLib.idle_add(p.destroy))
        box.show_all()
        pop.popup()
        self.menu = pop  # the one open, for the tests

    def ask_remove(self):
        s = self.chatlist.get(self.open_chat) if self.chatlist.listed(self.open_chat) else None
        if not s:
            return
        question, yes = {
            "CHANNEL": ("Отписаться от канала «%s»?", "Отписаться"),
            "CHAT": ("Выйти из группы «%s»? Её сообщения уйдут из списка.", "Выйти"),
        }.get(s["type"], ("Удалить переписку с «%s» у себя? У собеседника она останется.",
                          "Удалить"))
        self.naming.hide()
        self.confirm_text.set_text(question % s["title"])
        self.confirm_yes.set_label(yes)
        self.confirm.show()

    def remove(self):
        chat_id = self.open_chat
        self.confirm_yes.set_sensitive(False)

        def done(_res, err):
            self.confirm_yes.set_sensitive(True)
            if err:
                if self.open_chat == chat_id:
                    self.sub.set_text("не удалось, попробуйте ещё раз")
                return
            self.confirm.hide()
            self.chatlist.remove(chat_id)
            view = self.views.pop(chat_id, None)
            if view is not None:
                if view is self.view:
                    self.view = None
                view.destroy()
            if self.open_chat == chat_id:
                self.show_list()
            else:
                self.fill_list()

        self.backend.run(self.backend.remove(chat_id), done)


# Every link (PyMaxLink; tests/fake_link.py) gives these, never its library's
# objects: nothing above a link knows which messenger it talks to.
@dataclasses.dataclass
class Person:
    """Someone in the messenger: their id, name and optional portrait."""
    id: object
    name: str = ""
    photo: str = None  # fetched only through Media's host and redirect checks


@dataclasses.dataclass
class Message:
    """A message as it is shown: for a forwarded one the original's text and
    attachments, and fwd ({"chat": its chat's name or None, "sender": its
    sender}) saying where it came from."""
    id: object
    chat: object
    sender: object
    time: int  # ms
    text: str = ""  # in words: a messenger's own keys are put in words by its link
    photos: list = dataclasses.field(default_factory=list)  # links of its photos
    media: list = dataclasses.field(default_factory=list)  # media items (media_of)
    notes: list = dataclasses.field(default_factory=list)  # what is not shown, in words
    parts: list = dataclasses.field(default_factory=list)  # each attachment in words ("" a photo)
    reactions: list = dataclasses.field(default_factory=list)  # [[emoji, count]]
    yours: str = None  # the account's own reaction
    fwd: dict = None
    reply: dict = None  # the message it answers: {"id", "sender", "text"} (text may be "")
    call: dict = None  # a call's record: {"video", "end" (HUNGUP, MISSED, REJECTED, CANCELED), "duration" ms}


@dataclasses.dataclass
class Chat:
    id: object
    kind: str  # "DIALOG", "CHAT" (a group) or "CHANNEL"
    title: str = None  # None for a dialog: it is called by the person
    members: list = dataclasses.field(default_factory=list)  # ids known in it
    count: int = 0  # how many are in it
    unread: int = 0
    last: Message = None  # its last message
    time: int = 0  # ms of its last event
    link: str = None  # a public channel's or group's link (https://…), to join it by
    seen: int = 0  # how far the others have read the account's messages (the link's seen_by)
    photo: str = None  # a group's or channel's picture (a dialog's is its person's)



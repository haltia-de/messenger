        """The chats a message can go to: dialogs and groups, the newest
        first (channels take only their owners' posts), or what the search
        finds."""
        for child in self.fwd_list.get_children():
            child.destroy()
        text = self.fwd_entry.get_text().strip()
        chats = self.chatlist.find(text) if text else [e[0] for e in self.chatlist.entries("chats")]

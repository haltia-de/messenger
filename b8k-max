    def show_chats(self, summaries):
        self.summaries = {s["id"]: s for s in summaries}
        save_list(summaries)
        page = self.stack.get_visible_child_name()
        if page in ("wait", "qr"):
            self.stack.set_visible_child_name("chats")
        elif page == "settings":
            self.came_from = "chats"
        self.fill_list()
        return False

    def incoming(self, msg, summary):
        if summary:
            self.summaries[summary["id"]] = summary
            if self.pending.pop(summary["id"], None) and self.open_chat == summary["id"]:
                self.trash.set_visible(self.stack.get_visible_child_name() == "chat")
        if self.hidden(self.summaries.get(msg["chat"])) and self.open_chat != msg["chat"]:
            self.fill_list()
            return False  # from a stranger: no bubble, no buzz, left unread
        here = self.open_chat == msg["chat"] and self.win.is_visible()
        view = self.views.get(msg["chat"])
        if view and msg["id"] not in view.shown:
            self.add_bubble(view, msg)
            if here:
                self.scroll_down()
        if here and not msg["mine"] and self.win.is_active():
            self.backend.run(self.backend.read(msg["chat"], msg["id"]))
            if msg["chat"] in self.summaries:
                self.summaries[msg["chat"]]["unread"] = 0
        if not msg["mine"] and self.buzz_new:
            self.buzz()
            if not here:
                GLib.timeout_add(180, lambda: self.buzz() and False)
        self.fill_list()
        return False

    # the list
    def fill_list(self):
        for child in self.list.get_children():
            self.list.remove(child)
        total = 0
        shown = [s for s in self.summaries.values() if not self.hidden(s)]
        for s in sorted(shown, key=lambda s: -(s["time"] or 0)):
            total += s["unread"]
            self.list.add(self.chat_row(s))
        self.list.show_all()
        if self.open_chat is None and self.stack.get_visible_child_name() == "chats":
            self.sub.set_text("непрочитанных: %d" % total if total else "")
        # The button counts people, not news: channels are left out.
        set_badge(sum(s["unread"] for s in shown if s.get("type") != "CHANNEL"))

    def chat_row(self, s):
        """One chat of a list: initials, name, last message, time, unread."""
        row = Gtk.ListBoxRow()
        row.chat_id = s["id"]
        box = Gtk.Box(spacing=18)
        box.set_margin_start(16)
        box.set_margin_end(16)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.pack_start(initials_icon(s["title"], s["id"]), False, False, 0)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        mid.set_valign(Gtk.Align.CENTER)
        mid.pack_start(label(s["title"], "chat-name", ellipsize=True), False, False, 0)
        mid.pack_start(label(s["last"], "chat-last", ellipsize=True), False, False, 0)
        box.pack_start(mid, True, True, 0)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.set_valign(Gtk.Align.CENTER)
        right.pack_start(label(when(s["time"]), "chat-time", xalign=1.0), False, False, 0)
        if s["unread"]:
            badge = label(str(s["unread"]), "badge", xalign=0.5)
            badge.set_halign(Gtk.Align.END)
            right.pack_start(badge, False, False, 0)
        box.pack_end(right, False, False, 0)
        row.add(box)
        return row

    def on_row(self, _list, row):
        self.buzz()
        self.open(row.chat_id)

    def show_list(self):
        self.open_chat = None
        self.back.hide()
        self.title.set_text("MAX")
        self.stack.set_visible_child_name("chats")
        self.fill_list()

    # the search: a person by phone, a channel or group by link, own chats by name
    def show_find(self):
        self.open_chat = None
        self.title.set_text("Поиск")
        self.sub.set_text("")
        self.back.show()
        self.find_hint.set_text(
            "Номер телефона — найти человека в MAX. Ссылка max.ru/… или @имя — "
            "канал или группа. Другое — среди ваших чатов.")
        self.stack.set_visible_child_name("find")
        self.find_entry.grab_focus()

    def find(self):
        text = self.find_entry.get_text().strip()
        for child in self.found.get_children():
            child.destroy()
        if not text:
            return
        phone, link = phone_of(text), link_of(text)
        if phone:
            self.find_hint.set_text("Ищу %s…" % phone)

            def person(p, err):
                if self.find_entry.get_text().strip() != text:
                    return  # asked something else meanwhile
                if err or not p:
                    self.find_hint.set_text("С номером %s в MAX никого не нашлось." % phone)
                    return
                self.find_hint.set_text("")
                self.show_person(p)

            self.backend.run(self.backend.find_phone(phone), person)
        elif link:
            self.find_hint.set_text("Открываю ссылку…")

            def chat(info, err):
                if self.find_entry.get_text().strip() != text:
                    return
                if err or not info:
                    # MAX told nothing about the link; joining may still work.
                    self.find_hint.set_text("Сведений по ссылке нет, но вступить можно попробовать.")
                    info = {"id": 0, "title": link.split("max.ru/", 1)[1], "type": "",
                            "members": 0, "joined": False}
                else:
                    self.find_hint.set_text("")
                self.show_found_chat(info, link)

            self.backend.run(self.backend.link_info(link), chat)
        else:
            want = text.casefold()
            hits = sorted((c for c in self.summaries.values()
                           if want in c["title"].casefold() and not self.hidden(c)),
                          key=lambda c: -(c["time"] or 0))
            self.find_hint.set_text("" if hits else "Среди ваших чатов такого нет.")
            if hits:
                box = Gtk.ListBox()
                box.set_selection_mode(Gtk.SelectionMode.NONE)
                box.connect("row-activated", self.on_row)
                for c in hits:
                    box.add(self.chat_row(c))
                self.found.pack_start(box, False, False, 0)
        self.found.show_all()

    def found_card(self, title, about, key):
        """A card of a search result; its buttons go in the returned box."""
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.get_style_context().add_class("settings")
        top = Gtk.Box(spacing=18)
        top.pack_start(initials_icon(title, key), False, False, 0)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        mid.set_valign(Gtk.Align.CENTER)
        mid.pack_start(label(title, "chat-name", ellipsize=True), False, False, 0)
        mid.pack_start(label(about, "chat-last", ellipsize=True), False, False, 0)
        top.pack_start(mid, True, True, 0)
        card.pack_start(top, False, False, 0)
        buttons = Gtk.Box(spacing=12)
        card.pack_start(buttons, False, False, 0)
        self.found.pack_start(card, False, False, 0)
        return buttons

    def action(self, box, text, cls, clicked):
        b = Gtk.Button(label=text)
        b.get_style_context().add_class(cls)
        b.connect("clicked", clicked)
        box.pack_start(b, False, False, 0)
        return b

    def show_person(self, p):
        buttons = self.found_card(p["name"], self.find_entry.get_text().strip(), p["id"])
        if p["chat"] is not None:
            self.action(buttons, "Написать", "act", lambda _b: self.write_to(p))

        def add(btn):
            btn.set_sensitive(False)

            def done(_res, err):
                btn.set_label("Не удалось, ещё раз" if err else "В контактах")
                btn.set_sensitive(bool(err))
                if not err:
                    for c in self.summaries.values():
                        if c.get("peer") == p["id"]:
                            c["stranger"] = False
                    self.fill_list()

            self.backend.run(self.backend.add_contact(p["id"]), done)

        self.action(buttons, "В контакты", "plain", add)
        self.found.show_all()

    def write_to(self, p):
        if p["chat"] not in self.summaries:
            self.pending[p["chat"]] = {"id": p["chat"], "title": p["name"], "type": "DIALOG",
                                       "last": "", "time": 0, "unread": 0}
        self.open(p["chat"])

    def show_found_chat(self, info, link):
        channel = info["type"] == "CHANNEL"
        n = info["members"]
        about = ("канал" if channel else "группа" if info["type"] else "ссылка в MAX") + (
            " · %s: %d" % ("подписчиков" if channel else "участников", n) if n else "")
        buttons = self.found_card(info["title"], about, info["id"])
        if info["joined"] and info["id"] in self.summaries:
            self.action(buttons, "Открыть", "act", lambda _b: self.open(info["id"]))
        else:
            def join(btn):
                btn.set_sensitive(False)

                def done(summary, err):
                    if err or not summary:
                        btn.set_label("Не удалось, ещё раз")
                        btn.set_sensitive(True)
                        return
                    self.summaries[summary["id"]] = summary
                    save_list(list(self.summaries.values()))
                    self.fill_list()
                    self.open(summary["id"])

                self.backend.run(self.backend.join(link), done)

            self.action(buttons, "Подписаться" if channel else "Вступить", "act", join)
        self.found.show_all()

    # deleting a dialog, leaving a group or a channel
    def ask_remove(self):
        s = self.summaries.get(self.open_chat)
        if not s:
            return
        question, yes = {
            "CHANNEL": ("Отписаться от канала «%s»?", "Отписаться"),
            "CHAT": ("Выйти из группы «%s»? Её сообщения уйдут из списка.", "Выйти"),
        }.get(s["type"], ("Удалить переписку с «%s» у себя? У собеседника она останется.",
                          "Удалить"))
        self.confirm_text.set_text(question % s["title"])
        self.confirm_yes.set_label(yes)
        self.confirm.show()

    def remove(self):
        chat_id = self.open_chat
        self.confirm_yes.set_sensitive(False)

        def done(_res, err):
            self.confirm_yes.set_sensitive(True)
            if err:
                if self.open_chat == chat_id:
                    self.sub.set_text("не удалось, попробуйте ещё раз")
                return
            self.confirm.hide()
            self.summaries.pop(chat_id, None)
            save_list(list(self.summaries.values()))
            view = self.views.pop(chat_id, None)
            if view is not None:
                if view is self.view:
                    self.viewport.remove(view)
                    self.view = None
                view.destroy()
            if self.open_chat == chat_id:
                self.show_list()
            else:
                self.fill_list()

        self.backend.run(self.backend.remove(chat_id), done)

    # the settings
    def show_settings(self):
        self.came_from = self.stack.get_visible_child_name()
        self.title.set_text("Настройки")
        self.sub.set_text("")
        self.back.show()
        self.stack.set_visible_child_name("settings")

    def go_back(self):
        if self.stack.get_visible_child_name() == "settings" and self.came_from != "chats":
            self.back.hide()  # to the login page, which has no list behind it
            self.title.set_text("MAX")
            self.stack.set_visible_child_name(self.came_from)
        else:
            self.show_list()

    def setting(self, title, active, changed, hint):
        """One card of the settings page: a title, a switch and what it does."""
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.get_style_context().add_class("settings")
        row = Gtk.Box(spacing=24)
        row.pack_start(label(title, "setting", wrap=True), True, True, 0)
        switch = Gtk.Switch(active=active, valign=Gtk.Align.CENTER)
        switch.connect("notify::active", lambda sw, _p: (self.buzz(), changed(sw.get_active())))
        row.pack_end(switch, False, False, 0)
        card.pack_start(row, False, False, 0)
        card.pack_start(label(hint, "hint", wrap=True), False, False, 0)
        return card

    def on_contacts_only(self, on):
        self.contacts_only = on
        save_setting("contacts_only", on)
        self.fill_list()

    def on_invites(self, on):
        self.invites = on
        save_setting("invites", on)
        hint = self.invites_card.get_children()[1]
        text = hint.get_text().split("\n")[0]
        hint.set_text(text + "\nСохраняю в MAX…")

        def done(_res, err):
            hint.set_text(text + ("\nНе удалось сохранить в MAX: попробую при следующем входе."
                                  if err else ""))

        self.backend.run(self.backend.set_invites(on), done)

    def hidden(self, s):
        """A dialog with someone not in the contacts, while those are hidden."""
        return self.contacts_only and bool(s and s.get("stranger"))

    def on_buzz(self, on):
        self.buzz_new = on
        save_setting("buzz", on)

    def on_telemetry(self, on):
        self.telemetry.switch(on)

    def page_changed(self, *_args):
        page = self.stack.get_visible_child_name()
        # Settings from the list or before the login, so telemetry can be
        # switched off before anything is sent.
        self.gear.set_visible(page in ("chats", "wait", "qr"))
        self.findb.set_visible(page == "chats")
        self.trash.set_visible(page == "chat" and self.open_chat in self.summaries)
        if page != "chat":
            self.confirm.hide()
        self.moved()

    def moved(self):
        """Tell telemetry which screen is in front."""
        if not self.win.is_visible():
            return
        page = self.stack.get_visible_child_name()
        if page == "chats":
            self.telemetry.go(SCREEN_CHATS, MAIN_TAB)
        elif page == "find":
            self.telemetry.go(SCREEN_SEARCH)
        elif page == "chat":
            s = self.about(self.open_chat)
            self.telemetry.go(SCREEN_CHAT, {"source_type": 1 if s.get("type") == "DIALOG" else 2,
                                            "source_id": self.open_chat})
        elif page == "settings":
            self.telemetry.go(SCREEN_SETTINGS)

    # a chat
    def about(self, chat_id):
        """The chat's summary, also of a dialog not yet written to."""
        return self.summaries.get(chat_id) or self.pending.get(chat_id, {})

    def view_for(self, chat_id):
        """The built chat, from memory, else from the disk cache."""
        view = self.views.pop(chat_id, None)
        if view is None:
            view = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            view.set_margin_start(16)
            view.set_margin_end(16)
            view.set_margin_top(12)
            view.set_margin_bottom(12)
            view.chat_id = chat_id
            view.shown = set()
            view.last_day = None
            for m in cache_read(chat_id):
                self.add_bubble(view, m)
        self.views[chat_id] = view  # most recently used last
        while len(self.views) > VIEWS:
            old_id = next(iter(self.views))
            old = self.views.pop(old_id)
            if old is self.view:
                self.views[old_id] = old
                break
            old.destroy()
        return view

    def open(self, chat_id):
        start = time.monotonic()
        s = self.about(chat_id)
        self.open_chat = chat_id
        self.confirm.hide()
        self.trash.set_visible(chat_id in self.summaries)
        view = self.view_for(chat_id)
        if self.view is not view:
            if self.view is not None:
                self.viewport.remove(self.view)
            self.viewport.add(view)
            self.view = view
        view.show_all()
        self.title.set_text(s.get("title", ""))
        self.sub.set_text("" if view.shown else "загрузка…")
        self.back.show()
        self.inputbar.set_visible(s.get("type") != "CHANNEL")
        self.stack.set_visible_child_name("chat")
        self.scroll_down()

        def done(msgs, err):
            came = time.monotonic()
            if err:
                if self.open_chat == chat_id:
                    self.sub.set_text("" if view.shown else "не удалось загрузить")
                return
            latest = max((m["time"] for m in msgs if m["id"] in view.shown), default=0)
            for m in msgs or []:
                if m["id"] not in view.shown and m["time"] >= latest:
                    self.add_bubble(view, m)
            if self.open_chat == chat_id:
                self.sub.set_text("")

                def drawn():  # an idle runs after the redraw
                    self.telemetry.chat_shown(int((came - start) * 1000),
                                              int((time.monotonic() - came) * 1000))
                    return False
                GLib.idle_add(drawn)
            if chat_id in self.summaries:
                self.summaries[chat_id]["unread"] = 0
                self.fill_list()

        self.backend.run(self.backend.history(chat_id), done)

    def add_bubble(self, view, m):
        view.shown.add(m["id"])
        day = datetime.fromtimestamp(m["time"] / 1000).date() if m["time"] else None
        if day and day != view.last_day:
            view.last_day = day
            sep = label(day_label(m["time"]), "day", xalign=0.5)
            sep.set_halign(Gtk.Align.CENTER)
            view.pack_start(sep, False, False, 6)
            sep.show()
        bubble = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        bubble.get_style_context().add_class("bubble")
        bubble.get_style_context().add_class("mine" if m["mine"] else "theirs")
        bubble.set_halign(Gtk.Align.END if m["mine"] else Gtk.Align.START)
        group = self.summaries.get(view.chat_id, {}).get("type") in ("CHAT", "CHANNEL")
        if group and not m["mine"] and m["who"]:
            bubble.pack_start(label(m["who"], "who"), False, False, 0)
        for url in m["photos"]:
            img = Gtk.Image.new_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            img.set_size_request(460, 200)
            bubble.pack_start(img, False, False, 0)
            load_photo(url, lambda pix, img=img: pix and (img.set_from_pixbuf(pix),
                                                          img.set_size_request(-1, -1)))
        if m["text"]:
            text = label(m["text"], "msg", wrap=True)
            text.set_max_width_chars(38)
            text.set_selectable(False)
            bubble.pack_start(text, False, False, 0)
        bubble.pack_start(label(when(m["time"], full=True), "when", xalign=1.0), False, False, 0)
        view.pack_start(bubble, False, False, 0)
        bubble.show_all()

    def keep_bottom(self, adj):
        if self.at_bottom:
            adj.set_value(adj.get_upper() - adj.get_page_size())

    def track_bottom(self, adj):
        self.at_bottom = adj.get_value() + adj.get_page_size() >= adj.get_upper() - 60

    def scroll_down(self):
        self.at_bottom = True
        adj = self.msg_scroll.get_vadjustment()
        adj.set_value(adj.get_upper() - adj.get_page_size())

    def send(self):
        text = self.entry.get_text().strip()
        chat_id = self.open_chat
        if not text or chat_id is None:
            return
        self.sendb.set_sensitive(False)

        def done(msg, err):
            self.sendb.set_sensitive(True)
            if err:
                self.sub.set_text("не отправлено, попробуйте ещё раз")
                return
            self.entry.set_text("")
            self.sub.set_text("")
            view = self.views.get(chat_id)
            if msg and view and msg["id"] not in view.shown:
                self.add_bubble(view, msg)
                self.scroll_down()
            if chat_id in self.pending:  # the dialog exists now
                self.summaries.setdefault(chat_id, self.pending.pop(chat_id))
                self.trash.set_visible(self.open_chat == chat_id)
            s = self.summaries.get(chat_id)
            if s:
                s["last"], s["time"] = "Вы: " + text, int(time.time() * 1000)
                s["stranger"] = False  # written to here: welcome now

        self.backend.run(self.backend.send(chat_id, text), done)


if __name__ == "__main__":

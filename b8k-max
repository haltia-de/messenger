    def incoming(self, msg, summary):
        if summary:
            was_pending = not self.chatlist.listed(summary["id"]) and self.chatlist.get(summary["id"])
            self.chatlist.update(summary)
            if was_pending and self.open_chat == summary["id"]:
                self.edit.set_visible(self.stack.get_visible_child_name() == "chat")
        if self.chatlist.hidden(msg["chat"]) and self.open_chat != msg["chat"]:
            self.fill_list()
            return False  # from a stranger: no bubble, no buzz, left unread
        here = self.open_chat == msg["chat"] and self.win.is_visible()
        view = self.views.get(msg["chat"])
        if view:
            view.add(msg)
        if here and not msg["mine"] and self.win.is_active():
            self.backend.run(self.backend.read(msg["chat"], msg["id"]))
            self.chatlist.read(msg["chat"])
        if not msg["mine"] and self.buzz_new and self.chatlist.loud(msg["chat"]):
            self.buzz()
            if not here:
                GLib.timeout_add(180, lambda: self.buzz() and False)
        self.fill_list()
        return False

    # the list
    def fill_list(self):
        """Bring the list in line with the summaries. Rows are kept and only
        a chat that changed is redrawn: a new message used to rebuild every
        row, slow on the tablet with a hundred chats."""
        entries = {tab: self.chatlist.entries(tab) for tab in ("chats", "channels")}
        wanted = {e[0]["id"]: e for tab in entries.values() for e in tab}
        for chat_id in [i for i in self.rows if i not in wanted]:
            self.rows.pop(chat_id).destroy()
        for chat_id, entry in wanted.items():
            row = self.rows.get(chat_id)
            if row is None:
                row = self.rows[chat_id] = self.chat_row(entry)
                self.list.add(row)
                row.show_all()
            elif row.look != self.look(entry):
                row.remove(row.get_child())
                row.add(self.chat_row(entry).steal())
                row.show_all()
            row.summary, row.look = entry[0], self.look(entry)
        self.positions = {e[0]["id"]: i for i, e in enumerate(entries[self.tab])}
        self.list.invalidate_sort()
        self.list.invalidate_filter()
        counts = self.chatlist.counts()
        for b, name, tab in ((self.tab_chats, "Чаты", "chats"), (self.tab_channels, "Каналы", "channels")):
            b.set_label("%s · %d" % (name, counts[tab]) if counts[tab] else name)
        if self.open_chat is None and self.stack.get_visible_child_name() == "chats":
            self.sub.set_text("непрочитанных: %d" % counts["loud"] if counts["loud"] else "")
        # The button counts what may buzz: quiet chats (channels by default) are left out.
        set_badge(counts["loud"])

    def chat_row(self, entry):
        """One chat of a list (an entry of ChatList's): initials, name, last
        message, time, unread."""
        s, pinned, quiet = entry
        row = Gtk.ListBoxRow()
        row.chat_id = s["id"]
        row.summary, row.look = s, self.look(entry)
        row.steal = lambda: (row.remove(box), box)[1]  # the contents, for a kept row
        box = Gtk.Box(spacing=18)
        box.set_margin_start(16)
        box.set_margin_end(16)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.pack_start(initials_icon(s["title"], s["id"]), False, False, 0)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        mid.set_valign(Gtk.Align.CENTER)
        mid.pack_start(label(s["title"], "chat-name", ellipsize=True), False, False, 0)
        mid.pack_start(label(s["last"], "chat-last", ellipsize=True), False, False, 0)
        box.pack_start(mid, True, True, 0)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.set_valign(Gtk.Align.CENTER)
        top = "%s%s" % ("📌 " if pinned else "", when(s["time"]))
        right.pack_start(label(top, "chat-time", xalign=1.0), False, False, 0)
        if s["unread"]:
            badge = label(str(s["unread"]), "badge", xalign=0.5)
            if quiet:
                badge.get_style_context().add_class("quiet")
            badge.set_halign(Gtk.Align.END)
            right.pack_start(badge, False, False, 0)
        box.pack_end(right, False, False, 0)
        row.add(box)
        return row

    def on_row(self, _list, row):
        if time.monotonic() - self.held < 1.0:
            return  # the release of a long press: the menu is open
        self.buzz()
        self.open(row.chat_id)

    # tabs, pinning, notifications
    @staticmethod
    def look(entry):
        """What a row shows: when it changes the row is redrawn."""
        s, pinned, quiet = entry
        return (s["title"], s["last"], s["time"], s["unread"], pinned, quiet)

    def show_tab(self, name):
        self.tab = name
        self.fill_list()
        adj = self.list.get_parent().get_vadjustment() if isinstance(
            self.list.get_parent(), Gtk.Scrollable) else None
        if adj:
            adj.set_value(0)

    def row_menu(self, _gesture, _x, y):
        row = self.list.get_row_at_y(int(y))
        if row is None:
            return
        self.held = time.monotonic()
        self.buzz()
        s = row.summary
        pinned, muted = self.chatlist.is_pinned(s["id"]), self.chatlist.quiet(s["id"])
        self.popup_menu(row, [
            ("📌 Открепить" if pinned else "📌 Закрепить сверху", lambda: self.toggle_pin(s)),
            ("🔔 Включить оповещения" if muted else "🔕 Без оповещений",
             lambda: self.toggle_mute(s))])

    def toggle_pin(self, s):
        self.chatlist.pin(s["id"])
        self.fill_list()

    def toggle_mute(self, s):
        self.chatlist.mute(s["id"])
        self.fill_list()


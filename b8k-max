    # saving what a message carries
    def save_message(self, chat_id, m, items=None):
        """Every photo and file of a message (or only the items given) into
        the folder set in the settings; any kind of file, not only media.
        The link of a video or a file is asked of MAX first."""
        folder = load_text("folder", default_folder())
        jobs = [] if items else \
            [(url, "фото-%s-%d.jpg" % (m["id"], n + 1)) for n, url in enumerate(m["photos"])]
        for item in items or m.get("media") or []:
            if item["kind"] == "audio" and item["url"]:  # a voice message
                ext = os.path.splitext(urllib.parse.urlsplit(item["url"]).path)[1] or ".ogg"
                jobs.append((item["url"], "голосовое-%s%s" % (m["id"], ext)))
            elif item["kind"] == "audio":  # an audio file
                jobs.append(({"kind": "file", "id": item["file"]}, item["name"]))
            elif item["kind"] == "video":
                jobs.append((item, "видео-%s.mp4" % m["id"]))
            else:
                jobs.append((item, item["name"]))
        if not jobs:
            return
        state = {"left": len(jobs), "saved": [], "failed": 0}
        self.sub.set_text("сохраняю…")

        def one(path):
            state["left"] -= 1
            if path:
                state["saved"].append(os.path.basename(path))
            else:
                state["failed"] += 1
            if state["left"]:
                return
            if state["failed"]:
                self.sub.set_text("не удалось сохранить: %d из %d" % (state["failed"], len(jobs)))
            elif len(state["saved"]) == 1:
                self.sub.set_text("сохранено: %s" % state["saved"][0])
            else:
                self.sub.set_text("сохранено файлов: %d" % len(state["saved"]))

        for what, name in jobs:
            if isinstance(what, str):
                self.media.save(what, folder, name, one)
            else:
                def linked(url, err, name=name):
                    if err or not url:
                        one(None)
                    else:
                        self.media.save(url, folder, name, one)
                self.backend.run(self.backend.media_url(chat_id, m["id"], what), linked)


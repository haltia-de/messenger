def load_setting(key):
    """A yes/no setting of [max] in CONFIG (telemetry, buzz); yes until set."""
    conf = configparser.ConfigParser(interpolation=None)
    conf.read(CONFIG, encoding="utf-8")
    try:
        return conf.getboolean("max", key, fallback=True)
    except ValueError:
        return True


def save_setting(key, on):
    conf = configparser.ConfigParser(interpolation=None)
    conf.read(CONFIG, encoding="utf-8")
    if not conf.has_section("max"):
        conf.add_section("max")
    conf["max"][key] = "yes" if on else "no"
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".new", "w", encoding="utf-8") as fh:
            conf.write(fh)
        os.replace(CONFIG + ".new", CONFIG)
    except OSError:
        pass


def now_ms():
    return int(time.time() * 1000)


class Telemetry:
    """What MAX's app tells the server about its use, from what really
    happens here (see the top of the file). Called in the window's thread;
    the events leave through the MAX thread in small batches. The shapes
    and fixed values are PyMax 2.4.1's (pymax/telemetry/payloads.py)."""

    def __init__(self, backend):
        self.backend = backend
        self.on = load_setting("telemetry")
        self.user = None  # the account's id, once logged in
        self.session = 0
        self.screen = SCREEN_BACKGROUND
        self.last_go = now_ms()
        self.action = 0
        self.queue = []
        self.timer = 0

    def started(self, user, session):
        """Logged in, at start and after every reconnect, as PyMax does."""
        self.user, self.session = user, session
        self.add("PERF", "login", {
            "properties": {"connection_type": 2, "vpn": 0, "class": 2,
                           "background": 1, "warm_start": 1},
            "errorType": 100})

    def go(self, screen, params=None):
        """The person went to another screen (BACKGROUND: the window hid).
        Before the login nothing moves: the window tells again after it."""
        if screen == self.screen or self.user is None:
            return
        before, self.screen = self.screen, screen
        if before == SCREEN_BACKGROUND:
            self.session += 1  # a new visit, as the app counts them
        self.action = (self.action + 1) % 0xFFFFFFFF
        nav = {"prev_time": self.last_go, "screen_to": screen, "action_id": self.action,
               "screen_from": before}
        nav.update(params or {})
        self.last_go = now_ms()
        self.add("NAV", "GO", nav)
        if screen == SCREEN_BACKGROUND:
            self.flush()

    def chat_shown(self, messages, render):
        """A chat opened: ms until its messages came, then until drawn."""
        self.add("PERF", "open_chat_to_render", {
            "spans": [{"duration": messages + render, "name": "open_chat_to_render"},
                      {"duration": messages, "name": "messages_list_created"},
                      {"duration": render, "name": "messages_render"}],
            "properties": {"class": 2, "warm": 1, "flow": 1}})

    def add(self, type_, event, params):
        if not self.on or self.user is None:
            return
        self.queue.append({"time": now_ms(), "user_id": self.user, "type": type_,
                           "event": event, "params": params, "session_id": self.session})
        if not self.timer:
            self.timer = GLib.timeout_add_seconds(FLUSH_SEC, self._tick)

    def _tick(self):
        self.timer = 0
        self.flush()
        return False

    def flush(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        events, self.queue = self.queue, []
        if events:
            self.backend.run(self.backend.log(events))

    def switch(self, on):
        self.on = on
        save_setting("telemetry", on)
        if not on:
            self.queue = []
            self.flush()


def media_ok(url):
    """A link for a video, a voice message or a file: https on MAX's own
    hosts only, as with photos (a player or the browser opens it, and a
    sender must not point it at the LAN or anywhere else)."""
    parts = urllib.parse.urlsplit(url or "")
    host = (parts.hostname or "").lower()
    return parts.scheme == "https" and any(host == h or host.endswith("." + h)
                                           for h in MEDIA_HOSTS)


def secs(duration):
    """MAX gives durations in ms, some in seconds."""
    return duration / 1000 if duration > 1000 else duration


def mmss(sec):
    sec = int(sec or 0)
    return "%d:%02d" % (sec // 60, sec % 60)


def size_text(n):
    for unit in ("Б", "КБ", "МБ"):
        if n < 1024 or unit == "МБ":
            return ("%d %s" if unit == "Б" else "%.1f %s") % (n, unit)
        n /= 1024


class Sound:
    """Voice messages and audio through libmpv, sound only, one at a time;
    progress comes back on the GTK side. None of it if libmpv is missing."""

    def __init__(self):
        self.mpv = None
        self.on_time = self.on_end = lambda *_a: None
        try:
            import mpv
            self.mpv = mpv.MPV(video=False, ytdl=False, load_unsafe_playlists=False,
                               input_default_bindings=False, input_vo_keyboard=False)
        except Exception:
            return
        self.mpv.observe_property(
            "time-pos", lambda _n, v: v is not None and GLib.idle_add(self.on_time, v))

        @self.mpv.event_callback("end-file")
        def _end(event):
            # A file stopped or replaced by the next one ends too (ABORTED).
            if getattr(getattr(event, "data", None), "reason", None) != 2:
                GLib.idle_add(self.on_end)

    def play(self, url):
        self.mpv.play(url)
        self.mpv.pause = False

    def toggle(self):
        self.mpv.pause = not self.mpv.pause
        return not self.mpv.pause

    def stop(self):
        if self.mpv:
            self.mpv.command("stop")


def photo_ok(url):
    parts = urllib.parse.urlsplit(url or "")
    host = (parts.hostname or "").lower()
    return parts.scheme == "https" and any(host == h or host.endswith("." + h)
                                           for h in PHOTO_HOSTS)


class PhotoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not photo_ok(newurl):
            return None  # urllib then raises: no hop off MAX's CDN
        return super().redirect_request(req, fp, code, msg, headers, newurl)


PHOTO_OPENER = urllib.request.build_opener(PhotoRedirect)


def prune_photos():
    """Photos not shown for PHOTO_DAYS go (each one shown is touched)."""
    limit = time.time() - PHOTO_DAYS * 86400
    try:
        names = os.listdir(PHOTOS)
    except OSError:
        return
    for name in names:
        if not name.endswith(".img"):
            continue  # the chats directory, a half-written .new
        path = os.path.join(PHOTOS, name)
        try:
            if os.path.getmtime(path) < limit:
                os.remove(path)
        except OSError:
            continue


def load_photo(url, done):
    """Download one photo in a thread (cached by URL) and hand back a pixbuf."""
    if not photo_ok(url):
        return
    os.makedirs(PHOTOS, mode=0o700, exist_ok=True)
    path = os.path.join(PHOTOS, hashlib.sha1(url.encode()).hexdigest()[:20] + ".img")

    def work():
        try:
            if os.path.exists(path):
                os.utime(path)  # in use: kept by prune_photos
            else:
                req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
                with PHOTO_OPENER.open(req, timeout=20) as fh:
                    data = fh.read(8 * 1024 * 1024)
                with open(path + ".new", "wb") as out:
                    out.write(data)
                os.replace(path + ".new", path)
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 460, 460, True)
        except Exception:
            pix = None
        GLib.idle_add(lambda: done(pix) and False)

    threading.Thread(target=work, daemon=True).start()



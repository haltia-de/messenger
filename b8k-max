# --- small helpers ----------------------------------------------------------
def kind(value):
    """An enum or a string, as a plain upper-case string."""
    value = getattr(value, "value", value)
    return str(value or "").upper()


def when(ms, full=False):
    if not ms:
        return ""
    t = datetime.fromtimestamp(ms / 1000)
    if t.date() == date.today() and not full:
        return t.strftime("%-H:%M")
    if full:
        return t.strftime("%-H:%M")
    return "%d %s" % (t.day, MONTHS[t.month - 1])


def day_label(ms):
    d = datetime.fromtimestamp(ms / 1000).date()
    delta = (date.today() - d).days
    if delta == 0:
        return "Сегодня"
    if delta == 1:
        return "Вчера"
    return "%d %s" % (d.day, MONTHS[d.month - 1])


def label(text, cls, xalign=0.0, wrap=False, ellipsize=False):
    lab = Gtk.Label(label=text, xalign=xalign)
    lab.get_style_context().add_class(cls)
    if wrap:
        lab.set_line_wrap(True)
        lab.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if ellipsize:
        lab.set_ellipsize(Pango.EllipsizeMode.END)
        lab.set_single_line_mode(True)
    return lab


def initials_icon(name, key, size=64):
    area = Gtk.DrawingArea()
    area.set_size_request(size, size)
    letters = "".join(w[0] for w in (name or "?").split()[:2]).upper() or "?"
    colour = COLOURS[int(key) % len(COLOURS)]

    def draw(_w, cr):
        cr.set_source_rgb(*colour)
        cr.arc(size / 2, size / 2, size / 2, 0, 6.2832)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(size * 0.38)
        ext = cr.text_extents(letters)
        cr.move_to((size - ext.width) / 2 - ext.x_bearing, (size - ext.height) / 2 - ext.y_bearing)
        cr.show_text(letters)
        return False

    area.connect("draw", draw)
    return area


def phone_of(text):
    """A phone number as MAX looks it up (+7…), or None if this is not one."""
    if not re.fullmatch(r"\+?[\d\s()-]+", text):
        return None
    digits = re.sub(r"\D", "", text)
    if len(digits) == 10:
        digits = "7" + digits
    elif len(digits) == 11 and digits[0] == "8":
        digits = "7" + digits[1:]
    return "+" + digits if 11 <= len(digits) <= 15 else None


def link_of(text):
    """A MAX link to a channel or group (max.ru/name, max.ru/join/…, @name)
    as https://max.ru/…, or None."""
    text = text.strip()
    if re.fullmatch(r"@[\w.]+", text):
        return "https://max.ru/" + text[1:]
    m = re.fullmatch(r"(?:https?://)?(?:web\.)?max\.ru/([\w./-]+)", text, re.I)
    return "https://max.ru/" + m.group(1).strip("/") if m else None


def user_name(user):
    for n in getattr(user, "names", None) or []:
        full = getattr(n, "name", None) or " ".join(
            x for x in (getattr(n, "first_name", None), getattr(n, "last_name", None)) if x)
        if full:
            return full
    return "Пользователь %s" % getattr(user, "id", "")


def attach_summary(a):
    """(what, photo url or None) for one attachment."""
    t = kind(getattr(a, "type", ""))
    if t == "PHOTO":
        return "", getattr(a, "base_url", None)
    names = {"VIDEO": "видео", "AUDIO": "голосовое сообщение", "FILE": "файл",
             "STICKER": "стикер", "CONTACT": "контакт", "POLL": "опрос", "CALL": "звонок",
             "SHARE": "ссылка"}
    if t == "FILE" and getattr(a, "name", None):
        return "файл «%s»" % a.name, None
    return names.get(t, ""), None


# --- MAX, in its own thread -------------------------------------------------
class Backend:
    def __init__(self, ui):
        self.ui = ui
        self.loop = None
        self.client = None
        self.me = None
        self.names = {}
        self.chats = {}
        self.known, self.seeded = load_known()

    def start(self):
        threading.Thread(target=self._thread, daemon=True).start()

    def _thread(self):
        self.loop = asyncio.new_event_loop()
        asyncio.set_event_loop(self.loop)
        try:
            self.loop.run_until_complete(self._main())
        except Exception as exc:  # the client gave up for good
            GLib.idle_add(self.ui.failed, repr(exc))

    def run(self, coro, done=None):
        """Run a coroutine in the MAX thread; done(result, error) in the window's."""
        if not self.loop:
            return
        fut = asyncio.run_coroutine_threadsafe(coro, self.loop)
        if done:
            def back(f):
                try:
                    res, err = f.result(), None
                except Exception as exc:
                    res, err = None, exc
                GLib.idle_add(lambda: done(res, err) and False)
            fut.add_done_callback(back)

    async def _main(self):
        from pymax import WebClient
        from pymax.config import ExtraConfig

        os.makedirs(DATA, mode=0o700, exist_ok=True)
        self.client = WebClient(session_name="web.db", work_dir=DATA,
                                extra_config=ExtraConfig(telemetry=False, log_level="WARNING",
                                                         reconnect_delay=3.0),
                                qr_provider=self)
        self.client.on_start()(self._started)
        self.client.on_message()(self._message)
        await self.client.start()

    # QrHandler for PyMax
    async def show_qr(self, qr_url):
        import qrcode

        path = os.path.join(DATA, "qr.png")
        qrcode.make(qr_url, box_size=12, border=2).save(path)
        GLib.idle_add(self.ui.show_qr, path)

    async def _started(self, client):
        try:
            os.chmod(os.path.join(DATA, "web.db"), 0o600)
            os.remove(os.path.join(DATA, "qr.png"))
        except OSError:
            pass
        self.me = client.me.contact.id if client.me else None
        if self.me and client.me:
            self.names[self.me] = user_name(client.me.contact)
        # On a reconnect the sync only brings chats that changed since the
        # last one, so page through the whole list as well.
        found = {c.id: c for c in client.chats or []}
        marker = None
        for _page in range(5):
            try:
                page = await client._app.api.chats.fetch_chats(marker)
            except Exception:
                break
            fresh = [c for c in page if c.id not in found]
            for c in page:
                found.setdefault(c.id, c)
            if not page or not fresh:
                break
            marker = min(c.last_event_time for c in page if c.last_event_time) - 1
        chats = list(found.values())
        self.chats = found
        # The contacts come whole on the first login, then only what changed:
        # keep them on disk. The first time, everyone already in a dialog
        # counts too, so that nobody known goes quiet after an update.
        for u in client.contacts or []:
            if u:
                self.known.add(u.id)
                self.names.setdefault(u.id, user_name(u))
        if not self.seeded:
            self.known.update(p for p in map(self.peer, chats) if p)
            self.seeded = True
        save_known(self.known)
        try:
            await self.set_invites(load_setting("invites"), changed=False)
        except Exception:
            pass  # tried again at the next login
        want = set()
        for c in chats:
            if kind(c.type) == "DIALOG":
                want.update(u for u in c.participants if u != self.me)
        await self.lookup(want)
        if self.me:
            GLib.idle_add(self.ui.logged_in, self.me, client._app.config.device.client_session_id)
        GLib.idle_add(self.ui.show_chats, [self.summary(c) for c in chats])

    async def lookup(self, ids):
        ids = [i for i in ids if i and i not in self.names]
        for k in range(0, len(ids), 50):
            try:
                users = await self.client._app.api.users.get_users(ids[k:k + 50])
            except Exception:
                continue
            for u in users or []:
                if u:
                    self.names[u.id] = user_name(u)

    def peer(self, chat):
        """The other person of a dialog (None in Избранное, a group, a channel)."""
        if kind(chat.type) != "DIALOG":
            return None
        others = [u for u in chat.participants if u != self.me]
        return others[0] if others else None

    def remember(self, user_id):
        """Someone whose messages are welcome: a contact, or written to here."""
        if user_id and user_id != self.me and user_id not in self.known:
            self.known.add(user_id)
            save_known(self.known)

    def title(self, chat):
        if chat.title:
            return chat.title
        if kind(chat.type) == "DIALOG":
            others = [u for u in chat.participants if u != self.me]
            if not others:
                return "Избранное"
            return self.names.get(others[0], "Собеседник")
        return "Чат"

    def preview(self, msg):
        if not msg:
            return ""
        text = (msg.text or "").replace("\n", " ")
        if not text:
            parts = [attach_summary(a)[0] or "фото" for a in msg.attaches or []]
            text = ", ".join(p for p in parts if p).capitalize()
        if msg.sender == self.me and self.me:
            text = "Вы: " + text
        return text

    def summary(self, chat):
        last = chat.last_message
        peer = self.peer(chat)
        return {"id": chat.id, "title": self.title(chat), "type": kind(chat.type),
                "last": self.preview(last), "time": (last.time if last else 0) or chat.last_event_time,
                "unread": chat.new_messages or 0, "peer": peer,
                "stranger": peer is not None and peer not in self.known}

    def message(self, msg):
        texts, photos = [], []
        for a in msg.attaches or []:
            what, url = attach_summary(a)
            if url:
                photos.append(url)
            elif what:
                texts.append("[%s]" % what)
        body = msg.text or ""
        if texts:
            body = (body + "\n" if body else "") + " ".join(texts)
        return {"id": msg.id, "chat": msg.chat_id, "sender": msg.sender,
                "who": self.names.get(msg.sender, ""), "text": body, "photos": photos,
                "time": msg.time, "mine": bool(self.me) and msg.sender == self.me}

    async def chat(self, chat_id):
        """The chat, from the list or asked for (one just joined, a new
        dialog that has its first message); None if MAX has none."""
        chat = self.chats.get(chat_id)
        if chat is None:
            try:
                found = await self.client._app.api.chats.get_chats([chat_id])
            except Exception:
                found = []
            if found:
                chat = self.chats[chat_id] = found[0]
        return chat

    async def history(self, chat_id):
        chat = await self.chat(chat_id)
        if not chat:
            return []  # a dialog nobody has written to yet
        msgs = await chat.history(backward=HISTORY)
        if any(m.sender == self.me for m in msgs):
            self.remember(self.peer(chat))
        await self.lookup({m.sender for m in msgs})
        msgs.sort(key=lambda m: m.time)
        if msgs:
            try:
                await self.client._app.api.messages.read_message(msgs[-1].id, chat_id)
                chat.new_messages = 0
            except Exception:
                pass
        out = [self.message(m) for m in msgs]
        cache_add(chat_id, out)
        return out

    async def send(self, chat_id, text):
        chat = self.chats.get(chat_id)
        # A dialog not started yet is numbered own id XOR theirs.
        self.remember(self.peer(chat) if chat else chat_id ^ self.me if self.me else None)
        msg = await self.client._app.api.messages.send_message(chat_id, text)
        out = self.message(msg) if msg else None
        if out:
            cache_add(chat_id, [out])
        return out

    async def find_phone(self, phone):
        """The person with this phone number, if they are in MAX."""
        user = await self.client._app.api.users.search_by_phone(phone)
        self.names[user.id] = user_name(user)
        return {"id": user.id, "name": self.names[user.id],
                "chat": self.me ^ user.id if self.me else None}  # their dialog, as MAX numbers it

    async def add_contact(self, user_id):
        user = await self.client._app.api.users.add_contact(user_id)
        self.names[user.id] = user_name(user)
        self.remember(user.id)

    async def link_info(self, link):
        """The channel or group behind a link, before joining it."""
        from pymax.api.chats.enums import ChatPayloadKey
        from pymax.api.chats.payloads import LinkInfoPayload
        from pymax.api.response import parse_payload_item_model
        from pymax.protocol import Opcode
        from pymax.types.domain import Chat

        at = link.find("join/")  # invite links go as join/…, public ones whole
        frame = LinkInfoPayload(link=link[at:] if at != -1 else link)
        response = await self.client._app.invoke(Opcode.LINK_INFO, frame.to_payload())
        chat = parse_payload_item_model(response, ChatPayloadKey.CHAT, Chat)
        if chat is None:
            return None
        return {"id": chat.id, "title": chat.title or "Без названия", "type": kind(chat.type),
                "members": chat.participants_count or len(chat.participants),
                "joined": chat.id in self.chats}

    async def join(self, link):
        chat = await self.client._app.api.chats.join_channel(link)  # groups too
        self.chats[chat.id] = chat
        return self.summary(chat)

    async def remove(self, chat_id):
        """Leave a channel or group, delete a dialog: for this account only,
        never for the others in it."""
        api = self.client._app.api.chats
        chat = self.chats.get(chat_id)
        stamp = chat.last_event_time if chat else None
        if chat is not None and kind(chat.type) in ("CHAT", "CHANNEL"):
            await api.leave_group(chat_id)
            try:  # and its messages off the list, as the app does
                await api.delete_chat(chat_id, last_event_time=stamp, for_all=False)
            except Exception:
                pass
        else:
            await api.delete_chat(chat_id, last_event_time=stamp, for_all=False)
        self.chats.pop(chat_id, None)
        cache_drop(chat_id)

    async def set_invites(self, contacts, changed=True):
        """Who may add this account to chats, in MAX's own privacy settings:
        the contacts or anyone. Sent when switched here; at login only if
        MAX has not taken the switch's value from here yet (the first time,
        or after a failure), so a change made on the phone stays."""
        from pymax.api.self.enums import PrivacyAccess
        from pymax.api.self.payloads import PrivacySettingsUpdate

        if not self.me:
            return  # not logged in: the login sends it
        want = "CONTACTS" if contacts else "ALL"
        sent = load_sent()
        if not changed and sent.get(str(self.me)) == want:
            return
        await self.client._app.api.account.change_profile_settings(
            PrivacySettingsUpdate(chat_invites=PrivacyAccess(want)))
        sent[str(self.me)] = want
        save_sent(sent)

    async def read(self, chat_id, msg_id):
        await self.client._app.api.messages.read_message(msg_id, chat_id)

    async def log(self, events):
        """Telemetry events (dicts shaped as PyMax's TelemetryEvent) to MAX."""
        from pymax.protocol import Opcode
        from pymax.telemetry.payloads import TelemetryEvent, TelemetryPayload

        app = self.client._app
        if not (app.started and app.me and app.connection.is_open):
            return
        payload = TelemetryPayload(events=[TelemetryEvent(**e) for e in events]).to_payload()
        await app.invoke(Opcode.LOG, payload, timeout=app.config.request_timeout)

    async def _message(self, msg, _client):
        await self.lookup({msg.sender})
        known = msg.chat_id in self.chats  # a new chat comes with its count
        chat = await self.chat(msg.chat_id) if msg.chat_id is not None else None
        if chat is not None:
            chat.last_message = msg
            if msg.sender != self.me and known:
                chat.new_messages = (chat.new_messages or 0) + 1
        out = self.message(msg)
        if msg.chat_id is not None:
            cache_add(msg.chat_id, [out])
        GLib.idle_add(self.ui.incoming, out, self.summary(chat) if chat is not None else None)


_cache_lock = threading.Lock()


def cache_read(chat_id):
    try:
        with open(os.path.join(CHATS, "%d.json" % chat_id)) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return []


def cache_add(chat_id, msgs):
    """Merge messages into the chat's cache file; the newest KEEP stay."""
    if not msgs:
        return
    with _cache_lock:
        known = {m["id"]: m for m in cache_read(chat_id)}
        for m in msgs:
            known[m["id"]] = m
        keep = sorted(known.values(), key=lambda m: m["time"] or 0)[-KEEP:]
        try:
            os.makedirs(CHATS, mode=0o700, exist_ok=True)
            path = os.path.join(CHATS, "%d.json" % chat_id)
            fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as fh:
                json.dump(keep, fh, ensure_ascii=False)
            os.replace(path + ".new", path)
        except OSError:
            pass


def cache_drop(chat_id):
    with _cache_lock:
        try:
            os.remove(os.path.join(CHATS, "%d.json" % chat_id))
        except OSError:
            pass



        b.get_child().set_max_width_chars(32)
        b.set_can_focus(False)
        b.connect("clicked", lambda _b: self.open_media(view.chat_id, m["id"], item, b))
        return b

    def play_sound(self, item, play, bar, length):
        if self.sound is None:
            self.sound = Sound()
            self.sound.on_time = self.sound_time
            self.sound.on_end = self.sound_end
        if self.sound.mpv is None or not media_ok(item["url"]):
            play.set_label("✕")  # no libmpv here, or a link not to be opened
            return
        if self.playing and self.playing[1] is play:
            play.set_label("⏸" if self.sound.toggle() else "▶")
            return
        self.sound_end()
        self.playing = (bar, play, length, item["duration"])
        play.set_label("⏸")
        self.sound.play(item["url"])

    def sound_time(self, pos):
        if self.playing:
            bar, _play, length, total = self.playing
            total = secs(total)
            if total:
                bar.set_fraction(min(1.0, pos / total))
            length.set_text(mmss(pos))
        return False

    def sound_end(self):
        if self.playing:
            bar, play, length, total = self.playing
            bar.set_fraction(0)
            play.set_label("▶")
            length.set_text(mmss(secs(total)))
            self.playing = None
        return False

    def open_media(self, chat_id, msg_id, item, button):
        """A video full screen in the shell's player, a file in the browser;
        MAX gives the link on request."""
        button.set_sensitive(False)

        def done(url, err):
            button.set_sensitive(True)
            if err or not media_ok(url):
                self.sub.set_text("не удалось открыть")
                return
            if item["kind"] == "video":
                if self.playing:
                    self.sound.stop()
                    self.sound_end()
                # No youtube-dl and no playlists: the link is played as it is.
                cmd = ([PLAYER, "--title", self.title.get_text(), url, "ytdl=no",
                        "load-unsafe-playlists=no"] if os.access(PLAYER, os.X_OK) else
                       ["mpv", "--fs", "--ytdl=no", "--load-unsafe-playlists=no", "--", url])
                try:
                    subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
                except OSError:
                    self.sub.set_text("нет проигрывателя (b8k-vplay или mpv)")
            elif not (b8k_ui and b8k_ui.open_url(url)):
                try:
                    Gtk.show_uri_on_window(self.win, url, Gdk.CURRENT_TIME)
                except GLib.Error:
                    self.sub.set_text("нечем открыть файл")

        self.backend.run(self.backend.media_url(chat_id, msg_id, item), done)

    # reactions
    def fill_reactions(self, view, msg_id):
        """The reactions under a message: emoji and count, the account's own
        highlighted; a tap puts that one on, or takes the own one off."""
        m, box = view.msgs[msg_id]
        for child in box.get_children():
            child.destroy()
        for emoji, count in m.get("reactions") or []:
            b = Gtk.Button(label="%s %d" % (emoji, count))
            b.get_style_context().add_class("react")
            yours = emoji == m.get("yours")
            if yours:
                b.get_style_context().add_class("yours")
            b.set_can_focus(False)
            b.connect("clicked", lambda _b, e=None if yours else emoji:
                      self.react(view.chat_id, msg_id, e))
            box.pack_start(b, False, False, 0)
        box.show_all()

    def pick_reaction(self, view, msg_id, bubble):
        if msg_id not in view.msgs:
            return
        self.buzz()
        yours = view.msgs[msg_id][0].get("yours")
        pop = Gtk.Popover.new(bubble)
        row = Gtk.Box(spacing=4)
        row.set_margin_start(6)
        row.set_margin_end(6)
        row.set_margin_top(6)
        row.set_margin_bottom(6)
        for emoji in REACTIONS:
            b = Gtk.Button(label=emoji)
            b.get_style_context().add_class("emoji")
            if emoji == yours:
                b.get_style_context().add_class("yours")  # a tap takes it off
            b.set_can_focus(False)
            b.connect("clicked", lambda _b, e=emoji: (
                pop.popdown(), self.react(view.chat_id, msg_id, None if e == yours else e)))
            row.pack_start(b, False, False, 0)
        pop.add(row)
        pop.connect("closed", lambda p: GLib.idle_add(p.destroy))
        row.show_all()
        pop.popup()

    def react(self, chat_id, msg_id, emoji):
        """Put the account's reaction (None: take it off), then show what
        MAX says, or count it here if MAX sent no counts."""
        def done(res, err):
            if err:
                if self.open_chat == chat_id:
                    self.sub.set_text("реакция не отправлена, попробуйте ещё раз")
                return
            if res is None:
                view = self.views.get(chat_id)
                if not view or msg_id not in view.msgs:
                    return
                m = view.msgs[msg_id][0]
                counts = dict(m.get("reactions") or [])
                if m.get("yours") in counts:
                    counts[m["yours"]] -= 1
                if emoji:
                    counts[emoji] = counts.get(emoji, 0) + 1
                res = [[e, n] for e, n in counts.items() if n > 0], emoji
                cache_react(chat_id, msg_id, *res)
            self.reacted(chat_id, msg_id, *res)

        self.backend.run(self.backend.react(chat_id, msg_id, emoji), done)

    def reacted(self, chat_id, msg_id, reactions, yours):
        """New reactions of a message (yours: ... when not known to change)."""
        view = self.views.get(chat_id)
        if view and msg_id in view.msgs:
            m = view.msgs[msg_id][0]
            if m.get("reactions") != reactions or yours is not ... and m.get("yours") != yours:
                m["reactions"] = reactions
                if yours is not ...:
                    m["yours"] = yours
                self.fill_reactions(view, msg_id)
        return False

    def keep_bottom(self, adj):
        if self.at_bottom:
            adj.set_value(adj.get_upper() - adj.get_page_size())
        elif self.anchor is not None:  # older messages came in above: stay put
            adj.set_value(adj.get_upper() - self.anchor)
        GLib.idle_add(self.load_visible)

    def track_bottom(self, adj):
        self.at_bottom = adj.get_value() + adj.get_page_size() >= adj.get_upper() - 60
        view = self.view
        if view is not None and adj.get_value() < adj.get_page_size() * 0.5 and \
                self.stack.get_visible_child_name() == "chat":
            self.load_older(view)
        self.load_visible()

    def load_visible(self):
        """Fetch the photos of a chat within a screen of what is shown."""
        view = self.view
        if view is None or not view.photos:
            return False
        adj = self.msg_scroll.get_vadjustment()
        top, page = adj.get_value(), adj.get_page_size()
        keep = []
        for img, url in view.photos:
            pos = img.translate_coordinates(view, 0, 0)
            if img.get_realized() and pos and top - page <= pos[1] <= top + 2 * page:
                load_photo(url, lambda pix, img=img: pix and (
                    img.set_from_pixbuf(pix), img.set_size_request(-1, -1)))
            else:
                keep.append((img, url))
        view.photos = keep
        return False

    def load_older(self, view, background=False):
        """The page before the oldest message shown; the background ones
        stop when the reader leaves the chat."""
        if view.loading or view.done or view.oldest is None:
            return False
        if background and (view.prefetch <= 0 or self.view is not view):
            return False
        view.loading = True
        if background:
            view.prefetch -= 1
        else:
            self.sub.set_text("загрузка…")

        def done(msgs, err):
            view.loading = False
            if self.view is view and not background:
                self.sub.set_text("")
            if err:
                return
            if not msgs:
                view.done = True
                return
            adj = self.msg_scroll.get_vadjustment()
            self.anchor = adj.get_upper() - adj.get_value() if self.view is view else None
            self.prepend(view, msgs)
            GLib.timeout_add(400, self.drop_anchor)
            if background and view.prefetch > 0:
                GLib.timeout_add(600, lambda: self.load_older(view, background=True) and False)

        self.backend.run(self.backend.older(view.chat_id, view.oldest), done)
        return False

    def drop_anchor(self):
        self.anchor = None
        return False

    def trim(self, view):
        """A chat left keeps only its newest BUBBLES messages built."""
        holds = [w for w in view.get_children() if hasattr(w, "msg_id")]
        if len(holds) <= BUBBLES:
            return
        gone = set()
        for w in view.get_children():
            if hasattr(w, "msg_id"):
                if len(holds) - len(gone) <= BUBBLES:
                    break
                gone.add(w.msg_id)
            w.destroy()
        view.shown -= gone
        for i in gone:
            view.msgs.pop(i, None)
        view.photos = [(img, url) for img, url in view.photos if img.get_parent()]
        first = view.get_children()[0]
        m = view.msgs[first.msg_id][0]
        view.first_day = datetime.fromtimestamp(m["time"] / 1000).date()
        view.top_sep = self.day_sep(view, m["time"])
        view.reorder_child(view.top_sep, 0)
        view.oldest, view.done = m["time"], False

    def clear_view(self, view):
        for w in view.get_children():
            w.destroy()
        view.shown, view.msgs, view.photos = set(), {}, []
        view.last_day = view.first_day = view.top_sep = view.oldest = None
        view.done = False

    def scroll_down(self):
        self.at_bottom = True
        adj = self.msg_scroll.get_vadjustment()
        adj.set_value(adj.get_upper() - adj.get_page_size())

    def send(self):
        text = self.entry.get_text().strip()
        chat_id = self.open_chat
        if not text or chat_id is None:
            return
        self.sendb.set_sensitive(False)

        def done(msg, err):
            self.sendb.set_sensitive(True)
            if err:
                self.sub.set_text("не отправлено, попробуйте ещё раз")
                return
            self.entry.set_text("")
            self.sub.set_text("")
            view = self.views.get(chat_id)
            if msg and view and msg["id"] not in view.shown:
                self.add_bubble(view, msg)
                self.scroll_down()
            if chat_id in self.pending:  # the dialog exists now
                self.summaries.setdefault(chat_id, self.pending.pop(chat_id))
                self.trash.set_visible(self.open_chat == chat_id)
            s = self.summaries.get(chat_id)
            if s:
                s["last"], s["time"] = "Вы: " + text, int(time.time() * 1000)
                s["stranger"] = False  # written to here: welcome now

        self.backend.run(self.backend.send(chat_id, text), done)



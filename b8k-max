    # a chat
    def about(self, chat_id):
        """The chat's summary, also of a dialog not yet written to."""
        return self.summaries.get(chat_id) or self.pending.get(chat_id, {})

    def view_for(self, chat_id):
        """The built chat, from memory, else from the disk cache."""
        view = self.views.pop(chat_id, None)
        if view is None:
            view = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            view.set_margin_start(16)
            view.set_margin_end(16)
            view.set_margin_top(12)
            view.set_margin_bottom(12)
            view.chat_id = chat_id
            view.shown = set()
            view.msgs = {}  # message id -> (its dict, the box of its reactions)
            view.last_day = None  # of the newest message shown
            view.first_day, view.top_sep = None, None  # of the oldest, and its day label
            view.oldest = None  # time of the oldest message shown
            view.loading = view.done = False  # older pages: one at a time, none left
            view.prefetch = 0  # older pages still to fetch in the background
            view.photos = []  # (image, url) not loaded yet: only when near the screen
            for m in cache_read(chat_id):
                self.add_bubble(view, m)
        self.views[chat_id] = view  # most recently used last
        while len(self.views) > VIEWS:
            old_id = next(iter(self.views))
            old = self.views.pop(old_id)
            if old is self.view:
                self.views[old_id] = old
                break
            old.destroy()
        return view

    def open(self, chat_id):
        start = time.monotonic()
        s = self.about(chat_id)
        self.open_chat = chat_id
        self.confirm.hide()
        self.naming.hide()
        self.trash.set_visible(chat_id in self.summaries)
        self.pencil.set_visible(self.can_rename(chat_id))
        view = self.view_for(chat_id)
        if self.view is not view:
            if self.view is not None:
                self.trim(self.view)
                self.viewport.remove(self.view)
            self.viewport.add(view)
            self.view = view
        view.show_all()
        self.title.set_text(s.get("title", ""))
        self.sub.set_text("" if view.shown else "загрузка…")
        self.back.show()
        self.inputbar.set_visible(s.get("type") != "CHANNEL")
        self.stack.set_visible_child_name("chat")
        self.scroll_down()

        def done(res, err):
            came = time.monotonic()
            if err:
                if self.open_chat == chat_id:
                    self.sub.set_text("" if view.shown else "не удалось загрузить")
                return
            msgs, gap = res
            if gap:  # more came than a page: what was cached is not continuous
                self.clear_view(view)
            latest = max((m["time"] for m in msgs if m["id"] in view.shown), default=0)
            for m in msgs or []:
                if m["id"] not in view.shown and m["time"] >= latest:
                    self.add_bubble(view, m)
                elif m["id"] in view.msgs:  # reactions may have changed meanwhile
                    self.reacted(chat_id, m["id"], m["reactions"], m["yours"])
            if self.open_chat == chat_id:
                self.sub.set_text("")
                view.prefetch = PREFETCH
                GLib.timeout_add(800, lambda: self.load_older(view, background=True) and False)

                def drawn():  # an idle runs after the redraw
                    self.telemetry.chat_shown(int((came - start) * 1000),
                                              int((time.monotonic() - came) * 1000))
                    return False
                GLib.idle_add(drawn)
            if chat_id in self.summaries:
                self.summaries[chat_id]["unread"] = 0
                self.fill_list()

        self.backend.run(self.backend.history(chat_id), done)
        GLib.idle_add(self.load_visible)

    def day_sep(self, view, ms):
        sep = label(day_label(ms), "day", xalign=0.5)
        sep.set_halign(Gtk.Align.CENTER)
        sep.is_day = True
        view.pack_start(sep, False, False, 6)
        sep.show()
        return sep

    def add_bubble(self, view, m):
        """A message at the bottom of a chat (the newest)."""
        day = datetime.fromtimestamp(m["time"] / 1000).date() if m["time"] else None
        if day and day != view.last_day:
            view.last_day = day
            sep = self.day_sep(view, m["time"])
            if view.top_sep is None:
                view.first_day, view.top_sep = day, sep
        if view.oldest is None or (m["time"] or 0) < view.oldest:
            view.oldest = m["time"] or 0
        view.pack_start(self.bubble(view, m), False, False, 0)

    def prepend(self, view, msgs):
        """Older messages (oldest first) at the top, under their day labels."""
        pos, prev = 0, None
        first_sep = None
        for m in msgs:
            if m["id"] in view.shown:
                continue
            day = datetime.fromtimestamp(m["time"] / 1000).date() if m["time"] else None
            if day and day != prev:
                sep = self.day_sep(view, m["time"])
                view.reorder_child(sep, pos)
                pos += 1
                first_sep = first_sep or (day, sep)
                prev = day
            w = self.bubble(view, m)
            view.pack_start(w, False, False, 0)
            view.reorder_child(w, pos)
            pos += 1
            view.oldest = min(view.oldest or m["time"], m["time"])
        if first_sep is None:
            return 0
        if prev == view.first_day and view.top_sep is not None:
            view.top_sep.destroy()  # that day now starts higher up
        if view.last_day is None:
            view.last_day = prev
        view.first_day, view.top_sep = first_sep
        return pos

    def bubble(self, view, m):
        view.shown.add(m["id"])
        bubble = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        bubble.get_style_context().add_class("bubble")
        bubble.get_style_context().add_class("mine" if m["mine"] else "theirs")
        # A long press offers the reactions.
        hold = Gtk.EventBox()
        hold.set_halign(Gtk.Align.END if m["mine"] else Gtk.Align.START)
        hold.add(bubble)
        hold.press = Gtk.GestureLongPress.new(hold)
        hold.press.connect("pressed", lambda _g, _x, _y: self.pick_reaction(view, m["id"], bubble))
        group = self.summaries.get(view.chat_id, {}).get("type") in ("CHAT", "CHANNEL")
        if group and not m["mine"] and m["who"]:
            bubble.pack_start(label(m["who"], "who"), False, False, 0)
        for url in m["photos"]:
            img = Gtk.Image.new_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            img.set_size_request(460, 200)
            bubble.pack_start(img, False, False, 0)
            view.photos.append((img, url))  # loaded once near the screen
        for item in m.get("media") or []:
            bubble.pack_start(self.media_widget(view, m, item), False, False, 0)
        if m["text"]:
            text = label(m["text"], "msg", wrap=True)
            text.set_max_width_chars(38)
            text.set_selectable(False)
            bubble.pack_start(text, False, False, 0)
        reacts = Gtk.Box(spacing=6)
        bubble.pack_start(reacts, False, False, 0)
        view.msgs[m["id"]] = (m, reacts)
        self.fill_reactions(view, m["id"])
        bubble.pack_start(label(when(m["time"], full=True), "when", xalign=1.0), False, False, 0)
        hold.msg_id = m["id"]
        hold.show_all()
        return hold

    # voice messages, videos, files
    def media_widget(self, view, m, item):
        if item["kind"] == "audio":
            box = Gtk.Box(spacing=12)
            play = Gtk.Button(label="▶")
            play.get_style_context().add_class("media")
            play.set_can_focus(False)

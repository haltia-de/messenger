                self.show_found_chat(info, link)

            self.backend.run(self.backend.link_info(link), chat)
        else:
            want = text.casefold()
            hits = sorted((c for c in self.summaries.values()
                           if want in c["title"].casefold() and not self.hidden(c)),
                          key=lambda c: -(c["time"] or 0))
            self.find_hint.set_text("" if hits else "Среди ваших чатов такого нет.")

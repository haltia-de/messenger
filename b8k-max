    def show_chats(self, summaries):
        self.summaries = {s["id"]: s for s in summaries}
        save_list(summaries)
        page = self.stack.get_visible_child_name()
        if page in ("wait", "qr"):
            self.stack.set_visible_child_name("chats")
        elif page == "settings":
            self.came_from = "chats"
        self.fill_list()
        return False

    def incoming(self, msg, summary):
        if summary:
            self.summaries[summary["id"]] = summary
            if self.pending.pop(summary["id"], None) and self.open_chat == summary["id"]:
                self.trash.set_visible(self.stack.get_visible_child_name() == "chat")
        if self.hidden(self.summaries.get(msg["chat"])) and self.open_chat != msg["chat"]:
            self.fill_list()
            return False  # from a stranger: no bubble, no buzz, left unread
        here = self.open_chat == msg["chat"] and self.win.is_visible()
        view = self.views.get(msg["chat"])
        if view and msg["id"] not in view.shown:
            self.add_bubble(view, msg)
            if here:
                self.scroll_down()
        if here and not msg["mine"] and self.win.is_active():
            self.backend.run(self.backend.read(msg["chat"], msg["id"]))
            if msg["chat"] in self.summaries:
                self.summaries[msg["chat"]]["unread"] = 0
        loud = not self.is_muted(self.summaries.get(msg["chat"]) or {"id": msg["chat"]})
        if not msg["mine"] and self.buzz_new and loud:
            self.buzz()
            if not here:
                GLib.timeout_add(180, lambda: self.buzz() and False)
        self.fill_list()
        return False

    # the list
    def fill_list(self):
        """Bring the list in line with the summaries. Rows are kept and only
        a chat that changed is redrawn: a new message used to rebuild every
        row, slow on the tablet with a hundred chats."""
        for chat_id in [i for i in self.rows if i not in self.summaries]:
            self.rows.pop(chat_id).destroy()
        for s in self.summaries.values():
            row = self.rows.get(s["id"])
            look = self.look(s)
            if row is None:
                row = self.rows[s["id"]] = self.chat_row(s)
                self.list.add(row)
                row.show_all()
            elif row.look != look:
                row.remove(row.get_child())
                row.add(self.chat_row(s).steal())
                row.show_all()
            row.summary, row.look = s, look
        self.list.invalidate_sort()
        self.list.invalidate_filter()
        shown = [s for s in self.summaries.values() if not self.hidden(s)]
        loud = [s for s in shown if not self.is_muted(s)]
        total = sum(s["unread"] for s in loud)
        for b, name, channels in ((self.tab_chats, "Чаты", False), (self.tab_channels, "Каналы", True)):
            n = sum(s["unread"] for s in shown if (s.get("type") == "CHANNEL") == channels)
            b.set_label("%s · %d" % (name, n) if n else name)
        if self.open_chat is None and self.stack.get_visible_child_name() == "chats":
            self.sub.set_text("непрочитанных: %d" % total if total else "")
        # The button counts what may buzz: muted chats (channels by default) are left out.
        set_badge(total)

    def chat_row(self, s):
        """One chat of a list: initials, name, last message, time, unread."""
        row = Gtk.ListBoxRow()
        row.chat_id = s["id"]
        row.summary, row.look = s, self.look(s)
        row.steal = lambda: (row.remove(box), box)[1]  # the contents, for a kept row
        box = Gtk.Box(spacing=18)
        box.set_margin_start(16)
        box.set_margin_end(16)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.pack_start(initials_icon(s["title"], s["id"]), False, False, 0)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        mid.set_valign(Gtk.Align.CENTER)
        mid.pack_start(label(s["title"], "chat-name", ellipsize=True), False, False, 0)
        mid.pack_start(label(s["last"], "chat-last", ellipsize=True), False, False, 0)
        box.pack_start(mid, True, True, 0)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.set_valign(Gtk.Align.CENTER)
        top = "%s%s" % ("📌 " if s["id"] in self.pinned else "", when(s["time"]))
        right.pack_start(label(top, "chat-time", xalign=1.0), False, False, 0)
        if s["unread"]:
            badge = label(str(s["unread"]), "badge", xalign=0.5)
            if self.is_muted(s):
                badge.get_style_context().add_class("quiet")
            badge.set_halign(Gtk.Align.END)
            right.pack_start(badge, False, False, 0)
        box.pack_end(right, False, False, 0)
        row.add(box)
        return row

    def on_row(self, _list, row):
        if time.monotonic() - self.held < 1.0:
            return  # the release of a long press: the menu is open
        self.buzz()
        self.open(row.chat_id)

    # tabs, pinning, notifications
    def look(self, s):
        """What a row shows: when it changes the row is redrawn."""
        return (s["title"], s["last"], s["time"], s["unread"], s["id"] in self.pinned,
                self.is_muted(s))

    def order(self, s):
        """Pinned first, in the order pinned; then the newest."""
        if s["id"] in self.pinned:
            return (1, -self.pinned.index(s["id"]))
        return (0, s["time"] or 0)

    def in_tab(self, s):
        return not self.hidden(s) and (s.get("type") == "CHANNEL") == (self.tab == "channels")

    def is_muted(self, s):
        if s.get("type") == "CHANNEL":
            return s["id"] not in self.unmuted
        return s["id"] in self.muted

    def show_tab(self, name):
        self.tab = name
        self.list.invalidate_filter()
        adj = self.list.get_parent().get_vadjustment() if isinstance(
            self.list.get_parent(), Gtk.Scrollable) else None
        if adj:
            adj.set_value(0)

    def save_prefs(self):
        save_json(PREFS, {"pinned": self.pinned, "muted": sorted(self.muted),
                          "unmuted": sorted(self.unmuted)})

    def row_menu(self, _gesture, _x, y):
        row = self.list.get_row_at_y(int(y))
        if row is None:
            return
        self.held = time.monotonic()
        self.buzz()
        s = row.summary
        pop = Gtk.Popover.new(row)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        pinned, muted = s["id"] in self.pinned, self.is_muted(s)
        for text, act in (("📌 Открепить" if pinned else "📌 Закрепить сверху", self.toggle_pin),
                          ("🔔 Включить оповещения" if muted else "🔕 Без оповещений",
                           self.toggle_mute)):
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("menu")
            b.get_child().set_xalign(0.0)
            b.connect("clicked", lambda _b, a=act: (pop.popdown(), a(s)))
            box.pack_start(b, False, False, 0)
        pop.add(box)
        pop.connect("closed", lambda p: GLib.idle_add(p.destroy))
        box.show_all()
        pop.popup()

    def toggle_pin(self, s):
        if s["id"] in self.pinned:
            self.pinned.remove(s["id"])
        else:
            self.pinned.append(s["id"])
        self.save_prefs()
        self.fill_list()

    def toggle_mute(self, s):
        quiet = not self.is_muted(s)
        if s.get("type") == "CHANNEL":
            (self.unmuted.discard if quiet else self.unmuted.add)(s["id"])
        else:
            (self.muted.add if quiet else self.muted.discard)(s["id"])
        self.save_prefs()
        self.fill_list()

    def show_list(self):
        if self.view is not None:
            self.trim(self.view)
        self.open_chat = None
        self.back.hide()
        self.title.set_text("MAX")
        self.stack.set_visible_child_name("chats")
        self.fill_list()

    # the search: a person by phone, a channel or group by link, own chats by name
    def show_find(self):

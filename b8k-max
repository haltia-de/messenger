            box.pack_start(play, False, False, 0)
            box.pack_start(bar, True, True, 0)
            box.pack_start(length, False, False, 0)
            return box
        if item["kind"] == "video":
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            if photo_ok(item["thumb"]):
                img = Gtk.Image.new_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)
                img.set_size_request(460, 200)
                box.pack_start(img, False, False, 0)
                view.photos.append((img, item["thumb"]))
            sec = secs(item["duration"])
            b = Gtk.Button(label="▶  Видео %s" % mmss(sec) if sec else "▶  Видео")
            b.get_style_context().add_class("file")
            b.set_can_focus(False)
            b.connect("clicked", lambda _b: self.open_media(view.chat_id, m["id"], item, b))
            box.pack_start(b, False, False, 0)
            return box
        b = Gtk.Button(label="📄  %s · %s" % (item["name"], size_text(item["size"])))
        b.get_style_context().add_class("file")

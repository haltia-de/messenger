class Max(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="b8k.Max")
        self.win = None
        self.buzz = buzzer()
        self.backend = Backend(self)
        self.telemetry = Telemetry(self.backend)
        self.came_from = "chats"  # the page the settings go back to
        self.buzz_new = load_setting("buzz")  # buzz on a new message
        self.contacts_only = load_setting("contacts_only")  # strangers' dialogs hidden
        self.invites = load_setting("invites")  # only contacts may add to chats (on MAX)
        self.summaries = {}
        self.pending = {}  # dialogs opened from the search, not written to yet
        prefs = load_json(PREFS, {})
        # Kept here only: MAX's own pinning and muting are not in PyMax.
        self.pinned = [i for i in prefs.get("pinned", []) if isinstance(i, int)]
        self.muted = set(prefs.get("muted", []))  # chats without buzz and badge
        self.unmuted = set(prefs.get("unmuted", []))  # channels with them (muted by default)
        self.tab = "chats"  # or "channels"
        self.sound = None  # Sound, made at the first voice message played
        self.playing = None  # (progress bar, button, duration) of what plays
        self.held = 0.0  # when a row was long-pressed: its release opens nothing
        self.open_chat = None
        self.views = {}  # chat id -> built view, most recently used last
        self.view = None

        self.title.set_text("Поиск")
        self.sub.set_text("")
        self.back.show()
        self.find_hint.set_text(
            "Номер телефона — найти человека в MAX. Ссылка max.ru/… или @имя — "
            "канал или группа. Другое — среди ваших чатов.")

# --- small helpers ----------------------------------------------------------
def kind(value):
    """An enum or a string, as a plain upper-case string."""
    value = getattr(value, "value", value)
    return str(value or "").upper()


def when(ms, full=False):
    if not ms:
        return ""
    t = datetime.fromtimestamp(ms / 1000)
    if t.date() == date.today() and not full:
        return t.strftime("%-H:%M")
    if full:
        return t.strftime("%-H:%M")
    return "%d %s" % (t.day, MONTHS[t.month - 1])


def day_label(ms):
    d = datetime.fromtimestamp(ms / 1000).date()
    delta = (date.today() - d).days
    if delta == 0:
        return "Сегодня"
    if delta == 1:
        return "Вчера"
    return "%d %s" % (d.day, MONTHS[d.month - 1])


def label(text, cls, xalign=0.0, wrap=False, ellipsize=False):
    lab = Gtk.Label(label=text, xalign=xalign)
    lab.get_style_context().add_class(cls)
    if wrap:
        lab.set_line_wrap(True)
        lab.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if ellipsize:
        lab.set_ellipsize(Pango.EllipsizeMode.END)
        lab.set_single_line_mode(True)
    return lab


def initials_icon(name, key, size=64):
    area = Gtk.DrawingArea()
    area.set_size_request(size, size)
    letters = "".join(w[0] for w in (name or "?").split()[:2]).upper() or "?"
    colour = COLOURS[int(key) % len(COLOURS)]

    def draw(_w, cr):
        cr.set_source_rgb(*colour)
        cr.arc(size / 2, size / 2, size / 2, 0, 6.2832)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(size * 0.38)
        ext = cr.text_extents(letters)
        cr.move_to((size - ext.width) / 2 - ext.x_bearing, (size - ext.height) / 2 - ext.y_bearing)
        cr.show_text(letters)
        return False

    area.connect("draw", draw)
    return area


def phone_of(text):
    """A phone number as MAX looks it up (+7…), or None if this is not one."""
    if not re.fullmatch(r"\+?[\d\s()-]+", text):
        return None
    digits = re.sub(r"\D", "", text)
    if len(digits) == 10:
        digits = "7" + digits
    elif len(digits) == 11 and digits[0] == "8":
        digits = "7" + digits[1:]
    return "+" + digits if 11 <= len(digits) <= 15 else None


def link_of(text):
    """A MAX link to a channel or group (max.ru/name, max.ru/join/…, @name)
    as https://max.ru/…, or None."""
    text = text.strip()
    if re.fullmatch(r"@[\w.]+", text):
        return "https://max.ru/" + text[1:]
    m = re.fullmatch(r"(?:https?://)?(?:web\.)?max\.ru/([\w./-]+)", text, re.I)
    return "https://max.ru/" + m.group(1).strip("/") if m else None


def reactions_of(info):
    """[[emoji, count], ...] and the account's own emoji, from a ReactionInfo."""
    if not info:
        return [], None
    return ([[c.reaction, c.count] for c in info.counters or [] if c.count],
            info.your_reaction)


def user_name(user):
    for n in getattr(user, "names", None) or []:
        full = getattr(n, "name", None) or " ".join(
            x for x in (getattr(n, "first_name", None), getattr(n, "last_name", None)) if x)
        if full:
            return full
    return "Пользователь %s" % getattr(user, "id", "")


# Files played in the bubble like voice messages, by their name.
AUDIO_FILES = (".mp3", ".m4a", ".aac", ".ogg", ".oga", ".opus", ".wav", ".flac")


def media_of(a):
    """What can be played or opened of an attachment, or None. An audio file
    is played in the bubble too: its link (url None here) is asked of MAX
    when played, as for any file."""
    t = kind(getattr(a, "type", ""))
    if t == "AUDIO" and getattr(a, "url", None):
        return {"kind": "audio", "url": a.url, "duration": a.duration or 0}
    if t == "FILE" and (a.name or "").lower().endswith(AUDIO_FILES):
        return {"kind": "audio", "url": None, "file": a.file_id, "name": a.name,
                "size": a.size, "duration": 0}
    if t == "VIDEO":
        return {"kind": "video", "id": a.video_id, "thumb": a.thumbnail,
                "duration": a.duration or 0}
    if t == "FILE":
        return {"kind": "file", "id": a.file_id, "name": a.name, "size": a.size}
    return None


def attach_summary(a):
    """(what, photo url or None) for one attachment."""
    t = kind(getattr(a, "type", ""))
    if t == "PHOTO":
        return "", getattr(a, "base_url", None)
    names = {"VIDEO": "видео", "AUDIO": "голосовое сообщение", "FILE": "файл",
             "STICKER": "стикер", "CONTACT": "контакт", "POLL": "опрос", "CALL": "звонок",
             "SHARE": "ссылка"}
    if t == "FILE" and getattr(a, "name", None):
        return "файл «%s»" % a.name, None
    return names.get(t, ""), None


# --- MAX, in its own thread -------------------------------------------------
# --- the link to MAX -------------------------------------------------------------
class PyMaxLink:
    """The link to MAX (CONTEXT.md: Связь с MAX) through PyMax's web client:
    every request this program makes, and the events it gets, in one place.
    It hands out PyMax's own objects (Chat, Message, User, ReactionInfo) and
    keeps everything else of PyMax, its internals included, to itself, so a
    PyMax upgrade is checked here. tests/fake_link.py is the other one.

    run(events) logs in and lives as long as the connection: it calls
    events.on_qr(url) when a QR code is to be scanned, on_login(me, chats,
    contacts, agent, session_id) after every (re)login, on_message(msg) and
    on_reaction(chat_id, msg_id, reactions) as they come. All of it runs in
    the caller's asyncio loop."""

    def __init__(self, work_dir):
        self.work_dir = work_dir
        self.client = None
        self.events = None
        self.settings = {}  # the account's own settings, from the last login

    async def run(self, events):
        from pymax import WebClient
        from pymax.config import ExtraConfig

        self.events = events
        # PyMax's own telemetry (a random simulation) stays off: Telemetry
        # sends what really happens instead.
        self.client = WebClient(session_name="web.db", work_dir=self.work_dir,
                                extra_config=ExtraConfig(telemetry=False, log_level="WARNING",
                                                         reconnect_delay=3.0),
                                qr_provider=self)
        self._watch_login()
        self.client.on_start()(self._started)
        self.client.on_message()(self._message)
        self.client.on_reaction_update()(self._reaction)
        await self.client.start()

    def _watch_login(self):
        """Keep the account's own settings from each login answer: PyMax
        reads only the hash of its "config", the settings are in its
        "user" part (CHATS_INVITE and the like). The answer is caught where
        PyMax's auth turns it into a LoginResponse, as PyMax's runtime (and
        its invoke) exists only once start() runs."""
        from pymax.api.auth import service as auth

        real = getattr(auth.require_payload_model, "b8k_real", auth.require_payload_model)

        def keep(response, model, *args, **kwargs):
            if getattr(model, "__name__", "") == "LoginResponse":
                config = (getattr(response, "payload", None) or {}).get("config") or {}
                if isinstance(config.get("user"), dict):
                    self.settings = config["user"]
            return real(response, model, *args, **kwargs)

        keep.b8k_real = real
        auth.require_payload_model = keep

    def invites(self):
        """Who may add the account to chats, as MAX said at the last login:
        "CONTACTS", "ALL", or None when not said. Only MAX's own app may
        change it."""
        return self.settings.get("CHATS_INVITE")

    async def show_qr(self, qr_url):  # PyMax's QrHandler
        await self.events.on_qr(qr_url)

    async def _started(self, client):
        try:
            os.chmod(os.path.join(self.work_dir, "web.db"), 0o600)
        except OSError:
            pass
        device = client._app.config.device
        try:  # the browser PyMax presents itself as; media links want the same
            agent = device.user_agent.header_user_agent
        except AttributeError:
            agent = None
        await self.events.on_login(client.me.contact if client.me else None,
                                   list(client.chats or []), list(client.contacts or []),
                                   agent, device.client_session_id)

    async def _message(self, msg, _client):
        await self.events.on_message(msg)

    async def _reaction(self, event, _client):
        reactions = [[c.reaction, c.count] for c in event.counters or [] if c.count]
        await self.events.on_reaction(event.chat_id, int(event.message_id), reactions)

    @property
    def _api(self):
        return self.client._app.api

    # chats and people
    async def chats_page(self, marker=None):
        """A page of the chat list, the newest first, older than marker (ms)."""
        return await self._api.chats.fetch_chats(marker)

    async def chats(self, ids):
        return await self._api.chats.get_chats(list(ids))

    async def users(self, ids):
        return await self._api.users.get_users(list(ids))

    async def find_phone(self, phone):
        """The user with this phone number; an error if nobody in MAX has it."""
        return await self._api.users.search_by_phone(phone)

    async def add_contact(self, user_id):
        return await self._api.users.add_contact(user_id)

    async def link_info(self, link):
        """The channel or group behind a link, or None. PyMax's own call
        takes invite links only (join/…), so public max.ru/name links go
        as the web client sends them."""
        from pymax.api.chats.enums import ChatPayloadKey
        from pymax.api.chats.payloads import LinkInfoPayload
        from pymax.api.response import parse_payload_item_model
        from pymax.protocol import Opcode
        from pymax.types.domain import Chat

        at = link.find("join/")  # invite links go as join/…, public ones whole
        frame = LinkInfoPayload(link=link[at:] if at != -1 else link)
        response = await self.client._app.invoke(Opcode.LINK_INFO, frame.to_payload())
        return parse_payload_item_model(response, ChatPayloadKey.CHAT, Chat)

    async def join(self, link):
        return await self._api.chats.join_channel(link)  # groups too

    async def leave(self, chat_id):
        """Out of a group or channel."""
        await self._api.chats.leave_group(chat_id)

    async def delete(self, chat_id, last_event_time=None):
        """A chat off this account's list. Only for this account: there is
        no way here to delete it for the others in it."""
        await self._api.chats.delete_chat(chat_id, last_event_time=last_event_time,
                                          for_all=False)

    # messages
    async def history(self, chat_id, backward, before=None):
        """Up to backward messages, the newest ones, or those older than
        before (ms)."""
        if before is None:
            return await self._api.messages.fetch_history(chat_id=chat_id, backward=backward)
        msgs = await self._api.messages.fetch_history(chat_id=chat_id, backward=backward,
                                                      forward=0, from_=before - 1)
        return [m for m in msgs if m.time < before]

    async def read(self, chat_id, msg_id):
        await self._api.messages.read_message(msg_id, chat_id)

    async def send(self, chat_id, text):
        return await self._api.messages.send_message(chat_id, text)

    async def forward(self, chat_id, msg_id, from_chat_id):
        """A message (its attachments with it) into another chat, as MAX
        forwards: the new message links to the original."""
        return await self._api.messages.forward_message(chat_id, msg_id, from_chat_id)

    async def react(self, chat_id, msg_id, emoji):
        """The account's reaction put on (None: taken off); MAX's counts
        afterwards (ReactionInfo), or None when it sends none."""
        if emoji:
            return await self._api.messages.add_reaction(chat_id, msg_id, emoji)
        return await self._api.messages.remove_reaction(chat_id, msg_id)

    async def media_url(self, chat_id, msg_id, item):
        """The short-lived link MAX gives for a video or a file of a message.
        Only MAX's own link: an "external" one (a video elsewhere) is not
        given, since the player would fetch whatever it names."""
        if item["kind"] == "video":
            got = await self._api.messages.get_video_by_id(chat_id, msg_id, item["id"])
        else:
            got = await self._api.messages.get_file_by_id(chat_id, msg_id, item["id"])
        return getattr(got, "url", None) if got else None

    # the account
    async def log(self, events):
        """Telemetry events (dicts shaped as PyMax's TelemetryEvent); dropped
        while not connected."""
        from pymax.protocol import Opcode
        from pymax.telemetry.payloads import TelemetryEvent, TelemetryPayload

        app = self.client._app if self.client else None
        if not (app and app.started and app.me and app.connection.is_open):
            return
        payload = TelemetryPayload(events=[TelemetryEvent(**e) for e in events]).to_payload()
        await app.invoke(Opcode.LOG, payload, timeout=app.config.request_timeout)


class Backend:
    """What the window asks of MAX, and what MAX tells it, on top of a link
    (PyMaxLink, or tests/fake_link.py): the chat list and its summaries,
    names, known people, the message cache and its gaps, pages, reactions.
    It runs in its own thread with an asyncio loop;
    the window calls it only through run(), and hears back through
    GLib.idle_add. It is also the link's events object (on_qr, on_login,
    on_message, on_reaction)."""

    def __init__(self, ui, link=None):
        self.ui = ui
        self.link = link  # PyMaxLink unless given (tests)
        self.loop = None
        self.me = None
        self.names = {}
        self.chats = {}
        self.seeded = os.path.exists(KNOWN)
        self.known = set(load_json(KNOWN, []))
        self.agent = None  # PyMax's browser user agent, once logged in
        self.aliases = {int(k): v for k, v in load_json(ALIASES, {}).items()}

    def start(self):
        threading.Thread(target=self._thread, daemon=True).start()

    def _thread(self):
        self.loop = asyncio.new_event_loop()
        asyncio.set_event_loop(self.loop)
        try:
            self.loop.run_until_complete(self._main())
        except Exception as exc:  # the client gave up for good
            GLib.idle_add(self.ui.failed, repr(exc))

    def run(self, coro, done=None):
        """Run a coroutine in the MAX thread; done(result, error) in the window's."""
        if not self.loop:
            return
        fut = asyncio.run_coroutine_threadsafe(coro, self.loop)
        if done:
            def back(f):
                try:
                    res, err = f.result(), None
                except Exception as exc:
                    res, err = None, exc
                GLib.idle_add(lambda: done(res, err) and False)
            fut.add_done_callback(back)

    async def _main(self):
        os.makedirs(DATA, mode=0o700, exist_ok=True)
        if self.link is None:
            self.link = PyMaxLink(DATA)
        await self.link.run(self)

    # --- the link's events ------------------------------------------------------
    async def on_qr(self, qr_url):
        import qrcode

        path = os.path.join(DATA, "qr.png")
        qrcode.make(qr_url, box_size=12, border=2).save(path)
        GLib.idle_add(self.ui.show_qr, path)

    async def on_login(self, me, chats, contacts, agent, session_id):
        try:
            os.remove(os.path.join(DATA, "qr.png"))
        except OSError:
            pass
        self.me = me.id if me else None
        self.agent = agent
        if me:
            self.names[self.me] = user_name(me)
        # On a reconnect the sync only brings chats that changed since the
        # last one, so page through the whole list as well.
        found = {c.id: c for c in chats or []}
        marker = None
        for _page in range(5):
            try:
                page = await self.link.chats_page(marker)
            except Exception:
                break
            fresh = [c for c in page if c.id not in found]
            for c in page:
                found.setdefault(c.id, c)
            if not page or not fresh:
                break
            marker = min(c.last_event_time for c in page if c.last_event_time) - 1
        chats = list(found.values())
        self.chats = found
        # The contacts come whole on the first login, then only what changed:
        # keep them on disk. The first time, everyone already in a dialog
        # counts too, so that nobody known goes quiet after an update.
        for u in contacts or []:
            if u:
                self.known.add(u.id)
                self.names.setdefault(u.id, user_name(u))
        if not self.seeded:
            self.known.update(p for p in map(self.peer, chats) if p)
            self.seeded = True
        save_json(KNOWN, sorted(self.known))
        want = set()
        for c in chats:
            if kind(c.type) == "DIALOG":
                want.update(u for u in c.participants if u != self.me)
        await self.lookup(want)
        if self.me:
            GLib.idle_add(self.ui.logged_in, self.me, session_id)
            GLib.idle_add(self.ui.show_invites, self.link.invites())
        GLib.idle_add(self.ui.show_chats, [self.summary(c) for c in chats])

    async def on_message(self, msg):
        await self.lookup({msg.sender})
        known = msg.chat_id in self.chats  # a new chat comes with its count
        chat = await self.chat(msg.chat_id) if msg.chat_id is not None else None
        if chat is not None:
            chat.last_message = msg
            if msg.sender != self.me and known:
                chat.new_messages = (chat.new_messages or 0) + 1
        out = self.message(msg)
        if msg.chat_id is not None:
            cache_add(msg.chat_id, [out])
        GLib.idle_add(self.ui.incoming, out, self.summary(chat) if chat is not None else None)

    async def on_reaction(self, chat_id, msg_id, reactions):
        """Someone's reaction changed; the event does not say whose, so the
        account's own stays as it was known."""
        cache_react(chat_id, msg_id, reactions)
        GLib.idle_add(self.ui.reacted, chat_id, msg_id, reactions, ...)

    # --- names, summaries, messages ---------------------------------------------
    async def lookup(self, ids):
        ids = [i for i in ids if i and i not in self.names]
        for k in range(0, len(ids), 50):
            try:
                users = await self.link.users(ids[k:k + 50])
            except Exception:
                continue
            for u in users or []:
                if u:
                    self.names[u.id] = user_name(u)

    def peer(self, chat):
        """The other person of a dialog (None in Избранное, a group, a channel)."""
        if kind(chat.type) != "DIALOG":
            return None
        others = [u for u in chat.participants if u != self.me]
        return others[0] if others else None

    def remember(self, user_id):
        """Someone whose messages are welcome: a contact, or written to here."""
        if user_id and user_id != self.me and user_id not in self.known:
            self.known.add(user_id)
            save_json(KNOWN, sorted(self.known))

    def name(self, user_id, default=""):
        """The name given here, else the one in MAX."""
        return self.aliases.get(user_id) or self.names.get(user_id, default)

    def title(self, chat):
        if chat.title:
            return chat.title
        if kind(chat.type) == "DIALOG":
            others = [u for u in chat.participants if u != self.me]
            if not others:
                return "Избранное"
            return self.name(others[0], "Собеседник")
        return "Чат"

    @staticmethod
    def carried(msg):
        """The message whose text and attachments are shown: a forwarded
        one carries the original inside its link."""
        link = getattr(msg, "link", None)
        if link is not None and kind(getattr(link, "type", "")) == "FORWARD" and link.message:
            return link.message
        return msg

    def preview(self, msg):
        if not msg:
            return ""
        shown = self.carried(msg)
        text = (shown.text or "").replace("\n", " ")
        if not text:
            parts = [attach_summary(a)[0] or "фото" for a in shown.attaches or []]
            text = ", ".join(p for p in parts if p).capitalize()
        if shown is not msg:
            text = "↪ " + text
        if msg.sender == self.me and self.me:
            text = "Вы: " + text
        return text

    def summary(self, chat):
        last = chat.last_message
        peer = self.peer(chat)
        return {"id": chat.id, "title": self.title(chat), "type": kind(chat.type),
                "last": self.preview(last), "time": (last.time if last else 0) or chat.last_event_time,
                "unread": chat.new_messages or 0, "peer": peer,
                "stranger": peer is not None and peer not in self.known}

    def message(self, msg):
        shown = self.carried(msg)
        forwarded = None
        if shown is not msg:  # from whom: the chat it came from, else its sender
            forwarded = msg.link.chat_name or self.name(shown.sender) or "…"
        texts, photos, media = [], [], []
        for a in shown.attaches or []:
            what, url = attach_summary(a)
            item = media_of(a)
            if url:
                photos.append(url)
            elif item:
                media.append(item)
            elif what:
                texts.append("[%s]" % what)
        body = shown.text or ""
        if texts:
            body = (body + "\n" if body else "") + " ".join(texts)
        reactions, yours = reactions_of(msg.reaction_info)
        return {"id": msg.id, "chat": msg.chat_id, "sender": msg.sender,
                "who": self.name(msg.sender), "text": body, "photos": photos,
                "time": msg.time, "mine": bool(self.me) and msg.sender == self.me,
                "reactions": reactions, "yours": yours, "media": media,
                "forwarded": forwarded}

    async def chat(self, chat_id):
        """The chat, from the list or asked for (one just joined, a new
        dialog that has its first message); None if MAX has none."""
        chat = self.chats.get(chat_id)
        if chat is None:
            try:
                found = await self.link.chats([chat_id])
            except Exception:
                found = []
            if found:
                chat = self.chats[chat_id] = found[0]
        return chat

    # --- what the window asks -----------------------------------------------------
    async def history(self, chat_id):
        """The newest PAGE messages of a chat, and whether they leave a gap
        after the cache (more came meanwhile than a page): then the cache is
        started anew from them."""
        chat = await self.chat(chat_id)
        if not chat:
            return [], False  # a dialog nobody has written to yet
        # Nothing new since a full cache: no request at all (new messages
        # and reactions while running come as events). A cache of a few
        # messages (a chat that came by an event) is not full: asked for.
        cached = cache_read(chat_id)
        last = chat.last_message
        if len(cached) >= PAGE and last and not chat.new_messages and \
                any(m["id"] == last.id for m in cached[-5:]):
            return [], False
        msgs = await self.link.history(chat_id, PAGE)
        if any(m.sender == self.me for m in msgs):
            self.remember(self.peer(chat))
        await self.lookup({m.sender for m in msgs})
        msgs.sort(key=lambda m: m.time)
        if msgs:
            try:
                await self.link.read(chat_id, msgs[-1].id)
                chat.new_messages = 0
            except Exception:
                pass
        out = [self.message(m) for m in msgs]
        known = {m["id"] for m in cached}
        gap = bool(cached) and len(out) >= PAGE and not known & {m["id"] for m in out} and \
            out[0]["time"] > cached[-1]["time"]
        if gap:
            cache_drop(chat_id)
        cache_add(chat_id, out)
        return out, gap

    async def older(self, chat_id, before):
        """PAGE messages older than the time before (ms), oldest first; not
        cached, the cache keeps only the newest."""
        if not await self.chat(chat_id):
            return []
        msgs = await self.link.history(chat_id, PAGE, before=before)
        await self.lookup({m.sender for m in msgs})
        msgs = sorted((m for m in msgs if m.time < before), key=lambda m: m.time)
        return [self.message(m) for m in msgs]

    async def media_url(self, chat_id, msg_id, item):
        """Where a video or a file of a message can be fetched (MAX hands
        out short-lived links on request)."""
        return await self.link.media_url(chat_id, msg_id, item)

    async def forward(self, chat_id, msg_id, from_chat_id):
        """Forward a message into a chat; (the new message, that chat's
        summary) as the window shows them."""
        msg = await self.link.forward(chat_id, msg_id, from_chat_id)
        out = self.message(msg)
        cache_add(chat_id, [out])
        chat = await self.chat(chat_id)
        if chat is not None:
            chat.last_message = msg
        return out, self.summary(chat) if chat is not None else None

    async def send(self, chat_id, text):
        chat = self.chats.get(chat_id)
        # A dialog not started yet is numbered own id XOR theirs.
        self.remember(self.peer(chat) if chat else chat_id ^ self.me if self.me else None)
        msg = await self.link.send(chat_id, text)
        out = self.message(msg) if msg else None
        if out:
            cache_add(chat_id, [out])
        return out

    async def find_phone(self, phone):
        """The person with this phone number, if they are in MAX."""
        user = await self.link.find_phone(phone)
        self.names[user.id] = user_name(user)
        return {"id": user.id, "name": self.name(user.id),
                "chat": self.me ^ user.id if self.me else None}  # their dialog, as MAX numbers it

    async def add_contact(self, user_id):
        user = await self.link.add_contact(user_id)
        self.names[user.id] = user_name(user)
        self.remember(user.id)

    async def link_info(self, link):
        """The channel or group behind a link, before joining it."""
        chat = await self.link.link_info(link)
        if chat is None:
            return None
        return {"id": chat.id, "title": chat.title or "Без названия", "type": kind(chat.type),
                "members": chat.participants_count or len(chat.participants),
                "joined": chat.id in self.chats}

    async def join(self, link):
        chat = await self.link.join(link)
        self.chats[chat.id] = chat
        return self.summary(chat)

    async def remove(self, chat_id):
        """Leave a channel or group, delete a dialog: for this account only
        (the link can do no other)."""
        chat = self.chats.get(chat_id)
        stamp = chat.last_event_time if chat else None
        if chat is not None and kind(chat.type) in ("CHAT", "CHANNEL"):
            await self.link.leave(chat_id)
            try:  # and its messages off the list, as the app does
                await self.link.delete(chat_id, stamp)
            except Exception:
                pass
        else:
            await self.link.delete(chat_id, stamp)
        self.chats.pop(chat_id, None)
        cache_drop(chat_id)

    async def react(self, chat_id, msg_id, emoji):
        """Put the account's reaction on a message (None takes it off);
        (reactions, own emoji) as MAX has them afterwards, or None."""
        info = await self.link.react(chat_id, msg_id, emoji)
        if info is None:
            return None  # taken, but MAX sent no counts: the window counts itself
        reactions, _ = reactions_of(info)
        cache_react(chat_id, msg_id, reactions, emoji)
        return reactions, emoji

    async def rename(self, user_id, name):
        """Call someone by another name here (empty: by theirs in MAX again);
        MAX itself keeps no such names for its web client. The summaries of
        their dialogs come back renamed."""
        if name:
            self.aliases[user_id] = name
        else:
            self.aliases.pop(user_id, None)
        save_json(ALIASES, {str(k): v for k, v in self.aliases.items()})
        return [self.summary(c) for c in self.chats.values() if self.peer(c) == user_id]

    async def read(self, chat_id, msg_id):
        await self.link.read(chat_id, msg_id)

    async def log(self, events):
        """Telemetry events (dicts shaped as PyMax's TelemetryEvent) to MAX."""
        if self.link is not None:
            await self.link.log(events)


_cache_lock = threading.Lock()


def cache_read(chat_id):
    try:
        with open(os.path.join(CHATS, "%d.json" % chat_id)) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return []


def cache_add(chat_id, msgs):
    """Merge messages into the chat's cache file; the newest KEEP stay."""
    if not msgs:
        return
    with _cache_lock:
        known = {m["id"]: m for m in cache_read(chat_id)}
        for m in msgs:
            known[m["id"]] = m
        keep = sorted(known.values(), key=lambda m: m["time"] or 0)[-KEEP:]
        try:
            os.makedirs(CHATS, mode=0o700, exist_ok=True)
            path = os.path.join(CHATS, "%d.json" % chat_id)
            fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as fh:
                json.dump(keep, fh, ensure_ascii=False)
            os.replace(path + ".new", path)
        except OSError:
            pass


def cache_react(chat_id, msg_id, reactions, yours=...):
    """New reactions of one cached message (yours left alone if not given)."""
    with _cache_lock:
        msgs = cache_read(chat_id)
        for m in msgs:
            if m["id"] == msg_id:
                m["reactions"] = reactions
                if yours is not ...:
                    m["yours"] = yours
                break
        else:
            return
        try:
            path = os.path.join(CHATS, "%d.json" % chat_id)
            fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as fh:
                json.dump(msgs, fh, ensure_ascii=False)
            os.replace(path + ".new", path)
        except OSError:
            pass


def cache_drop(chat_id):
    with _cache_lock:
        try:
            os.remove(os.path.join(CHATS, "%d.json" % chat_id))
        except OSError:
            pass


def load_json(path, default):
    """A small state file of DATA, or default if missing or broken."""
    try:
        with open(path) as fh:
            data = json.load(fh)
        return data if isinstance(data, type(default)) else default
    except (OSError, ValueError):
        return default


def save_json(path, data):
    """Written whole and atomically, mode 600 (it names people)."""
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump(data, fh, ensure_ascii=False)
        os.replace(path + ".new", path)
    except OSError:
        pass


def set_badge(count):
    """The number on the panel's MAX button (b8k_ui redraws it)."""
    if b8k_ui:
        b8k_ui.badge("max", count)


def load_setting(key):
    """A yes/no setting of [max] in CONFIG (telemetry, buzz); yes until set."""
    conf = configparser.ConfigParser(interpolation=None)
    conf.read(CONFIG, encoding="utf-8")
    try:
        return conf.getboolean("max", key, fallback=True)
    except ValueError:
        return True


def load_text(key, default):
    """A text setting of [max] in CONFIG (the folder for files)."""
    conf = configparser.ConfigParser(interpolation=None)
    conf.read(CONFIG, encoding="utf-8")
    return conf.get("max", key, fallback=default) or default


def save_setting(key, on):
    conf = configparser.ConfigParser(interpolation=None)
    conf.read(CONFIG, encoding="utf-8")
    if not conf.has_section("max"):
        conf.add_section("max")
    conf["max"][key] = on if isinstance(on, str) else "yes" if on else "no"
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".new", "w", encoding="utf-8") as fh:
            conf.write(fh)
        os.replace(CONFIG + ".new", CONFIG)
    except OSError:
        pass


def now_ms():
    return int(time.time() * 1000)


class Telemetry:
    """What MAX's app tells the server about its use, from what really
    happens here (see the top of the file). Called in the window's thread;
    the events leave through the MAX thread in small batches. The shapes
    and fixed values are PyMax 2.4.1's (pymax/telemetry/payloads.py)."""

    def __init__(self, backend):
        self.backend = backend
        self.on = load_setting("telemetry")
        self.user = None  # the account's id, once logged in
        self.session = 0
        self.screen = SCREEN_BACKGROUND
        self.last_go = now_ms()
        self.action = 0
        self.queue = []
        self.timer = 0

    def started(self, user, session):
        """Logged in, at start and after every reconnect, as PyMax does."""
        self.user, self.session = user, session
        self.add("PERF", "login", {
            "properties": {"connection_type": 2, "vpn": 0, "class": 2,
                           "background": 1, "warm_start": 1},
            "errorType": 100})

    def go(self, screen, params=None):
        """The person went to another screen (BACKGROUND: the window hid).
        Before the login nothing moves: the window tells again after it."""
        if screen == self.screen or self.user is None:
            return
        before, self.screen = self.screen, screen
        if before == SCREEN_BACKGROUND:
            self.session += 1  # a new visit, as the app counts them
        self.action = (self.action + 1) % 0xFFFFFFFF
        nav = {"prev_time": self.last_go, "screen_to": screen, "action_id": self.action,
               "screen_from": before}
        nav.update(params or {})
        self.last_go = now_ms()
        self.add("NAV", "GO", nav)
        if screen == SCREEN_BACKGROUND:
            self.flush()

    def chat_shown(self, messages, render):
        """A chat opened: ms until its messages came, then until drawn."""
        self.add("PERF", "open_chat_to_render", {
            "spans": [{"duration": messages + render, "name": "open_chat_to_render"},
                      {"duration": messages, "name": "messages_list_created"},
                      {"duration": render, "name": "messages_render"}],
            "properties": {"class": 2, "warm": 1, "flow": 1}})

    def add(self, type_, event, params):
        if not self.on or self.user is None:
            return
        self.queue.append({"time": now_ms(), "user_id": self.user, "type": type_,
                           "event": event, "params": params, "session_id": self.session})
        if not self.timer:
            self.timer = GLib.timeout_add_seconds(FLUSH_SEC, self._tick)

    def _tick(self):
        self.timer = 0
        self.flush()
        return False

    def flush(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        events, self.queue = self.queue, []
        if events:
            self.backend.run(self.backend.log(events))

    def switch(self, on):
        self.on = on
        save_setting("telemetry", on)
        if not on:
            self.queue = []
            self.flush()


def media_ok(url):
    """A link for a photo, a video, a voice message or a file: https on MAX's
    own hosts only (a player or the browser opens it, and a sender must not
    point it at the LAN or anywhere else)."""
    parts = urllib.parse.urlsplit(url or "")
    host = (parts.hostname or "").lower()
    return parts.scheme == "https" and any(host == h or host.endswith("." + h)
                                           for h in MEDIA_HOSTS)


def photo_ok(url):
    return media_ok(url)


def where(url):
    """A link for the log: host and path, not the signature in its query."""
    parts = urllib.parse.urlsplit(url or "")
    return "%s%s" % (parts.hostname or "?", parts.path[:60])


def secs(duration):
    """MAX gives durations in ms, some in seconds."""
    return duration / 1000 if duration > 1000 else duration


def mmss(sec):
    sec = int(sec or 0)
    return "%d:%02d" % (sec // 60, sec % 60)


def size_text(n):
    for unit in ("Б", "КБ", "МБ"):
        if n < 1024 or unit == "МБ":
            return ("%d %s" if unit == "Б" else "%.1f %s") % (n, unit)
        n /= 1024


class PhotoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not media_ok(newurl):
            return None  # urllib then raises: no hop off MAX's hosts
        return super().redirect_request(req, fp, code, msg, headers, newurl)


PHOTO_OPENER = urllib.request.build_opener(PhotoRedirect)


def log_open():
    """The media log, mode 600, started anew past 256 KB; None if it can't be."""
    try:
        os.makedirs(PHOTOS, mode=0o700, exist_ok=True)
        if os.path.getsize(PLAYER_LOG) > 256 * 1024:
            os.remove(PLAYER_LOG)
    except OSError:
        pass
    try:
        fd = os.open(PLAYER_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        return os.fdopen(fd, "a", buffering=1)
    except OSError:
        return None


def log_line(text):
    fh = log_open()
    if fh:
        with fh:
            fh.write("%s %s\n" % (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), text))


class Libmpv:
    """Voice messages through libmpv, sound only; None of it without libmpv
    (made by Media, which gives it the agent and its callbacks)."""

    def __init__(self, on_time, on_end):
        import mpv

        self.mpv = mpv.MPV(video=False, ytdl=False, load_unsafe_playlists=False,
                           input_default_bindings=False, input_vo_keyboard=False,
                           log_handler=lambda level, prefix, text: log_line(
                               "voice %s %s: %s" % (level, prefix, text.strip())),
                           loglevel="warn")
        self.duration = None  # of what plays, once libmpv knows it (files carry none)
        self.mpv.observe_property("duration", lambda _n, v: setattr(self, "duration", v))
        self.mpv.observe_property(
            "time-pos", lambda _n, v: v is not None and GLib.idle_add(on_time, v, self.duration))

        @self.mpv.event_callback("end-file")
        def _end(event):
            # A file stopped or replaced by the next one ends too (ABORTED).
            if getattr(getattr(event, "data", None), "reason", None) != 2:
                GLib.idle_add(on_end)

    def play(self, url, agent):
        self.mpv["user-agent"] = agent
        self.mpv.play(url)
        self.mpv.pause = False

    def toggle(self):
        self.mpv.pause = not self.mpv.pause
        return not self.mpv.pause

    def stop(self):
        self.mpv.command("stop")


def spawn_player(cmd):
    """Start a player, its output to the media log; OSError if it is not there."""
    out = log_open() or subprocess.DEVNULL
    try:
        subprocess.Popen(cmd, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=out, stderr=out)
    finally:
        if out is not subprocess.DEVNULL:
            out.close()


def open_in_browser(url):
    """A link in the shell's browser, else the desktop's; False if neither."""
    if b8k_ui and b8k_ui.open_url(url):
        return True
    try:
        return Gtk.show_uri_on_window(None, url, Gdk.CURRENT_TIME)
    except GLib.Error:
        return False


def download_file(url, headers, path):
    """A file to disk as it comes, never wholly in memory (videos are big)."""
    req = urllib.request.Request(url, headers=headers)
    with PHOTO_OPENER.open(req, timeout=30) as fh, open(path, "wb") as out:
        shutil.copyfileobj(fh, out, 64 * 1024)


def safe_name(name):
    """A file name from a message, made harmless: no directories, no hidden
    file, nothing unprintable."""
    name = os.path.basename((name or "").replace("\\", "/"))
    name = "".join(c for c in name if c.isprintable()).strip().lstrip(".")
    return name[:120] or "файл"


def default_folder():
    """Where files are saved unless set otherwise: «Загрузки/MAX»."""
    down = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or \
        os.path.expanduser("~/Downloads")
    return os.path.join(down, "MAX")


def fetch_photo(url, headers):
    req = urllib.request.Request(url, headers=headers)
    with PHOTO_OPENER.open(req, timeout=20) as fh:
        return fh.read(8 * 1024 * 1024)


class Media:
    """Fetching and playing what messages carry (CONTEXT.md: Медиа): the one
    place that decides how to go to MAX's CDNs. Only https links on
    MEDIA_HOSTS are fetched, played or opened; photos never follow a redirect
    off them; everything goes with one header, the browser user agent
    PyMax presents (agent, set at login) and no Referer or Origin: MAX's
    video CDN answers 400 to those. Photos are cached on disk by URL and
    pruned when unshown for PHOTO_DAYS; voice messages play through libmpv,
    one at a time (on_time(sec, total or None), on_end() come back on the
    GTK side), audio files too; a
    video opens full screen in b8k-vplay (mpv elsewhere) without
    youtube-dl or playlists; a file in the browser. What fails, and what
    the players say, goes to PLAYER_LOG (600, host and path only).

    It also saves what a message carries into a folder (save()), under a
    harmless name that never overwrites another.

    Its hands come in at creation, the real ones by default: spawn(cmd),
    open_uri(url) -> bool, fetch(url, headers) -> bytes, player(on_time,
    on_end) -> an object with play(url, agent), toggle(), stop(), and
    download(url, headers, path). Tests give their own."""

    def __init__(self, spawn=spawn_player, open_uri=open_in_browser, fetch=fetch_photo,
                 player=Libmpv, download=download_file):
        self.spawn, self.open_uri, self.fetch, self.player = spawn, open_uri, fetch, player
        self.download = download
        self.agent = "Mozilla/5.0"  # PyMax's browser user agent, once logged in
        self.on_time = self.on_end = lambda *_a: None
        self._sound = None  # the voice player, made at the first voice message
        self._no_sound = False

    def headers(self):
        return {"User-Agent": self.agent}

    # --- photos ---------------------------------------------------------------
    def photo(self, url, done):
        """A photo, from the cache or fetched in a thread; done(pixbuf or
        None) on the GTK side. Nothing at all for a link not to be fetched."""
        if not media_ok(url):
            log_line("photo refused: %s" % where(url))
            return
        os.makedirs(PHOTOS, mode=0o700, exist_ok=True)
        path = os.path.join(PHOTOS, hashlib.sha1(url.encode()).hexdigest()[:20] + ".img")

        def work():
            try:
                if os.path.exists(path):
                    os.utime(path)  # in use: kept by prune()
                else:
                    data = self.fetch(url, self.headers())
                    with open(path + ".new", "wb") as out:
                        out.write(data)
                    os.replace(path + ".new", path)
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 460, 460, True)
            except Exception as exc:
                log_line("photo %s: %r" % (where(url), exc))
                pix = None
            GLib.idle_add(lambda: done(pix) and False)

        threading.Thread(target=work, daemon=True).start()

    @staticmethod
    def prune():
        """Photos not shown for PHOTO_DAYS go (each one shown is touched)."""
        limit = time.time() - PHOTO_DAYS * 86400
        try:
            names = os.listdir(PHOTOS)
        except OSError:
            return
        for name in names:
            if not name.endswith(".img"):
                continue  # the chats directory, a half-written .new
            path = os.path.join(PHOTOS, name)
            try:
                if os.path.getmtime(path) < limit:
                    os.remove(path)
            except OSError:
                continue

    # --- saving -----------------------------------------------------------------
    def save(self, url, folder, name, done):
        """A file into folder, in a thread; done(path or None) on the GTK side.
        The name is made harmless and, if taken, numbered: «песня (2).mp3»."""
        if not media_ok(url):
            log_line("save refused: %s" % where(url))
            GLib.idle_add(lambda: done(None) and False)
            return

        def work():
            path = None
            try:
                os.makedirs(folder, exist_ok=True)
                stem, ext = os.path.splitext(safe_name(name))
                for n in range(1, 1000):
                    path = os.path.join(folder, stem + (" (%d)" % n if n > 1 else "") + ext)
                    try:  # the name is taken here at once: two saves never meet
                        os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
                        break
                    except FileExistsError:
                        continue
                self.download(url, self.headers(), path + ".part")
                os.replace(path + ".part", path)
                log_line("saved %s as %s" % (where(url), path))
            except Exception as exc:
                log_line("save %s: %r" % (where(url), exc))
                for junk in (path, path and path + ".part"):
                    try:
                        if junk:
                            os.remove(junk)
                    except OSError:
                        pass
                path = None
            GLib.idle_add(lambda: done(path) and False)

        threading.Thread(target=work, daemon=True).start()

    # --- voice ----------------------------------------------------------------
    def voice(self, url):
        """Play a voice message (the one playing stops); False if it cannot
        be: no libmpv here, or a link not to be opened."""
        if not media_ok(url):
            log_line("voice refused: %s" % where(url))
            return False
        if self._sound is None and not self._no_sound:
            try:
                self._sound = self.player(lambda sec, total=None: self.on_time(sec, total),
                                          lambda: self.on_end())
            except Exception as exc:
                log_line("voice: no libmpv (%r)" % exc)
                self._no_sound = True
        if self._sound is None:
            return False
        log_line("voice %s" % where(url))
        self._sound.play(url, self.agent)
        return True

    def toggle(self):
        """Pause or go on; True if playing now."""
        return self._sound.toggle() if self._sound else False

    def stop(self):
        if self._sound:
            self._sound.stop()

    # --- video and files ------------------------------------------------------
    def video(self, url, title):
        """Full screen in the shell's player; False if it cannot be."""
        if not media_ok(url):
            log_line("video refused: %s" % where(url))
            return False
        self.stop()
        # No youtube-dl and no playlists: the link is played as it is.
        opts = {"ytdl": "no", "load-unsafe-playlists": "no", "user-agent": self.agent}
        if os.access(PLAYER, os.X_OK):
            opts.update({"terminal": "yes", "msg-level": "all=warn"})  # libmpv: to the log
            cmd = [PLAYER, "--title", title, url] + ["%s=%s" % kv for kv in opts.items()]
        else:
            cmd = ["mpv", "--fs"] + ["--%s=%s" % kv for kv in opts.items()] + ["--", url]
        log_line("video %s via %s" % (where(url), os.path.basename(cmd[0])))
        try:
            self.spawn(cmd)
        except OSError as exc:
            log_line("video: no player (%r)" % exc)
            return False
        return True

    def file(self, url):
        """A file in the browser; False if it cannot be."""
        if not media_ok(url):
            log_line("file refused: %s" % where(url))
            return False
        log_line("file %s" % where(url))
        return bool(self.open_uri(url))


# --- the chat list ---------------------------------------------------------------
class ChatList:
    """The chat list (CONTEXT.md: Список чатов) without its widgets: the
    chats' summaries, dialogs opened from the search and not written to
    yet, pins, notifications per chat, strangers hidden; and every answer
    the window needs of it: what a tab shows in which order, the counts,
    whether a message buzzes, what the search finds. It keeps the last list
    (list_path, shown at once on the next start) and the pins and
    notifications (prefs_path) on disk itself.

    Rules: pinned chats come first, in the order pinned, then the newest;
    channels are quiet unless switched on, other chats loud unless switched
    off; a quiet chat neither buzzes nor counts on the panel's button; while
    contacts_only is on, dialogs of strangers are not shown, counted or
    found, and do not buzz."""

    def __init__(self, list_path, prefs_path, contacts_only=True):
        self.list_path, self.prefs_path = list_path, prefs_path
        self.contacts_only = contacts_only
        self.chats = {s["id"]: s for s in load_json(list_path, []) if isinstance(s, dict)}
        self.pending = {}  # dialogs opened from the search, not written to yet
        prefs = load_json(prefs_path, {})
        self.pinned = [i for i in prefs.get("pinned", []) if isinstance(i, int)]
        self.muted = set(prefs.get("muted", []))  # chats without buzz and count
        self.unmuted = set(prefs.get("unmuted", []))  # channels with them

    # --- what comes in ----------------------------------------------------------
    def replace(self, summaries):
        """The whole list, after a login."""
        self.chats = {s["id"]: s for s in summaries}
        self.pending = {i: s for i, s in self.pending.items() if i not in self.chats}
        self._save_list()

    def update(self, summary):
        """One chat as it is now (a message, a join): a new one is added."""
        new = summary["id"] not in self.chats
        self.chats[summary["id"]] = summary
        self.pending.pop(summary["id"], None)
        if new:
            self._save_list()

    def retitle(self, chat_id, title):
        if chat_id in self.chats:
            self.chats[chat_id]["title"] = title
            self._save_list()

    def remove(self, chat_id):
        self.chats.pop(chat_id, None)
        self.pending.pop(chat_id, None)
        self._save_list()

    def read(self, chat_id):
        if chat_id in self.chats:
            self.chats[chat_id]["unread"] = 0

    def start_dialog(self, summary):
        """A dialog opened from the search: it joins the list once written to."""
        if summary["id"] not in self.chats:
            self.pending[summary["id"]] = summary

    def wrote(self, chat_id, text):
        """The own message sent: the dialog is in the list now, and whoever
        is in it is no stranger."""
        if chat_id in self.pending:
            self.chats.setdefault(chat_id, self.pending.pop(chat_id))
            self._save_list()
        s = self.chats.get(chat_id)
        if s:
            s["last"], s["time"] = "Вы: " + text, int(time.time() * 1000)
            s["stranger"] = False

    def known(self, user_id):
        """Someone added to the contacts: their dialog is shown."""
        for s in self.chats.values():
            if s.get("peer") == user_id:
                s["stranger"] = False

    def pin(self, chat_id):
        """Pinned to the top, or no longer."""
        if chat_id in self.pinned:
            self.pinned.remove(chat_id)
        else:
            self.pinned.append(chat_id)
        self._save_prefs()

    def mute(self, chat_id):
        """Notifications off, or on again."""
        quiet = not self.quiet(chat_id)
        if (self.chats.get(chat_id) or {}).get("type") == "CHANNEL":
            (self.unmuted.discard if quiet else self.unmuted.add)(chat_id)
        else:
            (self.muted.add if quiet else self.muted.discard)(chat_id)
        self._save_prefs()

    # --- what is asked ------------------------------------------------------------
    def get(self, chat_id):
        """The summary, also of a dialog not written to yet; None if unknown."""
        return self.chats.get(chat_id) or self.pending.get(chat_id)

    def listed(self, chat_id):
        """In the list (not only opened from the search)."""
        return chat_id in self.chats

    def is_pinned(self, chat_id):
        return chat_id in self.pinned

    def quiet(self, chat_id):
        """No buzz and no count on the panel's button."""
        s = self.chats.get(chat_id) or {}
        if s.get("type") == "CHANNEL":
            return chat_id not in self.unmuted
        return chat_id in self.muted

    def hidden(self, chat_id):
        """A stranger's dialog, while those are not shown."""
        return self.contacts_only and bool((self.chats.get(chat_id) or {}).get("stranger"))

    def loud(self, chat_id):
        """Whether a message from this chat buzzes."""
        return not self.hidden(chat_id) and not self.quiet(chat_id)

    def entries(self, tab):
        """What a tab ("chats" or "channels") shows, top to bottom:
        (summary, pinned, quiet) each."""
        shown = [s for s in self.chats.values() if not self.hidden(s["id"])
                 and (s.get("type") == "CHANNEL") == (tab == "channels")]

        def order(s):
            if s["id"] in self.pinned:
                return (0, self.pinned.index(s["id"]))
            return (1, -(s["time"] or 0))
        return [(s, s["id"] in self.pinned, self.quiet(s["id"])) for s in sorted(shown, key=order)]

    def counts(self):
        """Unread messages: per tab, and in loud chats (the subtitle and the
        panel's button)."""
        shown = [s for s in self.chats.values() if not self.hidden(s["id"])]
        return {"chats": sum(s["unread"] for s in shown if s.get("type") != "CHANNEL"),
                "channels": sum(s["unread"] for s in shown if s.get("type") == "CHANNEL"),
                "loud": sum(s["unread"] for s in shown if not self.quiet(s["id"]))}

    def find(self, text):
        """Own chats shown whose title has the text, the newest first."""
        want = text.casefold()
        return sorted((s for s in self.chats.values()
                       if want in s["title"].casefold() and not self.hidden(s["id"])),
                      key=lambda s: -(s["time"] or 0))

    # --- on disk ----------------------------------------------------------------------
    def _save_list(self):
        save_json(self.list_path, list(self.chats.values()))

    def _save_prefs(self):
        save_json(self.prefs_path, {"pinned": self.pinned, "muted": sorted(self.muted),
                                    "unmuted": sorted(self.unmuted)})


# --- a chat on screen ----------------------------------------------------------
class ChatView:
    """One chat's messages on screen (CONTEXT.md: Chat view): its own scroll
    area, the bubbles with their day labels, reactions and media controls,
    built a few at a time; older pages fetched as the reader scrolls up (and
    PREFETCH of them in the background), with a spinner while they come; the
    place kept while bubbles go in above; photos fetched only near the
    screen. It works only between enter() and leave(); leave() cuts it to
    its newest BUBBLES.

    What it needs from outside comes in at creation: the cached messages,
    fetch_older(before_ms, done(msgs, err)) for the page before a time, and
    what a long press (on_hold(msg_id, widget)), a media control
    (on_media(msg, item, controls)) and a reaction chip (on_react(msg_id,
    emoji or None)) do, and photo(url, done) that fetches a photo. Everything
    is called on the GTK side."""

    def __init__(self, chat_id, kind, cached, fetch_older, on_hold, on_media, on_react,
                 photo):
        self.chat_id = chat_id
        self.group = kind in ("CHAT", "CHANNEL")  # senders' names over their bubbles
        self.fetch_older, self.on_hold = fetch_older, on_hold
        self.on_media, self.on_react = on_media, on_react
        self.photo = photo  # photo(url, done(pixbuf)): Media.photo
        self.shown = set()  # ids of the messages built
        self.msgs = {}  # message id -> (its dict, the box of its reactions)
        self.photos = []  # (image, url) not loaded yet: only when near the screen
        self.last_day = None  # of the newest message built
        self.first_day = self.top_sep = None  # of the oldest, and its day label
        self.oldest = None  # time of the oldest message known (built or queued)
        self.loading = self.done = False  # older pages: one at a time, none left
        self.prefetch = 0  # older pages still to fetch in the background
        # Messages still to build: newer ones at the bottom, older ones
        # (oldest first) above the top, a few at a time (_step).
        self.pending_new, self.pending_old = [], []
        self.active = self.entered = self.building = False
        self.at_bottom = True  # stays at the newest while things come in
        self.anchor = None  # distance from the bottom kept while bubbles go in above
        self.moving = False  # the place is being set here, not by the reader
        self.scrolled_at = 0.0  # when the reader last moved it (monotonic)

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.box.set_margin_start(16)
        self.box.set_margin_end(16)
        self.box.set_margin_bottom(12)
        # Over the top message while an older page is on its way.
        self.busy = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        self.busy.set_margin_top(12)
        self.spinner = Gtk.Spinner()
        self.spinner.set_size_request(32, 32)
        self.busy.pack_start(self.spinner, False, False, 0)
        self.busy.pack_start(label("загрузка…", "older"), False, False, 0)
        self.busy.set_no_show_all(True)
        for w in self.busy.get_children():
            w.show()
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        column.set_margin_top(12)
        column.pack_start(self.busy, False, False, 0)
        column.pack_start(self.box, False, False, 0)
        viewport = Gtk.Viewport()
        viewport.set_shadow_type(Gtk.ShadowType.NONE)
        viewport.add(column)
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll.set_kinetic_scrolling(True)
        self.scroll.add(viewport)
        # Down to the newest message, while the reader is up among older
        # ones; it counts the messages come meanwhile.
        self.unseen = 0
        self.down = Gtk.Button(label="↓", halign=Gtk.Align.END, valign=Gtk.Align.END)
        self.down.get_style_context().add_class("down")
        self.down.set_margin_end(24)
        self.down.set_margin_bottom(24)
        self.down.set_can_focus(False)
        self.down.set_no_show_all(True)
        self.down.connect("clicked", lambda _b: self._to_bottom())
        self.widget = Gtk.Overlay()
        self.widget.add(self.scroll)
        self.widget.add_overlay(self.down)
        self.widget.show_all()
        adj = self.scroll.get_vadjustment()
        adj.connect("changed", self._keep_place)
        adj.connect("value-changed", self._moved)

        for m in cached[-FIRST:]:  # a screen at once, the rest above it later
            self._append(m)
        self._queue_older(cached[:-FIRST])

    # --- the interface --------------------------------------------------------
    @property
    def empty(self):
        return not self.shown

    def newest(self, msgs, gap, done=None):
        """The newest page fetched on opening. If more came than a screen
        (or MAX says there is a gap after the cache), what was built is not
        continuous with it: start again from these. done() runs once drawn."""
        latest = max((m["time"] for m in msgs if m["id"] in self.shown), default=0)
        new = [m for m in msgs if m["id"] not in self.shown and m["time"] >= latest]
        if gap or len(new) > FIRST:
            self._clear()
            new = list(msgs)
        for m in msgs:
            if m["id"] in self.msgs:  # reactions may have changed meanwhile
                self.reacted(m["id"], m["reactions"], m["yours"])
        if self.shown:
            self.pending_new.extend(new)  # a few newer ones: at the bottom
            # and older ones than any built (the cache had only the last few)
            self._queue_older([m for m in msgs if m["id"] not in self.shown and
                               m["time"] < latest and m not in new])
        else:
            for m in new[-FIRST:]:
                self._append(m)
            self._queue_older(new[:-FIRST])
        self.prefetch = PREFETCH  # fetched once the bubbles are built
        self._start()
        if not self.building and self.active:  # nothing to build: on to older pages
            GLib.timeout_add(800, lambda: self._load_older(background=True) and False)
        if done:
            GLib.idle_add(lambda: done() and False)  # an idle runs after the redraw

    def add(self, msg):
        """A message just come or sent: at the bottom. The own one scrolls
        there; another's only if the reader is already there."""
        if msg["id"] in self.shown:
            return
        if self.pending_new:
            self.pending_new.append(msg)
            self._start()
        else:
            self._append(msg)
        if msg["mine"]:
            self._to_bottom()
        elif not self.at_bottom:
            self.unseen += 1
            self._show_down()

    def reacted(self, msg_id, reactions, yours=...):
        """New reactions of a message (yours: ... when not known to change)."""
        if msg_id not in self.msgs:
            return
        m = self.msgs[msg_id][0]
        if m.get("reactions") != reactions or yours is not ... and m.get("yours") != yours:
            m["reactions"] = reactions
            if yours is not ...:
                m["yours"] = yours
            self._fill_reactions(msg_id)

    def message(self, msg_id):
        """The message as built, or None."""
        return self.msgs[msg_id][0] if msg_id in self.msgs else None

    def enter(self):
        """Shown: the first time at the newest message, later where it was."""
        self.active = True
        if not self.entered:
            self.entered = True
            self._to_bottom()
        self._start()
        GLib.idle_add(self._load_visible)

    def leave(self):
        """No longer shown: nothing more is built or fetched, and only the
        newest BUBBLES stay."""
        if not self.active:
            return
        self.active = False
        self._show_busy()
        self._trim()

    def destroy(self):
        self.active = False
        self.widget.destroy()

    # --- building ---------------------------------------------------------------
    def _day_label(self, ms):
        sep = label(day_label(ms), "day", xalign=0.5)
        sep.set_halign(Gtk.Align.CENTER)
        sep.is_day = True
        self.box.pack_start(sep, False, False, 6)
        sep.show()
        return sep

    def _append(self, m):
        """A message at the bottom (the newest)."""
        day = datetime.fromtimestamp(m["time"] / 1000).date() if m["time"] else None
        if day and day != self.last_day:
            self.last_day = day
            sep = self._day_label(m["time"])
            if self.top_sep is None:
                self.first_day, self.top_sep = day, sep
        if self.oldest is None or (m["time"] or 0) < self.oldest:
            self.oldest = m["time"] or 0
        self.box.pack_start(self._bubble(m), False, False, 0)

    def _prepend(self, msgs):
        """Older messages (oldest first) at the top, under their day labels."""
        pos, prev, first_sep = 0, None, None
        for m in msgs:
            if m["id"] in self.shown:
                continue
            day = datetime.fromtimestamp(m["time"] / 1000).date() if m["time"] else None
            if day and day != prev:
                sep = self._day_label(m["time"])
                self.box.reorder_child(sep, pos)
                pos += 1
                first_sep = first_sep or (day, sep)
                prev = day
            w = self._bubble(m)
            self.box.pack_start(w, False, False, 0)
            self.box.reorder_child(w, pos)
            pos += 1
            self.oldest = min(self.oldest or m["time"], m["time"])
        if first_sep is None:
            return
        if prev == self.first_day and self.top_sep is not None:
            self.top_sep.destroy()  # that day now starts higher up
        if self.last_day is None:
            self.last_day = prev
        self.first_day, self.top_sep = first_sep

    def _bubble(self, m):
        self.shown.add(m["id"])
        bubble = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        bubble.get_style_context().add_class("bubble")
        bubble.get_style_context().add_class("mine" if m["mine"] else "theirs")
        # A long press offers the reactions.
        hold = Gtk.EventBox()
        hold.set_halign(Gtk.Align.END if m["mine"] else Gtk.Align.START)
        hold.add(bubble)
        hold.press = Gtk.GestureLongPress.new(hold)
        hold.press.connect("pressed", lambda _g, _x, _y: self.on_hold(m["id"], bubble))
        if self.group and not m["mine"] and m["who"]:
            bubble.pack_start(label(m["who"], "who"), False, False, 0)
        if m.get("forwarded"):
            bubble.pack_start(label("↪ Переслано от %s" % m["forwarded"], "forwarded"), False, False, 0)
        for url in m["photos"]:
            img = Gtk.Image.new_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            img.set_size_request(460, 200)
            bubble.pack_start(img, False, False, 0)
            self.photos.append((img, url))  # loaded once near the screen
        for item in m.get("media") or []:
            bubble.pack_start(self._media(m, item), False, False, 0)
        if m["text"]:
            text = label(m["text"], "msg", wrap=True)
            text.set_max_width_chars(38)
            text.set_selectable(False)
            bubble.pack_start(text, False, False, 0)
        reacts = Gtk.Box(spacing=6)
        bubble.pack_start(reacts, False, False, 0)
        self.msgs[m["id"]] = (m, reacts)
        self._fill_reactions(m["id"])
        bubble.pack_start(label(when(m["time"], full=True), "when", xalign=1.0), False, False, 0)
        hold.msg_id = m["id"]
        hold.show_all()
        return hold

    def _media(self, m, item):
        """The controls of a voice message, a video or a file; what they do
        is on_media's."""
        if item["kind"] == "audio":
            box = Gtk.Box(spacing=12)
            play = Gtk.Button(label="▶")
            play.get_style_context().add_class("media")
            play.set_can_focus(False)
            bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER)
            bar.set_size_request(260, -1)
            length = label(mmss(secs(item["duration"])) if item["duration"] else
                           size_text(item.get("size") or 0), "when")
            controls = {"button": play, "bar": bar, "length": length}
            play.connect("clicked", lambda _b: self.on_media(m, item, controls))
            box.pack_start(play, False, False, 0)
            box.pack_start(bar, True, True, 0)
            box.pack_start(length, False, False, 0)
            if not item.get("name"):
                return box
            named = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            name = label("🎵  " + item["name"], "chat-last", ellipsize=True)
            name.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            name.set_max_width_chars(32)
            named.pack_start(name, False, False, 0)
            named.pack_start(box, False, False, 0)
            return named
        if item["kind"] == "video":
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            if item["thumb"]:
                img = Gtk.Image.new_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)
                img.set_size_request(460, 200)
                box.pack_start(img, False, False, 0)
                self.photos.append((img, item["thumb"]))  # Media.photo checks the host
            sec = secs(item["duration"])
            b = Gtk.Button(label="▶  Видео %s" % mmss(sec) if sec else "▶  Видео")
            b.get_style_context().add_class("file")
            b.set_can_focus(False)
            b.connect("clicked", lambda _b: self.on_media(m, item, {"button": b}))
            box.pack_start(b, False, False, 0)
            return box
        b = Gtk.Button(label="📄  %s · %s" % (item["name"], size_text(item["size"])))
        b.get_style_context().add_class("file")
        b.get_child().set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        b.get_child().set_max_width_chars(32)
        b.set_can_focus(False)
        b.connect("clicked", lambda _b: self.on_media(m, item, {"button": b}))
        return b

    def _fill_reactions(self, msg_id):
        """The reactions under a message: emoji and count, the account's own
        highlighted; a tap puts that one on, or takes the own one off."""
        m, box = self.msgs[msg_id]
        for child in box.get_children():
            child.destroy()
        for emoji, count in m.get("reactions") or []:
            b = Gtk.Button(label="%s %d" % (emoji, count))
            b.get_style_context().add_class("react")
            yours = emoji == m.get("yours")
            if yours:
                b.get_style_context().add_class("yours")
            b.set_can_focus(False)
            b.connect("clicked", lambda _b, e=None if yours else emoji: self.on_react(msg_id, e))
            box.pack_start(b, False, False, 0)
        box.show_all()

    def _start(self):
        if self.active and not self.building and (self.pending_new or self.pending_old):
            self.building = True
            GLib.idle_add(self._step, priority=GLib.PRIORITY_LOW)

    def _step(self):
        """A few bubbles, between the window's other work; stops when the
        chat is left and goes on when it is entered again."""
        if not self.active or not (self.pending_new or self.pending_old):
            self.building = False
            self._show_busy()
            if self.active:
                GLib.idle_add(self._load_visible)
                if self.prefetch > 0:  # all built: the next older page
                    GLib.timeout_add(300, lambda: self._load_older(background=True) and False)
            return False
        if self.pending_new:
            for m in self.pending_new[:STEP]:
                if m["id"] not in self.shown:
                    self._append(m)
            del self.pending_new[:STEP]
        elif time.monotonic() - self.scrolled_at < SETTLE:
            # The reader is scrolling: bubbles put in above now would fight
            # the kinetic scroll and throw the place. Wait until it rests.
            GLib.timeout_add(300, lambda: GLib.idle_add(self._step,
                                                        priority=GLib.PRIORITY_LOW) and False)
            return False  # still building: resumed by the timeout
        else:
            chunk = self.pending_old[-STEP:]
            del self.pending_old[-STEP:]
            adj = self.scroll.get_vadjustment()
            if not self.at_bottom:  # keep the place being read
                self.anchor = adj.get_upper() - adj.get_value()
            self._prepend(chunk)
            GLib.timeout_add(400, self._drop_anchor)
        return True

    def _queue_older(self, msgs):
        """Older messages (oldest first) to build above the top later; the
        oldest known time moves at once, so a page asked for meanwhile does
        not repeat them."""
        msgs = [m for m in msgs or [] if m["id"] not in self.shown]
        if not msgs:
            return
        self.pending_old = msgs + self.pending_old
        times = [m["time"] or 0 for m in msgs]
        self.oldest = min([self.oldest] + times) if self.oldest is not None else min(times)

    def _load_older(self, background=False):
        """The page before the oldest message known; the background ones
        stop when the chat is left."""
        if self.loading or self.done or self.oldest is None or self.pending_old:
            return False  # one page at a time, after the built ones
        if not self.active or background and self.prefetch <= 0:
            return False
        self.loading = True
        if background:
            self.prefetch -= 1
        self._show_busy()

        def done(msgs, err):
            self.loading = False
            if not err:
                if msgs:
                    self._queue_older(msgs)  # built above, a few at a time
                    self._start()
                else:
                    self.done = True
            self._show_busy()

        self.fetch_older(self.oldest, done)
        return False

    def _show_busy(self):
        """The spinner, while an older page comes or waits to be built and
        the reader is up at the top for it."""
        adj = self.scroll.get_vadjustment()
        near_top = adj.get_value() < adj.get_page_size() * 0.5
        on = self.active and near_top and (self.loading or bool(self.pending_old))
        if on != self.busy.get_visible():
            self.busy.set_visible(on)
            (self.spinner.start if on else self.spinner.stop)()

    # --- the place --------------------------------------------------------------
    def _keep_place(self, adj):
        self.moving = True
        if self.at_bottom:
            adj.set_value(adj.get_upper() - adj.get_page_size())
        elif self.anchor is not None:  # older messages came in above: stay put
            adj.set_value(adj.get_upper() - self.anchor)
        self.moving = False
        GLib.idle_add(self._load_visible)

    def _moved(self, adj):
        if not self.moving:
            self.scrolled_at = time.monotonic()
        self.at_bottom = adj.get_value() + adj.get_page_size() >= adj.get_upper() - 60
        self._show_down()
        if self.active and adj.get_value() < adj.get_page_size() * 0.5:
            self._load_older()
        self._show_busy()
        self._load_visible()

    def _to_bottom(self):
        self.at_bottom = True
        adj = self.scroll.get_vadjustment()
        self.moving = True
        adj.set_value(adj.get_upper() - adj.get_page_size())
        self.moving = False
        self._show_down()

    def _show_down(self):
        """The down button: only away from the newest message."""
        if self.at_bottom:
            self.unseen = 0
        self.down.set_label("↓ %d" % self.unseen if self.unseen else "↓")
        self.down.set_visible(not self.at_bottom and bool(self.shown))

    def _drop_anchor(self):
        self.anchor = None
        return False

    def _load_visible(self):
        """Fetch the photos within a screen of what is shown."""
        if not self.photos:
            return False
        adj = self.scroll.get_vadjustment()
        top, page = adj.get_value(), adj.get_page_size()
        keep = []
        for img, url in self.photos:
            pos = img.translate_coordinates(self.box, 0, 0)
            if img.get_realized() and pos and top - page <= pos[1] <= top + 2 * page:
                self.photo(url, lambda pix, img=img: pix and (
                    img.set_from_pixbuf(pix), img.set_size_request(-1, -1)))
            else:
                keep.append((img, url))
        self.photos = keep
        return False

    # --- forgetting -------------------------------------------------------------
    def _trim(self):
        """Only the newest BUBBLES messages stay built."""
        holds = [w for w in self.box.get_children() if hasattr(w, "msg_id")]
        if len(holds) <= BUBBLES:
            return
        gone = set()
        for w in self.box.get_children():
            if hasattr(w, "msg_id"):
                if len(holds) - len(gone) <= BUBBLES:
                    break
                gone.add(w.msg_id)
            w.destroy()
        self.shown -= gone
        self.pending_new, self.pending_old = [], []  # no longer continuous
        for i in gone:
            self.msgs.pop(i, None)
        self.photos = [(img, url) for img, url in self.photos if img.get_parent()]
        first = self.box.get_children()[0]
        m = self.msgs[first.msg_id][0]
        self.first_day = datetime.fromtimestamp(m["time"] / 1000).date()
        self.top_sep = self._day_label(m["time"])
        self.box.reorder_child(self.top_sep, 0)
        self.oldest, self.done = m["time"], False

    def _clear(self):
        for w in self.box.get_children():
            w.destroy()
        self.shown, self.msgs, self.photos = set(), {}, []
        self.pending_new, self.pending_old = [], []
        self.last_day = self.first_day = self.top_sep = self.oldest = None
        self.done = False


# --- the window -------------------------------------------------------------
class Max(Gtk.Application):
    def __init__(self, link=None, media=None):
        super().__init__(application_id="b8k.Max")
        self.win = None
        self.buzz = buzzer()
        self.backend = Backend(self, link)  # link: PyMaxLink unless given (tests, demo)
        self.telemetry = Telemetry(self.backend)
        self.came_from = "chats"  # the page the settings go back to
        self.buzz_new = load_setting("buzz")  # buzz on a new message
        # The list's rules and state; pins and notifications are kept here
        # only: MAX's own pinning and muting are not in PyMax.
        self.chatlist = ChatList(LIST, PREFS, contacts_only=load_setting("contacts_only"))
        self.positions = {}  # chat id -> place in the tab shown (the ListBox's order)
        self.tab = "chats"  # or "channels"
        self.media = media or Media()  # photos, voice, video, files: how MAX's CDNs are reached
        self.playing = None  # (progress bar, button, duration) of what plays
        self.held = 0.0  # when a row was long-pressed: its release opens nothing
        self.open_chat = None
        self.views = {}  # chat id -> its ChatView, most recently used last
        self.view = None  # the one on the chat page
        self.background = "--background" in sys.argv[1:]

    def do_activate(self):
        if self.win:
            self.win.present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_data((b8k_ui.HEADER_CSS if b8k_ui else b"") + CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.Button()  # the "pressed" signal exists once the class is set up
        GObject.add_emission_hook(Gtk.Button, "pressed", self.buzz)

        self.win = Gtk.ApplicationWindow(application=self, title="MAX")
        self.win.set_default_size(1160, 800)
        # Closing only hides the window: messages keep coming in.
        self.win.connect("delete-event", lambda w, _e: w.hide() or True)
        bar = Gtk.HeaderBar()
        heading = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.title = label("MAX", "title", xalign=0.5)
        self.sub = label("", "sub", xalign=0.5)
        heading.pack_start(self.title, False, False, 0)
        heading.pack_start(self.sub, False, False, 0)
        bar.set_custom_title(heading)
        self.back = Gtk.Button(label="←")
        self.back.get_style_context().add_class("back")
        self.back.connect("clicked", lambda _b: self.go_back())
        self.back.set_no_show_all(True)
        bar.pack_start(self.back)
        self.gear = Gtk.Button.new_from_icon_name("emblem-system-symbolic", Gtk.IconSize.DIALOG)
        self.gear.get_style_context().add_class("gear")
        self.gear.connect("clicked", lambda _b: self.show_settings())
        self.gear.set_no_show_all(True)
        bar.pack_end(self.gear)
        self.findb = Gtk.Button.new_from_icon_name("system-search-symbolic", Gtk.IconSize.DIALOG)
        self.findb.get_style_context().add_class("gear")
        self.findb.connect("clicked", lambda _b: self.show_find())
        self.findb.set_no_show_all(True)
        bar.pack_end(self.findb)
        # A chat's own menu: rename, pin, notifications, delete.
        self.edit = Gtk.Button.new_from_icon_name("document-edit-symbolic", Gtk.IconSize.DIALOG)
        self.edit.get_style_context().add_class("gear")
        self.edit.connect("clicked", lambda _b: self.chat_menu())
        self.edit.set_no_show_all(True)
        bar.pack_end(self.edit)
        self.win.set_titlebar(bar)
        self.win.connect("map", lambda _w: self.moved())
        self.win.connect("unmap", lambda _w: self.telemetry.go(SCREEN_BACKGROUND))

        self.stack = Gtk.Stack()
        # Only the page shown sets the window's size. A stack is as tall as
        # its tallest page by default: the QR page and the search page kept
        # the window taller than the room the on-screen keyboard leaves, and
        # the window covered the keyboard's top row.
        self.stack.set_vhomogeneous(False)
        self.stack.set_hhomogeneous(False)
        self.win.add(self.stack)
        wait = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        wait.set_valign(Gtk.Align.CENTER)
        self.wait_text = label("Подключение к MAX…", "big", xalign=0.5)
        wait.pack_start(self.wait_text, False, False, 0)
        self.stack.add_named(wait, "wait")

        qr = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        qr.set_valign(Gtk.Align.CENTER)
        qr.pack_start(label("Вход в MAX", "big", xalign=0.5), False, False, 0)
        self.qr_image = Gtk.Image()
        qr.pack_start(self.qr_image, False, False, 0)
        qr.pack_start(label("Откройте MAX на телефоне и отсканируйте этот код",
                            "hint", xalign=0.5), False, False, 0)
        self.stack.add_named(qr, "qr")

        self.list = Gtk.ListBox()
        self.list.set_selection_mode(Gtk.SelectionMode.NONE)
        self.list.connect("row-activated", self.on_row)
        # Newest first. GTK wants a 32-bit answer: the difference of two
        # times in ms overflows past 24 days, so only the sign is given.
        # The order and the tab are ChatList's (entries); GTK only shows them.
        self.list.set_sort_func(lambda a, b: self.positions.get(a.chat_id, 0)

    def forward_to(self, target):
        if not self.forwarding:
            return
        self.buzz()
        source, msg_id = self.forwarding
        title = (self.chatlist.get(target) or {}).get("title", "")
        self.end_forward()
        self.sub.set_text("пересылаю…")

        def done(res, err):
            if err or not res:
                self.sub.set_text("не удалось переслать")
                return
            out, summary = res
            if summary:
                self.chatlist.update(summary)
                self.fill_list()
            view = self.views.get(target)
            if view:
                view.add(out)
            if self.open_chat == source:
                self.sub.set_text("переслано: %s" % title)

        self.backend.run(self.backend.forward(target, msg_id, source), done)


        self.find_entry.grab_focus()

    def find(self):
        text = self.find_entry.get_text().strip()
        for child in self.found.get_children():
            child.destroy()
        if not text:
            return
        phone, link = phone_of(text), link_of(text)
        if phone:
            self.find_hint.set_text("Ищу %s…" % phone)

            def person(p, err):
                if self.find_entry.get_text().strip() != text:
                    return  # asked something else meanwhile
                if err or not p:
                    self.find_hint.set_text("С номером %s в MAX никого не нашлось." % phone)
                    return
                self.find_hint.set_text("")
                self.show_person(p)

            self.backend.run(self.backend.find_phone(phone), person)
        elif link:
            self.find_hint.set_text("Открываю ссылку…")

            def chat(info, err):
                if self.find_entry.get_text().strip() != text:
                    return
                if err or not info:
                    # MAX told nothing about the link; joining may still work.
                    self.find_hint.set_text("Сведений по ссылке нет, но вступить можно попробовать.")
                    info = {"id": 0, "title": link.split("max.ru/", 1)[1], "type": "",

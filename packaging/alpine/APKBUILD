# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-messenger
pkgver=2.9.6
pkgrel=0
pkgdesc="Сообщения: an unofficial client for the MAX messenger (Haltia, GTK 3)"
url="https://github.com/haltia-de/messenger"
# b8k-max until 2.0: apk upgrade takes this for it.
provides="b8k-max=$pkgver-r$pkgrel"
replaces="b8k-max"
arch="noarch"
license="GPL-3.0-or-later"
# PyMax's own needs, Telethon (Telegram), then voice messages (libmpv) and emoji.
depends="python3 py3-gobject3 gtk+3.0 py3-haltia-kit>=2.3.1 libsecret
	py3-aiohttp py3-pydantic py3-aiofiles py3-aiosqlite py3-msgpack
	py3-python-socks py3-qrcode py3-websockets py3-zstandard py3-telethon
	py3-mpv mpv-libs font-noto-emoji
	gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad libnice-gstreamer
	haltia-gst-webrtc libcamera-gstreamer gst-libav"
_whl=maxapi_python-2.4.1-py3-none-any.whl
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/messenger/archive/v$pkgver.tar.gz
	$_whl::https://files.pythonhosted.org/packages/py3/m/maxapi-python/$_whl"
noextract="$_whl"
# GitHub names the tarball's folder after the repository, not the package.
builddir="$srcdir/messenger-$pkgver"

# install.sh checks the PyMax wheel given in source= (net: abuild fetches it).
options="net !check"

package() {
	HALTIA_CACHE="$srcdir" sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
